<%# Compte de résultat: the income statement of the month, from AccountingStats. Nothing is calculated here except printing. %>
<% totals = stats.totals %>
<% cur = stats.currency %>
<% split = stats.delivery_split %>
<% gross_share = totals.revenue.positive? ? Rational(totals.gross_margin, totals.revenue) : nil %>
<% net_share = totals.revenue.positive? ? Rational(totals.net, totals.revenue) : nil %>
<% loss = totals.net.negative? %>

<section class="max-w-4xl rounded-2xl border border-[#e8e3df] bg-white p-5 sm:p-6" data-income>
  <h2 class="flex items-center gap-2 text-lg font-bold text-[#1f2430]"><%= seller_icon(:orders, size: 18) %><%= t("accounting.income.title") %></h2>

  <div class="mt-5 space-y-3">
    <div class="rounded-xl bg-[#f7f5f2] p-4" data-block="revenue">
      <p class="flex items-center gap-2 text-sm font-semibold text-[#2f7a4a]"><span class="size-2 rounded-full bg-[#2f7a4a]"></span><%= t("accounting.income.revenue_title") %></p>
      <div class="mt-2 flex justify-between border-s-2 border-[#e1dbd6] ps-3 text-sm"><span><%= t("accounting.income.product_sales") %></span><span data-amount="product_sales"><%= acc_exact(totals.revenue) %> <%= cur %></span></div>
      <div class="mt-3 flex justify-between border-t border-dashed border-[#e1dbd6] pt-3 font-semibold text-[#1f2430]"><span><%= t("accounting.income.revenue_total") %></span><span class="text-[#2f7a4a]" data-amount="revenue"><%= acc_exact(totals.revenue) %> <%= cur %></span></div>
    </div>

    <div class="rounded-xl bg-[#f7f5f2] p-4" data-block="goods">
      <div class="flex flex-wrap items-center justify-between gap-2">
        <p class="flex items-center gap-2 text-sm font-semibold text-[#d08a1f]"><span class="size-2 rounded-full bg-[#d08a1f]"></span><%= t("accounting.income.cogs_title") %></p>
        <span class="rounded-md bg-[#fcf0dc] px-2 py-0.5 text-[11px] font-medium text-[#9a6412]"><%= t("accounting.income.based_#{stats.basis}") %></span>
      </div>
      <div class="mt-2 flex justify-between border-s-2 border-[#e1dbd6] ps-3 text-sm"><span><%= t("accounting.income.product_costs") %></span><span data-amount="product_costs"><%= acc_exact(totals.goods) %> <%= cur %></span></div>
      <% stats.goods_breakdown.each do |product| %>
        <div class="mt-1 border-s-2 border-[#e1dbd6] ps-3 text-xs text-[#6f6967]" data-product="<%= product[:name] %>">
          <div class="flex items-baseline justify-between gap-3">
            <span class="min-w-0" dir="auto"><%= product[:name] %></span>
            <span class="flex shrink-0 items-baseline gap-4">
              <span class="text-[#8a8380]" dir="ltr"><%= product[:unit_cost_cents] ? "#{product[:quantity]} × #{acc_exact(product[:unit_cost_cents])} #{cur}" : "#{product[:quantity]} #{t("accounting.income.units")}" %></span>
              <span class="w-24 text-end text-[#1f2430]" data-amount="product"><%= acc_exact(product[:cents]) %></span>
            </span>
          </div>
          <% variants = product[:variants].reject { |variant| variant[:name].blank? } %>
          <% if variants.any? %>
            <details class="mt-0.5">
              <summary class="cursor-pointer text-[#3d63b8] select-none"><%= t("accounting.income.detail", count: variants.length) %></summary>
              <ul class="mt-1 space-y-0.5 ps-3">
                <% product[:variants].each do |variant| %>
                  <li class="flex items-baseline justify-between gap-3" data-variant>
                    <span dir="auto"><%= variant[:name].presence || t("accounting.income.no_variant") %></span>
                    <span class="flex shrink-0 items-baseline gap-4">
                      <span class="text-[#8a8380]" dir="ltr"><%= variant[:unit_cost_cents] ? "#{variant[:quantity]} × #{acc_exact(variant[:unit_cost_cents])} #{cur}" : "#{variant[:quantity]} #{t("accounting.income.units")}" %></span>
                      <span class="w-24 text-end text-[#1f2430]"><%= acc_exact(variant[:cents]) %></span>
                    </span>
                  </li>
                <% end %>
              </ul>
            </details>
          <% end %>
        </div>
      <% end %>
      <div class="mt-3 flex justify-between border-t border-dashed border-[#e1dbd6] pt-3 font-semibold text-[#1f2430]"><span><%= t("accounting.income.cogs_total") %></span><span class="text-[#d08a1f]" data-amount="goods"><%= acc_expense(totals.goods, cur) %></span></div>
    </div>

    <div class="flex items-center justify-between rounded-xl border border-[#cbd9f3] bg-[#eef3fc] px-4 py-3.5" data-block="gross_margin">
      <span class="font-bold text-[#1f2430]"><%= t("accounting.income.gross") %></span>
      <span class="text-lg font-bold text-[#3d63b8]"><span data-amount="gross_margin"><%= acc_exact(totals.gross_margin) %> <%= cur %></span><% if gross_share %> <span class="text-xs font-medium" data-share="gross"><%= acc_percent(gross_share) %> %</span><% end %></span>
    </div>

    <div class="rounded-xl bg-[#f7f5f2] p-4" data-block="ads">
      <p class="flex items-center gap-2 text-sm font-semibold text-[#8f6bc1]"><span class="size-2 rounded-full bg-[#8f6bc1]"></span><%= t("accounting.income.ads_title") %></p>
      <div class="mt-2 flex justify-between border-s-2 border-[#e1dbd6] ps-3 text-sm"><span><%= t("accounting.income.ad_spend") %></span><span><%= acc_exact(totals.ads) %> <%= cur %></span></div>
      <div class="mt-3 flex justify-between border-t border-dashed border-[#e1dbd6] pt-3 font-semibold text-[#1f2430]"><span><%= t("accounting.income.ads_total") %></span><span class="text-[#8f6bc1]" data-amount="ads"><%= acc_expense(totals.ads, cur) %></span></div>
    </div>

    <div class="rounded-xl bg-[#f7f5f2] p-4" data-block="delivery">
      <p class="flex items-center gap-2 text-sm font-semibold text-[#b4344e]"><span class="size-2 rounded-full bg-[#b4344e]"></span><%= t("accounting.income.delivery_title") %></p>
      <div class="mt-2 flex justify-between border-s-2 border-[#e1dbd6] ps-3 text-sm"><span><%= t("accounting.income.delivery_delivered") %></span><span data-amount="delivery_delivered"><%= acc_exact(split[:delivered]) %> <%= cur %></span></div>
      <div class="mt-1 flex justify-between border-s-2 border-[#e1dbd6] ps-3 text-sm"><span><%= t("accounting.income.delivery_returned") %></span><span data-amount="delivery_returned"><%= acc_exact(split[:returned]) %> <%= cur %></span></div>
      <div class="mt-3 flex justify-between border-t border-dashed border-[#e1dbd6] pt-3 font-semibold text-[#1f2430]"><span><%= t("accounting.income.delivery_total") %></span><span class="text-[#b4344e]" data-amount="delivery"><%= acc_expense(totals.delivery, cur) %></span></div>
    </div>

    <div class="rounded-xl bg-[#f7f5f2] p-4" data-block="operating">
      <p class="flex items-center gap-2 text-sm font-semibold text-[#b4344e]"><span class="size-2 rounded-full bg-[#b4344e]"></span><%= t("accounting.income.opex_title") %></p>
      <p class="mt-2 border-s-2 border-[#e1dbd6] ps-3 text-xs text-[#8a8380]"><%= t("accounting.income.opex_note") %></p>
      <div class="mt-3 flex justify-between border-t border-dashed border-[#e1dbd6] pt-3 font-semibold text-[#1f2430]"><span><%= t("accounting.income.opex_total") %></span><span class="text-[#b4344e]" data-amount="operating"><%= acc_expense(0, cur) %></span></div>
    </div>

    <div class="flex items-center justify-between rounded-xl border px-4 py-3.5 <%= loss ? "border-[#f0c6cd] bg-[#fdeff1]" : "border-[#bfe0c9] bg-[#eaf6ee]" %>" data-block="net">
      <span class="font-bold text-[#1f2430]"><%= t(loss ? "accounting.income.loss" : "accounting.income.net") %></span>
      <span class="text-lg font-bold <%= loss ? "text-[#b4344e]" : "text-[#2f7a4a]" %>"><span data-amount="net"><%= acc_exact(totals.net) %> <%= cur %></span><% if net_share %> <span class="text-xs font-medium" data-share="net"><%= acc_percent(net_share) %> %</span><% end %></span>
    </div>
  </div>

  <% if totals.orders.zero? && stats.lines.empty? %><p class="mt-4 text-center text-sm text-[#8a8380]"><%= t("accounting.income.empty") %></p><% end %>
</section>
