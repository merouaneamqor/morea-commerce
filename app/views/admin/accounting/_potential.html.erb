<% potential = stats.potential %>
<section class="min-w-0 rounded-xl border border-[#e0e0e5] bg-white p-4" data-potential-profit>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0">
      <h2 class="text-lg font-bold text-[#1c1c1e]"><%= t("accounting.potential.title") %></h2>
      <p class="mt-1 text-sm text-[#6e6e73]"><%= t("accounting.potential.orders", count: potential[:orders]) %></p>
    </div>
    <p class="min-w-0 break-words text-2xl font-bold <%= potential[:contribution]&.negative? ? "text-[#b4344e]" : "text-[#1c1c1e]" %>" data-potential-value>
      <%= acc_amount(potential[:contribution]) %><% unless potential[:contribution].nil? %> <span class="text-sm font-semibold text-[#6e6e73]"><%= stats.currency %></span><% end %>
    </p>
  </div>
  <p class="mt-3 text-sm text-[#3a3a3c]"><%= t("accounting.potential.assumption") %></p>
  <p class="mt-1 text-xs text-[#6e6e73]"><%= t("accounting.potential.costs") %></p>
  <% if potential[:missing_cost_orders].positive? || potential[:missing_delivery_fee_orders].positive? %>
    <div class="mt-3 space-y-1 rounded-lg bg-[#fdf0d9] px-3 py-2 text-sm text-[#8a5a12]" data-potential-incomplete>
      <p><%= t("accounting.potential.incomplete") %></p>
      <% if potential[:missing_cost_orders].positive? %><p><%= t("accounting.potential.missing_goods", count: potential[:missing_cost_orders]) %></p><% end %>
      <% if potential[:missing_delivery_fee_orders].positive? %><p><%= t("accounting.potential.missing_delivery", count: potential[:missing_delivery_fee_orders]) %></p><% end %>
    </div>
  <% end %>
</section>
