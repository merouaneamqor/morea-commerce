<%# Comptabilité. Every figure comes from AccountingStats; nothing is calculated in this view except printing. %>
<% content_for :title, t("accounting.title") %>
<% content_for :admin_page_class, "seller-page" %>
<% content_for :seller_lang, "1" %>
<% stats = @stats %>
<% totals = stats.totals %>
<% cur = stats.currency %>
<% range = stats.date_range %>
<% range_params = range.to_param.merge(preset: @date_range_preset).compact %>
<% link_for = ->(extra = {}) { seller_accounting_path({ **range_params, basis: stats.basis, tab: (@tab unless @tab == "overview") }.merge(extra).compact) } %>
<% daily = stats.daily.values %>
<% returns_count = stats.lines.count { |line| line.kind == "returned" } %>
<% warnings = stats.warnings %>

<header class="flex min-h-[72px] flex-wrap items-center justify-between gap-3 rounded-2xl bg-[#1c1c1e] px-4 py-3 text-white" data-header>
  <div class="flex items-center gap-3">
    <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-white/10"><%= seller_icon(:calculator, size: 20) %></span>
    <div>
      <h1 class="text-xl leading-tight font-bold"><%= t("accounting.title") %></h1>
      <p class="text-[13px] leading-tight text-white/70"><%= t("accounting.subtitle") %></p>
    </div>
  </div>
  <div class="flex flex-wrap items-center gap-2">
    <div class="flex rounded-lg bg-white/10 p-0.5 text-[13px] font-semibold" role="group" aria-label="<%= t("accounting.delivered") %> / <%= t("accounting.shipped") %>" data-basis-toggle>
      <% %w[delivered shipped].each do |basis| %>
        <%= link_to t("accounting.#{basis}"), link_for.(basis: basis), "aria-current": (stats.basis == basis ? "true" : nil), title: t("accounting.basis_#{basis}_hint"),
              class: "flex h-7 items-center rounded-md px-2.5 transition #{stats.basis == basis ? "bg-white text-[#1c1c1e]" : "text-white/75 hover:text-white"}" %>
      <% end %>
    </div>
    <%= render "admin/shared/date_range_picker", range: range, preset: @date_range_preset, url: seller_accounting_path, theme: "dark", size: "compact",
          extra: { basis: stats.basis, tab: (@tab unless @tab == "overview") }.compact %>
    <%= link_to seller_accounting_export_path(range.to_param.merge(basis: stats.basis, format: "csv")), data: { export: true },
          class: "flex h-8 items-center gap-1.5 rounded-lg bg-[#1d1d1f] px-2.5 text-[13px] font-semibold text-white hover:bg-[#3a3a3c]" do %>
      <svg viewBox="0 0 24 24" class="size-3.5 fill-none stroke-current [stroke-width:2] [stroke-linecap:round] [stroke-linejoin:round]" aria-hidden="true"><path d="M12 3v12m0 0 4-4m-4 4-4-4M4 19h16"/></svg>
      <%= t("accounting.export") %>
    <% end %>
    <%= render "admin/shared/language_switcher", size: "sm" %>
  </div>
</header>

<% if warnings[:missing_cost_orders].positive? || warnings[:missing_delivery_fee_orders].positive? || warnings[:missing_return_fee_orders].positive? || warnings[:unconverted_ad_rows].positive? %>
  <section class="space-y-2" data-warnings>
    <% if warnings[:missing_cost_orders].positive? %>
      <p class="flex flex-wrap items-center justify-between gap-2 rounded-2xl bg-[#fbe7ea] px-4 py-3 text-sm text-[#8f2a40]"><span><%= t("accounting.warnings.missing_cost", count: warnings[:missing_cost_orders]) %></span>
        <%= link_to t("accounting.warnings.complete_costs"), "/produits?missing=1", class: "font-semibold underline underline-offset-2" %></p>
    <% end %>
    <% if warnings[:missing_delivery_fee_orders].positive? %><p class="rounded-2xl bg-[#fbe7ea] px-4 py-3 text-sm text-[#8f2a40]"><%= t("accounting.warnings.missing_delivery_fee", count: warnings[:missing_delivery_fee_orders]) %></p><% end %>
    <% if warnings[:missing_return_fee_orders].positive? %><p class="rounded-2xl bg-[#fbe7ea] px-4 py-3 text-sm text-[#8f2a40]"><%= t("accounting.warnings.missing_return_fee", count: warnings[:missing_return_fee_orders]) %></p><% end %>
    <% if warnings[:unconverted_ad_rows].positive? %><p class="rounded-2xl bg-[#fdf0d9] px-4 py-3 text-sm text-[#8a5a12]"><%= t("accounting.warnings.unconverted_ads", count: warnings[:unconverted_ad_rows]) %></p><% end %>
  </section>
<% end %>

<nav class="flex w-fit max-w-full flex-wrap gap-1 rounded-xl border border-[#e0e0e5] bg-white p-1" aria-label="<%= t("accounting.title") %>" data-tabs>
  <% { "overview" => :profit, "income" => :orders, "receivables" => :clients, "debts" => :team, "inventory" => :box }.each do |tab, icon| %>
    <%= link_to link_for.(tab: (tab == "overview" ? nil : tab)), "aria-current": (@tab == tab ? "page" : nil),
          class: "flex items-center gap-1.5 rounded-lg px-3 py-1.5 text-[13px] font-medium whitespace-nowrap transition #{@tab == tab ? "bg-[#ececf0] font-semibold text-[#1d1d1f]" : "text-[#3a3a3c] hover:bg-[#e8e8ed]"}" do %>
      <%= seller_icon(icon, size: 14) %><%= t("accounting.tabs.#{tab}") %>
    <% end %>
  <% end %>
</nav>

<% if @tab == "overview" %>
  <% money_unit = cur %>
  <% diff = totals.revenue - stats.previous_totals.revenue %>
  <% revenue_sub = stats.change(:revenue).is_a?(Rational) || stats.change(:revenue) == :new ? t("accounting.subs.revenue_diff", amount: "#{diff.positive? ? "+" : ""}#{acc_amount(diff)}", currency: cur) : t("accounting.subs.revenue_none", count: totals.orders) %>
  <section class="grid grid-cols-2 gap-2.5 lg:grid-cols-3 xl:grid-cols-5" data-cards="first">
    <%= render "card", key: "revenue", label: t("accounting.cards.revenue"), icon: :profit, value: acc_amount(totals.revenue), unit: money_unit, change: acc_change(stats.change(:revenue)), good_when: :up,
          sub: revenue_sub, series: daily.map(&:revenue), featured: true %>
    <%= render "card", key: "goods", label: t("accounting.cards.goods"), title: t("accounting.cards.goods_title"), icon: :box, value: acc_amount(totals.goods), unit: money_unit, change: acc_change(stats.change(:goods)), good_when: :down,
          sub: t("accounting.subs.goods_share", pct: acc_percent(totals.revenue.positive? ? Rational(totals.goods, totals.revenue) : nil)), series: daily.map(&:goods) %>
    <%= render "card", key: "gross_margin", label: t("accounting.cards.gross_margin"), icon: :chart, value: acc_amount(totals.gross_margin), unit: money_unit, change: acc_change(stats.change(:gross_margin)), good_when: :up,
          sub: t("accounting.subs.gross"), series: daily.map(&:gross_margin) %>
    <%= render "card", key: "delivery", label: t("accounting.cards.delivery"), icon: :truck, value: acc_amount(totals.delivery), unit: money_unit, change: acc_change(stats.change(:delivery)), good_when: :down,
          sub: t("accounting.subs.delivery_returns", count: returns_count), series: daily.map(&:delivery) %>
    <%= render "card", key: "net", label: t("accounting.cards.net"), icon: :orders, value: acc_amount(totals.net), unit: money_unit, change: acc_change(stats.change(:net)), good_when: :up,
          sub: t("accounting.subs.net"), series: daily.map(&:net) %>
  </section>

  <section class="grid grid-cols-2 gap-2.5 xl:grid-cols-4" data-cards="second">
    <%= render "card", compact: true, key: "basket", label: t("accounting.cards.basket"), icon: :orders, value: acc_amount(totals.average_basket), unit: money_unit, change: acc_change(stats.change(:average_basket)), good_when: :up,
          sub: t("accounting.subs.basket", count: totals.orders), series: daily.map(&:average_basket) %>
    <%= render "card", compact: true, key: "ads", label: t("accounting.cards.ads"), icon: :target, value: acc_amount(totals.ads), unit: money_unit, change: acc_change(stats.change(:ads)), good_when: :down,
          sub: (totals.ads.positive? && totals.orders.positive? ? t("accounting.subs.ads_per_order", amount: acc_amount(Rational(totals.ads, totals.orders)), currency: cur) : t("accounting.subs.ads_none")), series: daily.map(&:ads) %>
    <%= render "card", compact: true, key: "expenses", label: t("accounting.cards.expenses"), icon: :chart, value: acc_amount(totals.expenses), unit: money_unit, change: acc_change(stats.change(:expenses)), good_when: :down,
          sub: t("accounting.subs.expenses"), series: daily.map(&:expenses) %>
    <% points_text, = acc_points_change(stats.margin_change_points) %>
    <%= render "card", compact: true, key: "margin", label: t("accounting.cards.margin"), icon: :profit, value: acc_percent(totals.margin), unit: (totals.margin ? "%" : ""), change: acc_points_change(stats.margin_change_points), good_when: :up,
          sub: t("accounting.subs.margin_points", pts: points_text), series: daily.map(&:margin) %>
  </section>

  <% split = stats.split_per_100 %>
  <section class="grid gap-2.5 xl:grid-cols-[1.6fr_1fr]">
    <div class="rounded-xl border border-[#e0e0e5] bg-white p-4" data-split>
      <div class="flex flex-wrap items-baseline justify-between gap-2">
        <h2 class="text-lg font-bold text-[#1c1c1e]"><%= t("accounting.split.title", currency: cur) %></h2>
        <span class="text-xs text-[#6e6e73]"><%= t("accounting.split.of", amount: acc_amount(totals.revenue), currency: cur) %></span>
      </div>
      <% if split.nil? %>
        <p class="mt-6 text-sm text-[#6e6e73]"><%= t("accounting.split.none") %></p>
      <% else %>
        <% parts = [ [ :goods, "#d19a4b", totals.goods ], [ :delivery, "#5b7fb9", totals.delivery ], [ :ads, "#8e8e93", totals.ads ], [ :profit, "#3b7d55", split[:loss] ? 0 : totals.net ] ] %>
        <% if split[:loss] %><p class="mt-3 rounded-xl bg-[#fbe7ea] px-3 py-2 text-sm text-[#8f2a40]"><%= t("accounting.split.loss_note", amount: acc_amount(-totals.net), currency: cur) %></p><% end %>
        <div class="mt-4 flex h-3 gap-0.5 overflow-hidden rounded-full" role="img" aria-label="<%= t("accounting.split.title", currency: cur) %>">
          <% parts.each do |key, color, _| %><% next if split[:shares][key].zero? %><span style="width: <%= split[:shares][key] / 10.0 %>%; background-color: <%= color %>" data-share="<%= key %>=<%= split[:shares][key] %>"></span><% end %>
        </div>
        <div class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-4">
          <% parts.each do |key, color, cents| %>
            <div data-part="<%= key %>">
              <p class="flex items-center gap-2 text-sm text-[#3a3a3c]"><span class="size-2.5 rounded-full" style="background-color: <%= color %>"></span><%= t("accounting.split.#{key}") %></p>
              <p class="mt-1 text-2xl font-bold text-[#1c1c1e]"><%= acc_tenths(split[:shares][key]) %> <span class="text-sm font-semibold text-[#6e6e73]"><%= cur %></span></p>
              <p class="text-xs text-[#6e6e73]"><%= acc_amount(cents) %> <%= cur %></p>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="space-y-2.5" data-side-cards>
      <% inventory = stats.inventory %>
      <% side = [
           [ "receivables", :receivables, acc_amount(stats.receivables[:cents]), t("accounting.side.receivables_sub", count: stats.receivables[:parcels]) ],
           [ "debts", :debts, acc_amount(nil), t("accounting.side.debts_sub") ],
           [ "inventory", :inventory, acc_amount(inventory[:cents]), t("accounting.side.inventory_sub", count: inventory[:products], out: inventory[:out_of_stock]) ]
         ] %>
      <% side.each do |key, tab, value, sub| %>
        <%= link_to link_for.(tab: tab), class: "group flex items-center justify-between gap-3 rounded-xl border border-[#e0e0e5] bg-white px-4 py-3 transition hover:border-[#d2d2d7]", data: { side: key } do %>
          <div>
            <p class="font-semibold text-[#1c1c1e]"><%= t("accounting.side.#{key}") %></p>
            <p class="text-xs text-[#6e6e73]"><%= t("accounting.side.#{key}_hint") %></p>
            <% if key == "inventory" && inventory[:missing_cost].positive? %><p class="mt-1 text-xs text-[#8a5a12]"><%= t("accounting.side.inventory_missing", count: inventory[:missing_cost]) %></p><% end %>
          </div>
          <div class="text-end">
            <p class="text-xl font-bold whitespace-nowrap text-[#1c1c1e]"><%= value %><% unless value == AccountingHelper::DASH %> <span class="text-sm font-semibold text-[#6e6e73]"><%= cur %></span><% end %></p>
            <p class="text-xs whitespace-nowrap text-[#6e6e73]"><%= sub %> <span class="inline-block transition group-hover:translate-x-0.5 rtl:rotate-180">→</span></p>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>
<% elsif @tab == "income" %>
  <%= render "income", stats: stats %>
<% else %>
  <section class="rounded-2xl border border-[#e0e0e5] bg-white p-10 text-center text-sm text-[#6e6e73]" data-tab-later="<%= @tab %>"><%= t("accounting.tab_later") %></section>
<% end %>
