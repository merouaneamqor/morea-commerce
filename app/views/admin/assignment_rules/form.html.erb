<%# The create / edit form answered into the order-modal frame (the glass window of "Nouvelle commande"). %>
<turbo-frame id="order-modal">
  <div data-order-modal data-controller="order-modal" data-action="click->order-modal#backdrop">
    <div data-order-modal-panel data-narrow role="dialog" aria-modal="true" aria-labelledby="rule-modal-title">
      <header class="flex items-start justify-between gap-3 px-6 pt-5">
        <div>
          <h2 id="rule-modal-title" class="flex items-center gap-2 text-xl font-bold text-[#1c1c1e]"><%= seller_icon(:settings, size: 20) %><%= @rule.persisted? ? sl("Modifier la règle") : sl("Créer une règle d'attribution") %></h2>
          <p class="mt-1 text-sm text-[#6e6e73]"><%= sl("Définissez quand cette règle s'applique et quels agents reçoivent les commandes correspondantes.") %></p>
        </div>
        <button type="button" data-action="order-modal#close" aria-label="<%= sl("Fermer") %>" class="grid size-8 shrink-0 cursor-pointer place-items-center rounded-full bg-[#e5484d] text-white shadow-[0_8px_18px_-8px_rgba(229,72,77,0.9)] hover:bg-[#cf3a3f]">
          <svg viewBox="0 0 24 24" class="size-4 fill-none stroke-current [stroke-width:2.4] [stroke-linecap:round]" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18"/></svg>
        </button>
      </header>
      <div class="px-6 pt-3 pb-5"><%= render "fields", rule: @rule, agents: agents, sources: sources, modal: true %></div>
    </div>
  </div>
</turbo-frame>
