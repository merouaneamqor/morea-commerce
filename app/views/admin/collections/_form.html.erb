<% content_for :title, (@collection.persisted? ? @collection.name : "Create collection") + " — Admin" %>

<div class="admin-page-header">
  <div class="flex items-center gap-2">
    <%= link_to admin_collections_path, class: "admin-back", "aria-label": "Back to collections" do %><%= admin_icon(:back) %><% end %>
    <h1 class="admin-page-header__title"><%= @collection.persisted? ? @collection.name : "Create collection" %></h1>
  </div>
  <button type="submit" form="collection-form" class="admin-btn">Save</button>
</div>

<%= form_with model: [:admin, @collection], id: "collection-form" do |f| %>
  <% if @collection.errors.any? %>
    <div class="admin-banner admin-banner--critical"><%= @collection.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="admin-layout">
    <div class="admin-stack">
      <%= render "translations_fields", f: f %>

      <section class="admin-card">
        <div class="admin-card__header"><h2 class="admin-card__title">Products</h2></div>
        <ul class="pb-2">
          <% current_store.products.includes(:translations, images_attachments: :blob).order(:name).each do |product| %>
            <li>
              <label class="flex cursor-pointer items-center gap-3 px-4 py-2 hover:bg-[#f7f7f7]">
                <%= check_box_tag "collection[product_ids][]", product.id, @collection.product_ids.include?(product.id), class: "h-4 w-4 accent-[#303030]" %>
                <%= admin_thumb(product_image_url(product)) %>
                <span class="flex-1 font-medium"><%= product.name %></span>
                <%= admin_badge(product.status) %>
              </label>
            </li>
          <% end %>
        </ul>
      </section>
    </div>

    <div class="admin-stack">
      <section class="admin-card">
        <div class="admin-card__header"><h2 class="admin-card__title">Cover image</h2></div>
        <div class="space-y-3 px-4 pb-4" data-controller="media">
          <% if (cover = collection_cover_url(@collection)) %>
            <span class="admin-thumb !h-32 !w-full"><%= image_tag MediaUrl.sized(cover, width: 640), alt: "", class: "h-full w-full object-cover" %></span>
            <% if @collection.image.attached? %>
              <label class="admin-check"><%= check_box_tag "collection[remove_image]", "1", false %> Remove cover</label>
            <% end %>
          <% end %>
          <label class="admin-dropzone" data-media-target="zone"
                 data-action="dragover->media#zoneOver dragleave->media#zoneLeave drop->media#zoneDrop">
            <span class="admin-btn-secondary pointer-events-none"><%= @collection.image.attached? ? "Replace image" : "Upload image" %></span>
            <span class="admin-help">or drop an image here. Shown on collection tiles; without one, a product photo is used.</span>
            <%= f.file_field :image, direct_upload: false, accept: "image/*", class: "sr-only",
                  data: { media_target: "input", action: "change->media#renderPreviews" } %>
          </label>
          <ul class="admin-media-grid empty:hidden" data-media-target="previews"></ul>
        </div>
      </section>

      <section class="admin-card">
        <div class="admin-card__header"><h2 class="admin-card__title">Publishing</h2></div>
        <div class="px-4 pb-4">
          <label class="admin-check"><%= f.check_box :published %> Visible on Online Store</label>
        </div>
      </section>

      <section class="admin-card">
        <div class="admin-card__header"><h2 class="admin-card__title">Details</h2></div>
        <div class="space-y-4 px-4 pb-4">
          <div>
            <%= f.label :slug, "URL handle", class: "admin-label" %>
            <%= f.text_field :slug, class: "admin-input" %>
          </div>
          <div>
            <%= f.label :position, "Sort position", class: "admin-label" %>
            <%= f.number_field :position, class: "admin-input" %>
          </div>
        </div>
      </section>
    </div>
  </div>
<% end %>

<% if @collection.persisted? %>
  <div class="mt-6 flex justify-between border-t border-[#e3e3e3] pt-4">
    <%= button_to "Delete collection", admin_collection_path(@collection), method: :delete,
          form: { data: { turbo_confirm: "Delete this collection?" } },
          class: "admin-btn-critical" %>
    <button type="submit" form="collection-form" class="admin-btn">Save</button>
  </div>
<% end %>
