<% content_for :title, "Collections — Admin" %>

<div class="mb-8 flex items-center justify-between">
  <h1 class="text-2xl font-medium">Collections</h1>
  <%= link_to "+ Add collection", new_admin_collection_path, class: "admin-btn" %>
</div>

<div class="overflow-hidden rounded border border-line bg-paper">
  <table class="admin-table">
    <thead><tr><th>Name</th><th>Products</th><th>Published</th></tr></thead>
    <tbody>
      <% @collections.each do |collection| %>
        <tr>
          <td><%= link_to collection.name, edit_admin_collection_path(collection), class: "underline" %></td>
          <td><%= collection.products.count %></td>
          <td><%= collection.published? ? "Yes" : "No" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
