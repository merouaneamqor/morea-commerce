<%# One agent: a header, four counts, and the figures against the team median. Printing only: Confirmations::Analytics#metrics and the
    medians of Confirmations::AgentComparison. locals: a (the agent's analytics), comparison, agent, card, title, sub, chip, tones %>
<% metrics = a.metrics %>
<% metric_tones = { delivered_per_100: :green, confirmation_rate: :green, delivery_rate: :green, return_rate: :red, fake_rate: :red, median_first_call: :amber, calls_per_order: :blue, perseverance: :blue, short_calls: :amber, talk_median: :blue } %>
<% counts = [ [ sl("Assignées"), a.assigned, :orders, tones[:blue] ], [ sl("Confirmées"), a.confirmed, :check, tones[:green] ], [ sl("Livrées"), a.delivered, :box, tones[:green] ], [ sl("Retournées"), a.returned, :undo, tones[:red] ] ] %>

<section class="<%= card %>" data-agent-header>
  <div class="flex items-center gap-3">
    <span class="grid size-10 shrink-0 place-items-center rounded-full bg-[#1c1c1e] text-[13px] font-bold text-white"><%= analytics_initials(agent) %></span>
    <h2 class="text-lg font-bold text-[#1c1c1e]" dir="auto"><%= agent.name.presence || agent.email %></h2>
  </div>
  <div class="mt-4 grid grid-cols-2 gap-2.5 lg:grid-cols-4">
    <% counts.each do |label, count, icon, tone| %>
      <div class="flex items-center justify-between rounded-xl border border-[#e0e0e5] bg-white px-3.5 py-3" data-agent-count="<%= label.downcase %>">
        <div><p class="text-xs text-[#6e6e73]"><%= label %></p><p class="mt-1 text-2xl leading-none font-bold text-[#1c1c1e] tabular-nums"><%= analytics_integer(count) %></p></div>
        <span class="<%= chip %> <%= tone %>"><%= seller_icon(icon, size: 15) %></span>
      </div>
    <% end %>
  </div>
</section>

<section class="<%= card %>" data-agent-metrics>
  <div class="flex items-start gap-3"><span class="<%= chip %> <%= tones[:blue] %>"><%= seller_icon(:chart, size: 16) %></span>
    <div><h2 class="<%= title %>"><%= sl("Face à la médiane de l'équipe") %></h2>
      <p class="<%= sub %>"><%= sl("Les chiffres de l'agent à côté de la médiane de toute l'équipe, et l'écart entre les deux. Un bon écart est en vert et un mauvais en rouge, quel que soit le sens de l'indicateur : un délai plus court avant le premier appel est une bonne chose.") %></p></div></div>
  <div class="mt-4 grid grid-cols-1 gap-2.5 sm:grid-cols-2 lg:grid-cols-4">
    <% Confirmations::AgentComparison::METRICS.each do |metric| %>
      <% value = metrics[metric] %>
      <% reference = comparison.median(metric) %>
      <% verdict = comparison.verdict(metric, value) %>
      <% delta = (analytics_metric_delta(metric, value, reference) if value && reference && value != reference) %>
      <div class="flex min-h-[104px] flex-col justify-between rounded-xl border border-[#e0e0e5] bg-white px-3.5 py-3" data-metric="<%= metric %>" data-verdict="<%= verdict %>" title="<%= sl(ConfirmationsAnalyticsHelper::METRIC_HINTS[metric]) %>">
        <p class="flex items-center justify-between gap-2 text-xs font-medium text-[#6e6e73]"><span class="truncate"><%= sl(ConfirmationsAnalyticsHelper::METRIC_LABELS[metric]) %></span><span class="<%= chip %> !size-6 !rounded-lg <%= tones[metric_tones[metric]] %>"><%= seller_icon(ConfirmationsAnalyticsHelper::METRIC_ICONS[metric], size: 13) %></span></p>
        <p class="text-[22px] leading-none font-bold whitespace-nowrap text-[#1c1c1e] tabular-nums" data-value><%= analytics_metric_value(metric, value) %></p>
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-[11px] text-[#6e6e73]">
          <% if delta %><span class="rounded-full px-2 py-0.5 font-semibold tabular-nums <%= analytics_verdict_class(verdict) %>" data-delta><%= delta %></span><% end %>
          <span><%= sl("Médiane de l'équipe") %> <span data-median-value><%= analytics_metric_value(metric, reference) %></span></span>
        </p>
      </div>
    <% end %>
  </div>
  <p class="mt-3 text-[11px] text-[#8e8e93]"><%= sl("Taux d'upsell, rappels à l'heure et finances ne sont pas encore calculés.") %></p>
</section>
