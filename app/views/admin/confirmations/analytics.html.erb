<%# Call center, Analyses: the figures of the orders created in the range and of the calls made in it. Printing only:
    every number comes from @analytics (Confirmations::Analytics). Design: the dashboard's own language: white tiles with a coloured symbol, small
    coloured symbol chips (only the symbol is coloured), thin bars on light tracks, rings like the distribution card. Each stage of an order
    keeps one colour on every chart (see `stage`); black for plain counts, gold for calls, grey for what is not the point, red only for
    "waiting too long"; a tooltip on every mark. %>
<% content_for :title, "#{sl("Analyses")} — Admin" %>
<% content_for :admin_page_class, "admin-page--dashboard" %>
<% a = @analytics %>
<% agent = a.agent %>
<% days = a.daily %>
<% provisional_from = days.index { |day| day[:provisional] } %>
<% card = "rounded-2xl border border-[#e0e0e5] bg-white p-5" %>
<% title = "text-sm font-semibold text-[#1c1c1e]" %>
<% sub = "mt-0.5 text-xs leading-snug text-[#6e6e73]" %>
<% chip = "grid size-8 shrink-0 place-items-center rounded-xl" %>
<% extra = agent && !agent_view? ? { "agent_id" => agent.id } : (@view == "agents" ? { "view" => "agents" } : (@view == "agent" ? { "view" => "agent" } : {})) %>
<% total_calls = a.call_results[:total] %>
<% ink = "#1c1c1e" %>
<% gold = "#d9a21b" %>
<% grey = "#d5d7dd" %>
<%# The colour of each stage of an order, the same on every chart of the page: received blue, reached by phone sky blue, confirmed green, shipped purple, delivered dark green %>
<% stage = { assigned: "#2a78d6", reached: "#5ab4ef", confirmed: "#5bc98f", shipped: "#8b5cf6", delivered: "#136b3d" } %>
<% tones = { ink: "bg-[#ececf0] text-[#1c1c1e]", blue: "bg-[#e6f0fd] text-[#2f6fed]", green: "bg-[#e3f3e8] text-[#2f9d5c]", amber: "bg-[#fdf0d9] text-[#d28a12]", red: "bg-[#fbe7ea] text-[#d6455d]" } %>

<div class="space-y-3" data-call-analytics data-controller="chart-tip" data-action="mouseover->chart-tip#show mouseout->chart-tip#hide focusin->chart-tip#show focusout->chart-tip#hide scroll@window->chart-tip#hide">
  <header class="flex min-h-[72px] flex-wrap items-center justify-between gap-3 rounded-3xl bg-[#1c1c1e] px-5 py-3 text-white" data-analytics-header>
    <div class="flex items-center gap-3">
      <span class="grid size-10 shrink-0 place-items-center rounded-2xl bg-white/10"><%= seller_icon(:chart, size: 20) %></span>
      <div>
        <h1 class="text-xl leading-tight font-bold"><%= sl("Analyses") %></h1>
        <p class="text-[13px] leading-tight text-white/65"><%= sl("Centre d'appels") %> · <%= agent ? (agent.name.presence || agent.email) : current_store.name %></p>
      </div>
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <%= render "admin/shared/date_range_picker", range: @date_range, preset: @date_range_preset, url: analytics_admin_confirmations_path, theme: "dark", size: "compact", extra: extra %>
      <%= link_to center_admin_confirmations_path, class: "inline-flex h-8 items-center gap-1.5 rounded-full bg-white/10 px-3.5 text-[13px] font-semibold text-white hover:bg-white/20" do %><%= seller_icon(:phone, size: 14) %><%= sl("File d'attente") %><% end %>
    </div>
  </header>

  <%# Overview / compare the agents / one agent: an iOS-style switch. The thumb slides at once and only the body below changes (Turbo frame),
      so the header and the switch stay where they are. %>
  <% unless agent_view? %>
    <% views = [ [ "overview", sl("Vue d'ensemble"), analytics_admin_confirmations_path ], [ "agents", sl("Comparer les agents"), analytics_admin_confirmations_path(view: "agents") ], [ "agent", sl("Agent"), analytics_admin_confirmations_path(view: "agent") ] ] %>
    <nav class="relative mx-auto flex w-fit items-center rounded-full p-1 text-[13px] font-semibold" aria-label="<%= sl("Analyses") %>" data-analytics-tabs data-controller="segmented" data-action="turbo:frame-load@document->segmented#frameLoaded resize@window->segmented#sync">
      <span data-segmented-target="thumb" class="pointer-events-none absolute start-0 top-1 bottom-1 rounded-full" aria-hidden="true"></span>
      <% views.each do |key, label, path| %>
        <%= link_to label, path, "data-tab": (key == "agents" ? "compare" : key), "data-view": key, "data-segmented-target": "item", "aria-current": (@view == key ? "page" : nil),
              data: { turbo_frame: "analytics-body", turbo_action: "advance", action: "click->segmented#select" }, class: "relative z-10 inline-flex h-8 items-center rounded-full px-4 whitespace-nowrap" %>
      <% end %>
    </nav>
  <% end %>

  <%# The people to switch to while one agent is open: a second iOS-style switch under the first, outside the frame so its thumb slides.
      It is always there for the owner and shown only while an agent is open (the segmented controller shows and hides it as the frame changes). %>
  <% unless agent_view? %>
    <nav class="relative mx-auto flex w-fit max-w-full items-center overflow-x-auto rounded-full p-1 text-[13px] font-semibold" aria-label="<%= sl("Agent") %>" data-agent-switch data-controller="segmented" data-segmented-by-value="agent"
         data-action="turbo:frame-load@document->segmented#frameLoaded resize@window->segmented#sync" <%= "hidden" unless @view == "agent" && agent %>>
      <span data-segmented-target="thumb" class="pointer-events-none absolute start-0 top-1 bottom-1 rounded-full" aria-hidden="true"></span>
      <% a.agents.each do |person| %>
        <%= link_to analytics_admin_confirmations_path(agent_id: person.id), "data-agent": person.id, "data-segmented-target": "item", "aria-current": (person == agent ? "page" : nil),
              data: { turbo_frame: "analytics-body", turbo_action: "advance", action: "click->segmented#select" }, class: "relative z-10 inline-flex h-8 shrink-0 items-center gap-2 rounded-full px-3 whitespace-nowrap" do %><span class="grid size-5 place-items-center rounded-full bg-[#ececf0] text-[9px] font-bold text-[#1c1c1e]" data-initials><%= analytics_initials(person) %></span><span dir="auto"><%= person.name.presence || person.email %></span><% end %>
      <% end %>
    </nav>
  <% end %>

  <turbo-frame id="analytics-body" class="block space-y-3" data-turbo-action="advance">
  <div class="space-y-3" data-analytics-view="<%= @view %>" data-analytics-agent="<%= agent&.id %>">



  <% if @view == "agents" %>
    <%= render "analytics_compare", comparison: @comparison, card: card, title: title, sub: sub, chip: chip, tones: tones, stage: stage %>
  <% elsif @view == "agent" && agent.nil? %>
    <%= render "analytics_picker", comparison: @comparison, card: card, title: title, sub: sub, chip: chip, tones: tones %>
  <% else %>
  <% if agent %>
    <%= render "analytics_agent", a: a, comparison: @comparison, agent: agent, card: card, title: title, sub: sub, chip: chip, tones: tones %>
  <% end %>

  <%# Five tiles: white cards with a coloured symbol, the percentages written in green. Not under an agent: her own grid above already holds them. %>
  <% kpis = [
       [ "delivered_per_100", sl("Livrées pour 100 commandes"), :box, tones[:green], a.delivered_per_100, "#{analytics_integer(a.delivered)} #{sl("livrées sur")} #{analytics_integer(a.assigned)} #{sl("assignées")}", days.map { |d| d[:delivered_per_100] } ],
       [ "confirmation_rate", sl("Taux de confirmation"), :check, tones[:green], a.confirmation_rate, "#{analytics_integer(a.confirmed)} #{sl("confirmées sur")} #{analytics_integer(a.assigned)}", days.map { |d| d[:confirmation_rate] } ],
       [ "delivery_rate", sl("Livrées sur confirmées"), :truck, tones[:green], a.delivery_rate, "#{analytics_integer(a.delivered)} #{sl("livrées sur")} #{analytics_integer(a.confirmed)}", days.map { |d| d[:delivery_rate] } ],
       [ "median_first_call", sl("Premier appel (médiane)"), :clock, tones[:amber], nil, sl("après la commande"), nil ],
       [ "waiting", sl("En attente d'appel"), :orders, tones[:red], nil, sl("commandes sans aucun appel"), nil ]
     ] %>
  <% unless agent %>
  <section class="grid grid-cols-2 gap-2.5 lg:grid-cols-5" data-kpis="analytics">
    <% kpis.each do |key, label, icon, tone, value, hint, series| %>
      <% green_value = %w[delivered_per_100 confirmation_rate delivery_rate].include?(key) %>
      <% shown = case key
                 when "median_first_call" then analytics_duration(a.median_first_call_seconds)
                 when "waiting" then analytics_integer(a.queue[:total])
                 else analytics_percent(value)
                 end %>
      <div class="flex min-h-[104px] min-w-0 flex-col justify-between rounded-xl border border-[#e0e0e5] bg-white px-3.5 py-3" data-kpi="<%= key %>">
        <p class="flex min-w-0 items-center gap-1.5 text-xs font-medium text-[#3a3a3c]" title="<%= label %>">
          <span class="grid size-6 shrink-0 place-items-center rounded-lg <%= tone %>"><%= seller_icon(icon, size: 13) %></span>
          <span class="truncate"><%= label %></span>
        </p>
        <div class="flex items-end justify-between gap-2">
          <p class="text-[24px] leading-none font-bold whitespace-nowrap tabular-nums <%= green_value ? "text-[#2f7a4a]" : "text-[#1c1c1e]" %>" data-value><%= shown %></p>
          <% if series %><span class="w-14 shrink-0 sm:w-16"><%= analytics_sparkline(series, dashed_from: provisional_from, color: green_value ? "#2f9d5c" : ink, size: "h-6 w-full") %></span><% end %>
        </div>
        <p class="truncate text-[11px] text-[#6e6e73]" title="<%= hint %>"><%= hint %></p>
      </div>
    <% end %>
  </section>
  <% end %>

  <%# What to act on, in plain words %>
  <% slots = a.answer_slots %>
  <% old_waiting = a.queue[:buckets].find { |bucket| bucket[:key] == :gt24h }[:count] %>
  <% if slots[:best] || old_waiting.positive? %>
    <section class="grid grid-cols-1 gap-2.5 lg:grid-cols-2" data-insights aria-label="<%= sl("Sur quoi agir") %>">
      <% if slots[:best] %>
        <p class="flex items-start gap-2.5 rounded-2xl border border-[#e0e0e5] bg-white px-4 py-3 text-[13px] text-[#1c1c1e]" data-insight="answer"><span class="<%= chip %> <%= tones[:amber] %>"><%= seller_icon(:clock, size: 15) %></span>
          <span class="pt-1"><%= sl("Les clients répondent le plus") %> <b><%= analytics_slot_label(slots[:best]) %></b> (<%= analytics_percent(slots[:best][:rate]) %>)<% if slots[:worst] && slots[:worst] != slots[:best] %> <%= sl("et le moins") %> <b><%= analytics_slot_label(slots[:worst]) %></b> (<%= analytics_percent(slots[:worst][:rate]) %>). <%= sl("Planifiez les rappels sur les meilleurs créneaux.") %><% end %></span></p>
      <% end %>
      <% if old_waiting.positive? %>
        <p class="flex items-start gap-2.5 rounded-2xl border border-[#e0e0e5] bg-white px-4 py-3 text-[13px] text-[#1c1c1e]" data-insight="waiting"><span class="<%= chip %> <%= tones[:red] %>"><%= seller_icon(:alert, size: 15) %></span>
          <span class="pt-1"><b><%= analytics_integer(old_waiting) %></b> <%= sl("commandes attendent un appel depuis plus d'un jour.") %> <%= sl("Appelez-les en premier.") %></span></p>
      <% end %>
    </section>
  <% end %>

  <%# 1. Funnel and orders per day %>
  <section class="grid grid-cols-1 gap-3 lg:grid-cols-2">
    <div class="<%= card %>" data-funnel>
      <div class="flex items-start gap-3"><span class="<%= chip %> <%= tones[:ink] %>"><%= seller_icon(:target, size: 16) %></span>
        <div><h2 class="<%= title %>"><%= sl("Où les commandes se perdent") %></h2>
          <p class="<%= sub %>"><b class="text-[#1c1c1e]"><%= analytics_integer(a.delivered) %></b> <%= sl("livrées sur") %> <b class="text-[#1c1c1e]"><%= analytics_integer(a.assigned) %></b> <%= sl("commandes reçues") %>. <%= sl("Le pourcentage est la part qui passe à l'étape suivante.") %></p></div></div>
      <% labels = { assigned: sl("Reçues"), reached: sl("Jointes par téléphone"), confirmed: sl("Confirmées"), shipped: sl("Expédiées"), delivered: sl("Livrées") } %>
      <% top = [ a.assigned, 1 ].max %>
      <ol class="mt-4 space-y-1">
        <% a.funnel.each do |key, count, step_rate| %>
          <% if key != :assigned %>
            <li class="grid grid-cols-[9rem_1fr_auto] gap-2.5 text-[11px] text-[#8e8e93]" aria-hidden="true"><span></span><span class="ps-1" data-step="<%= key %>">↓ <%= analytics_percent(step_rate) %></span><span class="w-9"></span></li>
          <% end %>
          <li class="grid grid-cols-[9rem_1fr_auto] items-center gap-2.5 text-[13px]" data-stage="<%= key %>" data-count="<%= count %>" data-tip="<%= labels[key] %> : <%= analytics_integer(count) %>">
            <span class="flex min-w-0 items-center gap-2 text-[#3a3a3c]"><i class="size-2.5 shrink-0 rounded-full" style="background: <%= stage[key] %>"></i><span class="truncate"><%= labels[key] %></span></span>
            <span class="block h-2.5 overflow-hidden rounded-full bg-[#efeff3]"><span data-grow class="block h-full rounded-full" style="width: <%= count.zero? ? 0 : [ count * 100.0 / top, 1.5 ].max.round(1) %>%; background: <%= stage[key] %>"></span></span>
            <span class="w-9 text-end font-semibold text-[#1c1c1e] tabular-nums"><%= analytics_integer(count) %></span>
          </li>
        <% end %>
      </ol>
    </div>

    <div class="<%= card %>" data-daily-orders>
      <div class="flex flex-wrap items-start justify-between gap-x-3 gap-y-1">
        <div class="flex items-start gap-3"><span class="<%= chip %> <%= tones[:blue] %>"><%= seller_icon(:orders, size: 16) %></span>
          <div><h2 class="<%= title %>"><%= sl("Commandes par jour") %></h2><p class="<%= sub %>"><%= sl("Chaque barre est un jour : la partie verte est confirmée.") %></p></div></div>
        <p class="flex items-center gap-3 text-[11px] whitespace-nowrap text-[#3a3a3c]"><span class="flex items-center gap-1.5"><i class="size-2 rounded-full" style="background: <%= stage[:confirmed] %>"></i><%= sl("Confirmées") %></span><span class="flex items-center gap-1.5"><i class="size-2 rounded-full" style="background: <%= grey %>"></i><%= sl("Non confirmées") %></span></p>
      </div>
      <% tallest = [ days.map { |d| d[:created] }.max.to_i, 1 ].max %>
      <div class="mt-4 flex gap-2">
        <div class="flex h-32 w-6 shrink-0 flex-col justify-between text-end text-[10px] text-[#8e8e93] tabular-nums" aria-hidden="true"><span><%= tallest %></span><span>0</span></div>
        <div class="relative min-w-0 flex-1">
          <div class="pointer-events-none absolute inset-x-0 top-0 border-t border-[#ececf0]"></div>
          <div class="flex h-32 items-end justify-between gap-[2px] border-b border-[#d9dce2]" role="img" aria-label="<%= sl("Commandes par jour") %>">
            <% days.each do |day| %>
              <div class="flex h-full min-w-0 max-w-6 flex-1 flex-col justify-end gap-[2px]" tabindex="0" data-tip="<%= l(day[:date], format: "%d/%m") %> : <%= day[:created] %> <%= sl("commandes") %>, <%= day[:confirmed] %> <%= sl("confirmées") %>" data-day="<%= day[:date].iso8601 %>" data-created="<%= day[:created] %>" data-confirmed="<%= day[:confirmed] %>">
                <% if day[:unconfirmed].positive? %><span data-rise class="block w-full rounded-t-[4px]" style="height: <%= (day[:unconfirmed] * 100.0 / tallest).round(1) %>%; background: <%= grey %>"></span><% end %>
                <% if day[:confirmed].positive? %><span data-rise class="block w-full <%= day[:unconfirmed].zero? ? "rounded-t-[4px]" : "" %>" style="height: <%= (day[:confirmed] * 100.0 / tallest).round(1) %>%; background: <%= stage[:confirmed] %>"></span><% end %>
              </div>
            <% end %>
          </div>
          <p class="mt-1 flex justify-between text-[10.5px] text-[#8e8e93]"><span><%= l(days.first[:date], format: "%d/%m") %></span><span><%= l(days.last[:date], format: "%d/%m") %></span></p>
        </div>
      </div>
    </div>
  </section>

  <%# 2. Rates per day and when customers answer %>
  <section class="grid grid-cols-1 gap-3 lg:grid-cols-2">
    <div class="<%= card %>" data-rates-chart>
      <div class="flex flex-wrap items-start justify-between gap-x-3 gap-y-1">
        <div class="flex items-start gap-3"><span class="<%= chip %> <%= tones[:green] %>"><%= seller_icon(:chart, size: 16) %></span>
          <div><h2 class="<%= title %>"><%= sl("Confirmation et livraison, jour par jour") %></h2><p class="<%= sub %>"><%= sl("Zone grise : jours récents, des colis sont encore en route.") %></p></div></div>
        <p class="flex items-center gap-3 text-[11px] whitespace-nowrap text-[#3a3a3c]"><span class="flex items-center gap-1.5"><i class="h-0.5 w-3.5 rounded" style="background: <%= stage[:confirmed] %>"></i><%= sl("Taux de confirmation") %></span><span class="flex items-center gap-1.5"><i class="h-0.5 w-3.5 rounded" style="background: <%= stage[:delivered] %>"></i><%= sl("Livrées sur confirmées") %></span></p>
      </div>
      <div class="mt-4 flex gap-2">
        <div class="flex h-32 w-8 shrink-0 flex-col justify-between text-end text-[10px] text-[#8e8e93] tabular-nums" aria-hidden="true"><span>100 %</span><span>50 %</span><span>0 %</span></div>
        <div class="relative min-w-0 flex-1">
          <%= analytics_line_chart([ { values: days.map { |d| d[:confirmation_rate] }, color: stage[:confirmed], area: true }, { values: days.map { |d| d[:delivery_rate] }, color: stage[:delivered] } ], max: 100, shade_from: provisional_from, count: days.size) %>
          <div class="absolute inset-x-0 top-0 flex h-32" aria-hidden="true">
            <% days.each do |day| %><span class="h-full flex-1 hover:bg-[#1c1c1e]/5" data-tip="<%= l(day[:date], format: "%d/%m") %> : <%= sl("confirmation") %> <%= analytics_percent(day[:confirmation_rate]) %> · <%= sl("livraison") %> <%= analytics_percent(day[:delivery_rate]) %><%= " (#{sl("provisoire")})" if day[:provisional] %>"></span><% end %>
          </div>
          <p class="mt-1 flex justify-between text-[10.5px] text-[#8e8e93]"><span><%= l(days.first[:date], format: "%d/%m") %></span><span><%= l(days.last[:date], format: "%d/%m") %></span></p>
        </div>
      </div>
    </div>

    <div class="<%= card %>" data-heatmap>
      <div class="flex items-start gap-3"><span class="<%= chip %> <%= tones[:amber] %>"><%= seller_icon(:phone, size: 16) %></span>
        <div><h2 class="<%= title %>"><%= sl("Quand les clients répondent") %></h2><p class="<%= sub %>"><%= sl("Part des appels décrochés, par jour et par heure (heure de la boutique). Plus c'est foncé, plus ils répondent.") %></p></div></div>
      <div class="mt-4 overflow-x-auto">
        <div class="grid min-w-[24rem] gap-[2px]" style="grid-template-columns: 1.75rem repeat(24, minmax(0, 1fr))">
          <span></span>
          <% 24.times do |hour| %><span class="text-center text-[9px] text-[#8e8e93]"><%= hour if (hour % 3).zero? %></span><% end %>
          <% a.answer_heatmap.each_with_index do |row, wday| %>
            <span class="pe-1 text-[10px] leading-4 text-[#6e6e73]"><%= analytics_weekday(wday) %></span>
            <% row.each_with_index do |cell, hour| %>
              <span class="h-4 rounded-[3px]" style="<%= analytics_heat_style(cell) %>" data-tip="<%= analytics_weekday(wday) %> <%= hour %> h : <%= cell[:calls].zero? ? sl("aucun appel") : "#{cell[:calls]} #{sl("appels")}, #{analytics_percent(cell[:rate])} #{sl("décrochés")}" %>" data-cell="<%= wday %>-<%= hour %>" data-calls="<%= cell[:calls] %>"></span>
            <% end %>
          <% end %>
        </div>
      </div>
      <p class="mt-2 flex items-center justify-end gap-1.5 text-[10.5px] text-[#6e6e73]">0 %<span class="flex gap-0.5"><i class="size-2.5 rounded-[2px]" style="background: rgba(90,180,239,0.14)"></i><i class="size-2.5 rounded-[2px]" style="background: rgba(90,180,239,0.4)"></i><i class="size-2.5 rounded-[2px]" style="background: rgba(90,180,239,0.7)"></i><i class="size-2.5 rounded-[2px]" style="background: rgba(90,180,239,1)"></i></span>100 %</p>
    </div>
  </section>

  <%# 3. Speed of the first call and the waiting queue %>
  <% speed_labels = { lt15: sl("< 15 min"), lt60: sl("15–60 min"), lt3h: sl("1–3 h"), lt24h: sl("3–24 h"), gt24h: sl("> 1 jour") } %>
  <% speed = a.first_call_speed %>
  <% best_bucket = speed.select { |bucket| bucket[:rate] }.max_by { |bucket| bucket[:rate] } %>
  <% worst_bucket = speed.select { |bucket| bucket[:rate] }.min_by { |bucket| bucket[:rate] } %>
  <% queue_labels = { lt1h: sl("Moins d'1 h"), lt6h: sl("1 à 6 h"), lt24h: sl("6 à 24 h"), gt24h: sl("Plus d'un jour") } %>
  <% queue = a.queue %>
  <section class="grid grid-cols-1 gap-3 lg:grid-cols-2">
    <div class="<%= card %>" data-first-call>
      <div class="flex items-start gap-3"><span class="<%= chip %> <%= tones[:amber] %>"><%= seller_icon(:clock, size: 16) %></span>
        <div><h2 class="<%= title %>"><%= sl("Plus on appelle vite, plus on confirme") %></h2>
          <p class="<%= sub %>"><%= sl("Taux de confirmation selon le temps d'attente avant le premier appel.") %> <%= sl("Médiane") %> : <b class="text-[#1c1c1e]" data-median><%= analytics_duration(a.median_first_call_seconds) %></b>.</p></div></div>
      <div class="mt-4 flex gap-2">
        <div class="flex h-28 w-8 shrink-0 flex-col justify-between text-end text-[10px] text-[#8e8e93] tabular-nums" aria-hidden="true"><span>100 %</span><span>0 %</span></div>
        <div class="min-w-0 flex-1">
          <div class="grid h-28 grid-cols-5 items-end gap-3 border-b border-[#d9dce2]">
            <% speed.each do |bucket| %>
              <div class="flex h-full flex-col items-center justify-end gap-1" data-speed="<%= bucket[:key] %>" data-orders="<%= bucket[:orders] %>" data-tip="<%= speed_labels[bucket[:key]] %> : <%= bucket[:orders] %> <%= sl("commandes") %>, <%= analytics_percent(bucket[:rate]) %> <%= sl("confirmées") %>" tabindex="0">
                <span class="text-xs font-semibold text-[#1c1c1e]"><%= bucket[:rate] ? "#{bucket[:rate].round} %" : "—" %></span>
                <span data-rise class="block w-full max-w-6 rounded-t-[4px]" style="height: <%= bucket[:rate] ? [ bucket[:rate] * 0.8, 1.5 ].max.round(1) : 0 %>%; background: <%= bucket == best_bucket ? stage[:confirmed] : "#cfeedd" %>"></span>
              </div>
            <% end %>
          </div>
          <div class="mt-1 grid grid-cols-5 gap-3 text-center text-[10.5px] text-[#6e6e73]"><% speed.each do |bucket| %><span><%= speed_labels[bucket[:key]] %></span><% end %></div>
        </div>
      </div>
      <% if best_bucket && worst_bucket && best_bucket != worst_bucket %>
        <p class="mt-3 text-[12.5px] text-[#3a3a3c]"><%= sl("Appelées en") %> « <%= speed_labels[best_bucket[:key]] %> » : <b><%= analytics_percent(best_bucket[:rate]) %></b> <%= sl("confirmées") %>, <%= sl("contre") %> <b><%= analytics_percent(worst_bucket[:rate]) %></b> <%= sl("en") %> « <%= speed_labels[worst_bucket[:key]] %> ».</p>
      <% end %>
    </div>

    <div class="<%= card %>" data-queue-state>
      <div class="flex items-start gap-3"><span class="<%= chip %> <%= tones[:red] %>"><%= seller_icon(:alert, size: 16) %></span>
        <div><h2 class="<%= title %>"><%= sl("File d'attente : depuis combien de temps ?") %></h2>
          <p class="<%= sub %>"><b class="text-[#1c1c1e]" data-waiting><%= analytics_integer(queue[:total]) %></b> <%= sl("commandes attendent un premier appel") %><% if queue[:oldest_seconds] %> · <%= sl("la plus ancienne") %> <b class="text-[#1c1c1e]" data-oldest><%= analytics_duration(queue[:oldest_seconds]) %></b><% end %>.</p></div></div>
      <div class="mt-4">
        <%= render "analytics_bars", data: "data-queue-bucket", top: [ queue[:total], 1 ].max, rows: queue[:buckets].map { |bucket|
              { label: queue_labels[bucket[:key]], count: bucket[:count], percent: (queue[:total].zero? ? nil : bucket[:count] * 100.0 / queue[:total]), key: bucket[:key], danger: bucket[:key] == :gt24h } } %>
      </div>
    </div>
  </section>

  <%# 4. Which call confirmed, results of the calls (rings like the dashboard's), why the customers cancel (ranked bars) %>
  <% at_call = a.confirmed_at_call %>
  <% call_colors = %w[#136b3d #2f9a62 #5bc98f #9fdfbc #d3f0e1] %>
  <% result_labels = { "confirmed" => sl("Confirmée"), "no_answer" => sl("Sans réponse"), "cancelled" => sl("Annulée"), "callback" => sl("Rappel programmé"), "wrong_number" => sl("Faux numéro"), "abandoned" => sl("Appel abandonné") } %>
  <% result_colors = { "confirmed" => "#3aa76d", "no_answer" => "#e0a52c", "cancelled" => "#8e8e93", "callback" => "#3b82c4", "wrong_number" => "#d6455d", "abandoned" => "#d5d7dd" } %>
  <% reasons = a.cancel_reasons %>
  <section class="grid grid-cols-1 gap-3 lg:grid-cols-3">
    <div class="<%= card %>" data-confirmed-at-call>
      <div class="flex items-start gap-3"><span class="<%= chip %> <%= tones[:green] %>"><%= seller_icon(:check, size: 16) %></span>
        <div><h2 class="<%= title %>"><%= sl("Confirmées à quel appel ?") %></h2>
          <p class="<%= sub %>"><b class="text-[#1c1c1e]" data-first-call-share><%= at_call[:buckets].first[:percent] ? "#{at_call[:buckets].first[:percent].round} %" : "—" %></b> <%= sl("sont confirmées dès le 1er appel.") %> <%= sl("Seules les commandes avec un appel enregistré sont comptées.") %></p></div></div>
      <div class="mt-4 flex flex-col items-center gap-4">
        <div class="relative shrink-0">
          <%= analytics_donut(at_call[:buckets].each_with_index.map { |bucket, i| { count: bucket[:count], color: call_colors[i] } }) %>
          <div class="absolute inset-0 grid place-content-center text-center"><span class="text-xl leading-none font-bold text-[#1c1c1e] tabular-nums"><%= at_call[:total] %></span><span class="mt-1 text-[11px] text-[#6e6e73]"><%= sl("confirmées") %></span></div>
        </div>
        <ul class="w-full space-y-2">
          <% at_call[:buckets].each_with_index do |bucket, i| %>
            <li class="flex items-center justify-between gap-2 text-[13px]" data-call-position="<%= bucket[:position] %>" data-count="<%= bucket[:count] %>" data-tip="<%= bucket[:position] == 5 ? sl("Appel 5 ou plus") : "#{sl("Appel")} #{bucket[:position]}" %> : <%= bucket[:count] %>">
              <span class="flex items-center gap-2 text-[#3a3a3c]"><i class="size-2.5 rounded-full" style="background: <%= call_colors[i] %>"></i><%= bucket[:position] == 5 ? sl("Appel 5 ou plus") : "#{sl("Appel")} #{bucket[:position]}" %></span>
              <span class="tabular-nums"><b class="font-semibold text-[#1c1c1e]"><%= analytics_integer(bucket[:count]) %></b> <span class="ms-2 text-xs text-[#8e8e93]"><%= bucket[:percent] ? "#{bucket[:percent].round} %" : "—" %></span></span>
            </li>
          <% end %>
        </ul>
      </div>
    </div>

    <div class="<%= card %>" data-call-results>
      <div class="flex items-start gap-3"><span class="<%= chip %> <%= tones[:blue] %>"><%= seller_icon(:calculator, size: 16) %></span>
        <div><h2 class="<%= title %>"><%= sl("Résultat des appels") %></h2>
          <p class="<%= sub %>"><%= sl("Ce qui s'est passé lors des appels passés sur la période.") %></p></div></div>
      <div class="mt-4 flex flex-col items-center gap-4">
        <div class="relative shrink-0">
          <%= analytics_donut(a.call_results[:outcomes].map { |row| { count: row[:count], color: result_colors[row[:outcome]] } }) %>
          <div class="absolute inset-0 grid place-content-center text-center"><span class="text-xl leading-none font-bold text-[#1c1c1e] tabular-nums" data-total-calls><%= analytics_integer(total_calls) %></span><span class="mt-1 text-[11px] text-[#6e6e73]"><%= sl("appels") %></span></div>
        </div>
        <ul class="w-full space-y-2">
          <% a.call_results[:outcomes].each do |row| %>
            <li class="flex items-center justify-between gap-2 text-[13px]" data-outcome="<%= row[:outcome] %>" data-count="<%= row[:count] %>" data-tip="<%= result_labels[row[:outcome]] %> : <%= row[:count] %>">
              <span class="flex items-center gap-2 text-[#3a3a3c]"><i class="size-2.5 rounded-full" style="background: <%= result_colors[row[:outcome]] %>"></i><%= result_labels[row[:outcome]] %></span>
              <span class="tabular-nums"><b class="font-semibold text-[#1c1c1e]"><%= analytics_integer(row[:count]) %></b> <span class="ms-2 text-xs text-[#8e8e93]"><%= row[:percent] ? "#{row[:percent].round} %" : "—" %></span></span>
            </li>
          <% end %>
        </ul>
      </div>
    </div>

    <div class="<%= card %>" data-cancel-reasons>
      <div class="flex items-start gap-3"><span class="<%= chip %> <%= tones[:red] %>"><%= seller_icon(:ban, size: 16) %></span>
        <div><h2 class="<%= title %>"><%= sl("Pourquoi les clients annulent") %></h2><p class="<%= sub %>"><%= sl("Motifs écrits par les agents sur les commandes annulées.") %></p></div></div>
      <% if reasons[:total].zero? %>
        <p class="mt-8 mb-4 text-center text-sm text-[#6e6e73]"><%= sl("Aucune commande annulée sur cette période.") %></p>
      <% else %>
        <% if reasons[:blank_percent].to_f >= 50 %>
          <p class="mt-3 rounded-xl border border-[#f3e3bf] bg-[#fffaf0] px-3 py-2 text-xs text-[#8a5a12]" data-no-reason-warning><b><%= sl("Sans motif") %> : <%= reasons[:blank_percent].round %> % <%= sl("des annulations") %></b>. <%= sl("Demandez aux agents d'écrire le motif quand ils annulent.") %></p>
        <% end %>
        <div class="mt-4">
          <%= render "analytics_bars", data: "data-reason", top: [ reasons[:rows].map { |row| row[:count] }.max.to_i, 1 ].max,
                rows: reasons[:rows].map { |row| { label: (row[:reason] == :others ? sl("Autres motifs") : (row[:reason].presence ? row[:reason].capitalize : sl("Sans motif"))), count: row[:count], percent: row[:percent], key: row[:reason] } } %>
        </div>
      <% end %>
    </div>
  </section>

  <%# 5. Where the orders ended up and how the deliveries went %>
  <%= render "analytics_delivery", a: a, card: card, title: title, sub: sub, chip: chip, tones: tones, days: days %>

  <%# 6. Load by hour, and how often the customers answered %>
  <% hourly = a.hourly %>
  <% hourly_max = [ hourly[:new_orders].max, hourly[:calls].max, 1 ].max %>
  <section class="<%= card %>" data-hourly>
    <div class="flex flex-wrap items-start justify-between gap-x-3 gap-y-1">
      <div class="flex items-start gap-3"><span class="<%= chip %> <%= tones[:ink] %>"><%= seller_icon(:chart, size: 16) %></span>
        <div><h2 class="<%= title %>"><%= sl("Charge et appels par heure") %></h2><p class="<%= sub %>"><%= sl("Nouvelles commandes et appels passés, par heure de la journée (heure de la boutique).") %></p></div></div>
      <p class="flex items-center gap-3 text-[11px] whitespace-nowrap text-[#3a3a3c]"><span class="flex items-center gap-1.5"><i class="h-0.5 w-3.5 rounded" style="background: <%= stage[:assigned] %>"></i><%= sl("Nouvelles commandes") %></span><span class="flex items-center gap-1.5"><i class="h-0.5 w-3.5 rounded" style="background: <%= gold %>"></i><%= sl("Appels") %></span></p>
    </div>
    <div class="mt-4 flex gap-2">
      <div class="flex h-28 w-6 shrink-0 flex-col justify-between text-end text-[10px] text-[#8e8e93] tabular-nums" aria-hidden="true"><span><%= hourly_max %></span><span>0</span></div>
      <div class="relative min-w-0 flex-1">
        <%= analytics_line_chart([ { values: hourly[:new_orders], color: stage[:assigned], area: true }, { values: hourly[:calls], color: gold } ], max: hourly_max, count: 24, height: "h-28") %>
        <div class="absolute inset-x-0 top-0 flex h-28" aria-hidden="true">
          <% 24.times do |hour| %><span class="h-full flex-1 hover:bg-[#1c1c1e]/5" data-tip="<%= hour %> h : <%= hourly[:new_orders][hour] %> <%= sl("nouvelles commandes") %>, <%= hourly[:calls][hour] %> <%= sl("appels") %>"></span><% end %>
        </div>
        <p class="mt-1 flex justify-between text-[10.5px] text-[#8e8e93]"><% [ 0, 3, 6, 9, 12, 15, 18, 21 ].each do |hour| %><span><%= hour %> h</span><% end %></p>
      </div>
    </div>
    <h3 class="mt-4 text-[13px] font-semibold text-[#1c1c1e]"><%= sl("Taux de réponse par heure") %></h3>
    <p class="mt-0.5 text-[11.5px] text-[#6e6e73]"><%= sl("Part des appels décrochés à chaque heure : plus la courbe est haute, plus les clients répondent.") %></p>
    <div class="mt-3 flex gap-2" data-answer-rate>
      <div class="flex h-24 w-8 shrink-0 flex-col justify-between text-end text-[10px] text-[#8e8e93] tabular-nums" aria-hidden="true"><span>100 %</span><span>0 %</span></div>
      <div class="relative min-w-0 flex-1">
        <%= analytics_line_chart([ { values: a.hourly_answer_rate, color: stage[:reached], area: true } ], max: 100, count: 24, height: "h-24") %>
        <div class="absolute inset-x-0 top-0 flex h-24" aria-hidden="true">
          <% 24.times do |hour| %><span class="h-full flex-1 hover:bg-[#1c1c1e]/5" data-tip="<%= hour %> h : <%= analytics_percent(a.hourly_answer_rate[hour]) %> <%= sl("décrochés") %>"></span><% end %>
        </div>
      </div>
    </div>
  </section>

  <%# The same numbers as a table, for reading them one by one %>
  <details class="<%= card %> !py-3" data-table-view>
    <summary class="cursor-pointer text-[13px] font-semibold text-[#1c1c1e]"><%= sl("Voir les chiffres jour par jour (tableau)") %></summary>
    <div class="mt-3 max-h-72 overflow-auto rounded-xl border border-[#ececf0]">
      <table class="w-full text-[12px]">
        <thead class="sticky top-0 bg-[#f7f8fa] text-[#6e6e73]"><tr><% [ "Jour", "Commandes", "Confirmées", "Livrées", "Taux de confirmation", "Livrées sur confirmées" ].each_with_index do |heading, i| %><th class="px-3 py-2 <%= i.zero? ? "text-start" : "text-end" %> font-medium"><%= sl(heading) %></th><% end %></tr></thead>
        <tbody class="divide-y divide-[#f1f1f4]">
          <% days.reverse_each do |day| %>
            <tr data-table-day="<%= day[:date].iso8601 %>"><td class="px-3 py-1.5"><%= l(day[:date], format: "%d/%m/%Y") %><%= " *" if day[:provisional] %></td><td class="px-3 py-1.5 text-end tabular-nums"><%= day[:created] %></td><td class="px-3 py-1.5 text-end tabular-nums"><%= day[:confirmed] %></td><td class="px-3 py-1.5 text-end tabular-nums"><%= day[:delivered] %></td><td class="px-3 py-1.5 text-end tabular-nums"><%= analytics_percent(day[:confirmation_rate]) %></td><td class="px-3 py-1.5 text-end tabular-nums"><%= analytics_percent(day[:delivery_rate]) %></td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <p class="mt-2 text-[11px] text-[#8e8e93]">* <%= sl("jour récent : provisoire") %></p>
  </details>

  <p class="px-1 text-[11px] text-[#8e8e93]" data-method-note>
    <%= sl("Chiffres calculés sur les commandes créées pendant la période (reçues, jointes, confirmées, expédiées, livrées) et sur les appels passés pendant la période. Les jours récents sont provisoires. Le taux d'upsell n'est pas encore calculé.") %>
  </p>
  <% end %>
  </div>
  </turbo-frame>
</div>
