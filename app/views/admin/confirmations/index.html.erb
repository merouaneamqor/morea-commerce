<% content_for :title, "#{t('admin.confirmations.title')}, Admin" %>
<% content_for :admin_page_class, "admin-page--dashboard" %>
<div class="admin-page-header">
  <div class="admin-page-header__row min-w-0 flex-1">
    <div class="min-w-0">
      <h1 class="admin-page-header__title"><%= t(agent_view? ? "admin.confirmations.agent_lead" : "admin.confirmations.title") %></h1>
      <p class="admin-page-header__meta"><%= t(agent_view? ? "admin.confirmations.agent_lead_help" : "admin.confirmations.description") %></p>
    </div>
  </div>
  <div class="admin-page-header__tools">
    <%= link_to t("admin.confirmations.performance"), dashboard_admin_confirmations_path, class: "admin-btn-secondary" %>
    <%= link_to t("admin.confirmations.orders"), admin_orders_path, class: "admin-btn-secondary" %>
  </div>
</div>

<% if agent_view? %>
  <%= render "agent_desk" %>
<% else %>

<div class="admin-card overflow-hidden">
  <nav class="admin-tabs px-4" aria-label="<%= t('admin.confirmations.filters') %>">
    <% @filters.each do |filter| %>
      <%= link_to t("admin.confirmations.#{filter}"), admin_confirmations_path(filter: filter), class: "admin-tab #{'is-active' if @filter == filter}", "aria-current": (@filter == filter ? "page" : nil) %>
    <% end %>
  </nav>

  <% if @orders.empty? %>
    <p class="admin-empty"><%= t("admin.confirmations.empty") %></p>
  <% else %>
    <ul class="admin-mobile-list md:hidden">
      <% @orders.each do |order| %>
        <% confirmation = @confirmations[order.id] %>
        <% mine = confirmation&.assigned_user_id == current_user.id %>
        <% items = order.order_items.to_a %>
        <li class="admin-mobile-list__card" aria-label="<%= t('admin.confirmations.order_label', number: order.number) %>">
          <div class="admin-mobile-list__top">
            <div class="min-w-0">
              <%= link_to "##{order.number}", admin_order_path(order), class: "admin-mobile-list__title admin-link" %>
              <p class="admin-mobile-list__meta"><%= l(order.created_at, format: :short) %></p>
            </div>
            <p class="admin-mobile-list__amount" dir="ltr"><%= order.total_display %></p>
          </div>

          <div class="admin-mobile-list__badges">
            <%= render "admin/orders/import_contact_alert", order: order, compact: true %>
            <span class="admin-badge admin-badge--neutral"><%= t("admin.confirmations.attempts", count: @attempt_counts[order.id].to_i) %></span>
            <% if confirmation&.callback_at %>
              <span class="admin-badge admin-badge--attention"><%= t("admin.confirmations.callback_due", time: l(confirmation.callback_at, format: :short)) %></span>
            <% end %>
            <% if confirmation&.assigned_user && (!agent_view? || mine) %>
              <span class="admin-badge admin-badge--info"><%= t("admin.confirmations.assigned", name: confirmation.assigned_user.name.presence || confirmation.assigned_user.email) %></span>
            <% elsif confirmation&.assigned_user %>
              <span class="admin-badge admin-badge--neutral"><%= t("admin.confirmations.claimed_elsewhere") %></span>
            <% else %>
              <span class="admin-badge admin-badge--success"><%= t("admin.confirmations.available") %></span>
            <% end %>
          </div>

          <p class="admin-mobile-list__name" dir="auto"><%= order.customer_name %></p>
          <p class="admin-mobile-list__meta" dir="auto"><%= order.customer_city %></p>
          <% if order.customer_phone.present? && !order.import_contact_issues.include?("phone") %>
            <p class="admin-mobile-list__meta"><%= link_to order.customer_phone, "tel:#{order.customer_phone.gsub(/[^\d+]/, '')}", class: "admin-link", dir: "ltr" %></p>
          <% end %>

          <% if items.any? %>
            <ul class="mt-2 space-y-1 text-sm">
              <% items.first(2).each do |item| %>
                <li>
                  <%= item.quantity %> × <%= item.product_name %><% if item.variant_name.present? %> <span class="admin-muted">(<%= item.variant_name %>)</span><% end %>
                </li>
              <% end %>
              <% if items.size > 2 %>
                <li class="admin-muted">… +<%= items.size - 2 %></li>
              <% end %>
            </ul>
          <% end %>

          <div class="admin-mobile-list__actions">
            <%= render "queue_actions", order: order, confirmation: confirmation, mine: mine %>
          </div>

          <% if mine && !order.contact_review_required? %>
            <div class="admin-mobile-list__form">
              <%= render "queue_outcome", order: order, confirmation: confirmation, id_suffix: "m" %>
            </div>
          <% end %>
        </li>
      <% end %>
    </ul>

    <div class="admin-table-wrap hidden md:block">
      <table class="admin-table">
        <thead>
          <tr>
            <th><%= t("admin.confirmations.columns.order") %></th>
            <th><%= t("admin.confirmations.columns.date") %></th>
            <th><%= t("admin.confirmations.columns.customer") %></th>
            <th><%= t("admin.confirmations.products") %></th>
            <th><%= t("admin.confirmations.columns.status") %></th>
            <th class="is-numeric"><%= t("admin.confirmations.columns.actions") %></th>
          </tr>
        </thead>
        <tbody>
          <% @orders.each do |order| %>
            <% confirmation = @confirmations[order.id] %>
            <% mine = confirmation&.assigned_user_id == current_user.id %>
            <tr class="align-top transition-colors hover:bg-[#f6f6f7]" aria-label="<%= t('admin.confirmations.order_label', number: order.number) %>">
              <td>
                <%= link_to "##{order.number}", admin_order_path(order), class: "admin-link font-semibold" %>
                <p class="admin-muted text-sm mt-1"><%= order.total_display %></p>
              </td>
              <td class="whitespace-nowrap admin-muted text-sm"><%= l(order.created_at, format: :short) %></td>
              <td>
                <p class="font-medium"><%= order.customer_name %></p>
                <p class="admin-muted text-sm"><%= order.customer_city %></p>
                <% if order.customer_phone.present? && !order.import_contact_issues.include?("phone") %>
                  <p class="text-sm"><%= link_to order.customer_phone, "tel:#{order.customer_phone.gsub(/[^\d+]/, '')}", class: "admin-link", dir: "ltr" %></p>
                <% end %>
              </td>
              <td>
                <ul class="space-y-1 text-sm">
                  <% order.order_items.each do |item| %>
                    <li>
                      <%= item.quantity %> × <%= item.product_name %><% if item.variant_name.present? %> <span class="admin-muted">(<%= item.variant_name %>)</span><% end %>
                      <span class="admin-muted ms-1"><%= money(item.total_cents, order.currency) %></span>
                    </li>
                  <% end %>
                </ul>
              </td>
              <td>
                <div class="flex flex-col items-start gap-1">
                  <%= render "admin/orders/import_contact_alert", order: order, compact: true %>
                  <span class="admin-badge admin-badge--neutral"><%= t("admin.confirmations.attempts", count: @attempt_counts[order.id].to_i) %></span>
                  <% if confirmation&.callback_at %>
                    <span class="admin-badge admin-badge--attention"><%= t("admin.confirmations.callback_due", time: l(confirmation.callback_at, format: :short)) %></span>
                  <% end %>
                  <% if confirmation&.assigned_user && (!agent_view? || mine) %>
                    <span class="admin-badge admin-badge--info"><%= t("admin.confirmations.assigned", name: confirmation.assigned_user.name.presence || confirmation.assigned_user.email) %></span>
                  <% elsif confirmation&.assigned_user %>
                    <span class="admin-badge admin-badge--neutral"><%= t("admin.confirmations.claimed_elsewhere") %></span>
                  <% else %>
                    <span class="admin-badge admin-badge--success"><%= t("admin.confirmations.available") %></span>
                  <% end %>
                </div>
              </td>
              <td class="is-numeric">
                <div class="flex flex-col items-end gap-2">
                  <%= render "queue_actions", order: order, confirmation: confirmation, mine: mine %>
                </div>
              </td>
            </tr>
            <% if mine && !order.contact_review_required? %>
              <tr class="bg-[#fafafa]">
                <td colspan="6">
                  <%= render "queue_outcome", order: order, confirmation: confirmation, id_suffix: "d" %>
                </td>
              </tr>
            <% end %>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>

  <nav class="flex flex-wrap items-center justify-between gap-4 border-t border-[#ebebeb] p-4" aria-label="<%= t('admin.confirmations.pagination') %>">
    <span class="admin-muted text-sm"><%= t("admin.confirmations.page", number: @page) %></span>
    <div class="flex items-center gap-2">
      <% if @page > 1 %>
        <%= link_to t("admin.confirmations.previous"), admin_confirmations_path(filter: @filter, page: @page - 1), class: "admin-btn-secondary" %>
      <% end %>
      <% if @has_next %>
        <%= link_to t("admin.confirmations.next"), admin_confirmations_path(filter: @filter, page: @page + 1), class: "admin-btn-secondary" %>
      <% end %>
    </div>
  </nav>
</div>
<% end %>
