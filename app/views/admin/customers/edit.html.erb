<% content_for :title, "Edit #{@customer.name} — Admin" %>

<div class="admin-page-header">
  <div class="flex items-center gap-2">
    <%= link_to admin_customer_path(@customer), class: "admin-back", "aria-label": "Back to customer" do %><%= admin_icon(:back) %><% end %>
    <h1 class="admin-page-header__title">Edit customer</h1>
  </div>
  <button type="submit" form="customer-form" class="admin-btn">Save</button>
</div>

<%= form_with model: [:admin, @customer], id: "customer-form", class: "admin-stack" do |f| %>
  <% if @customer.errors.any? %>
    <div class="admin-banner admin-banner--critical"><%= @customer.errors.full_messages.to_sentence %></div>
  <% end %>

  <section class="admin-card">
    <div class="admin-card__header"><h2 class="admin-card__title">Contact</h2></div>
    <div class="space-y-4 px-4 pb-4">
      <div class="admin-field-grid">
        <div>
          <%= f.label :name, class: "admin-label" %>
          <%= f.text_field :name, class: "admin-input", required: true %>
        </div>
        <div>
          <%= f.label :phone, class: "admin-label" %>
          <%= f.telephone_field :phone, class: "admin-input", required: true %>
        </div>
        <div>
          <%= f.label :email, class: "admin-label" %>
          <%= f.email_field :email, class: "admin-input" %>
        </div>
        <div>
          <%= f.label :city, class: "admin-label" %>
          <%= f.text_field :city, class: "admin-input" %>
        </div>
      </div>
    </div>
  </section>

  <div class="flex justify-end">
    <%= f.submit "Save", class: "admin-btn" %>
  </div>
<% end %>
