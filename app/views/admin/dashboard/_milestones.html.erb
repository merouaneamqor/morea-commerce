<%# Revenue milestones: lifetime delivered revenue (AccountingStats) against six tiers. Printing only: every figure comes from
    Seller::RevenueMilestones. locals: milestones, currency. %>
<% m = milestones %>
<% current = m.current %>
<% nxt = m.next_tier %>
<% mad = ->(cents) { "#{seller_number(cents / 100)} #{currency}" } %>
<% short = ->(cents) { whole = cents / 100; whole >= 1_000_000 ? "#{whole / 1_000_000}M" : "#{whole / 1_000}K" } %>

<section class="grid gap-5 rounded-3xl border border-[#e0e0e5] bg-white p-5 lg:grid-cols-[17rem_1fr] lg:items-center" data-milestones>
  <div>
    <p class="flex items-center gap-1.5 text-[11px] font-semibold tracking-wider text-[#6e6e73] uppercase"><%= seller_icon(:flag, size: 14) %><%= sl("Paliers de chiffre d'affaires") %></p>
    <p class="mt-2 text-3xl leading-none font-bold tracking-tight whitespace-nowrap text-[#1c1c1e] tabular-nums" data-milestone-revenue="<%= m.revenue_cents %>"><%= mad.(m.revenue_cents) %></p>
    <p class="mt-1 text-xs text-[#6e6e73]"><%= sl("Livré depuis le début") %></p>
    <p class="mt-3 flex flex-wrap items-center gap-2">
      <span class="rounded-full bg-[#1c1c1e] px-3 py-1 text-xs font-semibold text-white" data-milestone-current><%= current ? sl(current.name) : sl("Débutant") %></span>
      <% if nxt %><span class="text-xs text-[#6e6e73]"><%= sl("Prochain palier") %> : <%= sl(nxt.name) %></span><% end %>
    </p>
    <div class="mt-3 h-1.5 overflow-hidden rounded-full bg-[#e9e9ee]" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= m.percent_to_next %>">
      <div class="h-full rounded-full bg-[#1c1c1e]" style="width: <%= m.percent_to_next %>%"></div>
    </div>
    <p class="mt-1.5 text-xs text-[#6e6e73]" data-milestone-remaining>
      <% if m.maxed? %><%= sl("Palier maximal atteint") %>
      <% else %><%= mad.(m.remaining_cents) %> <%= sl("avant") %> <%= sl(nxt.name) %> · <%= m.percent_to_next %> %<% end %>
    </p>
  </div>

  <ol class="grid grid-cols-3 gap-x-3 gap-y-5 lg:grid-cols-6" data-milestone-tiers>
    <% m.tiers.each do |tier| %>
      <% is_current = current && current.key == tier.key %>
      <li data-tier="<%= tier.key %>" data-unlocked="<%= tier.unlocked %>" data-fill="<%= tier.fill %>" data-current="<%= is_current ? "true" : "false" %>">
        <div class="h-2.5 overflow-hidden rounded-full bg-[#e9e9ee]">
          <div class="h-full rounded-full bg-gradient-to-r from-[#1c1c1e] to-[#636366]" style="width: <%= tier.fill %>%"></div>
        </div>
        <div class="mt-2 flex items-center gap-1.5">
          <span class="grid size-5 shrink-0 place-items-center rounded-full <%= tier.unlocked ? "bg-[#1c1c1e] text-white" : "bg-[#efeff3] text-[#8e8e93]" %>"><%= seller_icon(tier.unlocked ? :check : :lock, size: 11) %></span>
          <span class="truncate text-[13px] <%= is_current ? "font-bold text-[#1c1c1e]" : (tier.unlocked ? "font-semibold text-[#3a3a3c]" : "font-medium text-[#8e8e93]") %>"><%= sl(tier.name) %></span>
        </div>
        <p class="mt-0.5 ps-6 text-[11px] text-[#8e8e93] tabular-nums"><%= short.(tier.threshold_cents) %> <%= currency %></p>
      </li>
    <% end %>
  </ol>
</section>
