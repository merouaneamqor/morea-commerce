<% content_for :title, "Home — Admin" %>

<div class="admin-page-header">
  <div>
    <h1 class="admin-page-header__title">Home</h1>
    <p class="admin-page-header__meta">Cash-on-delivery orders across all channels</p>
  </div>
  <%= link_to admin_orders_path, class: "admin-btn-secondary" do %>View orders<% end %>
</div>

<div class="admin-card mb-4">
  <div class="grid grid-cols-2 divide-[#ebebeb] sm:grid-cols-4 lg:grid-cols-7 lg:divide-x [&>*]:border-[#ebebeb] max-lg:[&>*]:border-b">
    <% @counts.each do |status, count| %>
      <%= link_to admin_orders_path(status: status), class: "block p-4 transition-colors hover:bg-[#f7f7f7]" do %>
        <p class="admin-metric__label"><%= status.humanize %></p>
        <p class="admin-metric__value"><%= count %></p>
      <% end %>
    <% end %>
    <div class="p-4">
      <p class="admin-metric__label">Cancel rate</p>
      <p class="admin-metric__value"><%= @cancel_rate %>%</p>
    </div>
  </div>
</div>

<div class="admin-layout">
  <section class="admin-card">
    <div class="admin-card__header">
      <h2 class="admin-card__title">Recent orders</h2>
      <%= link_to "View all", admin_orders_path, class: "admin-btn-plain" %>
    </div>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr><th>Order</th><th>Date</th><th>Customer</th><th>Status</th><th class="is-numeric">Total</th></tr>
        </thead>
        <tbody>
          <% @recent_orders.each do |order| %>
            <tr>
              <td><%= link_to "##{order.number}", admin_order_path(order), class: "admin-link" %></td>
              <td class="admin-muted"><%= order.created_at.strftime("%b %-d, %H:%M") %></td>
              <td><%= order.customer_name %></td>
              <td><%= admin_badge(order.status) %></td>
              <td class="is-numeric"><%= order.total_display %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
      <% if @recent_orders.empty? %>
        <p class="admin-empty">No orders yet. They'll show up here as soon as customers check out.</p>
      <% end %>
    </div>
  </section>

  <section class="admin-card">
    <div class="admin-card__header">
      <h2 class="admin-card__title">Low stock</h2>
      <%= link_to "Products", admin_products_path, class: "admin-btn-plain" %>
    </div>
    <ul class="pb-2">
      <% @low_stock.each do |product| %>
        <li>
          <%= link_to edit_admin_product_path(product), class: "flex items-center gap-3 px-4 py-2 hover:bg-[#f7f7f7]" do %>
            <%= admin_thumb(product_image_url(product)) %>
            <span class="min-w-0 flex-1 truncate font-medium"><%= product.name %></span>
            <span class="admin-badge <%= product.stock.zero? ? "admin-badge--critical" : "admin-badge--warning" %>"><%= product.stock %> left</span>
          <% end %>
        </li>
      <% end %>
    </ul>
    <% if @low_stock.empty? %>
      <p class="admin-empty">Everything is well stocked.</p>
    <% end %>
  </section>
</div>
