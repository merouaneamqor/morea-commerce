<%# Meta Ads: connect, choose ad accounts, follow campaigns, map products. Seller design. %>
<% content_for :title, t("meta_ads.title") %>
<% content_for :admin_page_class, "seller-page" %>
<% content_for :seller_lang, "1" %>
<% status = @connection&.status || "disconnected" %>
<% status = "needs_reauthorization" if @connection&.needs_reconnect? %>
<% badge = { "active" => "bg-[#e3f3e8] text-[#2f7a4a]", "needs_reauthorization" => "bg-[#fbe7ea] text-[#b4344e]", "disconnected" => "bg-[#f1eee9] text-[#8a8380]" }.fetch(status) %>
<% active = status == "active" %>
<% missing_business = active && !@connection.granted_scopes.include?("business_management") %>
<% money = ->(amount, currency) { amount.nil? ? admin_blank : number_to_currency(amount, unit: currency.to_s, format: "%n %u", precision: 2) } %>
<% status_badge = ->(key) {
  case key.to_s
  when "ACTIVE" then "bg-[#e3f3e8] text-[#2f7a4a]"
  when "PAUSED", "CAMPAIGN_PAUSED", "ADSET_PAUSED" then "bg-[#f1eee9] text-[#8a8380]"
  when "DISAPPROVED", "WITH_ISSUES" then "bg-[#fbe7ea] text-[#b4344e]"
  else "bg-[#fdf0d9] text-[#8a5a12]"
  end
} %>

<header class="flex flex-wrap items-start justify-between gap-3">
  <div class="flex items-start gap-3">
    <%= link_to "/dashboard", class: "mt-0.5 inline-flex size-10 shrink-0 items-center justify-center rounded-full border border-[#e8e3df] bg-white text-[#1f2430] hover:bg-[#f3f1ef]",
          data: { back_button: true }, "aria-label": t("meta_ads.back_button"), title: t("meta_ads.back_button") do %>
      <svg viewBox="0 0 24 24" class="size-5 fill-none stroke-current [stroke-width:2] [stroke-linecap:round] [stroke-linejoin:round] rtl:rotate-180" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
    <% end %>
    <div>
      <h1 class="text-2xl font-bold text-[#1f2430] sm:text-[28px]"><%= t("meta_ads.title") %></h1>
      <p class="max-w-2xl text-sm"><%= t("meta_ads.lead") %></p>
    </div>
  </div>
  <%= render "admin/shared/language_switcher" %>
</header>

<section>
  <div class="rounded-2xl border border-[#e8e3df] bg-white p-5" data-meta-connection>
    <div class="flex flex-wrap items-center gap-3">
      <img src="/images/partners/meta.png" alt="Meta" class="size-11 rounded-full border border-[#f0ebe7] bg-white object-contain p-0.5">
      <h2 class="text-base font-semibold text-[#1f2430]"><%= t("meta_ads.connection") %></h2>
      <span class="rounded-full px-2.5 py-1 text-xs font-semibold <%= badge %>" data-meta-status="<%= status %>"><%= t("meta_ads.status.#{status}") %></span>
    </div>
    <p class="mt-2 text-xs text-[#8a8380]"><%= t("meta_ads.read_only_note") %></p>
    <% unless @configured %><p class="mt-3 rounded-xl bg-[#fbe7ea] px-4 py-3 text-sm text-[#b4344e]"><%= t("meta_ads.errors.config_missing") %></p><% end %>
    <% if status == "needs_reauthorization" %><p role="alert" class="mt-3 rounded-xl bg-[#fbe7ea] px-4 py-3 text-sm text-[#b4344e]"><%= t("meta_ads.reauthorize_note") %></p><% end %>
    <% if @connection&.expires_soon? %><p role="alert" class="mt-3 rounded-xl bg-[#fdf0d9] px-4 py-3 text-sm text-[#8a5a12]"><%= t("meta_ads.notice.expires_soon", date: l(@connection.token_expires_at.to_date, format: "%d/%m/%Y")) %></p><% end %>
    <% if missing_business %><p class="mt-3 rounded-xl bg-[#fdf0d9] px-4 py-3 text-sm text-[#8a5a12]"><%= t("meta_ads.missing_business_management") %></p><% end %>
    <% if active %>
      <p class="mt-3 text-xs text-[#8a8380]">
        <% if @connection.token_expires_at %><%= t("meta_ads.valid_until", date: l(@connection.token_expires_at.to_date, format: "%d/%m/%Y")) %>, <% end %>
        <%= t("meta_ads.permissions") %> <span dir="ltr"><%= @connection.granted_scopes.join(", ") %></span>
      </p>
    <% end %>
    <div class="mt-4 flex flex-wrap gap-2">
      <%= button_to t(active || status == "needs_reauthorization" ? "meta_ads.reconnect" : "meta_ads.connect"), connect_admin_meta_ads_path, method: :post,
            class: "h-11 rounded-xl bg-[#a8432e] px-5 text-sm font-semibold text-white hover:bg-[#8e3624]" %>
      <% if active %>
        <%= button_to t("meta_ads.refresh"), refresh_admin_meta_ads_path, method: :post, class: "h-11 rounded-xl border border-[#e8e3df] px-4 text-sm font-semibold text-[#1f2430] hover:bg-[#f3f1ef]" %>
      <% end %>
      <% if status != "disconnected" %>
        <%= button_to t("meta_ads.disconnect"), connection_admin_meta_ads_path, method: :delete, class: "h-11 rounded-xl px-4 text-sm font-semibold text-[#b4344e] hover:bg-[#fbe7ea]",
              form: { onsubmit: "return confirm(#{t("meta_ads.disconnect_confirm").to_json})" } %>
      <% end %>
    </div>
  </div>
</section>

<section>
  <h2 class="mb-2.5 text-sm font-semibold text-[#1f2430]"><%= t("meta_ads.accounts_title") %></h2>
  <% if @accounts.blank? %>
    <p class="rounded-2xl border border-[#e8e3df] bg-white p-5 text-sm"><%= t("meta_ads.no_accounts") %></p>
  <% else %>
    <%= form_with url: accounts_admin_meta_ads_path, method: :patch do %>
      <p class="mb-2 text-xs text-[#8a8380]"><%= t("meta_ads.accounts_lead") %></p>
      <ul class="space-y-2" data-meta-accounts>
        <% @accounts.each do |account| %>
          <% selectable = account.selectable? %>
          <li class="flex flex-wrap items-center gap-3 rounded-2xl border bg-white p-3.5 <%= account.selected? ? "border-[#bfe0c9]" : "border-[#e8e3df]" %> <%= "opacity-60" unless selectable %>" data-ad-account="<%= account.meta_ad_account_id %>">
            <%= check_box_tag "ad_account_ids[]", account.meta_ad_account_id, account.selected?, id: "ad_account_#{account.id}", disabled: !active || !selectable,
                  class: "size-4 accent-[#a8432e]", "aria-label": account.name.presence || account.meta_ad_account_id %>
            <label for="ad_account_<%= account.id %>" class="min-w-0 flex-1">
              <span class="block truncate text-sm font-semibold text-[#1f2430]" dir="auto"><%= account.name.presence || account.meta_ad_account_id %></span>
              <span class="block truncate text-xs text-[#8a8380]"><span dir="ltr"><%= account.meta_ad_account_id %></span>, <%= account.currency %>, <%= account.timezone_name %></span>
            </label>
            <% unless selectable %>
              <span class="rounded-full bg-[#f1eee9] px-2.5 py-1 text-xs font-semibold text-[#8a8380]" data-account-status="<%= account.status_key %>"><%= t("meta_ads.account_status.#{account.status_key}") %>, <%= t("meta_ads.not_selectable") %></span>
            <% end %>
            <% if account.selected? %>
              <span class="text-xs text-[#8a8380]">
                <%= t("meta_ads.sync_status.#{account.sync_status}") %>
                <% if account.last_synced_at %>, <%= t("meta_ads.last_synced", time: l(account.last_synced_at, format: :short)) %><% end %>
                <% if account.last_error_code.present? %>, <span dir="ltr"><%= account.last_error_code %></span><% end %>
              </span>
            <% end %>
          </li>
        <% end %>
      </ul>
      <% if active %><div class="mt-3"><%= submit_tag t("meta_ads.save_selection"), class: "h-11 cursor-pointer rounded-xl bg-[#a8432e] px-5 text-sm font-semibold text-white hover:bg-[#8e3624]" %></div><% end %>
    <% end %>
  <% end %>
</section>

<section data-meta-campaigns>
  <div class="mb-2.5 flex flex-wrap items-end justify-between gap-3">
    <div>
      <h2 class="text-sm font-semibold text-[#1f2430]"><%= t("meta_ads.campaigns_title") %></h2>
      <p class="text-xs text-[#8a8380]"><%= t("meta_ads.campaigns_lead") %></p>
    </div>
    <%= form_with url: admin_meta_ads_path, method: :get, class: "flex flex-wrap items-end gap-2" do %>
      <%= render "admin/shared/date_range_picker", range: @date_range, preset: @date_range_preset, url: admin_meta_ads_path, align: "end" %>
      <%= hidden_field_tag :from, @date_range.from.iso8601, id: nil %>
      <%= hidden_field_tag :to, @date_range.to.iso8601, id: nil %>
      <%= hidden_field_tag :preset, @date_range_preset, id: nil if @date_range_preset %>
    <% end %>
  </div>

  <% totals = @overview.totals %>
  <div class="mb-3 grid grid-cols-2 gap-2 lg:grid-cols-4">
    <div class="rounded-2xl border border-[#e8e3df] bg-white p-3.5">
      <p class="text-xs text-[#8a8380]"><%= t("meta_ads.metric_spend") %></p>
      <p class="mt-1 text-base font-semibold text-[#1f2430]"><%= money.call(totals[:spend], totals[:currency]) %></p>
    </div>
    <div class="rounded-2xl border border-[#e8e3df] bg-white p-3.5">
      <p class="text-xs text-[#8a8380]"><%= t("meta_ads.metric_roas") %></p>
      <p class="mt-1 text-base font-semibold text-[#1f2430]"><%= totals[:roas] ? number_with_precision(totals[:roas], precision: 2) + "×" : admin_blank %></p>
    </div>
    <div class="rounded-2xl border border-[#e8e3df] bg-white p-3.5">
      <p class="text-xs text-[#8a8380]"><%= t("meta_ads.metric_active") %></p>
      <p class="mt-1 text-base font-semibold text-[#1f2430]"><%= totals[:active_campaigns] %> / <%= totals[:campaigns] %></p>
    </div>
    <div class="rounded-2xl border border-[#e8e3df] bg-white p-3.5">
      <p class="text-xs text-[#8a8380]"><%= t("meta_ads.metric_conversions") %></p>
      <p class="mt-1 text-base font-semibold text-[#1f2430]"><%= number_with_precision(totals[:conversions], precision: 0) %></p>
    </div>
  </div>

  <% if @overview.rows.empty? %>
    <p class="rounded-2xl border border-[#e8e3df] bg-white p-5 text-sm"><%= t("meta_ads.no_campaigns") %></p>
  <% else %>
    <%= form_with url: product_links_admin_meta_ads_path, method: :patch do %>
      <%= hidden_field_tag :from, @date_range.from.iso8601 %>
      <%= hidden_field_tag :to, @date_range.to.iso8601 %>
      <%= hidden_field_tag :preset, @date_range_preset if @date_range_preset %>
      <div class="overflow-x-auto rounded-2xl border border-[#e8e3df] bg-white">
        <table class="min-w-full text-left text-sm" data-meta-campaign-table>
          <thead class="border-b border-[#e8e3df] text-xs text-[#8a8380]">
            <tr>
              <th class="px-3.5 py-3 font-semibold"><%= t("meta_ads.col_campaign") %></th>
              <th class="px-3.5 py-3 font-semibold"><%= t("meta_ads.col_status") %></th>
              <th class="px-3.5 py-3 font-semibold"><%= t("meta_ads.col_budget") %></th>
              <th class="px-3.5 py-3 font-semibold"><%= t("meta_ads.col_spend") %></th>
              <th class="px-3.5 py-3 font-semibold"><%= t("meta_ads.col_roas") %></th>
              <th class="px-3.5 py-3 font-semibold"><%= t("meta_ads.col_ads") %></th>
              <th class="px-3.5 py-3 font-semibold"><%= t("meta_ads.col_product") %></th>
            </tr>
          </thead>
          <tbody>
            <% @overview.rows.each do |row| %>
              <% campaign = row.campaign %>
              <tr class="border-b border-[#f1eee9] last:border-0" data-meta-campaign="<%= campaign.meta_id %>" data-effective-status="<%= row.effective_status %>">
                <td class="px-3.5 py-3 align-top">
                  <p class="font-semibold text-[#1f2430]" dir="auto"><%= campaign.name.presence || campaign.meta_id %></p>
                  <p class="text-xs text-[#8a8380]">
                    <span dir="ltr"><%= campaign.meta_id %></span>
                   , <%= row.ad_account.name.presence || row.ad_account.meta_ad_account_id %>
                    <% if row.objective.present? %>, <%= row.objective.tr("_", " ").downcase %><% end %>
                  </p>
                </td>
                <td class="px-3.5 py-3 align-top">
                  <% key = row.effective_status.to_s.presence || "UNKNOWN" %>
                  <span class="rounded-full px-2.5 py-1 text-xs font-semibold <%= status_badge.call(key) %>">
                    <%= t("meta_ads.delivery_status.#{key.downcase}", default: key.tr("_", " ").titleize) %>
                  </span>
                </td>
                <td class="px-3.5 py-3 align-top text-[#1f2430]">
                  <% if row.daily_budget.present? %>
                    <p><%= t("meta_ads.budget_daily", amount: money.call(row.daily_budget, row.currency)) %></p>
                  <% elsif row.lifetime_budget.present? %>
                    <p><%= t("meta_ads.budget_lifetime", amount: money.call(row.lifetime_budget, row.currency)) %></p>
                  <% else %>
                    <p class="text-[#8a8380]"><%= admin_blank %></p>
                  <% end %>
                  <% if row.budget_level.present? %>
                    <p class="text-xs text-[#8a8380]"><%= t("meta_ads.budget_level.#{row.budget_level}") %></p>
                  <% end %>
                  <% if row.budget_remaining.present? %>
                    <p class="text-xs text-[#8a8380]"><%= t("meta_ads.budget_remaining", amount: money.call(row.budget_remaining, row.currency)) %></p>
                  <% end %>
                </td>
                <td class="px-3.5 py-3 align-top">
                  <p class="font-medium text-[#1f2430]"><%= money.call(row.spend_display || row.spend, row.spend_display ? row.display_currency : row.currency) %></p>
                  <% if row.spend_display && row.currency != row.display_currency %>
                    <p class="text-xs text-[#8a8380]"><%= money.call(row.spend, row.currency) %></p>
                  <% end %>
                </td>
                <td class="px-3.5 py-3 align-top font-medium text-[#1f2430]">
                  <%= row.roas ? number_with_precision(row.roas, precision: 2) + "×" : admin_blank %>
                </td>
                <td class="px-3.5 py-3 align-top text-[#1f2430]">
                  <%= t("meta_ads.ads_running", active: row.active_ads, total: row.total_ads) %>
                </td>
                <td class="px-3.5 py-3 align-top">
                  <% if row.link_source %><span class="mb-1 inline-block rounded-full bg-[#f1eee9] px-2.5 py-1 text-xs font-semibold text-[#8a8380]"><%= t("meta_ads.link_source.#{row.link_source}") %></span><% end %>
                  <%= select_tag "campaign_links[#{campaign.meta_id}]",
                        options_for_select([ [ t("meta_ads.no_product"), "" ] ] + @products.map { |product| [ product.name, product.id ] }, row.product&.id),
                        class: "h-10 min-w-44 rounded-xl border border-[#e8e3df] bg-white px-3 text-sm text-[#1f2430]",
                        "aria-label": campaign.name.presence || campaign.meta_id %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <div class="mt-3"><%= submit_tag t("meta_ads.save_campaign_links"), class: "h-11 cursor-pointer rounded-xl bg-[#a8432e] px-5 text-sm font-semibold text-white hover:bg-[#8e3624]" %></div>
    <% end %>
  <% end %>
</section>

<% if @ads.any? %>
  <section>
    <h2 class="mb-2.5 text-sm font-semibold text-[#1f2430]"><%= t("meta_ads.products_title") %></h2>
    <%= form_with url: product_links_admin_meta_ads_path, method: :patch do %>
      <p class="mb-2 text-xs text-[#8a8380]"><%= t("meta_ads.products_lead") %></p>
      <ul class="space-y-2" data-meta-product-links>
        <% @ads.each do |ad| %>
          <% link = @ad_links[ad.meta_id] %>
          <li class="flex flex-wrap items-center gap-3 rounded-2xl border border-[#e8e3df] bg-white p-3.5">
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-semibold text-[#1f2430]" dir="auto"><%= ad.name.presence || ad.meta_id %></p>
              <p class="truncate text-xs text-[#8a8380]" dir="ltr"><%= ad.meta_id %><% if ad.effective_status.present? %>, <%= ad.effective_status %><% end %></p>
            </div>
            <% if link %><span class="rounded-full bg-[#f1eee9] px-2.5 py-1 text-xs font-semibold text-[#8a8380]"><%= t("meta_ads.link_source.#{link.source}") %></span><% end %>
            <%= select_tag "links[#{ad.meta_id}]", options_for_select([ [ t("meta_ads.no_product"), "" ] ] + @products.map { |product| [ product.name, product.id ] }, link&.product_id),
                  class: "h-10 min-w-48 rounded-xl border border-[#e8e3df] bg-white px-3 text-sm text-[#1f2430]", "aria-label": ad.name.presence || ad.meta_id %>
          </li>
        <% end %>
      </ul>
      <div class="mt-3"><%= submit_tag t("meta_ads.save_links"), class: "h-11 cursor-pointer rounded-xl bg-[#a8432e] px-5 text-sm font-semibold text-white hover:bg-[#8e3624]" %></div>
    <% end %>
  </section>
<% end %>
