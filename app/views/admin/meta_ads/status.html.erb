<%# Development and test only. Shows connection state and last sync per ad account; never a token. %>
<% content_for :title, "Meta Ads status" %>
<% content_for :admin_page_class, "seller-page" %>
<h1 class="text-xl font-bold text-[#1f2430]">Meta Ads · status (dev only)</h1>
<dl class="mt-3 grid max-w-xl grid-cols-2 gap-1 text-sm" data-meta-dev-status>
  <dt>Configured</dt><dd><%= MetaAds::Oauth.configured? %></dd>
  <dt>Graph version</dt><dd><%= MetaAds::Config.api_version %></dd>
  <dt>Status</dt><dd><%= @connection&.status || "no connection" %></dd>
  <dt>Meta user</dt><dd><%= @connection&.meta_user_id || "-" %></dd>
  <dt>Scopes</dt><dd><%= @connection&.granted_scopes&.join(", ").presence || "-" %></dd>
  <dt>Token expires</dt><dd><%= @connection&.token_expires_at || "-" %></dd>
  <dt>Last verified</dt><dd><%= @connection&.last_verified_at || "-" %></dd>
  <dt>Last error</dt><dd><%= @connection&.last_error_code || "-" %></dd>
</dl>
<table class="mt-5 w-full text-left text-sm" data-meta-dev-accounts>
  <thead><tr><th>Account</th><th>Linked</th><th>Currency</th><th>Sync</th><th>Last attempt</th><th>Last synced</th><th>Next sync</th><th>Retries</th><th>Error</th><th>Rows (campaign / ad)</th></tr></thead>
  <tbody>
    <% @accounts.each do |account| %>
      <tr>
        <td><%= account.name %> <span dir="ltr"><%= account.meta_ad_account_id %></span></td>
        <td><%= account.selected? %></td>
        <td><%= account.currency %></td>
        <td><%= account.sync_status %></td>
        <td><%= account.last_attempt_at || "-" %></td>
        <td><%= account.last_synced_at || "-" %></td>
        <td><%= account.next_sync_at || "-" %></td>
        <td><%= account.retry_count %></td>
        <td><%= account.last_error_code || "-" %></td>
        <td><%= @insight_counts[[ account.id, "campaign" ]].to_i %> / <%= @insight_counts[[ account.id, "ad" ]].to_i %></td>
      </tr>
    <% end %>
  </tbody>
</table>
