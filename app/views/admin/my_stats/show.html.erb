<%# An agent's own dashboard, drawn like the owner's: same header (greeting, search, language, period), same figure cards and cards of charts.
    Every figure is the agent's own (Team::AgentEarnings); nothing about the other agents or the store. The clock-in lives in a small window
    opened from an icon, so it is not always on screen. %>
<% content_for :title, "#{sl("Tableau de bord")} — Admin" %>
<% content_for :seller_lang, "1" %>
<% content_for :admin_page_class, "seller-page" %>
<% figures = @summary.figures %>
<% first_name = (current_user.name.presence || current_user.email).to_s.strip.split(/\s+/).first.to_s %>
<% pct = ->(part) { figures.confirmed.zero? ? 0 : (part * 100.0 / figures.confirmed).round } %>
<% of_confirmed = ->(part) { t("admin.my_stats.of_confirmed", percent: pct.(part)) } %>
<% card = "rounded-2xl border border-[#e0e0e5] bg-white p-5" %>
<% breakdown = [
     [ t("admin.my_stats.delivered"), figures.delivered, "#2f9d5c" ],
     [ t("admin.my_stats.in_delivery"), figures.in_delivery + figures.pickup, "#3b82c4" ],
     [ t("admin.my_stats.postponed"), figures.postponed, "#e0a52c" ],
     [ t("admin.my_stats.unreachable"), figures.unreachable, "#8e8e93" ],
     [ t("admin.my_stats.returned"), figures.returned, "#d6455d" ]
   ].select { |_, n, _| n.positive? } %>
<% conf_rate = (rate = Confirmations::AgentHome.new(store: current_store, user: current_user, range: @range).confirmation_rate) ? (rate * 100).round : 0 %>
<% del_rate = figures.delivery_rate ? (figures.delivery_rate * 100).round : 0 %>

<%# "Créer une commande" opens the same window as on the Orders page. %>
<turbo-frame id="order-modal"></turbo-frame>

<header class="flex min-h-[72px] flex-wrap items-center justify-between gap-3 rounded-3xl bg-[#1c1c1e] px-5 py-3 text-white" data-agent-header>
  <div>
    <h1 class="text-2xl font-bold text-white sm:text-[26px]"><%= sl("Bonjour") %><%= first_name.present? ? ", #{first_name}" : "" %></h1>
  </div>
  <div class="flex flex-wrap items-center gap-2">
    <%= form_with url: admin_my_stats_path(anchor: "my-orders"), method: :get, class: "hidden h-11 items-center gap-2 rounded-xl bg-white/10 px-3 text-sm text-white sm:flex", data: { agent_search: true } do %>
      <span class="text-white/65"><%= seller_icon(:search) %></span>
      <input name="q" value="<%= @q %>" placeholder="<%= sl("Rechercher une commande") %>" class="w-44 bg-transparent text-white outline-none placeholder:text-white/55">
    <% end %>

    <%= link_to new_admin_order_path, data: { turbo_frame: "order-modal" }, class: "flex h-11 items-center gap-1.5 rounded-xl bg-white px-4 text-sm font-semibold text-[#1c1c1e] hover:bg-[#ececf0]" do %>+ <%= t("call_center.create_order") %><% end %>

    <%# Clock in / out: an icon; a click opens the window with the timer, the total and the button. A green dot says the agent is on shift. %>
    <div class="relative" data-controller="locale-switcher" data-my-hours>
      <button type="button" data-locale-switcher-target="button" data-action="locale-switcher#toggle" aria-haspopup="dialog" aria-expanded="false"
              title="<%= sl("Temps de travail") %>" aria-label="<%= sl("Temps de travail") %>"
              class="relative grid size-11 cursor-pointer place-items-center rounded-xl bg-white/10 text-white hover:bg-white/20">
        <%= seller_icon(:clock, size: 20) %>
        <% if @open_shift %><i class="absolute end-2 top-2 size-2.5 rounded-full border-2 border-[#1c1c1e] bg-[#34c759]" data-on-shift-dot></i><% end %>
      </button>
      <div role="dialog" data-locale-switcher-target="menu" hidden
           class="absolute end-0 z-50 mt-2 w-80 rounded-2xl border border-[#e0e0e5] bg-white p-4 text-start shadow-[0_12px_32px_-12px_rgba(0,0,0,0.25)]">
        <div class="flex items-start justify-between gap-3">
          <div>
            <h2 class="text-sm font-semibold text-[#1c1c1e]"><%= sl("Temps de travail") %></h2>
            <% if @open_shift %>
              <p class="mt-0.5 text-xs text-[#6e6e73]"><%= t("admin.confirmations.on_shift_since", time: l(@open_shift.started_at, format: :short)) %></p>
              <p role="timer" class="mt-1 text-2xl font-bold tabular-nums text-[#1c1c1e]" data-shift-running data-controller="shift-timer" data-shift-timer-started-at-value="<%= @open_shift.started_at.iso8601 %>"><%= shift_clock(Time.current - @open_shift.started_at) %></p>
            <% else %>
              <p class="mt-0.5 text-xs text-[#6e6e73]"><%= t("admin.confirmations.off_shift") %></p>
            <% end %>
          </div>
          <div class="text-end">
            <p class="text-[11px] text-[#6e6e73]"><%= sl("Total sur la période") %></p>
            <p class="text-lg font-bold tabular-nums text-[#1c1c1e]" data-worked="<%= @worked_seconds %>"><%= shift_hours(@worked_seconds) %> h</p>
          </div>
        </div>
        <% if @open_shift %>
          <%= button_to t("admin.confirmations.clock_out"), clock_out_admin_confirmations_path, class: "mt-3 flex h-10 w-full cursor-pointer items-center justify-center rounded-xl border border-[#e0e0e5] bg-white text-sm font-semibold text-[#1c1c1e] hover:bg-[#f5f5f7]", form_class: "w-full" %>
        <% else %>
          <%= button_to t("admin.confirmations.clock_in"), clock_in_admin_confirmations_path, class: "mt-3 flex h-10 w-full cursor-pointer items-center justify-center rounded-xl bg-[#1d1d1f] text-sm font-semibold text-white hover:bg-[#3a3a3c]", form_class: "w-full" %>
        <% end %>
        <% if @shifts.any? %>
          <table class="mt-3 w-full text-xs" data-my-shifts>
            <thead><tr class="text-[#6e6e73]"><th class="py-1 text-start font-medium"><%= sl("Arrivée") %></th><th class="py-1 text-start font-medium"><%= sl("Départ") %></th><th class="py-1 text-end font-medium"><%= sl("Durée") %></th></tr></thead>
            <tbody>
              <% @shifts.first(6).each do |shift| %>
                <tr class="border-t border-[#eeeef1]" data-shift>
                  <td class="py-1 tabular-nums"><%= l(shift.started_at.in_time_zone(DateRange::ZONE), format: :short) %></td>
                  <td class="py-1 tabular-nums"><%= shift.ended_at ? l(shift.ended_at.in_time_zone(DateRange::ZONE), format: :short) : sl("En cours") %></td>
                  <td class="py-1 text-end tabular-nums"><%= shift_hours(shift.seconds_within(@range)) %> h</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        <% end %>
      </div>
    </div>

    <%= render "admin/shared/language_switcher" %>
    <%= render "admin/shared/date_range_picker", range: @date_range, preset: @date_range_preset, url: admin_my_stats_path, theme: "dark" %>
  </div>
</header>

<%# Row 1: the confirmed orders (the gold card) and where they went. Row 2: the rest and the two rates. Same cards as the owner's dashboard. %>
<section class="mt-3 grid grid-cols-2 gap-2.5 md:grid-cols-3 xl:grid-cols-6" data-kpis="row1">
  <%= render "admin/dashboard/kpi", key: "confirmed", label: t("admin.my_stats.confirmed"), icon: :check, value: figures.confirmed, featured: true, sub: t("admin.my_stats.orders") %>
  <%= render "admin/dashboard/kpi", key: "cancelled", label: t("admin.my_stats.cancelled"), icon: :cancel, tone: "bg-[#fbe7ea] text-[#d6455d]", value: figures.cancelled, sub: t("admin.my_stats.cancel_reasons") %>
  <%= render "admin/dashboard/kpi", key: "pickup", label: t("admin.my_stats.pickup"), icon: :box, tone: "bg-[#e6f0fd] text-[#2f6fed]", value: figures.pickup, sub: of_confirmed.(figures.pickup) %>
  <%= render "admin/dashboard/kpi", key: "in_delivery", label: t("admin.my_stats.in_delivery"), icon: :truck, tone: "bg-[#e6f0fd] text-[#2f6fed]", value: figures.in_delivery, sub: of_confirmed.(figures.in_delivery) %>
  <%= render "admin/dashboard/kpi", key: "delivered", label: t("admin.my_stats.delivered"), icon: :box, tone: "bg-[#e3f3e8] text-[#2f9d5c]", value: figures.delivered, sub: of_confirmed.(figures.delivered) %>
  <%= render "admin/dashboard/kpi", key: "postponed", label: t("admin.my_stats.postponed"), icon: :clock, tone: "bg-[#fdf0d9] text-[#d28a12]", value: figures.postponed, sub: of_confirmed.(figures.postponed) %>
</section>

<section class="mt-2.5 grid grid-cols-2 gap-2.5 xl:grid-cols-4" data-kpis="row2">
  <%= render "admin/dashboard/kpi", key: "unreachable", label: t("admin.my_stats.unreachable"), icon: :ban, tone: "bg-[#fdf0d9] text-[#d28a12]", value: figures.unreachable, sub: of_confirmed.(figures.unreachable) %>
  <%= render "admin/dashboard/kpi", key: "returned", label: t("admin.my_stats.returned"), icon: :undo, tone: "bg-[#ececf0] text-[#1c1c1e]", value: figures.returned, sub: of_confirmed.(figures.returned) %>
  <%= render "admin/dashboard/kpi", key: "confirmation_rate", label: t("admin.my_stats.confirmation_rate"), icon: :check, tone: "bg-[#e3f3e8] text-[#2f9d5c]", value: "#{conf_rate} %", sub: t("admin.my_stats.confirmation_rate_sub") %>
  <%= render "admin/dashboard/kpi", key: "delivery_rate", label: t("admin.my_stats.delivery_rate"), icon: :truck, tone: "bg-[#e6f0fd] text-[#2f6fed]", value: "#{del_rate} %", sub: t("admin.my_stats.delivery_rate_sub") %>
</section>
<p class="my-3 text-xs text-[#6e6e73]"><%= t("admin.my_stats.courier_note") %></p>

<section class="grid grid-cols-1 gap-3 lg:grid-cols-2">
  <div class="<%= card %>" data-distribution>
    <h2 class="font-semibold text-[#1c1c1e]"><%= t("admin.my_stats.distribution") %></h2>
    <p class="text-xs text-[#6e6e73]"><%= t("admin.my_stats.distribution_sub") %></p>
    <% total = breakdown.sum { |_, n, _| n } %>
    <% stops = []; at = 0.0
       breakdown.each { |_, n, color| from = at; at += n * 100.0 / total; stops << "#{color} #{from.round(2)}% #{at.round(2)}%" } %>
    <div class="seallo-donut-row">
      <div class="seallo-donut" style="background: <%= total.zero? ? '#efeff3' : "conic-gradient(#{stops.join(', ')})" %>">
        <div><strong><%= total %></strong><span><%= t("admin.my_stats.order_count") %></span></div>
      </div>
      <ul class="seallo-legend">
        <% breakdown.each do |label, n, color| %>
          <li><i style="background:<%= color %>"></i><span><%= label %></span><b><%= n %></b><em><%= (n * 100.0 / total).round %> %</em></li>
        <% end %>
      </ul>
    </div>
  </div>

  <div class="<%= card %>">
    <h2 class="font-semibold text-[#1c1c1e]"><%= t("admin.my_stats.per_day") %></h2>
    <% max = [ @by_day.values.max.to_i, 1 ].max %>
    <div class="seallo-bars">
      <% @chart_days.each do |day| %>
        <% n = @by_day.fetch(day, 0) %>
        <div class="seallo-bars__col" title="<%= day %> · <%= n %>">
          <span class="seallo-bars__bar" style="height: <%= n.zero? ? 3 : (n * 100.0 / max).round %>%; background: #2f9d5c"></span>
          <small><%= day.strftime(@chart_days.length > 7 ? "%d" : "%a") %></small>
        </div>
      <% end %>
    </div>
  </div>
</section>

<%# The agent's orders with where each one stands; the search bar of the header filters this list. %>
<% call_badges = { "pending" => [ sl("En attente"), "bg-[#fdf0d9] text-[#8a5a12]" ], "no_answer" => [ sl("Sans réponse"), "bg-[#fdeadb] text-[#b4560f]" ], "callback" => [ sl("Planifiée"), "bg-[#e1edfb] text-[#2b5f9e]" ],
                    "confirmed" => [ sl("Confirmées"), "bg-[#e3f3e8] text-[#2f7a4a]" ], "cancelled" => [ sl("Annulées"), "bg-[#fbe7ea] text-[#b4344e]" ], "wrong_number" => [ sl("Faux numéros"), "bg-[#efeff3] text-[#6e6e73]" ],
                    "blocked" => [ sl("Bloqué"), "bg-[#efeff3] text-[#6e6e73]" ] } %>
<section id="my-orders" class="<%= card %> mt-3" data-my-orders>
  <div class="flex flex-wrap items-center justify-between gap-2">
    <div>
      <h2 class="font-semibold text-[#1c1c1e]"><%= t("admin.my_stats.orders") %></h2>
      <p class="text-xs text-[#6e6e73]"><%= sl("Les commandes qui vous sont attribuées, avec leur statut.") %></p>
    </div>
    <% if @q.present? %><%= link_to sl("Effacer"), admin_my_stats_path(anchor: "my-orders"), class: "inline-flex h-8 items-center rounded-full border border-[#e0e0e5] px-3 text-xs font-semibold text-[#3a3a3c] hover:bg-[#f5f5f7]", data: { clear_search: true } %><% end %>
  </div>
  <% if @my_orders.empty? %>
    <p class="my-6 text-center text-sm text-[#6e6e73]" data-no-orders><%= @q.present? ? sl("Aucune commande ne correspond à cette recherche.") : sl("Aucune commande pour le moment.") %></p>
  <% else %>
    <div class="mt-3 overflow-x-auto">
      <table class="w-full text-[13px]">
        <thead class="text-[11px] text-[#6e6e73]"><tr>
          <th class="px-2 py-2 text-start font-medium"><%= sl("Commande") %></th>
          <th class="px-2 py-2 text-start font-medium"><%= sl("Client") %></th>
          <th class="px-2 py-2 text-start font-medium"><%= sl("Ville") %></th>
          <th class="px-2 py-2 text-end font-medium"><%= sl("Montant") %></th>
          <th class="px-2 py-2 text-start font-medium"><%= sl("Statut") %></th>
          <th class="px-2 py-2 text-start font-medium"><%= sl("Appel") %></th>
          <th class="px-2 py-2 text-start font-medium"><%= sl("Date") %></th>
        </tr></thead>
        <tbody class="divide-y divide-[#f1f1f4]">
          <% @my_orders.each do |order| %>
            <% status_label, status_class = seller_status_badge(order.status) %>
            <% call_label, call_class = call_badges[order.order_confirmation&.disposition.to_s] || [ "—", "text-[#8e8e93]" ] %>
            <tr data-order-row="<%= order.number %>">
              <td class="px-2 py-2 font-semibold text-[#1c1c1e]" dir="ltr"><%= link_to "##{order.number}", admin_order_path(order), class: "hover:underline" %></td>
              <td class="px-2 py-2" dir="auto"><%= order.customer_name %><span class="block text-[11px] text-[#8e8e93]" dir="ltr"><%= order.customer_phone %></span></td>
              <td class="px-2 py-2"><%= order.customer_city.presence || "—" %></td>
              <td class="px-2 py-2 text-end tabular-nums"><%= money(order.total_cents, order.currency) %></td>
              <td class="px-2 py-2"><span class="inline-block rounded-full px-2.5 py-0.5 text-[12px] font-medium whitespace-nowrap <%= status_class %>" data-status="<%= order.status %>"><%= sl(status_label) %></span></td>
              <td class="px-2 py-2"><span class="inline-block rounded-full px-2.5 py-0.5 text-[12px] font-medium whitespace-nowrap <%= call_class %>"><%= call_label %></span></td>
              <td class="px-2 py-2 tabular-nums text-[#6e6e73]"><%= l(order.created_at.in_time_zone(DateRange::ZONE), format: :short) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
