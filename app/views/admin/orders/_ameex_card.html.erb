<section class="admin-card">
  <div class="admin-card__header">
    <h2 class="admin-card__title">Ameex</h2>
    <%= ameex_badge(order) %>
  </div>

  <% if !order.store.ameex_configured? %>
    <p class="admin-muted px-4 pb-4">Add your Ameex credentials in <%= link_to "Integrations", seller_integrations_path, class: "underline" %> to sync orders.</p>
  <% else %>
    <div class="space-y-3 px-4 pb-4">
      <p class="admin-muted text-[12px]">Ameex sets the delivery status. Confirm or cancel the order here. Seallo refreshes the courier status every 15 minutes, or use Refresh.</p>
      <% if order.ameex_error.present? %>
        <div class="admin-banner admin-banner--critical !mb-0"><%= order.ameex_error %></div>
      <% end %>

      <% if order.ameex_code.present? %>
        <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1">
          <dt class="admin-muted">Parcel</dt><dd class="font-semibold tabular-nums"><%= order.ameex_code %></dd>
          <dt class="admin-muted">City</dt><dd><%= order.ameex_city_name || admin_blank %></dd>
          <% if order.ameex_fee.present? %><dt class="admin-muted">Fee</dt><dd><%= number_with_precision(order.ameex_fee, precision: 0) %> MAD</dd><% end %>
          <% if order.ameex_message.present? %><dt class="admin-muted">Courier note</dt><dd><%= order.ameex_message %></dd><% end %>
          <% if order.ameex_synced_at.present? %><dt class="admin-muted">Synced</dt><dd class="admin-muted"><%= order.ameex_synced_at.strftime("%b %-d, %H:%M") %></dd><% end %>
        </dl>
        <div class="flex flex-wrap gap-2 pt-1">
          <%= button_to "Refresh", ameex_admin_order_path(order, op: "refresh"), class: "admin-btn-secondary" %>
          <% if Ameex::Sync.new(order).cancellable? && Ameex::Sync.normalize_status(order.ameex_status) != "CANCELED" %>
            <%= button_to "Mark cancelled", ameex_admin_order_path(order, op: "cancel"), class: "admin-btn-plain admin-btn-plain--critical",
                  form: { data: { turbo_confirm: "Mark parcel #{order.ameex_code} as cancelled in Seallo?" } } %>
          <% end %>
        </div>
      <% elsif order.status.in?(%w[confirmed preparing awaiting_pickup address_issue]) || order.ameex_error.present? %>
        <%= form_with url: ameex_admin_order_path(order), method: :post, class: "space-y-3" do %>
          <div>
            <%= label_tag :city_id, "Ameex city", class: "admin-label" %>
            <%= select_tag :city_id, ameex_city_options(order), include_blank: "Match automatically from #{order.customer_city}", class: "admin-input" %>
          </div>
          <%= submit_tag (order.ameex_error.present? ? "Retry sending to Ameex" : "Send to Ameex"), class: "admin-btn w-full" %>
        <% end %>
      <% else %>
        <p class="admin-muted">Not sent yet. Seallo creates the parcel on Ameex when the order is confirmed.</p>
        <% unless order.status.in?(%w[cancelled returned delivered]) || order.sendit_code.present? || order.ozon_code.present? %>
          <%= button_to "Send to Ameex now", ameex_admin_order_path(order), class: "admin-btn-secondary mt-3 w-full",
                form: { data: { turbo_confirm: "Create the Ameex parcel before confirming the order?" } } %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</section>
