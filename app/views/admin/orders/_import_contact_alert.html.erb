<% if order.contact_review_required? %>
  <% fields = order.import_contact_issues.filter_map { |field| t("import_contact.fields.#{field}") if %w[name phone city address].include?(field) }.to_sentence %>
  <% if local_assigns[:compact] %>
    <p class="admin-badge admin-badge--warning mt-1 whitespace-normal" role="alert" data-import-contact-alert>
      <span aria-hidden="true">‼</span> <%= t("import_contact.check_fields", fields: fields) %>
    </p>
  <% else %>
    <section class="admin-banner admin-banner--critical mb-4 min-w-0" role="alert" data-import-contact-alert>
      <h2 class="font-semibold"><span aria-hidden="true">‼</span> <%= t("import_contact.title") %></h2>
      <p><%= t("import_contact.help") %></p>
      <p class="mt-1 font-medium"><%= t("import_contact.check_fields", fields: fields) %></p>
      <% if local_assigns[:allow_correction] && order.status == "new" %>
        <%= form_with url: complete_import_contact_admin_order_path(order), method: :patch, scope: :contact, class: "mt-4 space-y-3", data: { import_contact_form: true } do |form| %>
          <div class="grid min-w-0 gap-3 sm:grid-cols-2">
            <% { name: order.customer_name, phone: order.customer_phone, city: order.customer_city, address: order.customer_address, district: order.customer_district }.each do |field, value| %>
              <div class="min-w-0">
                <%= form.label field, t("import_contact.fields.#{field}"), class: "admin-label" %>
                <% if field == :phone %>
                  <%= form.telephone_field field, value: value, required: true, maxlength: 30, autocomplete: "tel", class: "admin-input !min-h-[44px] !text-base", dir: "ltr" %>
                <% else %>
                  <%= form.text_field field, value: value, required: field != :district, maxlength: 255, class: "admin-input !min-h-[44px] !text-base" %>
                <% end %>
              </div>
            <% end %>
          </div>
          <%= form.submit t("import_contact.save"), class: "admin-btn !min-h-[44px]" %>
          <p class="admin-help"><%= t("import_contact.local_correction") %></p>
        <% end %>
      <% else %>
        <p class="mt-2"><%= t("import_contact.manager_help") %></p>
      <% end %>
    </section>
  <% end %>
<% end %>
