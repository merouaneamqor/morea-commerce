<%# One figure of the Orders page, drawn exactly like the dashboard and Comptabilité cards: a small grey icon beside the label,
    the value, a change pill, a short description; the featured card is the gold one. Clicking it opens the table filtered on
    exactly what it counts (and jumps to it); clicking the open card again goes back to all the orders. Printing only.
    locals: key, label, value, hint, href, icon, active (optional), featured (optional), pill (optional [text, tone]) %>
<% featured = local_assigns.fetch(:featured, false) %>
<% active = local_assigns.fetch(:active, false) %>
<% pill_text, pill_tone = local_assigns[:pill] %>
<% pill_class = { up: "bg-[#e3f3e8] text-[#2f7a4a]", down: "bg-[#fbe7ea] text-[#b4344e]" }.fetch(pill_tone, featured ? "bg-[#1c1c1e]/80 text-white" : "bg-[#efeff3] text-[#6e6e73]") %>
<% tones = { "pending" => "bg-[#fdf0d9] text-[#d28a12]", "confirmed" => "bg-[#e3f3e8] text-[#2f9d5c]", "cancelled" => "bg-[#fbe7ea] text-[#d6455d]", "wrong" => "bg-[#ececf0] text-[#1c1c1e]",
     "to_ship" => "bg-[#eceefa] text-[#5b6bb5]", "in_transit" => "bg-[#e6f0fd] text-[#2f6fed]", "scheduled" => "bg-[#ece9fb] text-[#6a4fd8]", "delivered" => "bg-[#e3f3e8] text-[#2f9d5c]", "failed" => "bg-[#fff1dc] text-[#c26a00]", "returned" => "bg-[#fbe7ea] text-[#d6455d]" } %>
<%= link_to href, "data-card": key, "data-value": value, title: label, "aria-current": (active ? "true" : nil),
      class: "flex h-[110px] min-w-0 flex-col justify-between rounded-xl px-3.5 py-3 transition hover:-translate-y-0.5 hover:shadow-[0_14px_30px_-18px_rgba(0,0,0,0.4)] #{featured ? "bg-gradient-to-br from-[#f7d9a4] to-[#eeb460] text-[#3a2a0e] shadow-[0_14px_30px_-20px_rgba(190,120,20,0.8)]" : "border border-[#e0e0e5] bg-white"} #{"outline outline-2 outline-offset-2 outline-[#1c1c1e]" if active}" do %>
  <div class="flex items-center justify-between gap-2">
    <p class="flex min-w-0 items-center gap-1.5 text-xs font-medium <%= featured ? "" : "text-[#3a3a3c]" %>">
      <span class="<%= featured ? "grid size-5 shrink-0 place-items-center rounded-md bg-[#1c1c1e] text-white" : "grid size-6 shrink-0 place-items-center rounded-lg #{tones.fetch(key, "bg-[#efeff3] text-[#6e6e73]")}" %>"><%= seller_icon(icon, size: featured ? 12 : 14) %></span>
      <span class="truncate"><%= label %></span>
    </p>
    <% if pill_text.present? %><span class="rounded-full px-2 py-0.5 text-[11px] font-semibold whitespace-nowrap <%= pill_class %>"><%= pill_text %></span><% end %>
  </div>
  <p class="text-[22px] leading-none font-bold whitespace-nowrap text-[#1c1c1e] tabular-nums 2xl:text-[25px]"><%= seller_number(value) %></p>
  <p class="line-clamp-2 min-w-0 text-[11px] leading-tight <%= featured ? "text-[#6d4f17]" : "text-[#6e6e73]" %>" title="<%= hint %>"><%= hint %></p>
<% end %>
