<section class="admin-card">
  <div class="admin-card__header">
    <h2 class="admin-card__title">Ozon Express</h2>
    <%= ozon_badge(order) %>
  </div>

  <% if !order.store.ozon_configured? %>
    <p class="admin-muted px-4 pb-4">Add your Ozon Express credentials in <%= link_to "Integrations", seller_integrations_path, class: "underline" %> to sync orders.</p>
  <% else %>
    <div class="space-y-3 px-4 pb-4">
      <p class="admin-muted text-[12px]">Ozon Express sets the delivery status. Confirm or cancel the order here. Seallo refreshes the courier status every 15 minutes, or use Refresh.</p>
      <% if order.ozon_error.present? %>
        <div class="admin-banner admin-banner--critical !mb-0">
          <%= order.ozon_error %>
        </div>
      <% end %>

      <% if order.ozon_code.present? %>
        <dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1">
          <dt class="admin-muted">Parcel</dt><dd class="font-semibold tabular-nums"><%= order.ozon_code %></dd>
          <dt class="admin-muted">City</dt><dd><%= order.ozon_city_name || admin_blank %></dd>
          <% if order.ozon_fee.present? %><dt class="admin-muted">Fee</dt><dd><%= number_with_precision(order.ozon_fee, precision: 0) %> MAD</dd><% end %>
          <% if order.ozon_message.present? %><dt class="admin-muted">Courier note</dt><dd><%= order.ozon_message %></dd><% end %>
          <% if order.ozon_synced_at.present? %><dt class="admin-muted">Synced</dt><dd class="admin-muted"><%= order.ozon_synced_at.strftime("%b %-d, %H:%M") %></dd><% end %>
        </dl>
        <div class="flex flex-wrap gap-2 pt-1">
          <%= link_to "Print label", ozon_label_admin_order_path(order), class: "admin-btn-secondary", target: "_blank", rel: "noopener" %>
          <%= button_to "Refresh", ozon_admin_order_path(order, op: "refresh"), class: "admin-btn-secondary" %>
          <% if Ozon::Sync.new(order).cancellable? && Ozon::Sync.normalize_status(order.ozon_status) != "CANCELED" %>
            <%= button_to "Mark cancelled", ozon_admin_order_path(order, op: "cancel"), class: "admin-btn-plain admin-btn-plain--critical",
                  form: { data: { turbo_confirm: "Mark parcel #{order.ozon_code} as cancelled in Seallo? (Ozon has no delete API.)" } } %>
          <% end %>
        </div>
      <% elsif order.status.in?(%w[confirmed preparing awaiting_pickup address_issue]) || order.ozon_error.present? %>
        <%= form_with url: ozon_admin_order_path(order), method: :post, class: "space-y-3" do %>
          <div>
            <%= label_tag :city_id, "Ozon city", class: "admin-label" %>
            <%= select_tag :city_id, ozon_city_options(order), include_blank: "Match automatically from #{order.customer_city}", class: "admin-input" %>
            <p class="admin-help">Ozon needs its own city id. Leave the match on automatic unless it failed.</p>
          </div>
          <%= submit_tag (order.ozon_error.present? ? "Retry sending to Ozon" : "Send to Ozon"), class: "admin-btn w-full" %>
        <% end %>
      <% else %>
        <p class="admin-muted">Not sent yet. Seallo creates the parcel on Ozon Express when the order is confirmed.</p>
        <% unless order.status.in?(%w[cancelled returned delivered]) || order.sendit_code.present? %>
          <%= button_to "Send to Ozon now", ozon_admin_order_path(order), class: "admin-btn-secondary mt-3 w-full",
                form: { data: { turbo_confirm: "Create the Ozon parcel before confirming the order?" } } %>
        <% end %>
      <% end %>
    </div>
  <% end %>
</section>
