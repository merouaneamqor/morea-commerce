<%# Read-only order for confirmation agents: contact, address and what was ordered. No costs, profit or staff actions. %>
<% content_for :title, "##{@order.number}, Admin" %>
<% confirmation = @order.order_confirmation %>

<div class="admin-page-header">
  <div class="flex items-center gap-2">
    <%= link_to admin_orders_path, class: "admin-back", "aria-label": "Back to orders" do %><%= admin_icon(:back) %><% end %>
    <h1 class="admin-page-header__title">#<%= @order.number %></h1>
    <%= admin_badge(@order.status) %>
  </div>
  <%= link_to t("admin.confirmations.title"), admin_confirmations_path, class: "admin-btn-secondary" %>
</div>

<%= render "import_contact_alert", order: @order, allow_correction: false %>

<div class="grid gap-4 lg:grid-cols-3" data-agent-order>
  <section class="admin-card lg:col-span-2">
    <div class="admin-card__header"><h2 class="admin-card__title">Products</h2></div>
    <ul class="divide-y divide-[#ebebeb] px-4 pb-2">
      <% @order.order_items.each do |item| %>
        <li class="flex items-center justify-between gap-3 py-2 text-[13px]">
          <span><%= item.quantity %> × <%= item.product_name %><% if item.variant_name.present? %> <span class="admin-muted">(<%= item.variant_name %>)</span><% end %></span>
          <span class="tabular-nums"><%= money(item.total_cents, @order.currency) %></span>
        </li>
      <% end %>
    </ul>
    <p class="flex items-center justify-between border-t border-[#ebebeb] px-4 py-3 text-[13px] font-semibold"><span>Total</span><span class="tabular-nums"><%= @order.total_display %></span></p>
  </section>

  <section class="admin-card">
    <div class="admin-card__header"><h2 class="admin-card__title">Customer</h2></div>
    <div class="space-y-1 px-4 pb-4 text-[13px]">
      <p class="font-medium"><%= @order.customer_name %></p>
      <% if @order.customer_phone.present? && !@order.import_contact_issues.include?("phone") %>
        <p><%= link_to @order.customer_phone, "tel:#{@order.customer_phone.to_s.gsub(/[^\d+]/, '')}", class: "admin-link", dir: "ltr" %></p>
      <% else %>
        <p class="admin-muted"><%= @order.customer_phone.presence || admin_blank %></p>
      <% end %>
      <p class="admin-muted"><%= [ @order.customer_address, @order.customer_district, @order.customer_city ].compact_blank.join(", ") %></p>
      <% if @order.notes.present? %><p class="admin-muted"><%= @order.notes %></p><% end %>
      <p class="admin-muted pt-2">
        <% if confirmation&.assigned_user %>
          <%= t("admin.confirmations.assigned", name: confirmation.assigned_user.name.presence || confirmation.assigned_user.email) %>
        <% else %>
          <%= t("admin.confirmations.available") %>
        <% end %>
      </p>
    </div>
  </section>
</div>
