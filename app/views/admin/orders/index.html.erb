<% content_for :title, "Orders — Admin" %>

<div class="mb-8 flex flex-wrap items-center justify-between gap-4">
  <h1 class="text-2xl font-medium">Orders</h1>
  <div class="flex flex-wrap gap-2">
    <%= link_to "All", admin_orders_path, class: "admin-chip #{'is-active' if @status.blank?}" %>
    <% Order::STATUSES.each do |status| %>
      <%= link_to status.humanize, admin_orders_path(status: status), class: "admin-chip #{'is-active' if @status == status}" %>
    <% end %>
  </div>
</div>

<div class="overflow-hidden rounded border border-line bg-paper">
  <table class="admin-table">
    <thead>
      <tr><th>Order</th><th>Customer</th><th>Phone</th><th>City</th><th>Total</th><th>Status</th></tr>
    </thead>
    <tbody>
      <% @orders.each do |order| %>
        <tr>
          <td><%= link_to order.number, admin_order_path(order), class: "underline" %></td>
          <td><%= order.customer_name %></td>
          <td><%= order.customer_phone %></td>
          <td><%= order.customer_city %></td>
          <td><%= order.total_display %></td>
          <td><%= order.status_label %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
