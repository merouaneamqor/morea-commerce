<% content_for :title, "Orders — Admin" %>

<div class="admin-page-header admin-page-header--orders">
  <div class="admin-page-header__row">
    <h1 class="admin-page-header__title">Orders</h1>
    <% unless agent_view? %>
      <%= link_to t("dashboard.create_order"), new_admin_order_path, class: "admin-btn admin-page-header__primary" %>
    <% end %>
  </div>
  <% if agent_view? %>
    <div class="admin-page-header__tools">
      <%= link_to t("admin.confirmations.title"), admin_confirmations_path, class: "admin-btn-secondary" %>
    </div>
  <% elsif @shopify_connections.any? || current_store.sendit_configured? %>
    <div class="admin-page-header__tools">
      <% if @shopify_connections.any? %>
        <%= button_to t("shopify_sync.button"), shopify_sync_all_admin_orders_path, class: "admin-btn-secondary admin-btn--compact", disabled: !Connections::ShopifyOauth.configured? %>
      <% end %>
      <% if current_store.sendit_configured? %>
        <%= button_to t("shopify_sync.sendit_button"), sendit_sync_all_admin_orders_path, class: "admin-btn-secondary admin-btn--compact" %>
      <% end %>
    </div>
  <% end %>
</div>

<% if @shopify_connections.any? && !agent_view? %>
  <% attention_count = @shopify_connections.count { |c| c.last_error_code.present? } %>
  <details class="admin-card admin-sync-panel">
    <summary class="admin-sync-panel__summary">
      <span id="shopify-sync-title" class="admin-sync-panel__title"><%= t("shopify_sync.title") %></span>
      <span class="admin-muted admin-sync-panel__meta">
        <%= t("shopify_sync.summary", count: @shopify_connections.size) %>
        <% if attention_count.positive? %>
          · <%= t("shopify_sync.attention_count", count: attention_count) %>
        <% end %>
      </span>
    </summary>
    <ul class="admin-sync-panel__list">
      <% @shopify_connections.each do |connection| %>
        <li class="admin-sync-panel__item">
          <div class="admin-sync-panel__store">
            <%= link_to connection.name, admin_store_connection_path(connection), class: "admin-link" %>
            <span class="admin-muted"><%= connection_state(connection) %></span>
          </div>
          <%= render "admin/store_connections/shopify_sync_status", connection: connection, compact: true %>
        </li>
      <% end %>
    </ul>
  </details>
<% end %>

<div class="admin-card">
  <%= form_with url: admin_orders_path, method: :get, class: "admin-filter-bar flex flex-wrap items-center gap-3 p-4" do %>
    <%= hidden_field_tag :status, @status %>
    <%= hidden_field_tag :q, params[:q] %>
    <%= hidden_field_tag :attention, params[:attention] if params[:attention] == "delivery_issues" %>
    <%= label_tag :connection_id, t("connections.source"), class: "admin-label" %>
    <%= select_tag :connection_id, options_from_collection_for_select(@connections, :id, :name, params[:connection_id]), include_blank: t("connections.all_sources"), class: "admin-input !w-auto" %>
    <%= hidden_field_tag :group, @group if @group %>
    <% unless agent_view? %>
      <%= select_tag :agent_id, options_for_select([ [ t("admin.orders_groups.unassigned"), "none" ] ] + @agents.map { |a| [ a.name.presence || a.email, a.id ] }, params[:agent_id]), include_blank: t("admin.orders_groups.all_agents"), class: "admin-input !w-auto" %>
    <% end %>
    <%= submit_tag t("connections.filter"), class: "admin-btn-secondary" %>
  <% end %>
  <% if params[:attention] == "delivery_issues" %>
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[#ebebeb] px-4 py-2" role="status">
      <span><%= t("dashboard.filters.delivery_issues") %></span>
      <%= link_to t("dashboard.filters.clear"), admin_orders_path(connection_id: params[:connection_id].presence, q: params[:q].presence), class: "admin-link" %>
    </div>
  <% end %>
  <% keep = { q: params[:q].presence, connection_id: params[:connection_id].presence, agent_id: params[:agent_id].presence } %>
  <nav class="admin-tabs" aria-label="Filter orders">
    <% Admin::OrdersController::ORDER_GROUPS.each_key do |key| %>
      <% active = !@archived && @status.blank? && (@group || "all") == key %>
      <%= link_to admin_orders_path(keep.merge(group: (key unless key == "all"))), class: "admin-tab #{'is-active' if active}" do %>
        <%= t("admin.orders_groups.#{key}") %> <span class="admin-tab__count"><%= @group_counts&.fetch(key) %></span>
      <% end %>
    <% end %>
    <%= link_to "Archived", admin_orders_path(keep.merge(status: "archived")), class: "admin-tab #{'is-active' if @archived}" %>
  </nav>

  <% if params[:q].present? %>
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-[#ebebeb] px-4 py-2 text-[13px]">
      <span class="admin-muted">Results for “<%= params[:q] %>”</span>
      <%= link_to "Clear search", admin_orders_path(status: @status.presence, connection_id: params[:connection_id].presence), class: "admin-btn-plain" %>
    </div>
  <% end %>

  <% if @orders.empty? %>
    <p class="admin-empty">No orders match these filters.</p>
  <% else %>
    <%# Phone: stacked rows so status/amount stay fully visible without sideways scroll. %>
    <ul class="admin-mobile-list md:hidden" data-orders-mobile>
      <% @orders.each do |order| %>
        <li>
          <%= link_to admin_order_path(order), class: "admin-mobile-list__item" do %>
            <div class="admin-mobile-list__top">
              <div class="min-w-0">
                <span class="admin-mobile-list__title">
                  #<%= order.number %>
                  <% if order.contact_review_required? %>
                    <span class="admin-mobile-list__alert" title="<%= t("import_contact.title") %>" aria-label="<%= t("import_contact.title") %>">‼</span>
                  <% end %>
                </span>
                <p class="admin-mobile-list__name" dir="auto"><%= order.customer_name.presence || "—" %></p>
                <p class="admin-mobile-list__meta">
                  <% bits = [ order.customer_city.presence, order.customer_phone.presence ].compact %>
                  <% if bits.any? %><span dir="auto"><%= bits.join(" · ") %></span><% else %>—<% end %>
                </p>
              </div>
              <%= admin_badge(order.status) %>
            </div>
            <p class="admin-mobile-list__amount" dir="ltr"><%= order.total_display %></p>
          <% end %>
        </li>
      <% end %>
    </ul>

    <%# md+: the six columns that matter come first; Order and Customer stay pinned while the rest scrolls. %>
    <div class="admin-table-wrap admin-table-wrap--sticky hidden md:block" data-orders-table>
      <table class="admin-table admin-table--sticky">
        <thead>
          <tr><th>Order</th><th>Customer</th><th>Phone</th><th>City</th><th>Status</th><th class="is-numeric">Amount</th><th><%= t("connections.source") %></th><th>Date</th><th><%= t("admin.orders_groups.agent") %></th><% unless agent_view? %><th>Sendit</th><% end %></tr>
        </thead>
        <tbody>
          <% @orders.each do |order| %>
            <tr data-order-row="<%= order.number %>">
              <td>
                <%= link_to "##{order.number}", admin_order_path(order), class: "admin-link" %>
                <%= render "import_contact_alert", order: order, compact: true %>
                <% if order.tag_list.any? %>
                  <span class="admin-muted ms-1 text-xs"><%= order.tag_list.first(2).join(", ") %></span>
                <% end %>
              </td>
              <td title="<%= order.customer_name %>"><%= order.customer_name.presence || "—" %></td>
              <td class="admin-muted"><%= order.customer_phone.presence || "—" %></td>
              <td class="admin-muted"><%= order.customer_city %></td>
              <td><%= admin_badge(order.status) %></td>
              <td class="is-numeric"><%= order.total_display %></td>
              <td class="admin-muted" data-source><%= order.store_connection&.name || t("admin.orders_groups.manual") %></td>
              <td class="admin-muted"><%= order.created_at.strftime("%b %-d, %H:%M") %></td>
              <% agent = order.order_confirmation&.assigned_user %>
              <td><%= agent ? tag.span(class: "seallo-agent") { tag.i((agent.name.presence || agent.email).first.upcase) + (agent.name.presence || agent.email) } : tag.span(t("admin.orders_groups.unassigned"), class: "admin-subdued") %></td>
              <% unless agent_view? %><td><%= courier_badge(order) || tag.span("—", class: "admin-subdued") %></td><% end %>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
