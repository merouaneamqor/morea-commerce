<% content_for :title, t("carrier_settings.title", carrier: @provider_info["name"]) %>
<% content_for :admin_page_class, "seller-page" %>
<% content_for :seller_lang, "1" %>
<% currency = current_store.currency.to_s.upcase == "DH" ? "MAD" : current_store.currency.to_s.upcase %>

<header class="flex flex-wrap items-start justify-between gap-3">
  <div class="flex items-start gap-3">
    <%= link_to seller_integrations_path, class: "mt-0.5 inline-flex size-10 shrink-0 items-center justify-center rounded-full border border-[#e8e3df] bg-white text-[#1f2430] hover:bg-[#f3f1ef]",
          data: { back_button: true }, "aria-label": t("carrier_settings.back"), title: t("carrier_settings.back") do %>
      <svg viewBox="0 0 24 24" class="size-5 fill-none stroke-current [stroke-width:2] [stroke-linecap:round] [stroke-linejoin:round] rtl:rotate-180" aria-hidden="true"><path d="M19 12H5"/><path d="m12 19-7-7 7-7"/></svg>
    <% end %>
    <div class="flex items-start gap-3">
      <img src="<%= @provider_info["logo"] %>" alt="<%= @provider_info["name"] %>" class="size-11 shrink-0 rounded-full border border-[#f0ebe7] bg-white object-contain p-0.5">
      <div>
        <h1 class="text-2xl font-bold text-[#1f2430] sm:text-[28px]"><%= t("carrier_settings.title", carrier: @provider_info["name"]) %></h1>
        <p class="max-w-2xl text-sm"><%= t("carrier_settings.description", carrier: @provider_info["name"]) %></p>
      </div>
    </div>
  </div>
  <%= render "admin/shared/language_switcher" %>
</header>

<section class="rounded-2xl border border-[#e8e3df] bg-white p-5">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap items-center gap-2">
      <h2 class="text-base font-semibold text-[#1f2430]"><%= t("carrier_settings.connection") %></h2>
      <% if @account&.connected? %>
        <span class="flex items-center gap-1.5 rounded-full bg-[#e3f3e8] px-2.5 py-1 text-xs font-semibold text-[#2f7a4a]"><span class="size-1.5 rounded-full bg-[#2f7a4a]"></span> <%= sl("Connectée") %></span>
      <% else %>
        <span class="rounded-full bg-[#f1eee9] px-2.5 py-1 text-xs font-semibold text-[#8a8380]"><%= sl("Non connectée") %></span>
      <% end %>
    </div>
    <% if @account %>
      <%= link_to t("carrier_settings.manage_connection"), seller_integrations_path(edit_account: @account.id), class: "text-sm font-semibold text-[#a8432e]" %>
    <% else %>
      <%= link_to t("carrier_settings.connect", carrier: @provider_info["name"]), seller_integrations_path(connect: "ozon"), class: "text-sm font-semibold text-[#a8432e]" %>
    <% end %>
  </div>
  <% if @account&.webhook_url.present? %>
    <p class="mt-3 break-all text-xs text-[#8a8380]"><%= t("carrier_settings.webhook_url") %>: <code dir="ltr"><%= @account.webhook_url %></code></p>
  <% end %>
  <% if @account %>
    <p class="mt-2 text-xs text-[#8a8380]">
      <% if @account.cities_count.to_i.positive? %>
        <%= t("seller_integrations.ozon.cities", count: @account.cities_count) %>
      <% else %>
        <%= t("seller_integrations.ozon.cities_pending") %>
      <% end %>
    </p>
    <%= button_to t("carrier_settings.refresh_cities"), refresh_cities_admin_ozon_settings_path, method: :post, class: "mt-3 h-9 rounded-lg border border-[#e8e3df] px-3 text-xs font-semibold text-[#1f2430] hover:border-[#a8432e] hover:text-[#a8432e]" %>
  <% end %>
</section>

<% if @account %>
  <section class="admin-card mt-4 min-w-0" id="ozon-settings">
    <div class="admin-card__header">
      <h3 class="admin-card__title"><%= t("carrier_settings.options") %></h3>
      <p class="admin-help"><%= t("carrier_settings.options_help", carrier: @provider_info["name"]) %></p>
    </div>
    <div class="space-y-4 px-4 pb-4">
      <%= form_with model: @account, scope: :delivery_account, url: admin_ozon_settings_path, method: :patch, class: "space-y-4" do |f| %>
        <div>
          <%= f.label :pickup_city, sl("Ville de ramassage"), class: "admin-label" %>
          <%= f.text_field :pickup_city, class: "admin-input", dir: "auto" %>
        </div>
        <div class="admin-field-grid">
          <div>
            <%= f.label :delivery_fee, "#{sl("Frais par colis livré")} (#{currency})", class: "admin-label" %>
            <%= f.number_field :delivery_fee, class: "admin-input", min: 0, step: 0.01, dir: "ltr" %>
          </div>
          <div>
            <%= f.label :return_fee, "#{sl("Frais par colis retourné")} (#{currency})", class: "admin-label" %>
            <%= f.number_field :return_fee, class: "admin-input", min: 0, step: 0.01, dir: "ltr" %>
          </div>
        </div>
        <label class="admin-check"><%= f.check_box :allow_open %> <%= sl("Ouvrir le colis") %></label>
        <label class="admin-check"><%= f.check_box :is_active %> <%= sl("Compte actif") %></label>
        <%= f.submit t("carrier_settings.save"), class: "admin-btn" %>
      <% end %>
    </div>
  </section>
<% else %>
  <p class="mt-4 rounded-2xl border border-[#e8e3df] bg-white p-5 text-sm"><%= t("carrier_settings.connect_first", carrier: @provider_info["name"]) %></p>
<% end %>
