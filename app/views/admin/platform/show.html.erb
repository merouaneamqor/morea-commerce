<% content_for :title, t("platform_admin.document_title", name: Store.platform_name) %>

<div class="admin-page-header">
  <div class="min-w-0">
    <h1 class="admin-page-header__title"><%= t("platform_admin.title") %></h1>
    <p class="admin-page-header__meta"><%= t("platform_admin.overview_description") %></p>
  </div>
  <div class="platform-toolbar">
    <%= link_to t("platform_admin.new_workspace"), new_admin_tenant_path, class: "admin-btn" %>
    <%= link_to t("platform_admin.requests_count", count: @pending_requests_count), admin_access_requests_path, class: "admin-btn-secondary", data: { access_requests_count: @pending_requests_count } %>
    <%= link_to t("seallo_connect_pages.privacy_rights.admin.title"), admin_platform_privacy_rights_requests_path, class: "admin-btn-secondary" %>
  </div>
</div>

<div class="admin-card mb-4">
  <div class="grid grid-cols-2 divide-[#ebebeb] sm:grid-cols-3 lg:grid-cols-5 lg:divide-x [&>*]:border-[#ebebeb] max-lg:[&>*]:border-b">
    <div class="p-4">
      <p class="admin-metric__label"><%= t("platform_admin.workspaces") %></p>
      <p class="admin-metric__value"><%= @summary.stores_count %></p>
    </div>
    <div class="p-4">
      <p class="admin-metric__label"><%= t("platform_admin.orders") %></p>
      <p class="admin-metric__value"><%= @orders_total %></p>
    </div>
    <div class="p-4">
      <p class="admin-metric__label"><%= t("platform_admin.orders_today") %></p>
      <p class="admin-metric__value"><%= @summary.orders_today_count %></p>
    </div>
    <div class="p-4">
      <p class="admin-metric__label"><%= t("platform_admin.order_value") %></p>
      <% @order_values.each do |currency, cents| %>
        <p class="admin-metric__value" data-platform-order-value="<%= currency %>"><%= dashboard_money(cents, currency) %></p>
      <% end %>
    </div>
    <div class="p-4">
      <p class="admin-metric__label"><%= t("platform_admin.staff") %></p>
      <p class="admin-metric__value"><%= @staff_count %></p>
    </div>
  </div>
  <div class="grid grid-cols-2 divide-[#ebebeb] border-t border-[#ebebeb] sm:grid-cols-4 lg:divide-x [&>*]:border-[#ebebeb] max-sm:[&>*]:border-b">
    <div class="p-4" id="platform-paid">
      <p class="admin-metric__label"><%= t("platform_admin.billing_page.paid_this_month") %></p>
      <p class="admin-metric__value"><%= dashboard_money(@summary.paid_this_month_cents, "MAD") %></p>
    </div>
    <div class="p-4" id="platform-outstanding">
      <p class="admin-metric__label"><%= t("platform_admin.billing_page.outstanding") %></p>
      <p class="admin-metric__value"><%= dashboard_money(@summary.outstanding_cents, "MAD") %></p>
    </div>
    <div class="p-4" id="platform-overdue">
      <p class="admin-metric__label"><%= t("platform_admin.billing_page.overdue", count: @summary.overdue_count) %></p>
      <p class="admin-metric__value"><%= dashboard_money(@summary.overdue_cents, "MAD") %></p>
    </div>
    <div class="p-4">
      <p class="admin-metric__label"><%= t("platform_admin.storefront") %></p>
      <p class="admin-metric__value"><%= @summary.storefronts_count %></p>
    </div>
  </div>
</div>

<%= render "admin/platform/action_queue", action_queue: @action_queue %>

<section class="admin-card" id="workspaces">
  <div class="admin-card__header">
    <h2 class="admin-card__title"><%= t("platform_admin.workspaces") %></h2>
    <%= link_to t("platform_admin.new_workspace"), new_admin_tenant_path, class: "admin-btn-plain" %>
  </div>
  <% if @stores.empty? %>
    <p class="admin-empty"><%= t("platform_admin.no_workspaces") %></p>
  <% else %>
    <ul class="admin-mobile-list lg:hidden">
      <% @stores.each do |store| %>
        <li class="admin-mobile-list__card">
          <div class="admin-mobile-list__top">
            <div>
              <p class="admin-mobile-list__name"><%= link_to store.name, admin_tenant_path(store) %></p>
              <p class="admin-mobile-list__meta"><%= store.slug %></p>
            </div>
            <span class="admin-mobile-list__amount"><%= money(store.billing_amount_cents, "MAD") %></span>
          </div>
          <p class="admin-mobile-list__meta">
            <%= t(store.storefront_enabled? ? "platform_admin.storefront_enabled" : "platform_admin.storefront_disabled") %>
            · <%= store.billing_status.humanize %>
            · <%= t("platform_admin.staff") %> <%= store.users.size %>
            · <%= t("platform_admin.orders") %> <%= store.orders.count %>
          </p>
          <%= render "admin/platform/workspace_actions", store: store %>
        </li>
      <% end %>
    </ul>

    <div class="admin-table-wrap hidden lg:block">
      <table class="admin-table">
        <thead>
          <tr>
            <th><%= t("platform_admin.workspace") %></th>
            <th><%= t("platform_admin.storefront") %></th>
            <th><%= t("platform_admin.slug") %></th>
            <th><%= t("platform_admin.billing") %></th>
            <th><%= t("platform_admin.amount") %></th>
            <th><%= t("platform_admin.status") %></th>
            <th><%= t("platform_admin.period_ends") %></th>
            <th><%= t("platform_admin.staff") %></th>
            <th><%= t("platform_admin.orders") %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @stores.each do |store| %>
            <tr>
              <td class="font-semibold"><%= link_to store.name, admin_tenant_path(store) %></td>
              <td><%= t(store.storefront_enabled? ? "platform_admin.storefront_enabled" : "platform_admin.storefront_disabled") %></td>
              <td class="admin-muted tabular-nums"><%= store.slug %></td>
              <td><%= store.billing_interval.humanize %></td>
              <td class="tabular-nums"><%= money(store.billing_amount_cents, "MAD") %></td>
              <td><%= store.billing_status.humanize %></td>
              <td class="admin-muted">
                <%= store.billing_period_ends_on&.strftime("%b %-d, %Y") || t("platform_admin.no_date") %>
              </td>
              <td class="tabular-nums"><%= store.users.size %></td>
              <td class="tabular-nums"><%= store.orders.count %></td>
              <td><%= render "admin/platform/workspace_actions", store: store %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <% @stores.each do |store| %>
      <%= render "admin/platform/impersonate_popover", store: store %>
    <% end %>
  <% end %>
</section>
