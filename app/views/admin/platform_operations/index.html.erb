<% content_for :title, t("platform_admin.operations.title") %>

<div class="admin-page-header">
  <div class="min-w-0">
    <h1 class="admin-page-header__title"><%= t("platform_admin.operations.title") %></h1>
    <p class="admin-page-header__meta"><%= t("platform_admin.operations.description") %></p>
  </div>
  <% if @redis_available && @dead_jobs.any? %>
    <div class="platform-toolbar">
      <% if @orphan_count.positive? %>
        <%= button_to t("platform_admin.operations.clear_orphans", count: @orphan_count),
              clear_orphans_admin_platform_operations_path,
              method: :delete,
              class: "admin-btn",
              form: { data: { turbo_confirm: t("platform_admin.operations.clear_orphans_confirm", count: @orphan_count) } } %>
      <% end %>
      <%= button_to t("platform_admin.operations.clear_dead"),
            clear_dead_admin_platform_operations_path,
            method: :delete,
            class: "admin-btn-secondary",
            form: { data: { turbo_confirm: t("platform_admin.operations.clear_dead_confirm") } } %>
    </div>
  <% end %>
</div>

<% unless @redis_available %>
  <div class="admin-banner admin-banner--critical mb-4" data-redis-unavailable="true"><%= t("platform_admin.operations.redis_unavailable") %></div>
<% end %>

<% if @orphan_count.to_i.positive? %>
  <div class="admin-banner admin-banner--warning mb-4" data-orphan-jobs="<%= @orphan_count %>">
    <%= t("platform_admin.operations.orphan_help", count: @orphan_count) %>
  </div>
<% end %>

<section class="admin-card mb-4" data-platform-operations-dead>
  <div class="admin-card__header">
    <h2 class="admin-card__title"><%= t("platform_admin.operations.failed_jobs") %></h2>
  </div>
  <% if @dead_jobs.empty? %>
    <p class="admin-empty"><%= t("platform_admin.operations.empty_jobs") %></p>
  <% else %>
    <ul class="admin-mobile-list lg:hidden">
      <% @dead_jobs.each do |job| %>
        <li class="admin-mobile-list__card" data-job-set="dead" data-job-class="<%= job.class_name %>" data-job-orphan="<%= job.orphan %>">
          <div class="admin-mobile-list__top">
            <div>
              <p class="admin-mobile-list__name"><%= job.class_name %></p>
              <p class="admin-mobile-list__meta">
                <%= job.queue %>
                <% if job.orphan %> · <%= t("platform_admin.operations.orphan_badge") %><% end %>
              </p>
            </div>
            <span class="admin-mobile-list__amount admin-muted"><%= job.failed_at&.strftime("%b %-d, %Y %H:%M") || admin_blank %></span>
          </div>
          <p class="admin-mobile-list__meta">
            <% if job.store_id.present? %>
              <%= link_to (job.store_name.presence || t("platform_admin.operations.unknown_workspace", id: job.store_id)), admin_tenant_path(job.store_id) %>
            <% else %>
              <%= admin_blank %>
            <% end %>
            · <%= job.error.presence || admin_blank %>
          </p>
          <div class="admin-mobile-list__actions">
            <%= button_to t("platform_admin.operations.delete_job"),
                  destroy_dead_admin_platform_operations_path(jid: job.jid),
                  method: :delete,
                  class: "admin-btn-plain",
                  form: { data: { turbo_confirm: t("platform_admin.operations.delete_job_confirm") } } %>
          </div>
        </li>
      <% end %>
    </ul>

    <div class="admin-table-wrap hidden lg:block">
      <table class="admin-table">
        <thead>
          <tr>
            <th><%= t("platform_admin.operations.columns.job") %></th>
            <th><%= t("platform_admin.operations.columns.queue") %></th>
            <th><%= t("platform_admin.operations.columns.workspace") %></th>
            <th><%= t("platform_admin.operations.columns.error") %></th>
            <th><%= t("platform_admin.operations.columns.when") %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @dead_jobs.each do |job| %>
            <tr data-job-set="dead" data-job-class="<%= job.class_name %>" data-job-orphan="<%= job.orphan %>">
              <td class="font-semibold">
                <%= job.class_name %>
                <% if job.orphan %>
                  <span class="admin-muted block text-[13px]"><%= t("platform_admin.operations.orphan_badge") %></span>
                <% end %>
              </td>
              <td class="admin-muted"><%= job.queue %></td>
              <td>
                <% if job.store_id.present? %>
                  <%= link_to (job.store_name.presence || t("platform_admin.operations.unknown_workspace", id: job.store_id)), admin_tenant_path(job.store_id) %>
                <% else %>
                  <%= admin_blank %>
                <% end %>
              </td>
              <td class="admin-muted"><%= job.error.presence || admin_blank %></td>
              <td class="admin-muted"><%= job.failed_at&.strftime("%b %-d, %Y %H:%M") || admin_blank %></td>
              <td class="text-right">
                <%= button_to t("platform_admin.operations.delete_job"),
                      destroy_dead_admin_platform_operations_path(jid: job.jid),
                      method: :delete,
                      class: "admin-btn-plain",
                      form: { data: { turbo_confirm: t("platform_admin.operations.delete_job_confirm") } } %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>

