<section class="admin-card">
  <div class="admin-card__header">
    <h2 class="admin-card__title"><%= t("platform_admin.operations.webhook_failures") %></h2>
  </div>
  <% if @webhook_failures.empty? %>
    <p class="admin-empty"><%= t("platform_admin.operations.empty_webhooks") %></p>
  <% else %>
    <ul class="admin-mobile-list lg:hidden">
      <% @webhook_failures.each do |connection| %>
        <% error_code = connection.shopify_api_error_code.presence || connection.last_error_code %>
        <li class="admin-mobile-list__card" data-connection-id="<%= connection.id %>" data-error-code="<%= error_code %>">
          <div class="admin-mobile-list__top">
            <div>
              <p class="admin-mobile-list__name"><%= connection.store.name %></p>
              <p class="admin-mobile-list__meta"><%= connection.provider.humanize %> · <span dir="ltr"><%= connection.external_domain %></span></p>
            </div>
            <span class="admin-mobile-list__amount admin-muted"><%= error_code %></span>
          </div>
          <div class="admin-mobile-list__actions">
            <%= link_to t("platform_admin.integrations.view"), admin_platform_integration_path(connection.store), class: "admin-btn-plain" %>
          </div>
        </li>
      <% end %>
    </ul>

    <div class="admin-table-wrap hidden lg:block">
      <table class="admin-table">
        <thead>
          <tr>
            <th><%= t("platform_admin.workspace") %></th>
            <th><%= t("platform_admin.operations.columns.connection") %></th>
            <th><%= t("platform_admin.operations.columns.code") %></th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @webhook_failures.each do |connection| %>
            <% error_code = connection.shopify_api_error_code.presence || connection.last_error_code %>
            <tr data-connection-id="<%= connection.id %>" data-error-code="<%= error_code %>">
              <td class="font-semibold"><%= connection.store.name %></td>
              <td><%= connection.provider.humanize %> · <span dir="ltr"><%= connection.external_domain %></span></td>
              <td class="admin-muted"><%= error_code %></td>
              <td><%= link_to t("platform_admin.integrations.view"), admin_platform_integration_path(connection.store), class: "admin-btn-plain" %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>
