<% content_for :title, t("platform_admin.operations.title") %>

<div class="admin-page-header">
  <div>
    <h1 class="admin-page-header__title"><%= t("platform_admin.operations.title") %></h1>
    <p class="admin-page-header__meta"><%= t("platform_admin.operations.description") %></p>
  </div>
</div>

<% unless @redis_available %>
  <div class="admin-banner admin-banner--critical mb-4" data-redis-unavailable="true"><%= t("platform_admin.operations.redis_unavailable") %></div>
<% end %>

<section class="admin-card mb-4" data-platform-operations-dead>
  <div class="admin-card__header">
    <h2 class="admin-card__title"><%= t("platform_admin.operations.failed_jobs") %></h2>
  </div>
  <% if @dead_jobs.empty? %>
    <p class="admin-empty"><%= t("platform_admin.operations.empty_jobs") %></p>
  <% else %>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th><%= t("platform_admin.operations.columns.job") %></th>
            <th><%= t("platform_admin.operations.columns.queue") %></th>
            <th><%= t("platform_admin.operations.columns.workspace") %></th>
            <th><%= t("platform_admin.operations.columns.error") %></th>
            <th><%= t("platform_admin.operations.columns.when") %></th>
          </tr>
        </thead>
        <tbody>
          <% @dead_jobs.each do |job| %>
            <tr data-job-set="dead" data-job-class="<%= job.class_name %>">
              <td class="font-semibold"><%= job.class_name %></td>
              <td class="admin-muted"><%= job.queue %></td>
              <td>
                <% if job.store_id.present? %>
                  <%= link_to (job.store_name.presence || t("platform_admin.operations.unknown_workspace", id: job.store_id)), admin_tenant_path(job.store_id) %>
                <% else %>
                  <%= admin_blank %>
                <% end %>
              </td>
              <td class="admin-muted"><%= job.error.presence || admin_blank %></td>
              <td class="admin-muted"><%= job.failed_at&.strftime("%b %-d, %Y %H:%M") || admin_blank %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</section>

