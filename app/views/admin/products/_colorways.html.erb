<section class="admin-card">
  <div class="admin-card__header"><h2 class="admin-card__title">Colorways</h2></div>
  <div class="space-y-4 px-4 pb-4" data-controller="colorway" data-colorway-preview-url-value="<%= preview_admin_product_colorways_path(@product) %>">
    <p class="admin-help">
      Dye the garment and leave the photo alone: skin, hair, backdrop, and accessories stay as shot.
      Folds and shading stay in the fabric. Name the colorway the same as the variant color so the product page can swap photos.
      Click the outfit if the mask picks up something else. Small logos stay. Glass and strong reflections are a poor fit.
    </p>

    <% if @product.images.attached? %>
      <%= form_with url: admin_product_colorways_path(@product), data: { colorway_target: "form" }, class: "space-y-4" do %>
        <div class="admin-media-grid">
          <% @product.ordered_images.each_with_index do |image, index| %>
            <label class="admin-media-item cursor-pointer">
              <%= radio_button_tag :attachment_id, image.id, index.zero?,
                    class: "absolute start-1.5 top-1.5 z-10 h-4 w-4 accent-[#303030]",
                    data: { action: "change->colorway#selectSource", colorway_url: media_url(image) } %>
              <%= image_tag MediaUrl.sized(media_url(image), width: 320), alt: "" %>
              <span class="admin-media-item__bar"><%= index.zero? ? "Main" : "##{index + 1}" %></span>
            </label>
          <% end %>
        </div>

        <div class="colorway-stage">
          <img src="<%= media_url(@product.ordered_images.first) %>" alt="Click the garment" data-colorway-target="stage" data-action="click->colorway#addPoint">
          <div class="colorway-dots" data-colorway-target="dots"></div>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <%= hidden_field_tag :points, "[]", data: { colorway_target: "points" } %>
          <button type="button" class="admin-btn-secondary" data-action="colorway#clearPoints">Clear clicks</button>
          <span class="admin-help">Clicks are optional. Use them to keep one piece, such as the top.</span>
        </div>

        <div>
          <label class="admin-label" for="colorway-prompt">What should be recolored?</label>
          <%= text_field_tag :prompt, "the matching workout set", id: "colorway-prompt", class: "admin-input", maxlength: 160 %>
        </div>

        <div class="flex flex-wrap gap-2">
          <% Recolor::PRESETS.each do |preset| %>
            <button type="button" class="admin-btn-secondary" data-action="colorway#preset" data-hex="<%= preset[:hex].downcase %>" data-name="<%= preset[:name] %>">
              <span class="me-1 inline-block h-3 w-3 rounded-full align-middle" style="background: <%= preset[:hex] %>"></span>
              <%= preset[:name] %>
            </button>
          <% end %>
        </div>

        <div class="admin-field-grid">
          <div>
            <label class="admin-label" for="colorway-name">Color name</label>
            <%= text_field_tag :name, "Baby pink", id: "colorway-name", class: "admin-input", required: true, maxlength: 60, data: { colorway_target: "name" } %>
          </div>
          <div>
            <label class="admin-label" for="colorway-hex">Color</label>
            <input type="color" name="hex" id="colorway-hex" value="#f4c2c2" class="admin-input h-10 w-20 p-1" data-colorway-target="hex">
          </div>
        </div>

        <div class="flex flex-wrap gap-2">
          <button type="button" class="admin-btn-secondary" data-colorway-target="submit" data-action="colorway#preview">Preview</button>
          <button type="submit" class="admin-btn" data-colorway-target="submit" data-turbo-submits-with="Saving…">Save colorway</button>
        </div>
      <% end %>

      <div class="space-y-3" data-colorway-target="results" hidden>
        <p class="admin-help" data-colorway-target="report"></p>
        <div class="grid gap-3 sm:grid-cols-3">
          <figure>
            <img alt="Original" data-colorway-target="original" class="w-full rounded-lg bg-[#f7f7f7]">
            <figcaption class="admin-help">Original</figcaption>
          </figure>
          <figure>
            <img alt="Product mask" data-colorway-target="mask" class="w-full rounded-lg bg-[#f7f7f7]">
            <figcaption class="admin-help">Product mask</figcaption>
          </figure>
          <figure>
            <img alt="Recolored" data-colorway-target="result" class="w-full rounded-lg bg-[#f7f7f7]">
            <figcaption class="admin-help">Recolored</figcaption>
          </figure>
        </div>
      </div>
    <% else %>
      <p class="admin-help">Upload a product photo first, then you can recolor the garment.</p>
    <% end %>

    <% colorways = @product.product_colorways.includes(image_attachment: :blob).order(:name, :id) %>
    <% if colorways.any? %>
      <ul class="admin-media-grid">
        <% colorways.each do |colorway| %>
          <li class="admin-media-item admin-media-item--pending">
            <% if colorway.image.attached? %>
              <%= image_tag MediaUrl.sized(media_url(colorway.image), width: 320), alt: colorway.name %>
            <% end %>
            <div class="admin-media-item__bar flex-wrap">
              <span class="inline-block h-3 w-3 rounded-full" style="background: <%= colorway.hex %>"></span>
              <%= colorway.name %>
              <%= button_to "Remove", admin_product_colorway_path(@product, colorway), method: :delete,
                    form: { class: "inline", data: { turbo_confirm: "Remove the #{colorway.name} colorway?" } },
                    class: "admin-btn-plain admin-btn-plain--critical" %>
            </div>
          </li>
        <% end %>
      </ul>
      <p class="admin-help">Saved dyes are stored next to the original. The original file is not replaced.</p>
    <% end %>
  </div>
</section>
