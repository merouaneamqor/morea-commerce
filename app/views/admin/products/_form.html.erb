<% content_for :title, (@product.persisted? ? @product.name : "Add product") + " — Admin" %>

<div class="admin-page-header">
  <div class="flex items-center gap-2">
    <%= link_to admin_products_path, class: "admin-back", "aria-label": "Back to products" do %><%= admin_icon(:back) %><% end %>
    <h1 class="admin-page-header__title">
      <%= @product.persisted? ? @product.name : "Add product" %>
      <% if @product.persisted? %><%= admin_badge(@product.status) %><% end %>
    </h1>
  </div>
  <div class="flex items-center gap-2">
    <% if @product.persisted? && @product.status == "active" %>
      <%= link_to "Preview", product_path(@product, locale: :fr), class: "admin-btn-secondary", target: "_blank", rel: "noopener" %>
    <% end %>
    <button type="submit" form="product-form" class="admin-btn">Save</button>
  </div>
</div>

<%= form_with model: [:admin, @product], id: "product-form" do |f| %>
  <% if @product.errors.any? %>
    <div class="admin-banner admin-banner--critical"><%= @product.errors.full_messages.to_sentence %></div>
  <% end %>

  <div class="admin-layout">
    <div class="admin-stack">
      <%= render "translations_fields", f: f %>

      <section class="admin-card">
        <div class="admin-card__header"><h2 class="admin-card__title">Media</h2></div>
        <div class="space-y-4 px-4 pb-4">
          <div class="admin-product-media space-y-4" data-controller="media">
            <div class="admin-media-toolbar">
              <span class="admin-help" data-media-target="selectionCount" aria-live="polite">Drag to reorder. First image is featured.</span>
              <div class="flex gap-2">
                <button type="button" class="admin-btn-secondary" data-media-target="mainButton" data-action="media#makeMain" disabled>Set as main</button>
                <button type="button" class="admin-btn-secondary" data-media-target="removeButton" data-action="media#removeSelected" disabled>Remove</button>
              </div>
            </div>
              <ul class="admin-media-grid" data-media-target="list" data-action="dragover->media#dragOver drop->media#drop">
                <% @product.ordered_images.each do |image| %>
                  <li class="admin-media-item" draggable="true" data-media-target="item"
                      data-action="dragstart->media#dragStart dragend->media#dragEnd">
                    <%= hidden_field_tag "product[image_order][]", image.id, id: nil %>
                    <button type="button" class="admin-media-preview" data-action="media#preview" aria-label="Preview <%= image.filename %>">
                      <%= image_tag MediaUrl.sized(media_url(image), width: 640), alt: image.filename.to_s, draggable: false %>
                    </button>
                    <span class="admin-media-item__main">Featured</span>
                    <input type="checkbox" class="admin-media-select" aria-label="Select <%= image.filename %>" data-action="change->media#selectionChanged">
                    <span class="admin-media-item__bar">
                      <button type="button" class="admin-media-item__btn" data-action="media#moveEarlier" aria-label="Move earlier">←</button>
                      <span class="admin-media-filename" title="<%= image.filename %>"><%= image.filename %></span>
                      <button type="button" class="admin-media-item__btn" data-action="media#moveLater" aria-label="Move later">→</button>
                    </span>
                  </li>
                <% end %>
              </ul>
            <div data-media-target="removals"></div>
            <p class="admin-help" data-media-target="undoNotice" hidden>Images will be removed when you save. <button type="button" class="admin-btn-plain" data-action="media#undoRemove">Undo</button></p>

            <label class="admin-dropzone" data-media-target="zone"
                   data-action="dragover->media#zoneOver dragleave->media#zoneLeave drop->media#zoneDrop">
              <span class="admin-btn-secondary pointer-events-none">Upload new</span>
              <span class="admin-help">Drop images here, or click to upload</span>
              <%= f.file_field :images, multiple: true, direct_upload: false, accept: "image/*", class: "sr-only",
                    data: { media_target: "input", action: "change->media#addFiles" } %>
            </label>
            <ul class="admin-media-grid empty:hidden" data-media-target="previews"></ul>
            <dialog class="admin-media-dialog admin-media-viewer" data-media-target="viewer" aria-label="Image preview">
              <div class="admin-media-dialog__header"><h2>Image preview</h2><button type="button" class="admin-media-close" data-action="media#closePreview" aria-label="Close preview">×</button></div>
              <img data-media-target="viewerImage" alt="">
            </dialog>
          </div>
        </div>
      </section>

      <section class="admin-card">
        <div class="admin-card__header"><h2 class="admin-card__title">Pricing</h2></div>
        <div class="admin-field-grid px-4 pb-4">
          <div>
            <%= f.label :price_dh, "Price", class: "admin-label" %>
            <%= f.number_field :price_dh, class: "admin-input", required: true, min: 0 %>
          </div>
          <div>
            <%= f.label :compare_at_dh, "Compare-at price", class: "admin-label" %>
            <%= f.number_field :compare_at_dh, class: "admin-input", min: 0 %>
          </div>
          <div>
            <%= f.label :cost_dh, "Cost per unit", class: "admin-label" %>
            <%= f.number_field :cost_dh, class: "admin-input", min: 0 %>
            <p class="admin-help">Your purchase cost. Used for net profit; copied onto each new order.</p>
          </div>
        </div>
      </section>

      <section class="admin-card">
        <div class="admin-card__header"><h2 class="admin-card__title">Inventory</h2></div>
        <div class="space-y-4 px-4 pb-4">
          <label class="admin-check"><%= f.check_box :track_inventory %> Track quantity</label>
          <div class="admin-field-grid">
            <div>
              <%= f.label :stock, "Quantity", class: "admin-label" %>
              <%= f.number_field :stock, class: "admin-input", min: 0 %>
            </div>
            <div>
              <%= f.label :sku, "SKU (Stock Keeping Unit)", class: "admin-label" %>
              <%= f.text_field :sku, class: "admin-input" %>
            </div>
          </div>
        </div>
      </section>

    </div>

    <div class="admin-stack">
      <section class="admin-card">
        <div class="admin-card__header"><h2 class="admin-card__title">Status</h2></div>
        <div class="px-4 pb-4">
          <%= f.select :status, Product::STATUSES.map { |s| [s.humanize, s] }, {}, class: "admin-input" %>
        </div>
      </section>

      <section class="admin-card">
        <div class="admin-card__header"><h2 class="admin-card__title">Product organization</h2></div>
        <div class="space-y-4 px-4 pb-4">
          <div>
            <p class="admin-label">Collections</p>
            <div class="space-y-2">
              <%= f.collection_check_boxes :collection_ids, current_store.collections.order(:name), :id, :name do |b| %>
                <label class="admin-check"><%= b.check_box %> <%= b.text %></label>
              <% end %>
            </div>
          </div>
          <label class="admin-check"><%= f.check_box :featured %> Featured on home page</label>
        </div>
      </section>

      <section class="admin-card">
        <div class="admin-card__header"><h2 class="admin-card__title">Search engine listing</h2></div>
        <div class="px-4 pb-4">
          <%= f.label :slug, "URL handle", class: "admin-label" %>
          <%= f.text_field :slug, class: "admin-input" %>
          <p class="admin-help">morea.website/fr/products/<%= @product.slug.presence || "…" %></p>
        </div>
      </section>
    </div>
  </div>
<% end %>

<% if @product.persisted? %>
  <%# Separate forms keep product and variant saves valid and predictable. %>
  <div class="admin-layout mt-4"><div><%= render "variants", product: @product %></div></div>
  <div class="admin-layout mt-4">
    <section class="admin-card">
      <div class="admin-card__header"><h2 class="admin-card__title">Inventory history</h2></div>
      <%= form_with url: admin_product_inventory_index_path(@product), method: :post, class: "space-y-3 border-b border-[#ebebeb] px-4 pb-4" do %>
        <p class="admin-label">Manual adjustment</p>
        <div class="admin-field-grid">
          <% if @product.product_variants.any? %>
            <div>
              <label class="admin-label" for="product_variant_id">Apply to</label>
              <select name="product_variant_id" id="product_variant_id" class="admin-input">
                <option value="">Product stock</option>
                <% @product.product_variants.order(:id).each do |variant| %>
                  <option value="<%= variant.id %>"><%= variant.display_name %> (<%= variant.stock %>)</option>
                <% end %>
              </select>
            </div>
          <% end %>
          <div>
            <label class="admin-label" for="quantity">Quantity change</label>
            <%= number_field_tag :quantity, nil, class: "admin-input", required: true, placeholder: "+5 or -2" %>
          </div>
          <div>
            <label class="admin-label" for="reason">Reason</label>
            <%= select_tag :reason,
                  options_for_select([
                    [ "Manual adjustment", "manual_adjustment" ],
                    [ "Received stock", "received" ],
                    [ "Damaged / loss", "damaged" ],
                    [ "Correction", "correction" ]
                  ]),
                  class: "admin-input" %>
          </div>
          <div>
            <label class="admin-label" for="note">Note</label>
            <%= text_field_tag :note, nil, class: "admin-input", placeholder: "Optional" %>
          </div>
        </div>
        <%= submit_tag "Adjust stock", class: "admin-btn-secondary" %>
      <% end %>

      <% if @inventory_movements&.any? %>
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead><tr><th>When</th><th>Change</th><th>Reason</th><th>Note</th></tr></thead>
            <tbody>
              <% @inventory_movements.each do |movement| %>
                <tr>
                  <td class="admin-muted"><%= movement.created_at.strftime("%b %-d, %Y %H:%M") %></td>
                  <td class="tabular-nums <%= movement.quantity.negative? ? "text-red-700" : "text-green-700" %>">
                    <%= movement.quantity.positive? ? "+" : "" %><%= movement.quantity %>
                    <% if movement.product_variant %><span class="admin-muted"> · <%= movement.product_variant.display_name %></span><% end %>
                  </td>
                  <td><%= movement.reason.to_s.humanize %></td>
                  <td class="admin-muted"><%= movement.note.presence || "—" %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="admin-empty">No movements yet. Confirming or cancelling orders writes history here.</p>
      <% end %>
    </section>
  </div>

  <div class="mt-6 flex justify-between border-t border-[#e3e3e3] pt-4">
    <%= button_to "Delete product", admin_product_path(@product), method: :delete, form: { data: { turbo_confirm: "Delete this product?" } }, class: "admin-btn-critical" %>
    <button type="submit" form="product-form" class="admin-btn">Save</button>
  </div>
<% end %>
