<%# Garment measurements for the storefront size advisor and size guide. %>
<% chart = Storefront::SizeChart.normalize(product.size_chart) %>
<% sizes = product.variant_sizes.presence || ProductVariant::SIZE_OPTIONS %>
<% parts = chart["parts"] %>
<% set_mode = parts.size >= 2 %>
<% top_part = parts.find { |part| part["garment"] == "tops" } || parts[0] || { "label" => "Top", "rows" => [] } %>
<% bottom_part = parts.find { |part| part["garment"] == "bottoms" } || parts[1] || { "label" => "Bottom", "rows" => [] } %>
<% single_rows_by_size = chart["rows"].index_by { |row| row["size"].to_s.upcase } %>
<% top_rows_by_size = Array(top_part["rows"]).index_by { |row| row["size"].to_s.upcase } %>
<% bottom_rows_by_size = Array(bottom_part["rows"]).index_by { |row| row["size"].to_s.upcase } %>

<section class="admin-card" data-controller="size-chart-admin">
  <div class="admin-card__header">
    <h2 class="admin-card__title">Size chart</h2>
  </div>
  <div class="space-y-4 px-4 pb-4">
    <p class="admin-help">Used by Size guide and Find my size on the product page. Leave rows blank to use profile defaults for this product’s sizes. Enter finished garment centimetres, not body measures. For sets, choose flat if you measure side to side on a table.</p>

    <div class="admin-field-grid">
      <div>
        <label class="admin-label" for="product_size_chart_profile">Sizing profile</label>
        <%= select_tag "product[size_chart][profile]",
              options_for_select(Storefront::SizeChart::PROFILES.map { |p| [p.humanize, p] }, chart["profile"]),
              id: "product_size_chart_profile", class: "admin-input" %>
      </div>
      <div>
        <label class="admin-label" for="product_size_chart_cut">How it’s cut</label>
        <%= select_tag "product[size_chart][cut]",
              options_for_select(Storefront::SizeChart::CUTS.map { |c| [c.humanize, c] }, chart["cut"]),
              id: "product_size_chart_cut", class: "admin-input" %>
      </div>
      <div>
        <label class="admin-label" for="product_size_chart_basis">How you measure</label>
        <%= select_tag "product[size_chart][basis]",
              options_for_select([
                [ "Circumference (full tour)", "circumference" ],
                [ "Flat (laid flat, side to side)", "flat" ]
              ], chart["basis"]),
              id: "product_size_chart_basis", class: "admin-input" %>
      </div>
      <div>
        <label class="admin-label" for="product_size_chart_mode">Product shape</label>
        <select id="product_size_chart_mode" class="admin-input" data-size-chart-admin-target="mode" data-action="change->size-chart-admin#toggle">
          <option value="single" <%= "selected" unless set_mode %>>Single piece</option>
          <option value="set" <%= "selected" if set_mode %>>Two-piece set</option>
        </select>
      </div>
    </div>

    <div data-size-chart-admin-target="single" <%= "hidden" if set_mode %>>
      <div class="mb-3">
        <label class="admin-label" for="product_size_chart_garment">Garment type</label>
        <%= select_tag "product[size_chart][garment]",
              options_for_select([
                [ "Tops (chest, hem/waist, hips, length)", "tops" ],
                [ "Bottoms (waist, hips, length)", "bottoms" ]
              ], chart["garment"]),
              id: "product_size_chart_garment", class: "admin-input" %>
      </div>

      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Size</th>
              <th>Chest</th>
              <th>Waist / hem</th>
              <th>Hips</th>
              <th>Length</th>
            </tr>
          </thead>
          <tbody>
            <% sizes.each do |size| %>
              <% row = single_rows_by_size[size.to_s.upcase] || { "size" => size } %>
              <tr>
                <td>
                  <%= hidden_field_tag "product[size_chart][rows][][size]", size %>
                  <span class="font-medium"><%= size %></span>
                </td>
                <% %w[chest waist hips length].each do |measure| %>
                  <td>
                    <%= number_field_tag "product[size_chart][rows][][#{measure}]",
                          row[measure],
                          class: "admin-input",
                          min: 0,
                          step: 0.5,
                          placeholder: "—" %>
                  </td>
                <% end %>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="space-y-6" data-size-chart-admin-target="set" <%= "hidden" unless set_mode %>>
      <div>
        <div class="mb-2 flex flex-wrap items-end justify-between gap-3">
          <div>
            <p class="admin-label">Top</p>
            <p class="admin-help">Chest, hem (waist column), optional hips, length.</p>
          </div>
          <div class="min-w-[12rem]">
            <label class="admin-label" for="product_size_chart_part_top_label">Label on guide</label>
            <input type="text"
                   name="product[size_chart][parts][0][label]"
                   id="product_size_chart_part_top_label"
                   value="<%= top_part["label"].presence || "Top" %>"
                   class="admin-input">
          </div>
        </div>
        <input type="hidden" name="product[size_chart][parts][0][key]" value="top">
        <input type="hidden" name="product[size_chart][parts][0][garment]" value="tops">
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Size</th>
                <th>Chest</th>
                <th>Hem</th>
                <th>Hips</th>
                <th>Length</th>
              </tr>
            </thead>
            <tbody>
              <% sizes.each_with_index do |size, index| %>
                <% row = top_rows_by_size[size.to_s.upcase] || { "size" => size } %>
                <tr>
                  <td>
                    <input type="hidden" name="product[size_chart][parts][0][rows][<%= index %>][size]" value="<%= size %>">
                    <span class="font-medium"><%= size %></span>
                  </td>
                  <% %w[chest waist hips length].each do |measure| %>
                    <td>
                      <input type="number"
                             name="product[size_chart][parts][0][rows][<%= index %>][<%= measure %>]"
                             value="<%= row[measure] %>"
                             class="admin-input"
                             min="0"
                             step="0.5"
                             placeholder="—">
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>

      <div>
        <div class="mb-2 flex flex-wrap items-end justify-between gap-3">
          <div>
            <p class="admin-label">Bottom</p>
            <p class="admin-help">Waist, hips, length.</p>
          </div>
          <div class="min-w-[12rem]">
            <label class="admin-label" for="product_size_chart_part_bottom_label">Label on guide</label>
            <input type="text"
                   name="product[size_chart][parts][1][label]"
                   id="product_size_chart_part_bottom_label"
                   value="<%= bottom_part["label"].presence || "Bottom" %>"
                   class="admin-input">
          </div>
        </div>
        <input type="hidden" name="product[size_chart][parts][1][key]" value="bottom">
        <input type="hidden" name="product[size_chart][parts][1][garment]" value="bottoms">
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Size</th>
                <th>Waist</th>
                <th>Hips</th>
                <th>Length</th>
              </tr>
            </thead>
            <tbody>
              <% sizes.each_with_index do |size, index| %>
                <% row = bottom_rows_by_size[size.to_s.upcase] || { "size" => size } %>
                <tr>
                  <td>
                    <input type="hidden" name="product[size_chart][parts][1][rows][<%= index %>][size]" value="<%= size %>">
                    <span class="font-medium"><%= size %></span>
                  </td>
                  <% %w[waist hips length].each do |measure| %>
                    <td>
                      <input type="number"
                             name="product[size_chart][parts][1][rows][<%= index %>][<%= measure %>]"
                             value="<%= row[measure] %>"
                             class="admin-input"
                             min="0"
                             step="0.5"
                             placeholder="—">
                    </td>
                  <% end %>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</section>
