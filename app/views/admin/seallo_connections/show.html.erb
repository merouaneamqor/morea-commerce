<h1 class="admin-page-title"><%= t("seallo_connect.title") %></h1>
<section class="admin-card p-5 space-y-3">
  <h2 class="admin-card__title"><%= current_store.name %></h2>
  <p><%= t("seallo_connect.instructions") %></p>
  <p><%= t("seallo_connect.import_help") %></p>
  <%= link_to t("seallo_connect.privacy.link"), admin_shopify_privacy_requests_path, class: "admin-btn-secondary" %>
</section>
<% @connections.each do |connection| %>
  <section class="admin-card p-5 mt-4">
    <%= link_to connection.name, admin_store_connection_path(connection), class: "font-semibold" %>
    <p><%= t("seallo_connect.connection_states.#{connection.connection_state}") %> · <%= t("seallo_connect.sync_states.#{connection.shopify_sync_state || 'waiting'}") %></p>
  </section>
<% end %>
