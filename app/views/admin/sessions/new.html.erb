<% content_for :localized, "1" %>
<% content_for :title, t("sign_in.page_title", name: current_store&.name.presence || Store.platform_name) %>
<% content_for :back_label, t("sign_in.back") %>
<% content_for :topbar do %>
  <nav class="flex items-center gap-2" aria-label="<%= t("sign_in.language") %>">
    <% Morea::Locales::AVAILABLE.each do |locale| %>
      <%= link_to locale.to_s.upcase, admin_login_path(locale: locale),
            class: (locale.to_s == I18n.locale.to_s ? "font-semibold text-white" : "fx-link"),
            "aria-current": (locale.to_s == I18n.locale.to_s ? "true" : nil) %>
    <% end %>
  </nav>
<% end %>
<% content_for :aside do %>
  <p class="fx-chip"><span class="fx-dot" aria-hidden="true"></span><%= t("sign_in.aside.chip") %></p>
  <h2 class="fx-gradient-text mt-6 text-5xl font-bold leading-[1.05] tracking-tight"><%= t("sign_in.aside.headline") %></h2>
  <ul class="mt-8 space-y-4 text-[#b9d3ff]">
    <% t("sign_in.aside.points").each do |point| %>
      <li class="flex items-center gap-3"><span class="fx-dot" aria-hidden="true"></span><%= point %></li>
    <% end %>
  </ul>
<% end %>

<div class="fx-glass p-7 sm:p-9">
  <h1 class="text-3xl font-bold tracking-tight text-white"><%= t("sign_in.heading") %></h1>
  <p class="mt-2 text-sm text-[#b9d3ff]">
    <%= Store.apex_host?(request.host) ? t("sign_in.workspace_subtitle") : t("sign_in.tenant_subtitle", name: current_store&.name) %>
  </p>

  <% if alert.present? %>
    <div role="alert" class="fx-alert mt-6"><%= alert %></div>
  <% end %>

  <%= form_with url: admin_login_path, method: :post, class: "mt-7 space-y-5" do %>
    <div>
      <%= label_tag :email, t("sign_in.email"), class: "fx-label" %>
      <%= email_field_tag :email, params[:email], required: true, autofocus: true, autocomplete: "username", placeholder: "you@company.com", class: "fx-input" %>
    </div>
    <div>
      <%= label_tag :password, t("sign_in.password"), class: "fx-label" %>
      <%= password_field_tag :password, nil, required: true, autocomplete: "current-password", placeholder: "••••••••", class: "fx-input" %>
    </div>
    <% if Store.apex_host?(request.host) %>
      <div>
        <%= label_tag :workspace, t("sign_in.workspace"), class: "fx-label" %>
        <%= text_field_tag :workspace, params[:workspace], autocomplete: "off", autocapitalize: "none", spellcheck: false, "aria-describedby": "workspace-help", class: "fx-input" %>
        <p id="workspace-help" class="mt-2 text-xs text-[#b9d3ff]"><%= t("sign_in.workspace_help") %></p>
      </div>
    <% end %>
    <%= submit_tag t("sign_in.submit"), class: "fx-btn" %>
  <% end %>
  <% account_origin = Store.apex_host?(request.host) ? "" : Store.platform_origin %>
  <p class="mt-5 text-center text-sm">
    <%= link_to t("registration.forgot_password"), "#{account_origin}#{new_password_reset_path(locale: I18n.locale)}", class: "fx-link" %>
  </p>
  <p class="mt-6 border-t border-white/15 pt-6 text-center text-sm text-[#b9d3ff]">
    <%= t("registration.no_account") %>
    <%= link_to t("registration.create_account"), "#{account_origin}#{signup_path(locale: I18n.locale)}", class: "fx-link font-semibold underline underline-offset-4" %>
  </p>
</div>
