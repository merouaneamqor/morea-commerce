<% content_for :title, "Sign in — Admin" %>

<div class="w-full">
  <p class="font-display text-3xl tracking-wide">Morea Admin</p>
  <p class="mt-2 text-sm text-ink-faint">Orders, catalog, and COD for morea.website</p>

  <%= form_with url: admin_login_path, method: :post, class: "mt-10 space-y-6" do %>
    <div>
      <label class="text-xs uppercase tracking-wider text-ink-faint">Email</label>
      <%= email_field_tag :email, params[:email], required: true, class: "admin-input" %>
    </div>
    <div>
      <label class="text-xs uppercase tracking-wider text-ink-faint">Password</label>
      <%= password_field_tag :password, nil, required: true, class: "admin-input" %>
    </div>
    <%= submit_tag "Sign in", class: "admin-btn cursor-pointer" %>
  <% end %>
</div>
