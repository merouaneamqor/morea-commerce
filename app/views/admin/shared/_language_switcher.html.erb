<nav aria-label="Language / Langue / اللغة" class="flex items-center rounded-full border border-[#e8e3df] bg-white p-0.5" dir="ltr" data-admin-language-switcher>
  <% Morea::Locales::AVAILABLE.each do |locale| %>
    <%= link_to Morea::Locales.code_for(locale),
          admin_language_switch_path(locale),
          class: "rounded-full px-2 py-0.5 text-xs font-semibold uppercase transition #{locale == current_locale.to_sym ? 'bg-[#1f2430] text-white' : 'text-[#8a8380] hover:text-[#1f2430]'}",
          lang: locale,
          hreflang: locale,
          aria: { label: Morea::Locales.label_for(locale), current: ("true" if locale == current_locale.to_sym) } %>
  <% end %>
</nav>
