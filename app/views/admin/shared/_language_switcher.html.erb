<%# One button showing the current language; a click opens the list, a choice is saved in the language cookie (see ApplicationController#set_locale). %>
<% small = local_assigns[:size] == "sm" # 32px high, 13px text, for compact headers %>
<% current = current_locale.to_sym %>
<div class="relative" dir="ltr" aria-label="Language / Langue / اللغة" data-admin-language-switcher data-controller="locale-switcher">
  <button type="button"
          class="inline-flex items-center gap-1.5 rounded-full border border-[#e0e0e5] bg-white font-semibold text-[#1c1c1e] transition hover:border-[#c7c7cc] <%= small ? "h-8 px-3 text-[13px]" : "h-9 px-3.5 text-sm" %>"
          data-locale-switcher-target="button"
          data-action="locale-switcher#toggle"
          aria-haspopup="listbox"
          aria-expanded="false"
          aria-label="Language / Langue / اللغة">
    <svg class="h-4 w-4 text-[#6e6e73]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.7 3.8 5.7 3.8 9s-1.3 6.3-3.8 9c-2.5-2.7-3.8-5.7-3.8-9S9.5 5.7 12 3z"/></svg>
    <span><%= Morea::Locales.code_for(current) %></span>
    <svg class="h-3 w-3 text-[#6e6e73]" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5"/></svg>
  </button>
  <ul class="absolute right-0 z-50 mt-2 min-w-[10rem] overflow-hidden rounded-2xl border border-[#e0e0e5] bg-white p-1 shadow-[0_12px_32px_-12px_rgba(0,0,0,0.25)]" role="listbox" data-locale-switcher-target="menu" hidden>
    <% Morea::Locales::AVAILABLE.each do |locale| %>
      <li role="option" aria-selected="<%= locale == current %>">
        <%= link_to admin_language_switch_path(locale),
              class: "flex items-center justify-between gap-4 rounded-xl px-3 py-2 text-sm transition #{locale == current ? 'bg-[#f5f5f7] font-semibold text-[#1c1c1e]' : 'text-[#3a3a3c] hover:bg-[#f5f5f7]'}",
              lang: locale,
              hreflang: locale,
              aria: { label: Morea::Locales.label_for(locale), current: ("true" if locale == current) } do %>
          <span><%= Morea::Locales.label_for(locale) %></span>
          <% if locale == current %><span aria-hidden="true">✓</span><% end %>
        <% end %>
      </li>
    <% end %>
  </ul>
</div>
