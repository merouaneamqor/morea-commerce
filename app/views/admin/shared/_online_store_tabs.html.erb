<nav class="admin-card mb-4 admin-tabs !border-0" aria-label="<%= sl("Boutique en ligne") %>">
  <%= link_to sl("Aperçu"), admin_online_store_path, class: "admin-tab #{'is-active' if controller_name == 'online_store'}" %>
  <%= link_to sl("Personnaliser"), admin_home_sections_path, class: "admin-tab #{'is-active' if controller_name == 'home_sections'}" %>
  <%= link_to sl("Thèmes"), admin_themes_path, class: "admin-tab #{'is-active' if controller_name == 'themes'}", data: { online_store_tab: "themes" } %>
  <%= link_to sl("Pages"), admin_pages_path, class: "admin-tab #{'is-active' if controller_name.in?(%w[pages page_sections])}" %>
  <%= link_to sl("Navigation"), admin_menu_items_path, class: "admin-tab #{'is-active' if controller_name == 'menu_items'}" %>
  <% if current_store.storefront_enabled? %>
    <%= link_to localized_root_path(locale: :fr), class: "admin-tab ms-auto inline-flex items-center gap-1.5", target: "_blank", rel: "noopener" do %>
      <%= sl("Voir la boutique") %> <%= admin_icon(:external, size: 14) %>
    <% end %>
  <% else %>
    <%= link_to sl("Publier la boutique"), edit_admin_store_path(anchor: "storefront"), class: "admin-tab ms-auto" %>
  <% end %>
</nav>
