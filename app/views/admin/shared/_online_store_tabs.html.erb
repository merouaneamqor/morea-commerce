<nav class="admin-card mb-4 admin-tabs !border-0" aria-label="Online Store">
  <%= link_to "Overview", admin_online_store_path, class: "admin-tab #{'is-active' if controller_name == 'online_store'}" %>
  <%= link_to "Customize", admin_home_sections_path, class: "admin-tab #{'is-active' if controller_name == 'home_sections'}" %>
  <%= link_to "Themes", admin_themes_path, class: "admin-tab #{'is-active' if controller_name == 'themes'}" %>
  <%= link_to "Pages", admin_pages_path, class: "admin-tab #{'is-active' if controller_name.in?(%w[pages page_sections])}" %>
  <%= link_to "Navigation", admin_menu_items_path, class: "admin-tab #{'is-active' if controller_name == 'menu_items'}" %>
  <% if current_store.storefront_enabled? %>
    <%= link_to localized_root_path(locale: :fr), class: "admin-tab ms-auto inline-flex items-center gap-1.5", target: "_blank", rel: "noopener" do %>
      View store <%= admin_icon(:external, size: 14) %>
    <% end %>
  <% else %>
    <%= link_to "Publish storefront", edit_admin_store_path(anchor: "storefront"), class: "admin-tab ms-auto" %>
  <% end %>
</nav>
