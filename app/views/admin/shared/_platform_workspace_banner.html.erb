<% if super_admin? && session[:admin_mode] == "store" && current_store %>
  <div class="admin-impersonation" role="status" data-platform-workspace-banner>
    <p><%= t("platform_admin.workspace_banner.working_in", name: current_store.name) %></p>
    <div class="flex flex-wrap gap-2">
      <%= link_to t("platform_admin.workspace_banner.workspace_detail"), admin_tenant_path(current_store), class: "admin-btn admin-btn--compact" %>
      <%= link_to t("platform_admin.workspace_banner.platform"), admin_platform_path, class: "admin-btn-secondary admin-btn--compact" %>
    </div>
  </div>
<% end %>
