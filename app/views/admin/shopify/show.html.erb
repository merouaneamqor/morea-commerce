<% content_for :title, t("shopify_app.title") %>
<div class="admin-page-header">
  <div>
    <h1 class="admin-page-header__title"><%= t("shopify_app.title") %></h1>
    <p class="admin-page-header__meta"><%= t("shopify_app.intro") %></p>
  </div>
</div>
<section class="admin-card p-5 mb-4 space-y-3" aria-labelledby="shopify-workspace">
  <h2 id="shopify-workspace" class="admin-card__title"><%= t("shopify_app.workspace", name: current_store.name) %></h2>
  <% if @shop %><p dir="ltr"><%= @shop %></p><% end %>
  <p class="admin-muted"><%= t("shopify_app.approval") %></p>
  <% if @shop && (connection = @connections.first) %>
    <%= link_to t("shopify_app.manage"), admin_store_connection_path(connection), class: "admin-btn" %>
  <% else %>
    <%= link_to t("connections.shopify_api.connect"), new_admin_store_connection_path(provider: "shopify", shop: @shop), class: "admin-btn" %>
  <% end %>
  <%= link_to t("connections.title"), admin_store_connections_path, class: "admin-btn-secondary" %>
</section>
<section class="admin-card">
  <div class="admin-table-wrap">
    <table class="admin-table">
      <thead><tr><th><%= t("connections.name") %></th><th><%= t("connections.domain") %></th><th><%= t("connections.status") %></th></tr></thead>
      <tbody>
        <% @connections.each do |connection| %>
          <tr>
            <td><%= link_to connection.name, admin_store_connection_path(connection), class: "admin-link" %></td>
            <td dir="ltr"><%= connection.external_domain %></td>
            <td><%= connection_state(connection) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
    <% if @connections.empty? %><p class="admin-empty"><%= t("shopify_app.empty") %></p><% end %>
  </div>
</section>
