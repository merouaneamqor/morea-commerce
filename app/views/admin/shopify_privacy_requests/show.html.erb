<% status_badges = { "pending" => "attention", "needs_review" => "warning", "completed" => "success" } %>
<div class="admin-page-header">
  <div>
    <h1 class="admin-page-header__title"><%= t("seallo_connect.privacy.request_title", id: @privacy_request.id) %></h1>
    <p class="admin-page-header__meta"><%= t("seallo_connect.privacy.topics.#{@privacy_request.topic}") %></p>
  </div>
  <span class="admin-badge admin-badge--<%= status_badges.fetch(@privacy_request.status, "neutral") %>"><%= t("seallo_connect.privacy.statuses.#{@privacy_request.status}") %></span>
</div>
<section class="admin-card space-y-4 p-5">
  <p class="admin-muted text-[13px]"><%= t("seallo_connect.privacy.due", date: l((@privacy_request.created_at + 30.days).to_date, format: "%d/%m/%Y")) %></p>
  <% if @privacy_request.error_code == "secure_response_required" %>
    <p class="text-[14px] leading-6"><%= t("seallo_connect.privacy.secure_response") %></p>
  <% elsif @privacy_request.error_code == "retained_business_records" %>
    <p role="alert" class="rounded-xl border border-[#f0c2bd] bg-[#f8dcd9] px-4 py-3 text-[14px] leading-6 text-[#b0342a]"><%= t("seallo_connect.privacy.retained_records") %></p>
  <% end %>
  <% if @privacy_request.status != "completed" %>
    <div class="flex flex-wrap items-center gap-3">
      <% if @privacy_request.topic == "customers/data_request" %>
        <%= link_to t("seallo_connect.privacy.download"), export_admin_shopify_privacy_request_path(@privacy_request), class: "admin-btn-secondary" %>
        <%= button_to t("seallo_connect.privacy.confirm_delivery"), complete_admin_shopify_privacy_request_path(@privacy_request), class: "admin-btn" %>
      <% else %>
        <%= button_to t("seallo_connect.privacy.retry_redaction"), retry_processing_admin_shopify_privacy_request_path(@privacy_request), class: "admin-btn" %>
      <% end %>
    </div>
  <% end %>
</section>
