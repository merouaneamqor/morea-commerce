<section aria-labelledby="shopify-setup-title" class="admin-card p-5 mb-4 space-y-4">
  <div>
    <h2 id="shopify-setup-title" class="admin-card__title"><%= t("connections.shopify_setup.title") %></h2>
    <p class="mt-2"><%= t("connections.shopify_setup.intro") %></p>
    <% unless local_assigns[:saved] %><p class="admin-muted mt-2"><%= t("connections.shopify_setup.before_start") %></p><% end %>
  </div>
  <ol class="list-decimal ps-5 space-y-3">
    <% %w[one two three].each do |step| %>
      <li>
        <h3 class="font-semibold"><%= t("connections.shopify_setup.step_#{step}_title") %></h3>
        <p class="admin-muted mt-1"><%= t("connections.shopify_setup.step_#{step}_body") %></p>
      </li>
    <% end %>
  </ol>
  <div class="grid gap-4 md:grid-cols-2 border-t pt-4">
    <div><h3 class="font-semibold"><%= t("connections.shopify_setup.supported_title") %></h3><p class="admin-muted mt-1"><%= t("connections.shopify_setup.supported_body") %></p></div>
    <div><h3 class="font-semibold"><%= t("connections.shopify_setup.unavailable_title") %></h3><p class="admin-muted mt-1"><%= t("connections.shopify_setup.unavailable_body") %></p></div>
  </div>
</section>
