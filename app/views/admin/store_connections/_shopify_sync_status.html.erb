<span class="admin-muted">
  <% if connection.shopify_orders_synced_at %>
    <%= t("shopify_sync.checked_through") %>
    <time datetime="<%= connection.shopify_orders_synced_at.iso8601 %>"><%= l(connection.shopify_orders_synced_at.in_time_zone("Africa/Casablanca"), format: "%d/%m/%Y %H:%M") %></time>
  <% else %>
    <%= t("shopify_sync.not_synced") %>
  <% end %>
</span>
<% if connection.last_error_code.present? %>
  <span class="admin-muted"><%= t("shopify_sync.receipt_attention") %></span>
<% end %>
