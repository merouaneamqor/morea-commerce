<% compact = local_assigns.fetch(:compact, false) %>
<span class="admin-sync-status <%= "admin-sync-status--compact" if compact %>">
  <% if connection.shopify_sync_state.present? %>
    <span><%= connection.shopify_sync_state.humanize %></span>
    <% if connection.shopify_sync_error %><span role="alert"><%= connection.shopify_sync_error.humanize %></span><% end %>
  <% end %>
  <% if connection.shopify_orders_synced_at %>
    <% unless compact %><span><%= t("shopify_sync.checked_through") %></span><% end %>
    <time datetime="<%= connection.shopify_orders_synced_at.iso8601 %>"><%= l(connection.shopify_orders_synced_at.in_time_zone("Africa/Casablanca"), format: compact ? "%d/%m %H:%M" : "%d/%m/%Y %H:%M") %></time>
  <% else %>
    <span><%= t("shopify_sync.not_synced") %></span>
  <% end %>
  <% if connection.last_error_code.present? %>
    <span class="admin-sync-status__attention"><%= t(compact ? "shopify_sync.receipt_attention_short" : "shopify_sync.receipt_attention") %></span>
  <% end %>
</span>
