<%# Intégrations API, ported from the seallo page: online-store platforms, delivery companies and ad networks. %>
<% content_for :title, sl("Intégrations API") %>
<% content_for :admin_page_class, "seller-page" %>
<% content_for :seller_lang, "1" %>
<% platforms = [
     { key: "shopify", name: "Shopify", logo: "/images/partners/shopify.png", desc: "Commandes et produits en direct, dès leur création.", steps: t("seller_integrations.shopify_steps"), href: admin_seallo_connect_path },
     { key: "woocommerce", name: "WooCommerce", logo: "/images/partners/woocommerce.png", desc: "Votre site WordPress : autorisation en un clic ou clés API.", steps: t("seller_integrations.woocommerce_steps"), href: admin_woocommerce_connect_path },
     { key: "youcan", name: "YouCan", logo: "/images/partners/youcan.png", desc: "Votre boutique YouCan reliée en quelques secondes.", steps: t("seller_integrations.youcan_steps"), href: new_admin_store_connection_path(provider: "youcan") }
   ] %>
<% linked_by_provider = @connections.select(&:active?).group_by(&:provider) %>
<% ad_networks = [ [ "Meta Ads", "/images/partners/meta.png" ], [ "TikTok Ads", "/images/partners/tiktok.png" ] ] %>
<% locale_tag = { "ar" => "ar-MA", "en" => "en-GB" }.fetch(I18n.locale.to_s, "fr-FR") %>
<% currency = current_store.currency.to_s.upcase == "DH" ? "MAD" : current_store.currency.to_s.upcase %>
<%
  catalog = {
    regions: Carriers.regions.transform_values { |name| sl(name) },
    countries: Carriers.countries.transform_values { |name| sl(name) },
    providers: Carriers.providers.transform_values { |p| { name: p["name"], desc: sl(p["desc"]), region: p["region"], countries: p["countries"], logo: (p["asset"] ? asset_path(p["asset"]) : p["logo"]), unavailable: p["unavailable"] == true } }
  }
  accounts_json = @delivery_accounts.map do |a|
    { id: a.id, provider: a.provider, name: a.name, contact_name: a.contact_name, contact_phone: a.contact_phone, account_type: a.account_type, pickup_city: a.pickup_city,
      allow_open: a.allow_open, delivery_fee: a.delivery_fee&.to_f, return_fee: a.return_fee&.to_f, is_active: a.is_active, has_credentials: a.credentials?,
      public_key: (a.credentials["api_key"] if a.sendit?), secret_hint: (a.secret_hint if a.sendit?), webhook_url: a.webhook_url,
      cities_count: a.cities_count, cities_synced: a.cities_synced_at.present? }
  end
  modal_strings = [
    "Choisissez une région", "Toutes les régions", "fournisseurs", "Pays pris en charge", "Tous", "Fournisseurs disponibles", "résultats", "Rechercher un fournisseur…",
    "Configurer", "Autre société", "Votre société n'est pas dans la liste : suivi des colis à la main en attendant son intégration.", "Fournisseur", "Détails",
    "Sélectionner le fournisseur de livraison", "Choisissez votre société de livraison pour commencer.", "Nom du compte", "Nom de la société", "Contact",
    "Téléphone du contact", "Ville de ramassage", "Type de compte", "Normal", "Premium", "Frais par colis livré", "Frais par colis retourné", "Connexion API",
    "Clés fournies par", "dans votre espace client. Elles sont gardées chiffrées ; l'envoi automatique des colis sera activé dès que le connecteur sera disponible.",
    "Clé enregistrée (laisser vide pour garder)", "Clé publique / identifiant", "Clé secrète / token", "Ouvrir le colis", "Le client peut ouvrir le colis avant de payer.",
    "Compte actif", "Retour", "Enregistrer", "Ajouter la société"
  ].index_with { |text| sl(text) }
%>

<header class="flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-2xl font-bold text-[#1f2430] sm:text-[28px]"><%= sl("Intégrations API") %></h1>
    <p class="max-w-2xl text-sm"><%= sl("Reliez vos outils à seallo : les commandes arrivent toutes seules, et le tableau de bord se remplit en temps réel.") %></p>
  </div>
  <%= render "admin/shared/language_switcher" %>
</header>

<section>
  <h2 class="mb-2.5 text-sm font-semibold text-[#1f2430]"><%= sl("Boutique en ligne") %></h2>
  <div class="grid gap-3 md:grid-cols-3">
    <% platforms.each do |platform| %>
      <% linked = linked_by_provider.fetch(platform[:key], []) %>
      <article class="flex flex-col rounded-2xl border bg-white p-5 <%= linked.any? ? "border-[#bfe0c9]" : "border-[#e8e3df]" %>">
        <div class="flex items-start justify-between gap-3">
          <img src="<%= platform[:logo] %>" alt="<%= platform[:name] %>" class="size-12 rounded-xl object-contain">
          <% if linked.any? %>
            <span class="flex items-center gap-1.5 rounded-full bg-[#e3f3e8] px-2.5 py-1 text-xs font-semibold text-[#2f7a4a]"><span class="size-1.5 rounded-full bg-[#2f7a4a]"></span> <%= sl("Connectée") %></span>
          <% else %>
            <span class="rounded-full bg-[#f1eee9] px-2.5 py-1 text-xs font-semibold text-[#8a8380]"><%= sl("Non connectée") %></span>
          <% end %>
        </div>
        <h3 class="mt-3 text-base font-semibold text-[#1f2430]"><%= platform[:name] %></h3>
        <p class="mt-0.5 text-sm"><%= sl(platform[:desc]) %></p>

        <% linked.each do |connection| %>
          <% synced_at = connection.shopify_orders_synced_at || connection.last_received_at %>
          <div class="mt-4 rounded-xl bg-[#f3f1ef] p-3 text-sm">
            <p class="truncate font-semibold text-[#1f2430]" dir="ltr"><%= connection.external_domain %></p>
            <p class="mt-0.5 text-xs text-[#8a8380]"><%= sl("Dernière synchronisation") %> : <% if synced_at %><time datetime="<%= synced_at.iso8601 %>" data-when><%= synced_at.iso8601 %></time><% else %>—<% end %></p>
            <div class="mt-3 flex gap-2">
              <% if connection.provider == "shopify" && @shopify_configured %>
                <%= button_to sl("Synchroniser"), admin_store_connection_path(connection), method: :patch, params: { operation: "sync_shopify_orders" },
                      class: "flex h-9 w-full items-center justify-center rounded-lg bg-white px-3 text-xs font-semibold text-[#1f2430] hover:bg-[#ebe6e2]", form_class: "flex-1" %>
              <% else %>
                <%= link_to t("seller_integrations.details"), admin_store_connection_path(connection), class: "flex h-9 flex-1 items-center justify-center rounded-lg bg-white text-xs font-semibold text-[#1f2430] hover:bg-[#ebe6e2]" %>
              <% end %>
              <%= button_to sl("Déconnecter"), admin_store_connection_path(connection), method: :patch, params: { operation: "disconnect" },
                    class: "h-9 rounded-lg px-3 text-xs font-semibold text-[#b4344e] hover:bg-[#fbe7ea]",
                    form: { onsubmit: "return confirm(#{sl("Déconnecter cette boutique ? Les nouvelles commandes n'arriveront plus dans seallo.").to_json})" } %>
            </div>
          </div>
        <% end %>

        <button type="button" data-connect="<%= platform[:key] %>" class="mt-auto pt-4">
          <span class="flex h-11 w-full items-center justify-center rounded-xl text-sm font-semibold <%= linked.any? ? "border border-[#e8e3df] text-[#1f2430] hover:bg-[#f3f1ef]" : "bg-[#a8432e] text-white hover:bg-[#8e3624]" %>">
            <%= linked.any? ? "+ #{t("seller_integrations.add_another_store")}" : sl("Connecter") %>
          </span>
        </button>
      </article>
    <% end %>
  </div>
</section>

<section>
  <h2 class="mb-2.5 text-sm font-semibold text-[#1f2430]"><%= sl("Sociétés de livraison") %></h2>
  <button type="button" data-delivery-new class="group flex w-full flex-wrap items-center justify-between gap-3 rounded-2xl border border-[#e8e3df] bg-white p-4 text-start transition hover:border-[#d6cfca]">
    <span class="flex items-center gap-3">
      <span class="flex -space-x-2 rtl:space-x-reverse">
        <% %w[sendit ozon cathedis ameex].each do |key| %><img src="/images/partners/<%= key %>.png" alt="" class="size-10 rounded-full border-2 border-white bg-white object-contain p-0.5 shadow-sm"><% end %>
      </span>
      <span>
        <span class="block text-sm font-semibold text-[#1f2430]"><%= sl("Sendit, Ozon Express, Cathedis, Ameex et 10 autres") %></span>
        <span class="text-xs text-[#8a8380]"><%= sl("Ajoutez vos comptes de livraison, leurs tarifs et leur ville de ramassage.") %></span>
      </span>
    </span>
    <span class="text-sm font-semibold text-[#a8432e]"><%= sl("Gérer les sociétés de livraison") %> →</span>
  </button>

  <% if @delivery_accounts.any? %>
    <ul class="mt-3 space-y-2" data-delivery-accounts>
      <% @delivery_accounts.each do |account| %>
        <% info = account.provider_info %>
        <li class="flex flex-wrap items-center gap-3 rounded-2xl border bg-white p-3.5 <%= account.is_active? ? "border-[#bfe0c9]" : "border-[#e8e3df]" %>" data-account="<%= account.id %>">
          <span data-logo="<%= account.provider %>"></span>
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-semibold text-[#1f2430]" dir="auto"><%= account.name %> <span class="ms-1 text-xs font-medium text-[#8a8380]" dir="ltr"><%= account.code %></span></p>
            <p class="truncate text-xs text-[#8a8380]"><%= info["name"] %><% if info["unavailable"] %> · <%= t("seller_integrations.provider_unavailable") %><% end %><% if account.pickup_city.present? %> · <%= account.pickup_city %><% end %></p>
          </div>
          <% if account.is_active? %>
            <span class="flex items-center gap-1.5 rounded-full bg-[#e3f3e8] px-2.5 py-1 text-xs font-semibold text-[#2f7a4a]"><span class="size-1.5 rounded-full bg-[#2f7a4a]"></span> <%= sl("Connectée") %></span>
          <% else %>
            <span class="rounded-full bg-[#f1eee9] px-2.5 py-1 text-xs font-semibold text-[#8a8380]"><%= sl("Non connectée") %></span>
          <% end %>
          <button type="button" data-delivery-edit="<%= account.id %>" class="h-9 rounded-lg border border-[#e8e3df] px-3 text-xs font-semibold text-[#1f2430] hover:border-[#a8432e] hover:text-[#a8432e]"><%= sl("Modifier") %></button>
          <%= button_to sl("Supprimer"), seller_delivery_account_path(account.id), method: :delete, class: "h-9 rounded-lg px-3 text-xs font-semibold text-[#b4344e] hover:bg-[#fbe7ea]",
                form: { onsubmit: "return confirm(#{t("seller_integrations.delete_account_confirm").to_json})" } %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>

<section>
  <h2 class="mb-2.5 text-sm font-semibold text-[#1f2430]"><%= sl("Publicité") %></h2>
  <div class="grid grid-cols-2 gap-3 md:grid-cols-4">
    <% ad_networks.each do |name, logo| %>
      <div class="flex items-center gap-3 rounded-2xl border border-[#e8e3df] bg-white p-4">
        <img src="<%= logo %>" alt="<%= name %>" class="size-10 shrink-0 rounded-lg object-contain">
        <div class="min-w-0">
          <p class="truncate text-sm font-semibold text-[#1f2430]"><%= name %></p>
          <p class="text-xs text-[#8a8380]"><%= sl("Bientôt disponible") %></p>
        </div>
      </div>
    <% end %>
  </div>
</section>

<% platforms.each do |platform| %>
  <div data-modal="<%= platform[:key] %>" hidden class="fixed inset-0 z-50 grid place-items-center bg-[#1f2430]/30 p-4 backdrop-blur-sm">
    <div class="w-full max-w-md rounded-2xl bg-white p-6 shadow-2xl" role="dialog" aria-modal="true">
      <div class="mb-4 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <img src="<%= platform[:logo] %>" alt="" class="size-10 rounded-lg object-contain">
          <h2 class="text-lg font-bold text-[#1f2430]"><%= sl("Connecter") %> <%= platform[:name] %></h2>
        </div>
        <button type="button" data-close-modal class="rounded-lg p-1.5 text-[#8a8380] hover:bg-[#f3f1ef]" aria-label="✕">✕</button>
      </div>
      <p class="text-sm"><%= platform[:steps] %></p>
      <%= link_to t("seller_integrations.continue"), platform[:href], class: "mt-5 flex h-11 w-full items-center justify-center rounded-xl bg-[#a8432e] text-sm font-semibold text-white hover:bg-[#8e3624]" %>
    </div>
  </div>
<% end %>

<div data-delivery-modal hidden class="fixed inset-0 z-50 grid place-items-center bg-[#1f2430]/30 p-4 backdrop-blur-sm"
     data-catalog="<%= catalog.to_json %>" data-accounts="<%= accounts_json.to_json %>" data-strings="<%= modal_strings.to_json %>"
     data-currency="<%= currency %>" data-action="<%= seller_delivery_accounts_path %>" data-edit-path="/livraison/societes/"
     data-sendit="<%= t("seller_integrations.sendit").except(:errors).merge(browser_error: t("seller_integrations.sendit.errors.browser"), server_error: t("seller_integrations.sendit.errors.server_error", status: "%{status}"), detail_label: t("seller_integrations.sendit.errors.detail_label")).to_json %>"
     data-sendit-url="https://app.sendit.ma/edit-profile?tab=tabAPI"></div>

<script>
  (function () {
    var locale = "<%= locale_tag %>";
    document.querySelectorAll("time[data-when]").forEach(function (el) {
      el.textContent = new Date(el.getAttribute("datetime")).toLocaleString(locale, { day: "numeric", month: "short", hour: "2-digit", minute: "2-digit" });
    });
    var open = function (key) { var m = document.querySelector('[data-modal="' + key + '"]'); if (m) m.hidden = false; };
    document.querySelectorAll("[data-connect]").forEach(function (b) { b.addEventListener("click", function () { open(b.dataset.connect); }); });
    document.querySelectorAll("[data-modal]").forEach(function (m) {
      m.addEventListener("click", function (e) { if (e.target === m || e.target.closest("[data-close-modal]")) m.hidden = true; });
    });

    /* ---- Delivery companies: two-step dialog (1 Fournisseur, 2 Détails), as on the seallo Delivery page ---- */
    var root = document.querySelector("[data-delivery-modal]");
    var catalog = JSON.parse(root.dataset.catalog), accounts = JSON.parse(root.dataset.accounts), S = JSON.parse(root.dataset.strings);
    var currency = root.dataset.currency;
    var FLAGS = { MA: "🇲🇦", TN: "🇹🇳", CR: "🇨🇷", PA: "🇵🇦" };
    var esc = function (s) { return String(s == null ? "" : s).replace(/[&<>"']/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" }[c]; }); };
    var state = { provider: null, account: null, region: "all", country: "all", q: "" };
    var field = "h-11 w-full min-w-0 rounded-xl border border-[#e8e3df] bg-white px-3 text-sm text-[#1f2430] outline-none focus:border-[#a8432e] focus:ring-2 focus:ring-[#a8432e]/20";

    var placeholder = function (p, size) {
      var hue = 7; for (var i = 0; i < p.name.length; i++) hue = (hue * 31 + p.name.charCodeAt(i)) % 360;
      var initials = p.name.split(/[\s.]+/).filter(Boolean).slice(0, 2).map(function (w) { return w[0]; }).join("").toUpperCase();
      return '<span class="' + size + ' grid shrink-0 place-items-center rounded-full text-sm font-bold" style="background-color:hsl(' + hue + ' 55% 93%);color:hsl(' + hue + ' 45% 32%)">' + esc(initials) + "</span>";
    };
    // Every logo sits in the same round box, scaled to fit without stretching; a broken image falls back to the letter badge.
    var logo = function (p, size) {
      size = size || "size-11";
      if (p.logo) return '<img src="' + esc(p.logo) + '" alt="' + esc(p.name) + '" data-logo-img data-size="' + size + '" class="' + size + ' shrink-0 rounded-full border border-[#f0ebe7] bg-white object-contain p-0.5">';
      return placeholder(p, size);
    };
    document.addEventListener("error", function (event) {
      var img = event.target;
      if (!img || img.tagName !== "IMG" || !img.hasAttribute("data-logo-img")) return;
      var p = Object.keys(catalog.providers).map(function (k) { return catalog.providers[k]; }).filter(function (c) { return c.name === img.alt; })[0] || { name: img.alt || "?" };
      img.outerHTML = placeholder(p, img.dataset.size || "size-11");
    }, true);
    document.querySelectorAll("[data-logo]").forEach(function (el) { el.outerHTML = logo(catalog.providers[el.dataset.logo] || catalog.providers.other); });

    var entries = function () { return Object.keys(catalog.providers).filter(function (k) { return k !== "other" && !catalog.providers[k].unavailable; }).map(function (k) { return [k, catalog.providers[k]]; }); };
    var chip = function (on) { return "flex items-center gap-2 rounded-full border px-3.5 py-1.5 text-sm transition " + (on ? "border-[#a8432e] bg-[#f4e4de]/50 font-semibold text-[#a8432e]" : "border-transparent text-[#1f2430] hover:bg-[#f3f1ef]"); };
    var count = function (n, on) { return '<span class="rounded-md px-1.5 text-xs font-semibold ' + (on ? "bg-white text-[#a8432e]" : "bg-[#f1eee9] text-[#6f6967]") + '">' + n + "</span>"; };

    var providerCards = function () {
      var inRegion = entries().filter(function (e) { return state.region === "all" || e[1].region === state.region; });
      var list = inRegion.filter(function (e) { return state.country === "all" || e[1].countries.indexOf(state.country) >= 0; })
        .filter(function (e) { return !state.q || (e[1].name + " " + e[1].desc).toLowerCase().indexOf(state.q.toLowerCase()) >= 0; });
      return { list: list, html: list.map(function (e) {
        return '<div class="flex items-center gap-3 rounded-xl border border-[#e8e3df] p-3 transition hover:border-[#d6cfca] hover:bg-[#fdfcfb]">' + logo(e[1]) +
          '<div class="min-w-0 flex-1"><p class="truncate text-sm font-semibold text-[#1f2430]">' + esc(e[1].name) + '</p><p class="truncate text-xs text-[#8a8380]">' + esc(e[1].desc) + "</p></div>" +
          '<button type="button" data-pick="' + e[0] + '" class="h-9 shrink-0 rounded-lg border border-[#e8e3df] px-3 text-xs font-semibold text-[#1f2430] hover:border-[#a8432e] hover:text-[#a8432e]">' + esc(S["Configurer"]) + "</button></div>";
      }).join("") };
    };

    var step1 = function () {
      var all = entries();
      var inRegion = all.filter(function (e) { return state.region === "all" || e[1].region === state.region; });
      var countries = Object.keys(catalog.countries).filter(function (c) { return inRegion.some(function (e) { return e[1].countries.indexOf(c) >= 0; }); });
      var regions = [["all", S["Toutes les régions"]]].concat(Object.keys(catalog.regions).map(function (k) { return [k, catalog.regions[k]]; }));
      var html = '<h2 class="text-lg font-bold text-[#1f2430]">' + esc(S["Sélectionner le fournisseur de livraison"]) + '</h2><p class="mb-5 text-sm">' + esc(S["Choisissez votre société de livraison pour commencer."]) + "</p>" +
        '<p class="mb-2 text-[11px] font-semibold tracking-wider text-[#8a8380] uppercase">' + esc(S["Choisissez une région"]) + '</p><div class="grid gap-2 sm:grid-cols-3">' +
        regions.map(function (r) {
          var n = r[0] === "all" ? all.length : all.filter(function (e) { return e[1].region === r[0]; }).length, on = state.region === r[0];
          return '<button type="button" data-region="' + r[0] + '" class="flex items-center justify-between gap-3 rounded-xl border px-4 py-3 text-start transition ' + (on ? "border-[#a8432e] bg-[#f4e4de]/40" : "border-[#e8e3df] hover:bg-[#f3f1ef]") + '"><span><span class="block text-sm font-semibold text-[#1f2430]">' + esc(r[1]) +
            '</span><span class="text-xs text-[#8a8380]">' + n + " " + esc(S["fournisseurs"]) + "</span></span>" + (on ? '<span class="grid size-5 place-items-center rounded-full bg-[#a8432e] text-[11px] text-white">✓</span>' : "") + "</button>";
        }).join("") + "</div>" +
        '<p class="mt-5 mb-2 text-[11px] font-semibold tracking-wider text-[#8a8380] uppercase">' + esc(S["Pays pris en charge"]) + '</p><div class="flex flex-wrap gap-1.5">' +
        '<button type="button" data-country="all" class="' + chip(state.country === "all") + '">🌍 ' + esc(S["Tous"]) + " " + count(inRegion.length, state.country === "all") + "</button>" +
        countries.map(function (c) { return '<button type="button" data-country="' + c + '" class="' + chip(state.country === c) + '">' + (FLAGS[c] || c) + " " + esc(catalog.countries[c]) + " " + count(inRegion.filter(function (e) { return e[1].countries.indexOf(c) >= 0; }).length, state.country === c) + "</button>"; }).join("") + "</div>";
      var cards = providerCards();
      html += '<div class="mt-5 flex items-center justify-between"><p class="text-sm font-semibold text-[#1f2430]">' + esc(S["Fournisseurs disponibles"]) + '</p><p class="text-xs text-[#8a8380]"><span data-result-count>' + cards.list.length + "</span> " + esc(S["résultats"]) + "</p></div>" +
        '<label class="mt-2 flex h-11 items-center gap-2 rounded-xl border border-[#e8e3df] bg-white px-3 text-sm"><span class="text-[#8a8380]"><svg viewBox="0 0 24 24" class="size-[18px] fill-none stroke-current [stroke-width:1.8] [stroke-linecap:round]" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></span>' +
        '<input data-search value="' + esc(state.q) + '" placeholder="' + esc(S["Rechercher un fournisseur…"]) + '" class="w-full bg-transparent text-[#1f2430] outline-none placeholder:text-[#a49d99]"></label>' +
        '<div class="mt-3 grid gap-2 sm:grid-cols-2" data-provider-list>' + cards.html + "</div>" +
        '<button type="button" data-pick="other" class="mt-3 flex w-full items-center gap-3 rounded-xl border border-dashed border-[#d9d1cc] p-3 text-start hover:border-[#a8432e]"><span class="grid size-11 shrink-0 place-items-center rounded-xl bg-[#f3f1ef] text-lg text-[#8a8380]">+</span><span><span class="block text-sm font-semibold text-[#1f2430]">' +
        esc(S["Autre société"]) + '</span><span class="text-xs text-[#8a8380]">' + esc(S["Votre société n'est pas dans la liste : suivi des colis à la main en attendant son intégration."]) + "</span></span></button>";
      return html;
    };

    var toggle = function (name, on, label) {
      return '<input type="hidden" name="delivery_account[' + name + ']" value="' + on + '" data-toggle-input="' + name + '"><button type="button" role="switch" aria-checked="' + on + '" aria-label="' + esc(label) + '" data-toggle="' + name + '" class="relative h-6 w-11 shrink-0 rounded-full transition ' + (on ? "bg-[#2f7a4a]" : "bg-[#d9d1cc]") + '"><span class="absolute top-0.5 size-5 rounded-full bg-white shadow transition-all ' + (on ? "start-[22px]" : "start-0.5") + '"></span></button>';
    };

    var step2 = function () {
      var key = state.provider, a = state.account, p = catalog.providers[key] || catalog.providers.other;
      var v = function (x, d) { return esc(a && a[x] != null ? a[x] : d); };
      var label = "mb-1 block text-xs font-semibold text-[#8a8380]";
      var token = (document.querySelector('meta[name="csrf-token"]') || {}).content || "";
      var html = '<form method="post" action="' + esc(a ? root.dataset.editPath + a.id : root.dataset.action) + '" data-delivery-form>' +
        '<input type="hidden" name="authenticity_token" value="' + esc(token) + '">' + (a ? '<input type="hidden" name="_method" value="patch">' : '<input type="hidden" name="delivery_account[provider]" value="' + esc(key) + '">') +
        '<div class="mb-5 flex items-center gap-3 rounded-xl bg-[#f3f1ef] p-3">' + logo(p) + '<div><p class="font-semibold text-[#1f2430]">' + esc(p.name) + '</p><p class="text-xs text-[#8a8380]">' + esc(p.desc) + "</p></div></div>" +
        '<div class="grid gap-3 sm:grid-cols-2">' +
        '<label class="block sm:col-span-2"><span class="' + label + '">' + esc(S["Nom du compte"]) + '</span><input name="delivery_account[name]" value="' + (a ? esc(a.name) : (key === "other" ? "" : esc(p.name))) + '" class="' + field + '" required dir="auto" placeholder="' + (key === "other" ? esc(S["Nom de la société"]) : esc(p.name) + " (WALKFIT)") + '"></label>' +
        '<label class="block"><span class="' + label + '">' + esc(S["Contact"]) + '</span><input name="delivery_account[contact_name]" value="' + v("contact_name", "") + '" class="' + field + '" dir="auto"></label>' +
        '<label class="block"><span class="' + label + '">' + esc(S["Téléphone du contact"]) + '</span><input name="delivery_account[contact_phone]" value="' + v("contact_phone", "") + '" class="' + field + '" dir="ltr" inputmode="tel"></label>' +
        '<label class="block"><span class="' + label + '">' + esc(S["Ville de ramassage"]) + '</span><input name="delivery_account[pickup_city]" value="' + v("pickup_city", "") + '" class="' + field + '" dir="auto" placeholder="Casablanca - Aïn Sebaâ"></label>' +
        '<label class="block"><span class="' + label + '">' + esc(S["Type de compte"]) + '</span><select name="delivery_account[account_type]" class="h-11 w-full cursor-pointer rounded-xl border border-[#e8e3df] bg-white px-3 text-sm font-medium text-[#1f2430] outline-none focus:border-[#a8432e]"><option value="normal"' + (a && a.account_type === "premium" ? "" : " selected") + ">" + esc(S["Normal"]) + '</option><option value="premium"' + (a && a.account_type === "premium" ? " selected" : "") + ">" + esc(S["Premium"]) + "</option></select></label>" +
        '<label class="block"><span class="' + label + '">' + esc(S["Frais par colis livré"]) + " (" + esc(currency) + ')</span><input type="number" min="0" step="0.01" name="delivery_account[delivery_fee]" value="' + v("delivery_fee", "") + '" class="' + field + '" dir="ltr"></label>' +
        '<label class="block"><span class="' + label + '">' + esc(S["Frais par colis retourné"]) + " (" + esc(currency) + ')</span><input type="number" min="0" step="0.01" name="delivery_account[return_fee]" value="' + v("return_fee", "") + '" class="' + field + '" dir="ltr"></label></div>';
      if (key !== "other") {
        html += '<div class="mt-4 rounded-xl border border-[#f0ebe7] p-3.5"><p class="text-sm font-semibold text-[#1f2430]">' + esc(S["Connexion API"]) + '</p><p class="mt-0.5 text-xs text-[#8a8380]">' + esc(S["Clés fournies par"]) + " " + esc(p.name) + " " + esc(S["dans votre espace client. Elles sont gardées chiffrées ; l'envoi automatique des colis sera activé dès que le connecteur sera disponible."]) + "</p>" +
          '<div class="mt-3 grid gap-3 sm:grid-cols-2"><input name="delivery_account[api_key]" class="' + field + '" dir="ltr" autocomplete="off" placeholder="' + esc(a && a.has_credentials ? S["Clé enregistrée (laisser vide pour garder)"] : S["Clé publique / identifiant"]) + '">' +
          '<input name="delivery_account[api_secret]" type="password" class="' + field + '" dir="ltr" autocomplete="new-password" placeholder="' + (a && a.has_credentials ? "••••••••" : esc(S["Clé secrète / token"])) + '"></div></div>';
      }
      html += '<div class="mt-4 space-y-3"><label class="flex items-center justify-between gap-3 text-sm"><span><span class="block font-medium text-[#1f2430]">' + esc(S["Ouvrir le colis"]) + '</span><span class="text-xs text-[#8a8380]">' + esc(S["Le client peut ouvrir le colis avant de payer."]) + "</span></span>" + toggle("allow_open", a ? a.allow_open : true, S["Ouvrir le colis"]) + "</label>" +
        '<label class="flex items-center justify-between gap-3 text-sm"><span class="font-medium text-[#1f2430]">' + esc(S["Compte actif"]) + "</span>" + toggle("is_active", a ? a.is_active : true, S["Compte actif"]) + "</label></div>" +
        '<div class="mt-6 flex items-center justify-between">' + (a ? "<span></span>" : '<button type="button" data-back class="text-sm font-semibold text-[#8a8380] hover:text-[#1f2430]">← ' + esc(S["Retour"]) + "</button>") +
        '<button type="submit" class="h-11 rounded-xl bg-[#a8432e] px-5 text-sm font-semibold text-white hover:bg-[#8e3624]">' + esc(a ? S["Enregistrer"] : S["Ajouter la société"]) + "</button></div></form>";
      return html;
    };

    /* ---- Sendit: real connection (keys checked against Sendit's login, webhook URL shown afterwards) ---- */
    var SD = JSON.parse(root.dataset.sendit), SENDIT_URL = root.dataset.senditUrl;
    var eyeIcon = '<svg viewBox="0 0 24 24" class="size-[18px] fill-none stroke-current [stroke-width:1.8] [stroke-linecap:round] [stroke-linejoin:round]" aria-hidden="true"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>';
    var webhookBlock = function (url) {
      return '<div class="mt-4 rounded-xl border border-[#f0ebe7] p-3.5"><p class="text-sm font-semibold text-[#1f2430]">' + esc(SD.webhook_title) + '</p><p class="mt-0.5 text-xs text-[#8a8380]">' + esc(SD.webhook_help) + "</p>" +
        '<div class="mt-3 flex gap-2"><input readonly value="' + esc(url) + '" dir="ltr" data-webhook-url class="' + field + ' text-xs" onfocus="this.select()">' +
        '<button type="button" data-copy-webhook class="h-11 shrink-0 rounded-xl border border-[#e8e3df] px-4 text-sm font-semibold text-[#1f2430] hover:border-[#a8432e] hover:text-[#a8432e]">' + esc(SD.copy) + "</button></div></div>";
    };
    var citiesLine = function (a) {
      if (!a) return "";
      var text = a.cities_count ? SD.cities.replace("%{count}", a.cities_count) : SD.cities_pending;
      return '<p class="mt-3 text-xs text-[#8a8380]">' + esc(text) + "</p>";
    };
    var senditStep = function () {
      var a = state.account, p = catalog.providers.sendit, label = "mb-1 block text-xs font-semibold text-[#8a8380]";
      var token = (document.querySelector('meta[name="csrf-token"]') || {}).content || "";
      var html = '<form method="post" action="' + esc(a ? root.dataset.editPath + a.id : root.dataset.action) + '" data-sendit-form>' +
        '<input type="hidden" name="authenticity_token" value="' + esc(token) + '">' + (a ? '<input type="hidden" name="_method" value="patch">' : '<input type="hidden" name="delivery_account[provider]" value="sendit">') +
        '<div class="mb-5 flex items-center gap-3 rounded-xl bg-[#f3f1ef] p-3">' + logo(p) + '<div><p class="font-semibold text-[#1f2430]">' + esc(p.name) + '</p><p class="text-xs text-[#8a8380]">' + esc(p.desc) + "</p></div></div>" +
        '<p data-sendit-error hidden role="alert" class="mb-4 rounded-xl bg-[#fbe7ea] px-3.5 py-2.5 text-sm text-[#b4344e]"></p>' +
        '<div class="grid gap-3"><label class="block"><span class="' + label + '">' + esc(SD.name_label) + '</span><input name="delivery_account[name]" value="' + (a ? esc(a.name) : "") + '" required dir="auto" class="' + field + '" placeholder="' + esc(SD.name_placeholder) + '"></label>' +
        '<label class="block"><span class="' + label + '">' + esc(SD.public_key) + '</span><input name="delivery_account[api_key]" value="' + (a ? esc(a.public_key) : "") + '" required dir="ltr" autocomplete="off" spellcheck="false" class="' + field + '"></label>' +
        '<label class="block"><span class="' + label + '">' + esc(SD.secret_key) + '</span><span class="relative block"><input name="delivery_account[api_secret]" type="password" ' + (a && a.has_credentials ? "" : "required ") + 'dir="ltr" autocomplete="new-password" spellcheck="false" class="' + field + ' pe-11" placeholder="' + esc(a && a.has_credentials ? (a.secret_hint || SD.secret_saved) : "") + '">' +
        '<button type="button" data-eye aria-label="' + esc(SD.toggle_secret) + '" class="absolute inset-y-0 end-0 flex items-center px-3 text-[#8a8380] hover:text-[#1f2430]" tabindex="-1">' + eyeIcon + "</button></span></label></div>" +
        '<p class="mt-3 text-xs text-[#8a8380]">' + esc(SD.help) + ' <a href="' + esc(SENDIT_URL) + '" target="_blank" rel="noopener" class="font-semibold text-[#a8432e] hover:underline">' + esc(SD.help_link) + " ↗</a></p>" +
        (a && a.webhook_url ? webhookBlock(a.webhook_url) + citiesLine(a) : "") +
        '<div class="mt-6 flex items-center justify-between">' + (a ? "<span></span>" : '<button type="button" data-back class="text-sm font-semibold text-[#8a8380] hover:text-[#1f2430]">← ' + esc(S["Retour"]) + "</button>") +
        '<button type="submit" class="h-11 rounded-xl bg-[#a8432e] px-5 text-sm font-semibold text-white hover:bg-[#8e3624] disabled:opacity-60">' + esc(SD.connect) + "</button></div></form>";
      return html;
    };
    var senditDone = function () {
      return '<div class="text-center"><span class="mx-auto grid size-12 place-items-center rounded-full bg-[#e3f3e8] text-xl text-[#2f7a4a]">✓</span><h2 class="mt-3 text-lg font-bold text-[#1f2430]">' + esc(SD.success_title) + '</h2><p class="mt-1 text-sm">' + esc(SD.success_text) + "</p></div>" +
        webhookBlock(state.done.webhook_url) + citiesLine({ cities_count: null }) +
        '<div class="mt-6 flex justify-end"><button type="button" data-done class="h-11 rounded-xl bg-[#a8432e] px-5 text-sm font-semibold text-white hover:bg-[#8e3624]">' + esc(SD.done) + "</button></div>";
    };

    var render = function () {
      var step = state.provider ? 2 : 1, editing = !!state.account;
      var stepCls = function (n) { return "flex items-center gap-1.5 rounded-full px-3 py-1 text-xs font-semibold " + (step === n ? "bg-[#a8432e] text-white" : "text-[#8a8380]"); };
      root.innerHTML = '<div class="flex max-h-[92dvh] w-full max-w-2xl flex-col rounded-2xl bg-white shadow-2xl" role="dialog" aria-modal="true"><div class="flex items-center justify-between border-b border-[#f0ebe7] px-6 py-4"><div class="flex items-center gap-2">' +
        (editing ? "" : '<span class="' + stepCls(1) + '">1 · ' + esc(S["Fournisseur"]) + '</span><span class="h-px w-6 bg-[#e8e3df]"></span>') + '<span class="' + stepCls(2) + '">' + (editing ? "" : "2 · ") + esc(S["Détails"]) + "</span></div>" +
        '<button type="button" data-close class="rounded-lg p-1.5 text-[#8a8380] hover:bg-[#f3f1ef]" aria-label="✕">✕</button></div><div class="overflow-y-auto px-6 py-5">' + (state.done ? senditDone() : step === 1 ? step1() : state.provider === "sendit" ? senditStep() : step2()) + "</div></div>";
    };
    var show = function () { render(); root.hidden = false; };
    var close = function () { if (state.done) return window.location.reload(); root.hidden = true; };

    root.addEventListener("click", function (e) {
      var t = e.target;
      if (t === root || t.closest("[data-close]")) return close();
      var pick = t.closest("[data-pick]"); if (pick) { state.provider = pick.dataset.pick; return render(); }
      if (t.closest("[data-back]")) { state.provider = null; return render(); }
      var region = t.closest("[data-region]"); if (region) { state.region = region.dataset.region; state.country = "all"; return render(); }
      var country = t.closest("[data-country]"); if (country) { state.country = country.dataset.country; return render(); }
      if (t.closest("[data-done]")) return window.location.reload();
      var eye = t.closest("[data-eye]");
      if (eye) { var secret = eye.parentNode.querySelector("input"); secret.type = secret.type === "password" ? "text" : "password"; return; }
      var copyBtn = t.closest("[data-copy-webhook]");
      if (copyBtn) {
        var url = root.querySelector("[data-webhook-url]").value;
        var copied = function () { copyBtn.textContent = SD.copied; setTimeout(function () { copyBtn.textContent = SD.copy; }, 1500); };
        if (navigator.clipboard) navigator.clipboard.writeText(url).then(copied); else { var input = root.querySelector("[data-webhook-url]"); input.select(); document.execCommand("copy"); copied(); }
        return;
      }
      var sw = t.closest("[data-toggle]");
      if (sw) {
        var input = root.querySelector('[data-toggle-input="' + sw.dataset.toggle + '"]'), on = input.value !== "true";
        input.value = String(on); sw.setAttribute("aria-checked", on); sw.classList.toggle("bg-[#2f7a4a]", on); sw.classList.toggle("bg-[#d9d1cc]", !on);
        var knob = sw.firstElementChild; knob.classList.toggle("start-[22px]", on); knob.classList.toggle("start-0.5", !on);
      }
    });
    root.addEventListener("submit", function (e) {
      var form = e.target.closest("[data-sendit-form]");
      if (!form) return;
      e.preventDefault();
      var button = form.querySelector("[type=submit]"), box = form.querySelector("[data-sendit-error]"), label = button.textContent;
      box.hidden = true; button.disabled = true; button.textContent = SD.connecting;
      var token = (document.querySelector('meta[name="csrf-token"]') || {}).content || "";
      var fail = function (message, detail) {
        box.textContent = message;
        if (detail) { var line = document.createElement("span"); line.className = "mt-1.5 block text-xs opacity-80"; line.textContent = SD.detail_label + " : " + detail; box.appendChild(line); }
        box.hidden = false; button.disabled = false; button.textContent = label;
      };
      fetch(form.action, { method: "POST", body: new FormData(form), headers: { Accept: "application/json", "X-CSRF-Token": token }, credentials: "same-origin" })
        .then(function (res) {
          // The answer can be seallo's own error page (not JSON): say so instead of blaming the network.
          return res.text().then(function (text) {
            var json = null; try { json = JSON.parse(text); } catch (e) {}
            return { ok: res.ok && json && json.ok, status: res.status, json: json };
          });
        })
        .then(function (r) {
          if (r.ok) { state.done = { webhook_url: r.json.webhook_url }; return render(); }
          if (r.json && r.json.error) return fail(r.json.error, r.json.detail);
          fail(SD.server_error.replace("%{status}", r.status), null);
        })
        .catch(function () { fail(SD.browser_error, null); });
    });
    root.addEventListener("input", function (e) {
      if (!e.target.matches("[data-search]")) return;
      state.q = e.target.value;
      var cards = providerCards();
      root.querySelector("[data-provider-list]").innerHTML = cards.html;
      root.querySelector("[data-result-count]").textContent = cards.list.length;
    });
    document.addEventListener("keydown", function (e) {
      if (e.key !== "Escape") return;
      close();
      document.querySelectorAll("[data-modal]").forEach(function (m) { m.hidden = true; });
    });

    var begin = function (account) { state = { provider: account ? account.provider : null, account: account, region: "all", country: "all", q: "" }; show(); };
    document.querySelectorAll("[data-delivery-new]").forEach(function (b) { b.addEventListener("click", function () { begin(null); }); });
    document.querySelectorAll("[data-delivery-edit]").forEach(function (b) {
      b.addEventListener("click", function () { begin(accounts.filter(function (a) { return a.id === Number(b.dataset.deliveryEdit); })[0]); });
    });
  })();
</script>
