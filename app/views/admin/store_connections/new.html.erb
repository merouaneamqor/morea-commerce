<% content_for :title, t("connections.add") %>
<div class="admin-page-header"><h1 class="admin-page-header__title"><%= t("connections.add") %></h1></div>
<nav aria-label="<%= t('connections.choose') %>" class="flex flex-wrap gap-3 mb-4">
  <% StoreConnection::PROVIDERS.each do |provider| %>
    <%= link_to t("connections.providers.#{provider}"), new_admin_store_connection_path(provider: provider),
      class: @connection.provider == provider ? "admin-btn" : "admin-btn-secondary",
      aria: { current: @connection.provider == provider ? "page" : nil } %>
  <% end %>
</nav>
<% if @connection.errors.any? %><div role="alert" class="admin-banner admin-banner--critical"><%= @connection.errors.full_messages.to_sentence %></div><% end %>
<% if StoreConnection::PROVIDERS.include?(@connection.provider) %>
  <% shopify = @connection.provider == "shopify" %>
  <% if shopify %><%= render "shopify_setup" %><% end %>
  <div class="admin-card p-5 max-w-2xl">
    <h2 class="admin-card__title mb-4"><%= t("connections.providers.#{@connection.provider}") %></h2>
    <% unless shopify %><p class="admin-muted mb-4"><%= t("connections.setup_lead") %></p><% end %>
    <%= form_with model: [:admin, @connection], class: "space-y-4" do |f| %>
      <%= f.hidden_field :provider %>
      <div><%= f.label :name, t("connections.name"), class: "admin-label" %><%= f.text_field :name, required: true, maxlength: 100, class: "admin-input" %></div>
      <div><%= f.label :external_domain, t("connections.domain"), class: "admin-label" %><%= f.text_field :external_domain, required: true, placeholder: shopify ? "example.myshopify.com" : "shop.example.com", class: "admin-input", dir: "ltr", aria: { describedby: "domain-help" }, autocapitalize: "none", spellcheck: false %>
        <p id="domain-help" class="admin-muted mt-1"><%= t(shopify ? "connections.shopify_setup.domain_help" : "connections.domain_help") %></p></div>
      <% if @connection.provider == "youcan" %>
        <div><%= f.label :external_store_id, t("connections.store_id"), class: "admin-label" %><%= f.text_field :external_store_id, required: true, class: "admin-input", dir: "ltr", aria: { describedby: "store-id-help" } %>
          <p id="store-id-help" class="admin-muted mt-1"><%= t("connections.store_id_help") %></p></div>
      <% end %>
      <div><%= f.label :webhook_secret, t("connections.secret"), class: "admin-label" %><%= f.password_field :webhook_secret, required: true, autocomplete: "new-password", class: "admin-input", value: nil, aria: { describedby: "secret-help" } %>
        <p id="secret-help" class="admin-muted mt-1"><%= t(shopify ? "connections.shopify_setup.secret_help" : "connections.secret_help") %></p></div>
      <div class="flex flex-wrap gap-3"><%= f.submit t("connections.save"), class: "admin-btn" %><%= link_to t("connections.back"), admin_store_connections_path, class: "admin-btn-secondary" %></div>
    <% end %>
  </div>
<% else %>
  <div class="admin-card p-5"><p><%= t("connections.choose") %></p><p class="admin-muted mt-2"><%= t("connections.setup_lead") %></p></div>
<% end %>
