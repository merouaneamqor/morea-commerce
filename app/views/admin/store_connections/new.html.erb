<% content_for :title, t("connections.add") %>
<div class="admin-page-header"><h1 class="admin-page-header__title"><%= t("connections.add") %></h1></div>
<div class="admin-card p-5 max-w-2xl">
  <p class="admin-muted mb-4"><%= t("connections.setup_lead") %></p>
  <% if @connection.errors.any? %><div role="alert" class="admin-banner admin-banner--critical"><%= @connection.errors.full_messages.to_sentence %></div><% end %>
  <%= form_with model: [:admin, @connection], class: "space-y-4" do |f| %>
    <div><%= f.label :provider, t("connections.provider"), class: "admin-label" %>
      <%= f.select :provider, StoreConnection::PROVIDERS.map { |provider| [t("connections.providers.#{provider}"), provider] }, { include_blank: t("connections.choose") }, required: true, class: "admin-input" %></div>
    <div><%= f.label :name, t("connections.name"), class: "admin-label" %><%= f.text_field :name, required: true, maxlength: 100, class: "admin-input" %></div>
    <div><%= f.label :external_domain, t("connections.domain"), class: "admin-label" %><%= f.text_field :external_domain, required: true, placeholder: "shop.example.com", class: "admin-input", dir: "ltr" %>
      <p class="admin-muted mt-1"><%= t("connections.domain_help") %></p></div>
    <div><%= f.label :external_store_id, t("connections.store_id"), class: "admin-label" %><%= f.text_field :external_store_id, class: "admin-input", dir: "ltr" %>
      <p class="admin-muted mt-1"><%= t("connections.store_id_help") %></p></div>
    <div><%= f.label :webhook_secret, t("connections.secret"), class: "admin-label" %><%= f.password_field :webhook_secret, required: true, autocomplete: "new-password", class: "admin-input", value: nil %>
      <p class="admin-muted mt-1"><%= t("connections.secret_help") %></p></div>
    <div class="flex gap-3"><%= f.submit t("connections.save"), class: "admin-btn" %><%= link_to t("connections.back"), admin_store_connections_path, class: "admin-btn-secondary" %></div>
  <% end %>
</div>
