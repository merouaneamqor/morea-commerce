<% content_for :title, "Store settings — Admin" %>

<div class="admin-page-header">
  <h1 class="admin-page-header__title">Settings</h1>
  <button type="submit" form="store-form" class="admin-btn">Save</button>
</div>

<%= form_with model: @store, url: admin_store_path, method: :patch, id: "store-form", class: "admin-stack" do |f| %>
  <section class="admin-card">
    <div class="admin-card__header"><h2 class="admin-card__title">Store details</h2></div>
    <div class="space-y-4 px-4 pb-4">
  <div>
    <%= f.label :name, "Store name", class: "admin-label" %>
    <%= f.text_field :name, class: "admin-input" %>
  </div>
  <div class="admin-field-grid">
    <div>
      <%= f.label :phone, class: "admin-label" %>
      <%= f.text_field :phone, class: "admin-input" %>
    </div>
    <div>
      <%= f.label :whatsapp, "WhatsApp", class: "admin-label" %>
      <%= f.text_field :whatsapp, class: "admin-input", placeholder: "06 12 34 56 78" %>
      <p class="admin-help">Adds WhatsApp buttons to product and order pages. Leave empty to hide them.</p>
    </div>
    <div>
      <%= f.label :email, class: "admin-label" %>
      <%= f.email_field :email, class: "admin-input" %>
    </div>
    <div>
      <%= f.label :currency, class: "admin-label" %>
      <%= f.text_field :currency, class: "admin-input" %>
    </div>
  </div>

    </div>
  </section>

  <section class="admin-card" id="integrations">
    <div class="admin-card__header"><h2 class="admin-card__title">Integrations</h2></div>
    <div class="space-y-4 px-4 pb-4">
      <p class="admin-help">Keys belong to this store only. Leave a field blank to keep the saved value.</p>
      <div class="admin-field-grid">
        <div>
          <%= f.label :sendit_public_key, "Sendit public key", class: "admin-label" %>
          <%= f.password_field :sendit_public_key, class: "admin-input", autocomplete: "off", value: "", placeholder: (@store.sendit_public_key.present? ? "•••••••• (saved)" : "") %>
        </div>
        <div>
          <%= f.label :sendit_secret_key, "Sendit secret key", class: "admin-label" %>
          <%= f.password_field :sendit_secret_key, class: "admin-input", autocomplete: "off", value: "", placeholder: (@store.sendit_secret_key.present? ? "•••••••• (saved)" : "") %>
        </div>
        <div>
          <%= f.label :sendit_webhook_secret, "Sendit webhook secret", class: "admin-label" %>
          <%= f.password_field :sendit_webhook_secret, class: "admin-input", autocomplete: "off", value: "", placeholder: (@store.sendit_webhook_secret.present? ? "•••••••• (saved)" : "") %>
          <p class="admin-help">Webhook URL: <code><%= "#{@store.origin}/webhooks/sendit/#{@store.slug}" %></code></p>
        </div>
        <div class="md:col-span-2">
          <%= f.label :discord_orders_webhook_url, "Discord orders webhook URL", class: "admin-label" %>
          <%= f.password_field :discord_orders_webhook_url, class: "admin-input", autocomplete: "off", value: "", placeholder: (@store.discord_orders_webhook_url.present? ? "•••••••• (saved)" : "https://discord.com/api/webhooks/…") %>
        </div>
      </div>
    </div>
  </section>

  <section class="admin-card" id="shipping">
    <div class="admin-card__header"><h2 class="admin-card__title">Shipping · Sendit</h2></div>
    <div class="space-y-4 px-4 pb-4">
      <% if @store.sendit_configured? %>
        <% rates = (Sendit::Districts.shipping_cents_by_city(store: @store) rescue {}) %>
        <p class="admin-help">
          Delivery fees come from Sendit by city (<%= rates.size %> cities cached).
          Checkout updates the fee when the customer picks a city.
        </p>
        <% if rates.any? %>
          <details class="admin-disclosure">
            <summary class="admin-label cursor-pointer">View Sendit city rates</summary>
            <ul class="mt-2 max-h-48 space-y-1 overflow-y-auto text-sm text-[#616161]">
              <% rates.sort_by(&:first).each do |city, cents| %>
                <li class="flex justify-between gap-4 border-b border-[#ebebeb] py-1">
                  <span><%= city %></span>
                  <span class="tabular-nums"><%= money(cents, @store.currency) %></span>
                </li>
              <% end %>
            </ul>
          </details>
        <% end %>

        <% pickup = (Sendit::Districts.pickup_cities(store: @store) rescue []) %>
        <%= f.label :sendit_pickup_district_id, "Pickup city", class: "admin-label" %>
        <%= f.select :sendit_pickup_district_id, pickup.map { |d| [ d[:name], d[:id] ] }, { include_blank: "Choose where Sendit collects your parcels" }, class: "admin-input" %>
        <p class="admin-help">Required by Sendit to create parcels. Confirmed orders are sent automatically and synced every 15 minutes.</p>
        <div class="admin-field-grid">
          <label class="admin-check"><%= f.check_box :sendit_allow_open %> Allow customer to open the parcel</label>
          <label class="admin-check"><%= f.check_box :sendit_allow_try %> Allow customer to try on</label>
        </div>
        <div>
          <%= f.label :free_shipping_threshold_dh, "Free shipping from (#{@store.currency})", class: "admin-label" %>
          <%= f.number_field :free_shipping_threshold_dh, class: "admin-input", min: 1, placeholder: "Optional" %>
          <p class="admin-help">Waives the Sendit city fee once the cart reaches this amount. Leave empty to always charge.</p>
        </div>
      <% else %>
        <p class="admin-muted">Add Sendit API keys under Integrations to load city rates from Sendit.</p>
        <div class="admin-field-grid">
          <div>
            <%= f.label :shipping_dh, "Fallback shipping fee (#{@store.currency})", class: "admin-label" %>
            <%= f.number_field :shipping_dh, class: "admin-input", min: 0 %>
            <p class="admin-help">Used only while Sendit is disconnected.</p>
          </div>
          <div>
            <%= f.label :free_shipping_threshold_dh, "Free shipping from (#{@store.currency})", class: "admin-label" %>
            <%= f.number_field :free_shipping_threshold_dh, class: "admin-input", min: 1, placeholder: "Optional" %>
          </div>
        </div>
      <% end %>
    </div>
  </section>

  <section class="admin-card">
    <div class="admin-card__header"><h2 class="admin-card__title">Inventory alerts</h2></div>
    <div class="px-4 pb-4">
      <%= f.label :low_stock_threshold, "Low-stock threshold", class: "admin-label" %>
      <%= f.number_field :low_stock_threshold, class: "admin-input", min: 0 %>
      <p class="admin-help">Products at or below this quantity appear on the Home dashboard.</p>
    </div>
  </section>


  <section class="admin-card">
    <div class="admin-card__header"><h2 class="admin-card__title">Home page</h2></div>
    <div class="space-y-4 px-4 pb-4">
  <div>
    <%= f.label :campaign_image_url, "Campaign image URL", class: "admin-label" %>
    <%= f.text_field :campaign_image_url, class: "admin-input" %>
  </div>
  <div class="admin-field-grid">
  <div>
    <%= f.label :featured_product_id, "Featured product", class: "admin-label" %>
    <%= f.collection_select :featured_product_id, @store.products.active.order(:name), :id, :name, { include_blank: true }, class: "admin-input" %>
  </div>
  <div>
    <%= f.label :featured_collection_id, "Featured collection", class: "admin-label" %>
    <%= f.collection_select :featured_collection_id, @store.collections.published, :id, :name, { include_blank: true }, class: "admin-input" %>
  </div>
  </div>
    </div>
  </section>

  <% @store.build_missing_translations! %>

  <%= f.fields_for :translations, @store.translations.sort_by { |t| Morea::Locales::AVAILABLE.map(&:to_s).index(t.locale) || 99 } do |tf| %>
    <% locale = tf.object.locale %>
    <details class="admin-card admin-disclosure" <%= "open" if locale == "fr" %>>
      <summary class="admin-card__header admin-disclosure__summary">
        <h2 class="admin-card__title"><%= Morea::Locales.label_for(locale) %></h2>
        <% if @store.locale_complete?(locale) %><span class="admin-badge admin-badge--success">Complete</span><% else %><span class="admin-badge admin-badge--attention">Missing</span><% end %>
      </summary>
      <div class="space-y-4 px-4 pb-4">
      <%= tf.hidden_field :id if tf.object.persisted? %>
      <%= tf.hidden_field :locale %>
      <div id="announcement<%= "-#{locale}" unless locale == "fr" %>">
        <%= tf.label :announcement, "Announcement bar", class: "admin-label" %>
        <%= tf.text_field :announcement, class: "admin-input", placeholder: "Leave empty to hide the bar", dir: (locale == "ar" ? "rtl" : "ltr"), lang: locale %>
        <p class="admin-help">Shown above the header on every page.</p>
      </div>
      <div>
        <%= tf.label :tagline, class: "admin-label" %>
        <%= tf.text_field :tagline, class: "admin-input", dir: (locale == "ar" ? "rtl" : "ltr"), lang: locale %>
      </div>
      <div>
        <%= tf.label :about, class: "admin-label" %>
        <%= tf.text_area :about, rows: 4, class: "admin-input", dir: (locale == "ar" ? "rtl" : "ltr"), lang: locale %>
      </div>
      <div>
        <%= tf.label :cod_label, class: "admin-label" %>
        <%= tf.text_field :cod_label, class: "admin-input", dir: (locale == "ar" ? "rtl" : "ltr"), lang: locale %>
      </div>
      <div>
        <%= tf.label :cod_note, class: "admin-label" %>
        <%= tf.text_area :cod_note, rows: 2, class: "admin-input", dir: (locale == "ar" ? "rtl" : "ltr"), lang: locale %>
      </div>
      <div class="admin-field-grid">
        <div>
          <%= tf.label :campaign_title, class: "admin-label" %>
          <%= tf.text_field :campaign_title, class: "admin-input", dir: (locale == "ar" ? "rtl" : "ltr"), lang: locale %>
        </div>
        <div>
          <%= tf.label :campaign_season, class: "admin-label" %>
          <%= tf.text_field :campaign_season, class: "admin-input", dir: (locale == "ar" ? "rtl" : "ltr"), lang: locale %>
        </div>
        <div class="md:col-span-2">
          <%= tf.label :campaign_cta, "Campaign CTA", class: "admin-label" %>
          <%= tf.text_field :campaign_cta, class: "admin-input", dir: (locale == "ar" ? "rtl" : "ltr"), lang: locale %>
        </div>
      </div>
      </div>
    </details>
  <% end %>

  <div class="flex justify-end">
    <%= f.submit "Save", class: "admin-btn" %>
  </div>
<% end %>
