<% content_for :title, t(@access_request ? "platform_admin.review_request" : "platform_admin.new_workspace") %>

<div class="admin-page-header">
  <div>
    <h1 class="admin-page-header__title"><%= t(@access_request ? "platform_admin.review_request" : "platform_admin.new_workspace") %></h1>
    <p class="admin-page-header__meta"><%= t("platform_admin.workspace_description") %></p>
  </div>
  <%= link_to t("platform_admin.back"), admin_platform_path, class: "admin-btn-secondary" %>
</div>

<%= form_with model: @store, url: admin_tenants_path, class: "admin-stack" do |f| %>
  <% if @access_request %>
    <%= hidden_field_tag :access_request_id, @access_request.id %>
    <div class="admin-banner"><%= t("platform_admin.request_review_description", email: @access_request.email) %></div>
  <% end %>
  <% if @store.errors.any? %>
    <div class="admin-banner admin-banner--critical">
      <%= @store.errors.full_messages.to_sentence %>
    </div>
  <% end %>

  <section class="admin-card">
    <div class="admin-card__header"><h2 class="admin-card__title"><%= t("platform_admin.workspace") %></h2></div>
    <div class="space-y-4 px-4 pb-4">
      <div class="admin-field-grid">
        <div>
          <%= f.label :name, t("platform_admin.fields.business"), class: "admin-label" %>
          <%= f.text_field :name, class: "admin-input", required: true %>
        </div>
        <div>
          <%= f.label :slug, t("platform_admin.fields.subdomain"), class: "admin-label" %>
          <%= f.text_field :slug, class: "admin-input", required: true, placeholder: "atelier" %>
          <p class="admin-help"><%= t("platform_admin.subdomain_help", domain: "….#{Store.base_domain}") %></p>
        </div>
        <div>
          <%= f.label :email, t("platform_admin.fields.email"), class: "admin-label" %>
          <%= f.email_field :email, class: "admin-input" %>
        </div>
        <div>
          <%= f.label :phone, t("platform_admin.fields.phone"), class: "admin-label" %>
          <%= f.text_field :phone, class: "admin-input" %>
        </div>
        <div>
          <%= f.label :currency, t("platform_admin.fields.currency"), class: "admin-label" %>
          <%= f.text_field :currency, class: "admin-input" %>
        </div>
      </div>
      <div>
        <label class="admin-check"><%= f.check_box :storefront_enabled %> <%= t("onboarding.enable_storefront") %></label>
        <p class="admin-help"><%= t("onboarding.settings_help") %></p>
      </div>
    </div>
  </section>

  <section class="admin-card">
    <div class="admin-card__header"><h2 class="admin-card__title"><%= t("platform_admin.billing") %></h2></div>
    <div class="space-y-4 px-4 pb-4">
      <%= render "billing_fields", f: f %>
    </div>
  </section>

  <section class="admin-card">
    <div class="admin-card__header"><h2 class="admin-card__title"><%= t("platform_admin.first_admin") %></h2></div>
    <div class="space-y-4 px-4 pb-4">
      <div class="admin-field-grid">
        <div>
          <label class="admin-label" for="admin_email"><%= t("platform_admin.fields.email") %></label>
          <input class="admin-input" type="email" name="admin[email]" id="admin_email" value="<%= @access_request&.email %>" required>
        </div>
        <div>
          <label class="admin-label" for="admin_password"><%= t("platform_admin.fields.password") %></label>
          <input class="admin-input" type="password" name="admin[password]" id="admin_password" required autocomplete="new-password">
        </div>
      </div>
    </div>
  </section>

  <div class="flex justify-end">
    <%= f.submit t(@access_request ? "platform_admin.approve_and_create_workspace" : "platform_admin.create_workspace"), class: "admin-btn" %>
  </div>
<% end %>
