<% sections = local_assigns.fetch(:sections) %>
<% locale = local_assigns.fetch(:locale, I18n.locale) %>
<% empty_message = local_assigns.fetch(:empty_message, t("storefront_themes.empty_editor")) %>
<% selected_index = local_assigns[:selected_index] %>

<div class="storefront-body theme-editor-storefront-preview <%= "is-rtl" if Morea::Locales.rtl?(locale) %>"
     dir="<%= Morea::Locales.rtl?(locale) ? "rtl" : "ltr" %>"
     lang="<%= locale %>"
     data-theme-preview-sections>
  <% if sections.empty? %>
    <p class="px-6 py-16 text-center text-stone-500"><%= empty_message %></p>
  <% else %>
    <% sections.each_with_index do |section, visible_index| %>
      <% snapshot_index = section.position %>
      <div class="theme-editor-preview-section outline-none transition ring-inset <%= "ring-2 ring-blue-500" if selected_index.present? && selected_index.to_i == snapshot_index.to_i %>"
           data-preview-section="<%= section.kind %>"
           data-preview-index="<%= visible_index %>"
           data-section-index="<%= snapshot_index %>"
           role="button"
           tabindex="0"
           aria-pressed="<%= selected_index.present? && selected_index.to_i == snapshot_index.to_i %>"
           aria-label="<%= SectionBlock::KINDS.fetch(section.kind, section.kind.humanize) %>">
        <%= render "home/sections/#{section.kind}", section: section, first: visible_index.zero? %>
      </div>
    <% end %>
  <% end %>
</div>
