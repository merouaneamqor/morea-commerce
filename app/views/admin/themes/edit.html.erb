<% content_for :title, "Customize #{@theme.name}, Themes" %>
<% section_kinds = SectionBlock::KINDS.map { |kind, label| { kind: kind, label: label, description: SectionBlock::DESCRIPTIONS.fetch(kind) } } %>

<div class="te-shell"
     data-controller="theme-editor"
     data-theme-editor
     data-editor-pane="preview"
     data-theme-editor-save-url-value="<%= admin_theme_path(@theme) %>"
     data-theme-editor-image-url-value="<%= image_admin_theme_path(@theme) %>"
     data-theme-editor-preview-url-value="<%= preview_frame_admin_theme_path(@theme) %>"
     data-theme-editor-read-only-value="<%= @theme.published? %>"
     data-theme-editor-max-sections-value="<%= StorefrontThemes::UpdateSnapshot::MAX_SECTIONS %>"
     data-theme-editor-section-kinds-value="<%= section_kinds.to_json %>"
     data-theme-editor-remove-confirm-value="<%= t('storefront_themes.remove_confirm') %>"
     data-theme-editor-empty-editor-value="<%= t('storefront_themes.empty_editor') %>"
     <%= "data-theme-editor-read-only" if @theme.published? %>>
  <header class="te-topbar">
    <%= link_to admin_theme_path(@theme), class: "te-exit" do %>
      <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M10.5 3.5 6 8l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
      Exit
    <% end %>
    <div class="te-title">
      <h1><%= @theme.name %></h1>
      <span class="te-status" data-theme-editor-target="saveStatus"><%= @theme.published? ? "Published" : "Draft" %></span>
    </div>

    <div class="te-topbar__center">
      <button type="button" class="te-icon-btn" data-theme-editor-target="undoButton" data-action="theme-editor#undo" aria-label="Undo change" disabled>
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M6.2 4.2 3 7.4l3.2 3.2" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><path d="M3.4 7.4h6.1a3.5 3.5 0 0 1 0 7" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
      </button>
      <button type="button" class="te-icon-btn" data-theme-editor-target="redoButton" data-action="theme-editor#redo" aria-label="Redo change" disabled>
        <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M9.8 4.2 13 7.4 9.8 10.6" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><path d="M12.6 7.4H6.5a3.5 3.5 0 0 0 0 7" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
      </button>
      <div class="te-segment" role="group" aria-label="Preview size">
        <button type="button" data-theme-editor-target="desktopButton" data-action="theme-editor#setDesktop" aria-pressed="true">
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><rect x="2" y="3" width="12" height="8" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M6 13.2h4M8 11v2.2" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
          Desktop
        </button>
        <button type="button" data-theme-editor-target="mobileButton" data-action="theme-editor#setMobile" aria-pressed="false">
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><rect x="5" y="2" width="6" height="12" rx="1.2" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M7.2 12.2h1.6" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
          Mobile
        </button>
      </div>
    </div>

    <div class="te-topbar__end">
      <label class="te-sr" for="theme-editor-locale">Preview language</label>
      <select id="theme-editor-locale" class="te-locale" data-theme-editor-target="locale" data-action="change->theme-editor#changeLocale">
        <option value="fr">FR</option>
        <option value="en">EN</option>
        <option value="ar">AR</option>
        <option value="es">ES</option>
      </select>
      <% unless @theme.published? %>
        <button type="button" class="te-save" data-theme-editor-save data-theme-editor-target="saveButton" data-action="theme-editor#save">Save</button>
      <% end %>
    </div>
  </header>

  <% if @theme.published? %>
    <p class="te-banner" role="status">
      This published theme is read-only.
      <%= button_to "Duplicate as draft", duplicate_admin_theme_path(@theme), method: :post, form: { data: { turbo: false } } %>
      to edit a copy.
    </p>
  <% end %>

  <div class="te-panes" role="tablist" aria-label="Editor">
    <button type="button" role="tab" data-theme-editor-pane="sections" data-action="theme-editor#showPane" aria-pressed="false">Sections</button>
    <button type="button" role="tab" data-theme-editor-pane="preview" data-action="theme-editor#showPane" aria-pressed="true">Preview</button>
    <button type="button" role="tab" data-theme-editor-pane="settings" data-action="theme-editor#showPane" aria-pressed="false">Settings</button>
  </div>

  <div class="te-workspace">
    <aside class="te-sidebar" aria-label="Home page sections">
      <div class="te-panel-head">
        <h2>Home page</h2>
        <span data-theme-editor-target="sectionCount"><%= pluralize(@theme.snapshot.fetch("sections", []).size, "section", locale: :en) %></span>
      </div>
      <ol class="te-sections" data-theme-editor-sections data-theme-editor-target="sectionList"></ol>
      <p class="te-empty" data-theme-editor-target="emptyState" hidden><%= t("storefront_themes.empty_editor") %></p>
      <% unless @theme.published? %>
        <div class="te-sidebar__foot">
          <button type="button"
                  class="te-add"
                  data-theme-editor-add
                  data-theme-editor-target="addButton"
                  data-action="theme-editor#openPicker">
            Add section
          </button>
        </div>
      <% end %>
    </aside>

    <main class="te-canvas" aria-label="Storefront preview">
      <div class="te-frame" data-theme-editor-target="previewFrame">
        <div class="te-preview" data-theme-editor-preview data-theme-editor-target="preview" aria-live="polite">
          <p class="te-empty">Loading storefront preview…</p>
        </div>
      </div>
    </main>

    <aside class="te-inspector" aria-label="Section settings">
      <div class="te-panel-head">
        <h2 data-theme-editor-target="settingsTitle">Section settings</h2>
      </div>
      <form class="te-form" data-theme-editor-target="settingsForm" data-action="input->theme-editor#updateField change->theme-editor#updateField"></form>
    </aside>
  </div>

  <dialog class="te-dialog" data-theme-editor-target="sectionPicker" aria-labelledby="theme-section-picker-title">
    <div class="te-dialog__head">
      <h2 id="theme-section-picker-title">Add section</h2>
      <button type="button" class="te-icon-btn" data-action="theme-editor#closePicker" aria-label="Close section picker">
        <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 3l8 8M11 3 3 11" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/></svg>
      </button>
    </div>
    <div class="te-dialog__body">
      <ul class="te-picker" data-theme-editor-target="sectionPickerList" role="listbox" aria-label="Section types"></ul>
    </div>
  </dialog>

  <script type="application/json" data-theme-editor-target="payload"><%= raw(json_escape(@theme.snapshot.to_json)) %></script>
</div>
