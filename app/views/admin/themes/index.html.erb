<% content_for :title, "Themes — Online Store" %>

<div class="admin-page-header">
  <div>
    <h1 class="admin-page-header__title">Themes</h1>
    <p class="admin-page-header__meta">Choose a starting point, preview it safely, then publish when it is ready.</p>
  </div>
</div>

<%= render "admin/shared/online_store_tabs" %>

<section class="admin-card mb-6" aria-labelledby="installed-themes-heading">
  <div class="admin-card__header">
    <div>
      <h2 id="installed-themes-heading" class="admin-card__title">Installed themes</h2>
      <p class="admin-muted mt-1">Publishing replaces the current home page sections. Products, collections, pages, menus and store settings stay unchanged.</p>
    </div>
    <span class="admin-muted"><%= pluralize(@themes.size, "theme", locale: :en) %></span>
  </div>

  <% if @themes.any? %>
    <div class="grid gap-4 p-4 md:grid-cols-2 xl:grid-cols-3">
      <% @themes.each do |theme| %>
        <article class="rounded-lg border border-[#dedede] bg-white p-4" data-theme-id="<%= theme.id %>">
          <div class="mb-4 flex aspect-[4/3] items-center justify-center rounded-md bg-gradient-to-br from-[#f4eee7] to-[#ded4ca]" aria-hidden="true">
            <div class="w-3/4 space-y-3 rounded bg-white/90 p-4 shadow-sm">
              <div class="h-3 w-1/3 rounded bg-[#a98d75]"></div>
              <div class="h-8 rounded bg-[#292622]"></div>
              <div class="grid grid-cols-3 gap-2"><span class="h-12 bg-[#e8dfd6]"></span><span class="h-12 bg-[#e8dfd6]"></span><span class="h-12 bg-[#e8dfd6]"></span></div>
            </div>
          </div>
          <div class="flex items-start justify-between gap-3">
            <div><h3 class="font-semibold"><%= theme.name %></h3><p class="admin-muted mt-1"><%= theme.snapshot.fetch("sections", []).size %> home page sections</p></div>
            <span class="admin-badge <%= theme.published? ? 'admin-badge--success' : 'admin-badge--neutral' %>"><%= theme.published? ? "Published" : "Draft" %></span>
          </div>
          <div class="mt-4 flex gap-2">
            <%= link_to "Manage", admin_theme_path(theme), class: "admin-btn-secondary" %>
            <%= link_to "Preview", preview_admin_theme_path(theme), class: "admin-btn-secondary" %>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <p class="admin-empty">No theme is installed yet. Choose one from the theme library below.</p>
  <% end %>
</section>

<section aria-labelledby="theme-library-heading">
  <div class="mb-3">
    <h2 id="theme-library-heading" class="text-lg font-semibold">Theme library</h2>
    <p class="admin-muted mt-1">Built-in themes install as drafts and do not change the live storefront.</p>
  </div>
  <div class="grid gap-4 md:grid-cols-2">
    <% @catalog.each do |preset| %>
      <article class="admin-card overflow-hidden" data-catalog-theme="<%= preset[:key] %>">
        <div class="flex min-h-52 items-center justify-center bg-gradient-to-br <%= preset[:key] == 'minimal' ? 'from-stone-100 to-white' : 'from-[#eaded2] to-[#c9aa8d]' %> p-6" aria-hidden="true">
          <div class="w-full max-w-sm rounded bg-white p-5 shadow-lg">
            <div class="mb-4 h-2 w-1/4 rounded bg-stone-400"></div><div class="mb-3 h-10 rounded bg-stone-800"></div><div class="h-20 rounded bg-stone-200"></div>
          </div>
        </div>
        <div class="flex flex-wrap items-center justify-between gap-3 p-4">
          <div><h3 class="font-semibold"><%= preset[:name] %></h3><p class="admin-muted mt-1"><%= pluralize(preset[:snapshot].fetch("sections").size, "section", locale: :en) %> · FR / EN / AR</p></div>
          <%= button_to "Install theme", install_admin_themes_path, params: { catalog_key: preset[:key] }, class: "admin-btn" %>
        </div>
      </article>
    <% end %>
  </div>
</section>
