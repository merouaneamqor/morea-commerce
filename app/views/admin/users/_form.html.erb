<div class="admin-page-header">
  <div class="flex items-center gap-2">
    <%= link_to admin_users_path, class: "admin-back", "aria-label": "Back to staff" do %><%= admin_icon(:back) %><% end %>
    <h1 class="admin-page-header__title"><%= @user.persisted? ? (@user.name.presence || @user.email) : "Invite staff" %></h1>
  </div>
  <button type="submit" form="user-form" class="admin-btn">Save</button>
</div>

<%= form_with model: [:admin, @user], id: "user-form", class: "admin-stack" do |f| %>
  <% if @user.errors.any? %>
    <div class="admin-banner admin-banner--critical"><%= @user.errors.full_messages.to_sentence %></div>
  <% end %>

  <section class="admin-card">
    <div class="admin-card__header"><h2 class="admin-card__title">Account</h2></div>
    <div class="space-y-4 px-4 pb-4">
      <div class="admin-field-grid">
        <div>
          <%= f.label :name, class: "admin-label" %>
          <%= f.text_field :name, class: "admin-input" %>
        </div>
        <div>
          <%= f.label :email, class: "admin-label" %>
          <%= f.email_field :email, class: "admin-input", required: true %>
        </div>
        <div>
          <%= f.label :password, @user.persisted? ? "New password" : "Password", class: "admin-label" %>
          <%= f.password_field :password, class: "admin-input", required: !@user.persisted?, autocomplete: "new-password" %>
          <% if @user.persisted? %><p class="admin-help">Leave blank to keep the current password.</p><% end %>
        </div>
        <div>
          <%= f.label :password_confirmation, "Confirm password", class: "admin-label" %>
          <%= f.password_field :password_confirmation, class: "admin-input", autocomplete: "new-password" %>
        </div>
      </div>
      <label class="admin-check"><%= f.check_box :admin %> Admin access</label>
    </div>
  </section>

  <div class="flex justify-end">
    <%= f.submit "Save", class: "admin-btn" %>
  </div>
<% end %>
