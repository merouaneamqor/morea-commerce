<% content_for :title, "#{t('admin.team.title')} — Admin" %>
<% members = @users.reject(&:super_admin?) %>
<% totals = @summaries.values %>

<div class="admin-page-header">
  <div>
    <h1 class="admin-page-header__title"><%= t("admin.team.title") %></h1>
    <p class="admin-page-header__meta max-w-xl"><%= t("admin.team.subtitle") %></p>
  </div>
  <%= link_to t("admin.team.add_member"), new_admin_user_path, class: "admin-btn" %>
</div>

<div class="seallo-stats mb-4">
  <div class="seallo-stat"><span><%= t("admin.team.members") %></span><strong><%= members.size %></strong></div>
  <div class="seallo-stat seallo-stat--blue"><span><%= t("admin.team.confirmed_month") %></span><strong><%= totals.sum { |s| s.figures.confirmed } %></strong></div>
  <div class="seallo-stat seallo-stat--green"><span><%= t("admin.team.delivered_month") %></span><strong><%= totals.sum { |s| s.figures.delivered } %></strong></div>
  <div class="seallo-stat seallo-stat--rose"><span><%= t("admin.team.payroll_month") %></span><strong><%= money(totals.sum(&:earned_period)) %></strong></div>
</div>

<div class="seallo-member-grid">
  <% members.each do |user| %>
    <% summary = @summaries.fetch(user.id) %>
    <% figures = summary.figures %>
    <% agent = user.confirmation_agent? %>
    <section class="seallo-member">
      <header class="seallo-member__head">
        <span class="seallo-member__avatar"><%= (user.name.presence || user.email).first.upcase %></span>
        <div class="min-w-0">
          <div class="flex flex-wrap items-center gap-2">
            <strong class="truncate"><%= user.name.presence || user.email %></strong>
            <% if user == current_user %><span class="admin-muted">· <%= t("admin.team.you") %></span><% end %>
            <% if user.admin? %>
              <span class="seallo-chip seallo-chip--dark"><%= t("admin.team.owner") %></span>
            <% else %>
              <span class="seallo-chip seallo-chip--rose"><%= agent ? t("admin.team.role_agent") : t("admin.team.role_supervisor") %></span>
            <% end %>
          </div>
          <p class="admin-muted truncate"><%= user.email %></p>
        </div>
      </header>

      <% if agent %>
        <p class="seallo-member__pay"><%= t("admin.team.pay_rate", amount: money(user.pay_per_delivery_cents)) %></p>
        <dl class="seallo-member__figures">
          <div><dt><%= t("admin.team.confirmed") %></dt><dd><%= figures.confirmed %></dd></div>
          <div><dt><%= t("admin.team.cancelled") %></dt><dd><%= figures.cancelled %></dd></div>
          <div><dt><%= t("admin.team.delivered") %></dt><dd><%= figures.delivered %></dd></div>
          <div><dt><%= t("admin.team.rate") %></dt><dd><%= figures.delivery_rate ? "#{(figures.delivery_rate * 100).round} %" : "—" %></dd></div>
        </dl>
        <dl class="seallo-member__money">
          <div><dt><%= t("admin.team.earnings") %></dt><dd><%= money(summary.earned_total) %></dd></div>
          <div><dt><%= t("admin.team.already_paid") %></dt><dd><%= money(summary.paid_total) %></dd></div>
          <div><dt><%= t("admin.team.unpaid") %></dt><dd><%= money(summary.unpaid) %></dd></div>
        </dl>
      <% else %>
        <p class="admin-muted"><%= t("admin.team.owner_access") %></p>
      <% end %>

      <footer class="seallo-member__actions">
        <% if agent %>
          <%= button_to t("admin.team.pay"), pay_admin_user_path(user), method: :post, class: "admin-btn seallo-btn-green", disabled: summary.unpaid.zero? %>
        <% end %>
        <%= link_to t("admin.team.edit"), edit_admin_user_path(user), class: "admin-btn-secondary" %>
        <% unless user == current_user %>
          <%= button_to t("admin.team.remove"), admin_user_path(user), method: :delete,
                form: { data: { turbo_confirm: t("admin.team.remove_confirm", name: user.name.presence || user.email) } },
                class: "admin-btn-plain admin-btn-plain--critical" %>
        <% end %>
      </footer>
    </section>
  <% end %>
</div>
