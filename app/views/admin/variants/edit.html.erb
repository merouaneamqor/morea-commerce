<% content_for :title, "Edit #{@variant.display_name} — #{@product.name} — Admin" %>

<div class="admin-page-header">
  <div class="flex items-center gap-2">
    <%= link_to edit_admin_product_path(@product), class: "admin-back", "aria-label": "Back to product" do %><%= admin_icon(:back) %><% end %>
    <div>
      <p class="admin-muted text-sm"><%= @product.name %></p>
      <h1 class="admin-page-header__title">Edit <%= @variant.display_name %></h1>
    </div>
  </div>
  <button type="submit" form="variant-form" class="admin-btn">Save variant</button>
</div>

<%= form_with url: admin_product_variant_path(@product, @variant), method: :patch, scope: :product_variant, id: "variant-form" do %>
  <div class="admin-layout">
    <div class="admin-stack">
      <section class="admin-card">
        <div class="admin-card__header"><h2 class="admin-card__title">Options</h2></div>
        <div class="admin-field-grid px-4 pb-4">
          <div>
            <%= label_tag "product_variant_option1_value", "Size", class: "admin-label" %>
            <%= text_field_tag "product_variant[option1_value]", @variant.option1_value, class: "admin-input", id: "product_variant_option1_value" %>
          </div>
          <div>
            <%= label_tag "product_variant_option2_value", "Color", class: "admin-label" %>
            <%= text_field_tag "product_variant[option2_value]", @variant.option2_value, class: "admin-input", id: "product_variant_option2_value" %>
          </div>
          <div>
            <%= label_tag "product_variant_color_hex", "Color swatch", class: "admin-label" %>
            <%= text_field_tag "product_variant[color_hex]", @variant.color_hex, class: "admin-input", id: "product_variant_color_hex", placeholder: "#000000" %>
          </div>
        </div>
      </section>

      <section class="admin-card">
        <div class="admin-card__header"><h2 class="admin-card__title">Media</h2></div>
        <div class="space-y-4 px-4 pb-4">
          <p class="admin-help">These images appear when this variant is selected on the storefront. They do not alter the product gallery.</p>
          <% if @variant.images.attached? %>
            <div class="admin-media-grid">
              <% @variant.ordered_images.each do |image| %>
                <div class="admin-media-item">
                  <%= image_tag MediaUrl.sized(media_url(image), width: 320), alt: "" %>
                  <label class="admin-media-item__bar admin-media-item__remove" title="Remove when saved">
                    <%= check_box_tag "product_variant[remove_image_ids][]", image.id, false, id: nil, class: "h-3.5 w-3.5 accent-[#303030]" %> Remove
                  </label>
                </div>
              <% end %>
            </div>
          <% end %>
          <label class="admin-dropzone">
            <span class="admin-btn-secondary pointer-events-none">Upload images</span>
            <span class="admin-help">Add photos specific to <%= @variant.display_name %>.</span>
            <%= file_field_tag "product_variant[images][]", multiple: true, direct_upload: false, accept: "image/*", class: "sr-only" %>
          </label>
        </div>
      </section>
    </div>

    <div class="admin-stack">
      <section class="admin-card">
        <div class="admin-card__header"><h2 class="admin-card__title">Pricing</h2></div>
        <div class="px-4 pb-4">
          <%= label_tag "product_variant_price_dh", "Price override", class: "admin-label" %>
          <%= number_field_tag "product_variant[price_dh]", @variant.price_dh, class: "admin-input", id: "product_variant_price_dh", min: 0, placeholder: "Uses product price" %>
          <p class="admin-help">Leave blank to use the product price.</p>
        </div>
      </section>

      <section class="admin-card">
        <div class="admin-card__header"><h2 class="admin-card__title">Inventory</h2></div>
        <div class="space-y-4 px-4 pb-4">
          <div>
            <%= label_tag "product_variant_sku", "SKU", class: "admin-label" %>
            <%= text_field_tag "product_variant[sku]", @variant.sku, class: "admin-input", id: "product_variant_sku" %>
          </div>
          <div>
            <%= label_tag "product_variant_stock", "Available", class: "admin-label" %>
            <%= number_field_tag "product_variant[stock]", @variant.stock, class: "admin-input", id: "product_variant_stock", min: 0 %>
          </div>
          <label class="admin-check"><%= hidden_field_tag "product_variant[active]", "0" %><%= check_box_tag "product_variant[active]", "1", @variant.active %> Available for sale</label>
        </div>
      </section>
    </div>
  </div>
<% end %>

<div class="mt-6 flex justify-between border-t border-[#e3e3e3] pt-4">
  <%= button_to "Delete variant", admin_product_variant_path(@product, @variant), method: :delete, form: { data: { turbo_confirm: "Delete this variant?" } }, class: "admin-btn-critical" %>
  <button type="submit" form="variant-form" class="admin-btn">Save variant</button>
</div>
