<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title><%= @title %> — Morea</title>
    <style>
      :root {
        --ink: #1a1716;
        --ink-soft: #4a4340;
        --paper: #faf9f7;
        --stone: #f7f5f2;
        --brass: #9a6f72;
        --ok: #2f5d50;
        --bad: #8a3030;
      }
      * { box-sizing: border-box; margin: 0; }
      body {
        min-height: 100dvh;
        display: grid;
        place-items: center;
        padding: 2rem 1.25rem;
        background: var(--stone);
        color: var(--ink);
        font-family: "DM Sans", ui-sans-serif, system-ui, sans-serif;
      }
      .card {
        width: min(28rem, 100%);
        background: var(--paper);
        border: 1px solid rgba(26, 23, 22, 0.1);
        padding: 2rem 1.5rem;
        text-align: center;
      }
      .eyebrow {
        font-size: 0.7rem;
        letter-spacing: 0.24em;
        text-transform: uppercase;
        color: var(--brass);
      }
      h1 {
        margin-top: 0.75rem;
        font-family: "Cormorant Garamond", Georgia, serif;
        font-size: 2rem;
        font-weight: 400;
        color: <%= @ok ? "var(--ok)" : "var(--bad)" %>;
      }
      p {
        margin-top: 0.85rem;
        color: var(--ink-soft);
        line-height: 1.6;
        font-size: 0.95rem;
      }
      .meta {
        margin-top: 1.25rem;
        font-size: 0.7rem;
        letter-spacing: 0.18em;
        text-transform: uppercase;
        color: var(--ink-soft);
      }
    </style>
  </head>
  <body>
    <main class="card">
      <p class="eyebrow">Morea orders</p>
      <h1><%= @title %></h1>
      <p><%= @message %></p>
      <% if @order %>
        <p class="meta"><%= @order.number %> · <%= @order.status %></p>
      <% end %>
    </main>
  </body>
</html>
