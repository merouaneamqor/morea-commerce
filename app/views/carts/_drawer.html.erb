<%# Slide-out bag. Re-rendered by Turbo Streams after add / update / remove. %>
<% items = cart.cart_items.includes(product: [:translations, { images_attachments: :blob }], product_variant: []).order(:created_at) %>
<div id="cart-drawer"
     class="cart-drawer"
     data-cart-drawer-target="drawer"
     data-open="<%= local_assigns[:open] ? "true" : "false" %>"
     aria-hidden="true">
  <div class="cart-drawer__scrim" data-action="click->cart-drawer#close"></div>
  <aside class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="<%= t("cart.title") %>">
    <header class="cart-drawer__head">
      <p class="font-display text-2xl text-ink"><%= t("cart.title") %> <span class="text-base text-ink-faint">(<%= cart.item_count %>)</span></p>
      <button type="button" class="cart-drawer__close" data-action="cart-drawer#close" aria-label="<%= t("cart.close") %>">
        <svg width="18" height="18" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><path d="M4 4l12 12M16 4 4 16"/></svg>
      </button>
    </header>

    <% if items.empty? %>
      <div class="cart-drawer__empty">
        <p class="text-sm text-ink-soft"><%= t("cart.empty") %></p>
        <%= link_to t("cart.continue_shopping"), collections_path, class: "maison-cta mt-8" %>
      </div>
    <% else %>
      <ul class="cart-drawer__items">
        <% items.each do |item| %>
          <li class="cart-drawer__item">
            <%= link_to product_path(item.product), class: "object-frame aspect-[3/4] w-20 shrink-0" do %>
              <%= product_image_tag item.product, sizes: "80px", widths: [160, 240] %>
            <% end %>
            <div class="min-w-0 flex-1">
              <p class="font-display text-lg leading-snug text-ink"><%= item.product.name %></p>
              <% if item.product_variant %>
                <p class="mt-1 text-[10px] uppercase tracking-[0.2em] text-ink-faint"><%= item.product_variant.display_name %></p>
              <% end %>
              <div class="mt-3 flex items-center justify-between gap-3">
                <div class="cart-qty">
                  <%= button_to "−", update_item_cart_path, method: :patch, params: { item_id: item.id, quantity: item.quantity - 1, from: "drawer" },
                        class: "cart-qty__btn", disabled: item.quantity <= 1, "aria-label": t("cart.decrease") %>
                  <span class="cart-qty__value"><%= item.quantity %></span>
                  <%= button_to "+", update_item_cart_path, method: :patch, params: { item_id: item.id, quantity: item.quantity + 1, from: "drawer" },
                        class: "cart-qty__btn", "aria-label": t("cart.increase") %>
                </div>
                <p class="text-sm text-ink"><%= money(item.line_total_cents, item.product.currency) %></p>
              </div>
              <%= button_to t("cart.remove"), remove_item_cart_path, method: :delete, params: { item_id: item.id, from: "drawer" },
                    class: "mt-2 text-[10px] uppercase tracking-[0.18em] text-ink-faint hover:text-ink" %>
            </div>
          </li>
        <% end %>
      </ul>

      <footer class="cart-drawer__foot">
        <div class="flex items-baseline justify-between">
          <p class="text-[10px] uppercase tracking-[0.24em] text-ink-soft"><%= t("cart.subtotal") %></p>
          <p class="font-display text-2xl text-ink"><%= money(cart.subtotal_cents, current_store.currency) %></p>
        </div>
        <p class="mt-2 text-xs leading-5 text-ink-faint"><%= current_store.cod_label %> · <%= t("landing.trust.returns") %></p>
        <%= link_to t("cart.checkout"), checkout_path, class: "maison-button mt-5 block w-full text-center", data: { turbo_frame: "_top" } %>
        <%= link_to t("cart.view_bag"), cart_path, class: "mt-4 block text-center text-[10px] uppercase tracking-[0.24em] text-ink-soft hover:text-ink" %>
      </footer>
    <% end %>
  </aside>
</div>
