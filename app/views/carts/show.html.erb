<% content_for :title, "#{t("cart.title")} — #{current_store.name}" %>

<section class="cart-page">
  <h1 class="font-display text-3xl text-ink md:text-4xl"><%= t("cart.title") %></h1>

  <% if @items.empty? %>
    <div class="mt-10 md:mt-12">
      <p class="text-sm text-ink-soft"><%= t("cart.empty") %></p>
      <p class="mt-3 text-sm text-ink-faint"><%= t("cart.empty_hint") %></p>
      <div class="mt-8 flex flex-wrap gap-6 md:mt-10">
        <%= link_to t("cart.continue_shopping"), collections_path, class: "maison-cta" %>
        <%= link_to t("nav.home"), localized_root_path, class: "maison-link self-start pt-1" %>
      </div>
    </div>
  <% else %>
    <ul class="mt-10 space-y-8 md:mt-14 md:space-y-10">
      <% @items.each do |item| %>
        <li class="grid grid-cols-[5rem_1fr] gap-4 border-b border-line pb-8 sm:grid-cols-[7rem_1fr] md:grid-cols-12 md:gap-6 md:pb-10">
          <div class="object-frame aspect-[3/4] md:col-span-3">
            <%= product_image_tag item.product, sizes: "(max-width: 768px) 28vw, 25vw", widths: [160, 240, 360] %>
          </div>
          <div class="flex min-w-0 flex-col gap-3 md:col-span-9 md:grid md:grid-cols-9 md:gap-4">
            <div class="space-y-2 md:col-span-6">
              <p class="font-display text-xl leading-snug text-ink md:text-2xl"><%= item.display_name %></p>
              <p class="cart-page__unit"><%= money(item.unit_price_cents, item.product.currency) %></p>
              <div class="flex flex-wrap items-center gap-4 pt-1">
                <div class="cart-qty">
                  <%= button_to "−", update_item_cart_path, method: :patch, params: { item_id: item.id, quantity: item.quantity - 1 },
                        class: "cart-qty__btn", disabled: item.quantity <= 1, "aria-label": t("cart.decrease") %>
                  <span class="cart-qty__value"><%= item.quantity %></span>
                  <%= button_to "+", update_item_cart_path, method: :patch, params: { item_id: item.id, quantity: item.quantity + 1 },
                        class: "cart-qty__btn", "aria-label": t("cart.increase") %>
                </div>
                <%= button_to t("cart.remove"), remove_item_cart_path(item_id: item.id), method: :delete, class: "text-[10px] uppercase tracking-[0.18em] text-ink-faint hover:text-ink" %>
              </div>
            </div>
            <div class="md:col-span-3 md:text-end">
              <p class="cart-page__line"><%= money(item.line_total_cents, item.product.currency) %></p>
            </div>
          </div>
        </li>
      <% end %>
    </ul>

    <div class="mt-10 flex flex-col gap-5 md:mt-12 md:flex-row md:items-center md:justify-between md:gap-6">
      <p class="cart-page__total"><%= t("cart.total") %> <%= money(@cart.subtotal_cents, current_store.currency) %></p>
      <%= link_to t("cart.checkout"), checkout_path, class: "maison-button w-full text-center md:w-auto" %>
    </div>
  <% end %>
</section>
