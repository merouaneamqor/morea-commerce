<% content_for :title, "#{t("cart.title")} — #{current_store.name}" %>

<section class="mx-auto max-w-2xl px-5 pb-24 pt-28 md:px-10 md:pb-28 md:pt-32">
  <h1 class="font-display text-3xl text-ink md:text-4xl"><%= t("cart.title") %></h1>

  <% if @items.empty? %>
    <p class="mt-10 text-sm text-ink-soft md:mt-12"><%= t("cart.empty") %></p>
    <%= link_to t("cart.continue_shopping"), collections_path, class: "maison-cta mt-8 md:mt-10" %>
  <% else %>
    <ul class="mt-10 space-y-8 md:mt-14 md:space-y-10">
      <% @items.each do |item| %>
        <li class="grid grid-cols-[5rem_1fr] gap-4 border-b border-line pb-8 sm:grid-cols-[7rem_1fr] md:grid-cols-12 md:gap-6 md:pb-10">
          <div class="object-frame aspect-[3/4] md:col-span-3">
            <%= product_image_tag item.product, sizes: "(max-width: 768px) 28vw, 25vw", widths: [160, 240, 360] %>
          </div>
          <div class="flex min-w-0 flex-col gap-3 md:col-span-9 md:grid md:grid-cols-9 md:gap-4">
            <div class="space-y-2 md:col-span-6">
              <p class="font-display text-xl leading-snug text-ink md:text-2xl"><%= item.display_name %></p>
              <p class="text-[10px] uppercase tracking-[0.2em] text-ink-faint"><%= money(item.unit_price_cents, item.product.currency) %></p>
              <div class="flex flex-wrap items-center gap-4 pt-1">
                <%= form_with url: update_item_cart_path, method: :patch, class: "flex items-center gap-3" do %>
                  <%= hidden_field_tag :item_id, item.id %>
                  <%= number_field_tag :quantity, item.quantity, min: 1, max: 20, class: "w-14 border-b border-line bg-transparent py-2 text-base outline-none md:text-sm" %>
                  <%= submit_tag t("cart.update"), class: "text-[10px] uppercase tracking-[0.18em] text-ink-faint" %>
                <% end %>
                <%= button_to t("cart.remove"), remove_item_cart_path(item_id: item.id), method: :delete, class: "text-[10px] uppercase tracking-[0.18em] text-ink-faint" %>
              </div>
            </div>
            <div class="md:col-span-3 md:text-end">
              <p class="font-display text-lg md:text-xl"><%= money(item.line_total_cents, item.product.currency) %></p>
            </div>
          </div>
        </li>
      <% end %>
    </ul>

    <div class="mt-10 flex flex-col gap-5 md:mt-12 md:flex-row md:items-center md:justify-between md:gap-6">
      <p class="font-display text-2xl"><%= t("cart.total") %> <%= money(@cart.subtotal_cents, current_store.currency) %></p>
      <%= link_to t("cart.checkout"), checkout_path, class: "maison-button w-full text-center md:w-auto" %>
    </div>
  <% end %>
</section>
