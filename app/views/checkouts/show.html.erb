<% content_for :title, "#{t("checkout.title")} — #{current_store.name}" %>

<%
  cities = Checkout.cities
  rates = Sendit::Districts.shipping_cents_by_city
  checkout_city_attrs = if cities.any?
    {
      controller: "checkout-city",
      checkout_city_districts_value: Checkout.districts_by_city.to_json,
      checkout_city_rates_value: rates.to_json,
      checkout_city_subtotal_value: @checkout.subtotal_cents,
      checkout_city_discount_value: @checkout.discount_cents,
      checkout_city_free_threshold_value: current_store.free_shipping_threshold_cents.to_i,
      checkout_city_currency_value: current_store.currency,
      checkout_city_free_label_value: t("checkout.shipping_free"),
      checkout_city_pending_label_value: t("checkout.shipping_pending"),
      checkout_city_confirm_template_value: t("checkout.confirm_with_total", total: "%{total}"),
      checkout_city_choose_district_value: t("checkout.choose_district")
    }
  end
%>

<section class="checkout-page mx-auto max-w-6xl px-5 pb-28 pt-28 md:px-10 md:pb-32 md:pt-32"
         <% if checkout_city_attrs %>data-controller="<%= checkout_city_attrs[:controller] %>"
         data-checkout-city-districts-value="<%= checkout_city_attrs[:checkout_city_districts_value] %>"
         data-checkout-city-rates-value="<%= checkout_city_attrs[:checkout_city_rates_value] %>"
         data-checkout-city-subtotal-value="<%= checkout_city_attrs[:checkout_city_subtotal_value] %>"
         data-checkout-city-discount-value="<%= checkout_city_attrs[:checkout_city_discount_value] %>"
         data-checkout-city-free-threshold-value="<%= checkout_city_attrs[:checkout_city_free_threshold_value] %>"
         data-checkout-city-currency-value="<%= checkout_city_attrs[:checkout_city_currency_value] %>"
         data-checkout-city-free-label-value="<%= checkout_city_attrs[:checkout_city_free_label_value] %>"
         data-checkout-city-pending-label-value="<%= checkout_city_attrs[:checkout_city_pending_label_value] %>"
         data-checkout-city-confirm-template-value="<%= checkout_city_attrs[:checkout_city_confirm_template_value] %>"
         data-checkout-city-choose-district-value="<%= checkout_city_attrs[:checkout_city_choose_district_value] %>"<% end %>>
  <header class="max-w-2xl">
    <p class="text-[10px] uppercase tracking-[0.28em] text-brass"><%= t("checkout.step_label") %></p>
    <h1 class="mt-3 font-display text-3xl text-ink md:text-5xl"><%= t("checkout.title") %></h1>
    <p class="mt-4 max-w-xl text-sm leading-7 text-ink-soft md:text-base md:leading-8"><%= t("checkout.subtitle") %></p>
  </header>

  <aside class="checkout-pay-banner mt-8 md:mt-10" aria-label="<%= t("checkout.payment_method") %>">
    <div>
      <p class="text-[10px] uppercase tracking-[0.24em] text-brass"><%= t("checkout.payment_method") %></p>
      <p class="mt-2 font-display text-2xl text-ink md:text-3xl"><%= current_store.cod_label %></p>
      <% if current_store.cod_note.present? %>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-ink-soft"><%= current_store.cod_note %></p>
      <% end %>
    </div>
    <p class="checkout-pay-banner__badge"><%= t("checkout.no_prepay") %></p>
  </aside>

  <div class="mt-10 grid gap-10 lg:mt-14 lg:grid-cols-12 lg:items-start lg:gap-14">
    <aside class="checkout-summary order-1 lg:order-2 lg:col-span-5 lg:sticky lg:top-28">
      <div class="checkout-panel">
        <div class="flex items-center justify-between gap-4">
          <h2 class="checkout-panel__title"><%= t("checkout.order_summary") %></h2>
          <%= link_to t("checkout.edit_bag"), cart_path, class: "text-[10px] uppercase tracking-[0.2em] text-ink-faint transition hover:text-ink" %>
        </div>

        <ul class="mt-6 divide-y divide-line">
          <% @items.each do |item| %>
            <li class="flex gap-4 py-4 first:pt-0 last:pb-0">
              <div class="object-frame aspect-[3/4] w-16 shrink-0 sm:w-20">
                <%= product_image_tag item.product, sizes: "80px", widths: [160, 240], alt: item.display_name %>
              </div>
              <div class="min-w-0 flex-1">
                <p class="font-display text-lg leading-snug text-ink"><%= item.display_name %></p>
                <p class="mt-1 text-[10px] uppercase tracking-[0.18em] text-ink-faint">
                  <%= t("checkout.qty") %> <%= item.quantity %>
                  · <%= money(item.unit_price_cents, item.product.currency) %>
                </p>
              </div>
              <p class="font-display text-lg text-ink"><%= money(item.line_total_cents, current_store.currency) %></p>
            </li>
          <% end %>
        </ul>

        <div class="mt-6 border-t border-line pt-5 space-y-3">
          <div class="flex items-baseline justify-between gap-4">
            <span class="text-[10px] uppercase tracking-[0.22em] text-ink-faint"><%= t("checkout.subtotal") %></span>
            <span class="font-display text-lg text-ink"><%= money(@checkout.subtotal_cents, current_store.currency) %></span>
          </div>
          <% if @checkout.discount_cents.positive? %>
            <div class="flex items-baseline justify-between gap-4">
              <span class="text-[10px] uppercase tracking-[0.22em] text-ink-faint"><%= t("checkout.discount") %></span>
              <span class="font-display text-lg text-ink">−<%= money(@checkout.discount_cents, current_store.currency) %></span>
            </div>
          <% end %>
          <div class="flex items-baseline justify-between gap-4">
            <span class="text-[10px] uppercase tracking-[0.22em] text-ink-faint"><%= t("checkout.shipping") %></span>
            <span class="font-display text-lg text-ink" data-checkout-city-target="shipping">
              <% if @checkout.city.present? %>
                <%= @checkout.shipping_cents.zero? ? t("checkout.shipping_free") : money(@checkout.shipping_cents, current_store.currency) %>
              <% else %>
                <%= t("checkout.shipping_pending") %>
              <% end %>
            </span>
          </div>
          <div class="flex items-baseline justify-between gap-4 border-t border-line pt-3">
            <span class="text-[10px] uppercase tracking-[0.22em] text-ink-faint"><%= t("checkout.total") %></span>
            <span class="font-display text-3xl text-ink" data-checkout-city-target="total"><%= money(@checkout.total_cents, current_store.currency) %></span>
          </div>
          <p class="mt-3 text-xs leading-5 text-ink-soft"><%= t("checkout.total_note") %></p>
        </div>
      </div>
    </aside>

    <div class="order-2 lg:order-1 lg:col-span-7">
      <%= form_with model: @checkout, url: checkout_path, method: :post, class: "checkout-form space-y-6" do |f| %>
        <% if @checkout.errors.any? %>
          <div class="checkout-alert" role="alert">
            <p class="text-[10px] uppercase tracking-[0.22em] text-ink"><%= t("checkout.form_errors") %></p>
            <ul class="mt-2 list-disc space-y-1 ps-5 text-sm text-ink-soft">
              <% @checkout.errors.map(&:message).uniq.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <fieldset class="checkout-panel">
          <legend class="checkout-panel__title"><%= t("checkout.delivery_details") %></legend>
          <p class="checkout-panel__hint"><%= t("checkout.delivery_hint") %></p>

          <div class="mt-6 grid gap-5 sm:grid-cols-2">
            <div class="checkout-field sm:col-span-2">
              <%= f.label :name, t("checkout.full_name"), class: "checkout-label" %>
              <%= f.text_field :name, required: true, autocomplete: "name", class: "checkout-input", placeholder: t("checkout.placeholders.name") %>
            </div>

            <div class="checkout-field sm:col-span-2">
              <%= f.label :phone, t("checkout.phone"), class: "checkout-label" %>
              <div class="checkout-phone" dir="ltr">
                <span class="checkout-phone__prefix" aria-hidden="true">+212</span>
                <%= f.telephone_field :phone, required: true, autocomplete: "tel-national", inputmode: "tel", class: "checkout-input checkout-phone__input", placeholder: t("checkout.placeholders.phone") %>
              </div>
              <p class="checkout-help"><%= t("checkout.phone_help") %></p>
            </div>

            <div class="checkout-field">
              <%= f.label :city, t("checkout.city"), class: "checkout-label" %>
              <% if cities.any? %>
                <%= f.select :city, options_for_select(cities, @checkout.city), { include_blank: t("checkout.choose_city") },
                      required: true, autocomplete: "address-level2", class: "checkout-input checkout-select",
                      data: { checkout_city_target: "city", action: "checkout-city#update" } %>
              <% else %>
                <%= f.text_field :city, required: true, autocomplete: "address-level2", class: "checkout-input", placeholder: t("checkout.placeholders.city") %>
              <% end %>
            </div>

            <% district_required = @checkout.district_required? %>
            <% district_options = Checkout.districts_by_city[@checkout.city].to_a %>
            <div class="checkout-field" data-checkout-city-target="districtField" <%= "hidden" unless district_required %>>
              <%= f.label :district, t("checkout.district"), class: "checkout-label" %>
              <%= f.select :district,
                    options_for_select(district_options, @checkout.district),
                    { include_blank: t("checkout.choose_district") },
                    required: district_required,
                    disabled: !district_required,
                    autocomplete: "address-level3",
                    class: "checkout-input checkout-select",
                    data: { checkout_city_target: "district", action: "checkout-city#update" } %>
              <p class="checkout-help" data-checkout-city-target="districtHelp" <%= "hidden" unless district_required %>>
                <%= t("checkout.district_help") %>
              </p>
            </div>

            <div class="checkout-field sm:col-span-2">
              <%= f.label :address, t("checkout.address"), class: "checkout-label" %>
              <%= f.text_area :address, required: true, autocomplete: "street-address", rows: 2, class: "checkout-input checkout-input--area", placeholder: t("checkout.placeholders.address") %>
            </div>

            <div class="checkout-field sm:col-span-2">
              <%= f.label :notes, "#{t("checkout.notes")} (#{t("checkout.optional")})", class: "checkout-label" %>
              <%= f.text_area :notes, rows: 2, class: "checkout-input checkout-input--area", placeholder: t("checkout.placeholders.notes") %>
            </div>

            <div class="checkout-field sm:col-span-2">
              <%= f.label :discount_code, "#{t("checkout.discount_code")} (#{t("checkout.optional")})", class: "checkout-label" %>
              <%= f.text_field :discount_code, class: "checkout-input", placeholder: t("checkout.placeholders.discount_code"), autocomplete: "off" %>
            </div>
          </div>
        </fieldset>

        <div class="checkout-submit">
          <div class="mb-5 flex items-baseline justify-between gap-4 lg:hidden">
            <span class="text-[10px] uppercase tracking-[0.22em] text-ink-faint"><%= t("checkout.total") %></span>
            <span class="font-display text-3xl text-ink" data-checkout-city-target="mobileTotal"><%= money(@checkout.total_cents, current_store.currency) %></span>
          </div>
          <%= f.button type: "submit", class: "maison-button checkout-submit__button w-full cursor-pointer text-center", data: { turbo_submits_with: t("checkout.placing") } do %>
            <span data-checkout-city-target="submitLabel"><%= t("checkout.confirm_with_total", total: money(@checkout.total_cents, current_store.currency)) %></span>
          <% end %>
          <ul class="checkout-reassure">
            <li><%= t("checkout.reassure.cod") %></li>
            <li><%= t("checkout.reassure.no_prepay") %></li>
            <li><%= t("checkout.reassure.confirm_call") %></li>
          </ul>
        </div>
      <% end %>
    </div>
  </div>
</section>
