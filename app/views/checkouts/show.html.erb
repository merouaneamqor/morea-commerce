<% content_for :title, "#{t("checkout.title")} — #{current_store.name}" %>

<section class="checkout-page mx-auto max-w-6xl px-5 pb-28 pt-28 md:px-10 md:pb-32 md:pt-32">
  <header class="max-w-2xl">
    <p class="text-[10px] uppercase tracking-[0.28em] text-brass"><%= t("checkout.step_label") %></p>
    <h1 class="mt-3 font-display text-3xl text-ink md:text-5xl"><%= t("checkout.title") %></h1>
    <p class="mt-4 max-w-xl text-sm leading-7 text-ink-soft md:text-base md:leading-8"><%= t("checkout.subtitle") %></p>
  </header>

  <aside class="checkout-pay-banner mt-8 md:mt-10" aria-label="<%= t("checkout.payment_method") %>">
    <div>
      <p class="text-[10px] uppercase tracking-[0.24em] text-brass"><%= t("checkout.payment_method") %></p>
      <p class="mt-2 font-display text-2xl text-ink md:text-3xl"><%= current_store.cod_label %></p>
      <% if current_store.cod_note.present? %>
        <p class="mt-2 max-w-2xl text-sm leading-6 text-ink-soft"><%= current_store.cod_note %></p>
      <% end %>
    </div>
    <p class="checkout-pay-banner__badge"><%= t("checkout.no_prepay") %></p>
  </aside>

  <div class="mt-10 grid gap-10 lg:mt-14 lg:grid-cols-12 lg:items-start lg:gap-14">
    <aside class="checkout-summary order-1 lg:order-2 lg:col-span-5 lg:sticky lg:top-28">
      <div class="checkout-panel">
        <div class="flex items-center justify-between gap-4">
          <h2 class="checkout-panel__title"><%= t("checkout.order_summary") %></h2>
          <%= link_to t("checkout.edit_bag"), cart_path, class: "text-[10px] uppercase tracking-[0.2em] text-ink-faint transition hover:text-ink" %>
        </div>

        <ul class="mt-6 divide-y divide-line">
          <% @items.each do |item| %>
            <li class="flex gap-4 py-4 first:pt-0 last:pb-0">
              <div class="object-frame aspect-[3/4] w-16 shrink-0 sm:w-20">
                <%= product_image_tag item.product, sizes: "80px", widths: [160, 240], alt: item.display_name %>
              </div>
              <div class="min-w-0 flex-1">
                <p class="font-display text-lg leading-snug text-ink"><%= item.display_name %></p>
                <p class="mt-1 text-[10px] uppercase tracking-[0.18em] text-ink-faint">
                  <%= t("checkout.qty") %> <%= item.quantity %>
                  · <%= money(item.unit_price_cents, item.product.currency) %>
                </p>
              </div>
              <p class="shrink-0 text-sm text-ink"><%= money(item.line_total_cents, current_store.currency) %></p>
            </li>
          <% end %>
        </ul>

        <div class="mt-6 border-t border-line pt-5">
          <div class="flex items-baseline justify-between gap-4">
            <span class="text-[10px] uppercase tracking-[0.22em] text-ink-faint"><%= t("checkout.total") %></span>
            <span class="font-display text-3xl text-ink"><%= money(@cart.subtotal_cents, current_store.currency) %></span>
          </div>
          <p class="mt-3 text-xs leading-5 text-ink-soft"><%= t("checkout.total_note") %></p>
        </div>
      </div>
    </aside>

    <div class="order-2 lg:order-1 lg:col-span-7">
      <%= form_with model: @checkout, url: checkout_path, method: :post, class: "checkout-form space-y-6" do |f| %>
        <% if @checkout.errors.any? %>
          <div class="checkout-alert" role="alert">
            <p class="text-[10px] uppercase tracking-[0.22em] text-ink"><%= t("checkout.form_errors") %></p>
            <ul class="mt-2 list-disc space-y-1 ps-5 text-sm text-ink-soft">
              <% @checkout.errors.map(&:message).uniq.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <fieldset class="checkout-panel">
          <legend class="checkout-panel__title"><%= t("checkout.delivery_details") %></legend>
          <p class="checkout-panel__hint"><%= t("checkout.delivery_hint") %></p>

          <% cities = Checkout.cities %>
          <div class="mt-6 grid gap-5 sm:grid-cols-2"
               <% if cities.any? %>data-controller="checkout-city" data-checkout-city-districts-value="<%= Checkout.districts_by_city.to_json %>"<% end %>>
            <div class="checkout-field sm:col-span-2">
              <%= f.label :name, t("checkout.full_name"), class: "checkout-label" %>
              <%= f.text_field :name, required: true, autocomplete: "name", class: "checkout-input", placeholder: t("checkout.placeholders.name") %>
            </div>

            <div class="checkout-field sm:col-span-2">
              <%= f.label :phone, t("checkout.phone"), class: "checkout-label" %>
              <div class="checkout-phone" dir="ltr">
                <span class="checkout-phone__prefix" aria-hidden="true">+212</span>
                <%= f.telephone_field :phone, required: true, autocomplete: "tel-national", inputmode: "tel", class: "checkout-input checkout-phone__input", placeholder: t("checkout.placeholders.phone") %>
              </div>
              <p class="checkout-help"><%= t("checkout.phone_help") %></p>
            </div>

            <div class="checkout-field">
              <%= f.label :city, t("checkout.city"), class: "checkout-label" %>
              <% if cities.any? %>
                <%= f.select :city, options_for_select(cities, @checkout.city), { include_blank: t("checkout.choose_city") },
                      required: true, autocomplete: "address-level2", class: "checkout-input checkout-select",
                      data: { checkout_city_target: "city", action: "checkout-city#update" } %>
              <% else %>
                <%= f.text_field :city, required: true, autocomplete: "address-level2", class: "checkout-input", placeholder: t("checkout.placeholders.city") %>
              <% end %>
            </div>

            <div class="checkout-field">
              <%= f.label :district, t("checkout.district"), class: "checkout-label" %>
              <%= f.text_field :district, autocomplete: "address-level3", class: "checkout-input", placeholder: t("checkout.placeholders.district"),
                    list: "checkout-districts", data: { checkout_city_target: "district" } %>
              <datalist id="checkout-districts" data-checkout-city-target="options"></datalist>
            </div>

            <div class="checkout-field sm:col-span-2">
              <%= f.label :address, t("checkout.address"), class: "checkout-label" %>
              <%= f.text_area :address, required: true, autocomplete: "street-address", rows: 2, class: "checkout-input checkout-input--area", placeholder: t("checkout.placeholders.address") %>
            </div>

            <div class="checkout-field sm:col-span-2">
              <%= f.label :notes, "#{t("checkout.notes")} (#{t("checkout.optional")})", class: "checkout-label" %>
              <%= f.text_area :notes, rows: 2, class: "checkout-input checkout-input--area", placeholder: t("checkout.placeholders.notes") %>
            </div>
          </div>
        </fieldset>

        <div class="checkout-submit">
          <div class="mb-5 flex items-baseline justify-between gap-4 lg:hidden">
            <span class="text-[10px] uppercase tracking-[0.22em] text-ink-faint"><%= t("checkout.total") %></span>
            <span class="font-display text-3xl text-ink"><%= money(@cart.subtotal_cents, current_store.currency) %></span>
          </div>
          <%= f.button type: "submit", class: "maison-button checkout-submit__button w-full cursor-pointer text-center", data: { turbo_submits_with: t("checkout.placing") } do %>
            <%= t("checkout.confirm_with_total", total: money(@cart.subtotal_cents, current_store.currency)) %>
          <% end %>
          <ul class="checkout-reassure">
            <li><%= t("checkout.reassure.cod") %></li>
            <li><%= t("checkout.reassure.no_prepay") %></li>
            <li><%= t("checkout.reassure.confirm_call") %></li>
          </ul>
        </div>
      <% end %>
    </div>
  </div>
</section>
