<div class="home-tiles">
  <% tiles.each_with_index do |(collection, cover_url), i| %>
    <%= link_to collection_path(collection), class: "home-tile object-frame" do %>
      <%= image_tag cover_url, alt: collection.name, class: "h-full w-full object-cover", loading: "lazy", decoding: "async" %>
      <span class="home-tile__veil" aria-hidden="true"></span>
      <span class="home-tile__copy">
        <span class="home-tile__index"><%= format("%02d", i + 1) %></span>
        <span class="home-tile__name"><%= collection.name %></span>
        <% if collection.subtitle.present? %>
          <span class="home-tile__subtitle"><%= collection.subtitle %></span>
        <% end %>
        <span class="maison-cta maison-cta-light mt-6"><%= t("home.explore") %></span>
      </span>
    <% end %>
  <% end %>
</div>
