<% content_for :title, "#{t("shop.collections")} — #{current_store.name}" %>

<section class="collection-page !pb-0">
  <header class="collection-page__head" data-controller="reveal">
    <p class="landing-eyebrow justify-center"><%= t("shop.title") %></p>
    <h1 class="collection-page__title"><%= t("shop.collections") %></h1>
  </header>
  <%= render "collections/tiles", tiles: collection_tiles(@collections) %>
</section>
