<% content_for :title, "#{t("shop.title")} — #{current_store.name}" %>

<section class="mx-auto max-w-4xl px-5 pb-24 pt-28 md:px-10 md:pb-28 md:pt-32">
  <header class="mb-14 text-center md:mb-20" data-controller="reveal">
    <p class="text-[10px] uppercase tracking-[0.36em] text-brass"><%= t("shop.title") %></p>
    <h1 class="mt-3 font-display text-3xl text-ink md:mt-4 md:text-5xl"><%= t("shop.collections") %></h1>
  </header>

  <div class="space-y-14 md:space-y-20">
    <% @collections.each do |collection| %>
      <article class="text-center" data-controller="reveal">
        <h2 class="font-display text-2xl text-ink md:text-4xl"><%= collection.name %></h2>
        <p class="mx-auto mt-3 max-w-md text-sm leading-7 text-ink-soft md:mt-4"><%= collection.subtitle %></p>
        <%= link_to t("shop.enter"), collection_path(collection), class: "maison-cta mt-6 justify-center md:mt-8" %>
      </article>
    <% end %>
  </div>
</section>
