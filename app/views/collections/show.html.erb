<% content_for :title, "#{@collection.name} — #{current_store.name}" %>
<% content_for :meta_description, @collection.description.presence || @collection.subtitle %>
<% cover_url = collection_cover_url(@collection) %>

<section class="collection-page">
  <header class="collection-page__head" data-controller="reveal">
    <nav class="pdp__crumbs !justify-center !px-0" aria-label="Breadcrumb">
      <%= link_to t("nav.home"), localized_root_path %>
      <span aria-hidden="true">/</span>
      <%= link_to t("shop.collections"), collections_path %>
    </nav>
    <h1 class="collection-page__title"><%= @collection.name %></h1>
    <% if @collection.description.present? %>
      <p class="mx-auto mt-5 max-w-xl text-sm leading-7 text-ink-soft"><%= @collection.description %></p>
    <% end %>
  </header>

  <% if cover_url.present? %>
    <div class="collection-page__banner object-frame" data-controller="reveal">
      <%= object_image_tag cover_url,
            alt: @collection.name,
            sizes: "100vw",
            widths: [960, 1440, 1920],
            loading: "eager",
            fetchpriority: "high" %>
    </div>
  <% end %>

  <%= form_with url: collection_path(@collection), method: :get, class: "collection-toolbar", data: { controller: "auto-submit", turbo_action: "replace" } do %>
    <label class="collection-toolbar__filter">
      <%= check_box_tag :in_stock, "1", @in_stock, data: { action: "auto-submit#submit" } %>
      <span><%= t("shop.in_stock_only") %></span>
    </label>
    <p class="collection-toolbar__count"><%= t("shop.product_count", count: @products.size) %></p>
    <label class="collection-toolbar__sort">
      <span><%= t("shop.sort_by") %></span>
      <%= select_tag :sort,
            options_for_select(CollectionsController::SORTS.map { |s| [t("shop.sort.#{s}"), s] }, @sort),
            data: { action: "auto-submit#submit" } %>
    </label>
    <noscript><%= submit_tag t("shop.apply") %></noscript>
  <% end %>

  <% if @products.any? %>
    <div class="home-products md:!grid-cols-3 lg:!grid-cols-4" data-controller="reveal">
      <% @products.each do |product| %>
        <%= render "products/card", product: product, sizes: "(max-width: 768px) 50vw, 25vw" %>
      <% end %>
    </div>
  <% else %>
    <div class="py-20 text-center">
      <p class="text-sm text-ink-soft"><%= t("shop.no_results") %></p>
      <%= link_to t("shop.clear_filters"), collection_path(@collection), class: "maison-cta mt-6 justify-center" %>
    </div>
  <% end %>
</section>
