<% content_for :title, "#{@collection.name} — #{current_store.name}" %>

<section class="mx-auto max-w-6xl px-5 pb-24 pt-28 md:px-10 md:pb-28 md:pt-32">
  <header class="mx-auto mb-12 max-w-xl text-center md:mb-20" data-controller="reveal">
    <p class="text-[10px] uppercase tracking-[0.32em] text-brass"><%= t("shop.collection") %></p>
    <h1 class="mt-3 font-display text-3xl text-ink md:mt-4 md:text-5xl"><%= @collection.name %></h1>
    <p class="mt-4 text-sm leading-7 text-ink-soft md:mt-5"><%= @collection.description %></p>
  </header>

  <div class="grid grid-cols-2 gap-x-3 gap-y-8 md:grid-cols-3 md:gap-12">
    <% @products.each do |product| %>
      <%= link_to product_path(product), class: "block space-y-3 md:space-y-5" do %>
        <div class="object-frame aspect-[3/4]">
          <%= product_image_tag product, sizes: "(max-width: 768px) 50vw, 33vw" %>
        </div>
        <div class="space-y-1 text-center">
          <p class="font-display text-base leading-snug text-ink md:text-xl"><%= product.name %></p>
          <p class="text-[10px] uppercase tracking-[0.2em] text-ink-faint"><%= product.price_display %></p>
        </div>
      <% end %>
    <% end %>
  </div>
</section>
