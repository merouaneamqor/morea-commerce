<% content_for :title, "#{@store&.name || "Morea"} — #{@store&.tagline.presence || t("store.tagline_fallback")}" %>
<% if @sections.first&.kind == "hero" %>
  <% content_for :hero_nav, "1" %>
  <% if @sections.first.image_src.present? %>
    <% content_for :head do %>
      <%= preload_hero_image(@sections.first.image_src) %>
    <% end %>
  <% end %>
<% end %>

<% @sections.each_with_index do |section, index| %>
  <%= render "home/sections/#{section.kind}", section: section, first: index.zero? %>
<% end %>
