<% content_for :title, "#{@store&.name || "Morea"} — #{@store&.campaign_subheading || "SS / 26"}" %>
<% content_for :hero_nav, "1" %>
<% if @store&.campaign_image.present? %>
  <% content_for :head do %>
    <%= preload_hero_image(@store.campaign_image) %>
  <% end %>
<% end %>

<%# ——— Campaign ——— %>
<section class="campaign-hero">
  <div class="campaign-hero__media">
    <% if @store&.campaign_image.present? %>
      <%= object_image_tag @store.campaign_image,
            alt: "#{@store.name} campaign",
            sizes: "100vw",
            widths: [640, 960, 1440, 1920],
            loading: "eager",
            fetchpriority: "high",
            css_class: "h-full w-full object-cover" %>
    <% else %>
      <div class="h-full w-full bg-stone-deep"></div>
    <% end %>
  </div>
  <div class="campaign-hero__veil"></div>

  <div class="campaign-hero__content" data-controller="reveal">
    <p class="landing-eyebrow landing-eyebrow--light">
      <%= @store&.campaign_heading %> · <%= @store&.campaign_subheading %>
    </p>
    <h1 class="campaign-hero__title"><%= @store&.tagline.presence || t("store.tagline_fallback") %></h1>
    <div class="campaign-hero__actions">
      <%= link_to @campaign_target, class: "campaign-btn" do %>
        <span><%= @store&.campaign_button || t("store.default_campaign_cta") %></span>
      <% end %>
      <%= link_to t("home.view_all"), collections_path, class: "maison-cta maison-cta-light" %>
    </div>
  </div>
</section>

<%# ——— Service ticker ——— %>
<div class="home-ticker" aria-hidden="true">
  <div class="home-ticker__track">
    <% 2.times do %>
      <% [t("landing.trust.delivery"), t("landing.trust.returns"), t("store.footer_tagline"), @store&.campaign_subheading].compact.each do |item| %>
        <span class="home-ticker__item"><%= item %></span>
      <% end %>
    <% end %>
  </div>
</div>

<%# ——— Selection ——— %>
<% if @collection_products.any? %>
  <section class="home-section">
    <header class="home-section__head" data-controller="reveal">
      <div>
        <p class="landing-eyebrow"><%= @collection&.name || t("shop.selected") %></p>
        <h2 class="home-section__title"><%= t("home.selection_title") %></h2>
      </div>
      <%= link_to t("home.view_all"), (@collection ? collection_path(@collection) : collections_path), class: "maison-cta" %>
    </header>

    <div class="home-products" data-controller="reveal" data-reveal-delay-value="120">
      <% @collection_products.each_with_index do |product, i| %>
        <%= link_to product_path(product), class: "home-card" do %>
          <div class="home-card__media object-frame aspect-[3/4]">
            <%= product_image_tag product, sizes: "(max-width: 768px) 50vw, 25vw" %>
            <% if product.detail_image_url.present? && product.detail_image_url != product_image_url(product) %>
              <%= image_tag product.detail_image_url, alt: "", class: "home-card__alt", loading: "lazy", decoding: "async" %>
            <% end %>
          </div>
          <div class="home-card__meta">
            <span class="landing-gallery__index"><%= format("%02d", i + 1) %></span>
            <p class="home-card__name"><%= product.name %></p>
            <p class="home-card__price"><%= product.price_display %></p>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>

<%# ——— Collections ——— %>
<% if @collection_tiles.any? %>
  <section class="home-section home-section--flush">
    <header class="home-section__head" data-controller="reveal">
      <div>
        <p class="landing-eyebrow"><%= t("shop.collections") %></p>
        <h2 class="home-section__title"><%= t("home.collections_title") %></h2>
      </div>
    </header>

    <div class="home-tiles">
      <% @collection_tiles.each_with_index do |(collection, cover_url), i| %>
        <%= link_to collection_path(collection), class: "home-tile object-frame" do %>
          <%= image_tag cover_url, alt: collection.name, class: "h-full w-full object-cover", loading: "lazy", decoding: "async" %>
          <span class="home-tile__veil" aria-hidden="true"></span>
          <span class="home-tile__copy">
            <span class="home-tile__index"><%= format("%02d", i + 1) %></span>
            <span class="home-tile__name"><%= collection.name %></span>
            <% if collection.subtitle.present? %>
              <span class="home-tile__subtitle"><%= collection.subtitle %></span>
            <% end %>
            <span class="maison-cta maison-cta-light mt-6"><%= t("home.explore") %></span>
          </span>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>

<%# ——— Manifesto ——— %>
<% if @store&.about.present? %>
  <section class="home-manifesto" data-controller="reveal">
    <% if @manifesto_image %>
      <%= image_tag @manifesto_image, alt: "", class: "home-manifesto__media", loading: "lazy", decoding: "async" %>
    <% end %>
    <div class="home-manifesto__copy">
      <p class="landing-eyebrow landing-eyebrow--light justify-center"><%= t("landing.story_eyebrow") %></p>
      <blockquote class="home-manifesto__quote"><%= @store.about %></blockquote>
      <% if @featured %>
        <%= link_to @store.campaign_button, product_path(@featured), class: "maison-cta maison-cta-light mt-12" %>
      <% end %>
    </div>
  </section>
<% end %>
