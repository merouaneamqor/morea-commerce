<% content_for :title, "#{@store&.name || "Morea"} — #{@store&.tagline.presence || t("store.tagline_fallback")}" %>
<% if @sections.first&.kind == "hero" %>
  <% content_for :hero_nav, "1" %>
  <% if @sections.first.image_src.present? %>
    <% content_for :head do %>
      <%= preload_hero_image(@sections.first.image_src) %>
    <% end %>
  <% end %>
<% end %>

<% @sections.each_with_index do |section, index| %>
  <%= render "home/sections/#{section.kind}", section: section, first: index.zero? %>
  <% if index.zero? && section.kind == "hero" %>
    <section class="home-trust" aria-label="<%= t("landing.trust.strip_label") %>">
      <div class="home-trust__item">
        <p class="home-trust__label"><%= current_store&.cod_label.presence || t("landing.trust.cod") %></p>
      </div>
      <div class="home-trust__item">
        <p class="home-trust__label"><%= t("landing.trust.ship") %></p>
      </div>
      <div class="home-trust__item">
        <p class="home-trust__label"><%= t("landing.trust.returns") %></p>
      </div>
    </section>
  <% end %>
<% end %>
