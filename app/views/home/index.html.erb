<% content_for :title, "#{@store&.name || "Morea"} — #{@featured&.name || t("landing.hero_product")}" %>
<% content_for :meta_description, @store&.tagline || t("landing.hero_tagline") %>
<% if @hero_image.present? %>
  <% content_for :head do %>
    <%= preload_hero_image(@hero_image) %>
  <% end %>
<% end %>

<%# ——— Hero ——— %>
<section class="landing-hero">
  <div class="landing-hero__copy" data-controller="reveal">
    <div class="landing-hero__brand" aria-hidden="true">
      <%= render "shared/wordmark_svg" %>
    </div>
    <span class="sr-only">Morea</span>

    <p class="landing-hero__eyebrow"><%= t("landing.eyebrow") %></p>
    <h1 class="landing-hero__title"><%= @featured&.name || t("landing.hero_product") %></h1>
    <p class="landing-hero__tagline"><%= t("landing.hero_tagline") %></p>

    <a href="#essentiel"
       class="landing-ghost-btn"
       data-controller="scroll-to"
       data-action="scroll-to#scroll">
      <%= t("landing.discover") %>
    </a>
  </div>

  <div class="landing-hero__visual">
    <div class="landing-hero__media">
      <% if @hero_image.present? %>
        <%= object_image_tag @hero_image,
              alt: (@featured&.name || "Morea"),
              sizes: "(max-width: 768px) 100vw, 58vw",
              widths: [640, 960, 1280, 1600],
              loading: "eager",
              fetchpriority: "high" %>
      <% else %>
        <div class="h-full w-full bg-stone-deep"></div>
      <% end %>
    </div>

    <div class="landing-hero__caption" data-controller="reveal" data-reveal-delay-value="180">
      <p class="landing-hero__movement"><%= t("landing.for_movement") %></p>
      <ul class="landing-features" role="list">
        <% [
          ["breathable", t("landing.features.breathable")],
          ["quickdry", t("landing.features.quickdry")],
          ["fit", t("landing.features.fit")],
          ["modest", t("landing.features.modest")]
        ].each do |key, label| %>
          <li class="landing-features__item">
            <span class="landing-features__icon" aria-hidden="true">
              <%= render "home/feature_icon", name: key %>
            </span>
            <span class="landing-features__label"><%= label %></span>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</section>

<%# ——— Product ——— %>
<% if @featured %>
  <section id="essentiel" class="landing-product">
    <div class="landing-gallery" data-controller="reveal">
      <% @gallery.each_with_index do |shot, i| %>
        <figure class="landing-gallery__shot">
          <div class="object-frame aspect-[3/4]">
            <%= object_image_tag shot[:url],
                  alt: "#{@featured.name} — #{shot[:label]}",
                  sizes: "(max-width: 768px) 70vw, 18vw",
                  widths: [400, 640, 960],
                  loading: i < 2 ? "eager" : "lazy" %>
          </div>
          <figcaption class="landing-gallery__caption"><%= shot[:label] %></figcaption>
        </figure>
      <% end %>
    </div>

    <div class="landing-buy" data-controller="reveal" data-reveal-delay-value="120">
      <%= form_with url: add_item_cart_path, method: :post, class: "landing-buy__form",
            data: (@variants.any? ? {
              controller: "variant-picker",
              variant_picker_variants_value: @variant_payload
            } : {}) do %>
        <%= hidden_field_tag :product_id, @featured.id %>
        <%= hidden_field_tag :quantity, 1 %>

        <% if @variants.any? %>
          <%= hidden_field_tag :product_variant_id, @variants.first.id, data: { variant_picker_target: "variantId" } %>

          <% if @colors.any? %>
            <div class="landing-buy__group">
              <div class="flex flex-wrap gap-5">
                <% @colors.each do |color| %>
                  <button type="button"
                          class="landing-swatch <%= "is-active" if color == @colors.first %>"
                          data-variant-picker-target="colorButton"
                          data-color="<%= color %>"
                          data-action="variant-picker#selectColor"
                          aria-label="<%= color %>">
                    <span class="landing-swatch__dot" style="background: <%= color_hex(color) %>"></span>
                    <span class="landing-swatch__name"><%= color %></span>
                  </button>
                <% end %>
              </div>
            </div>
          <% end %>

          <% if @sizes.any? %>
            <div class="landing-buy__group">
              <p class="landing-buy__label"><%= t("product.size") %></p>
              <div class="mt-3 flex gap-2">
                <% @sizes.each do |size| %>
                  <button type="button"
                          class="size-pill <%= "is-active" if size == @sizes.first %>"
                          data-variant-picker-target="sizeButton"
                          data-size="<%= size %>"
                          data-action="variant-picker#selectSize"><%= size %></button>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>

        <%= button_tag t("product.add_to_bag"), type: "submit", class: "maison-button w-full cursor-pointer text-center" %>

        <ul class="landing-trust" role="list">
          <li class="landing-trust__item">
            <span class="landing-trust__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 7h11v10H3z"/><path d="M14 10h4l3 3v4h-7"/><circle cx="7" cy="18.5" r="1.5"/><circle cx="17" cy="18.5" r="1.5"/></svg>
            </span>
            <span><%= t("landing.trust.delivery") %></span>
          </li>
          <li class="landing-trust__item">
            <span class="landing-trust__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M4 12a8 8 0 0 1 13.5-5.8L20 8"/><path d="M20 4v4h-4"/><path d="M20 12a8 8 0 0 1-13.5 5.8L4 16"/><path d="M4 20v-4h4"/></svg>
            </span>
            <span><%= t("landing.trust.returns") %></span>
          </li>
        </ul>
      <% end %>
    </div>
  </section>
<% end %>

<%# ——— Story ——— %>
<section class="landing-story" data-controller="reveal">
  <div class="landing-story__copy">
    <h2 class="landing-story__title"><%= t("landing.story_title") %></h2>
    <p class="landing-story__body">
      <%= t("landing.story_body") %>
    </p>
    <%= link_to t("landing.our_story"), collections_path, class: "maison-cta mt-8 md:mt-10" %>
  </div>

  <div class="landing-story__media object-frame">
    <% if @story_image.present? %>
      <%= object_image_tag @story_image,
            alt: t("landing.story_title"),
            sizes: "(max-width: 768px) 100vw, 50vw",
            widths: [640, 960, 1280] %>
    <% else %>
      <div class="aspect-[4/3] w-full bg-stone-deep md:aspect-auto md:min-h-[28rem]"></div>
    <% end %>
  </div>
</section>
