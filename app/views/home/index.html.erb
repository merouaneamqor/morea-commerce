<% content_for :title, "#{@store&.name || "Morea"} — #{@store&.campaign_subheading || "SS / 26"}" %>
<% content_for :hero_nav, "1" %>
<% if @store&.campaign_image.present? %>
  <% content_for :head do %>
    <%= preload_hero_image(@store.campaign_image) if @store.campaign_image.to_s.start_with?("http") %>
  <% end %>
<% end %>

<section class="campaign-hero">
  <div class="campaign-hero__media">
    <% if @store&.campaign_image.present? %>
      <%= object_image_tag @store.campaign_image,
            alt: "#{@store.name} campaign",
            sizes: "100vw",
            widths: [640, 960, 1440, 1920],
            loading: "eager",
            fetchpriority: "high",
            css_class: "h-full w-full object-cover" %>
    <% else %>
      <div class="h-full w-full bg-stone-deep"></div>
    <% end %>
  </div>
  <div class="campaign-hero__veil"></div>

  <div class="campaign-hero__content" data-controller="reveal">
    <div class="campaign-wordmark" aria-hidden="true">
      <%= render "shared/wordmark_svg" %>
    </div>
    <span class="sr-only">Morea</span>
    <p class="mt-8 text-[10px] uppercase tracking-[0.32em] opacity-80 md:mt-10 md:tracking-[0.4em]">
      <%= @store&.campaign_heading %>
    </p>
    <p class="mt-2 font-display text-2xl tracking-[0.14em] md:mt-3 md:text-4xl md:tracking-[0.18em]">
      <%= @store&.campaign_subheading %>
    </p>
    <%= link_to (@store&.campaign_button || t("store.default_campaign_cta")), @campaign_target,
          class: "maison-cta maison-cta-light mt-10 justify-center md:mt-12" %>
  </div>
</section>

<% if @collection_products.any? %>
  <section class="mx-auto max-w-6xl px-5 py-16 md:px-10 md:py-28">
    <div class="mb-10 text-center md:mb-16" data-controller="reveal">
      <p class="text-[10px] uppercase tracking-[0.32em] text-brass"><%= @collection&.name || t("shop.selected") %></p>
      <p class="mx-auto mt-3 max-w-sm text-sm leading-7 text-ink-soft md:mt-4"><%= @collection&.subtitle %></p>
    </div>

    <div class="grid gap-10 sm:grid-cols-2 md:grid-cols-3 md:gap-12">
      <% @collection_products.each do |product| %>
        <%= link_to product_path(product), class: "block space-y-4 md:space-y-5" do %>
          <div class="object-frame aspect-[3/4]">
            <%= product_image_tag product, sizes: "(max-width: 640px) 100vw, (max-width: 768px) 50vw, 33vw" %>
          </div>
          <div class="space-y-1 text-center">
            <p class="font-display text-xl text-ink md:text-2xl"><%= product.name %></p>
            <p class="text-[10px] uppercase tracking-[0.22em] text-ink-faint"><%= product.price_display %></p>
          </div>
        <% end %>
      <% end %>
    </div>
  </section>
<% end %>
