<% tiles = collection_tiles(current_store.collections.published.order(:position).includes(:translations).limit(section.item_limit(3))) %>
<% if tiles.any? %>
  <section class="home-section home-section--flush home-section--collections">
    <header class="home-section__head" <% unless local_assigns[:lcp] %>data-controller="reveal" data-reveal-stagger-value="true"<% end %>>
      <div>
        <% if section.subheading.present? %><p class="landing-eyebrow" data-reveal-item><%= section.subheading %></p><% end %>
        <h2 class="home-section__title" data-reveal-item><%= section.heading %></h2>
      </div>
    </header>
    <%= render "collections/tiles", tiles: tiles %>
  </section>
<% end %>
