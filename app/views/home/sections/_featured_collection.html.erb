<% products = section.products.to_a %>
<% if products.any? %>
  <section class="home-section home-section--featured home-section--catalog">
    <header class="home-section__head home-section__head--catalog" <% unless local_assigns[:lcp] %>data-controller="reveal" data-reveal-stagger-value="true"<% end %>>
      <div>
        <% if section.subheading.present? %>
          <p class="catalog-eyebrow" data-reveal-item><%= section.subheading %></p>
        <% end %>
        <h2 class="home-section__title home-section__title--catalog" data-reveal-item><%= section.heading %></h2>
      </div>
      <%= link_to (section.collection ? t("merchandising.discover_collection") : t("home.view_all")), (section.collection ? collection_path(section.collection) : collections_path), class: "catalog-link", data: { reveal_item: true } %>
    </header>

    <div class="home-products home-products--catalog" <% unless local_assigns[:lcp] %>data-controller="reveal" data-reveal-delay-value="100" data-reveal-stagger-value="true"<% end %>>
      <% products.each_with_index do |product, i| %>
        <div data-reveal-item>
          <%= render "products/card", product: product, sizes: "(max-width: 768px) 50vw, (max-width: 1024px) 33vw, 25vw",
                loading: (local_assigns[:lcp] && i.zero? ? "eager" : nil),
                fetchpriority: (local_assigns[:lcp] && i.zero? ? "high" : nil) %>
        </div>
      <% end %>
    </div>
  </section>
<% end %>