<%# Animated dashboard preview beside the auth forms; the figures are examples, not data (as on the seallo sign-in page). %>
<% a = ->(key) { t("auth_preview.#{key}") } %>
<%
  money = ->(n) { %(<bdi dir="ltr">#{number_with_delimiter(n, delimiter: " ")} MAD</bdi>).html_safe }
  revenue_days = [1180, 1420, 1310, 1650, 1580, 1290, 1720, 1890, 1760, 1540, 1980, 2140, 1870, 1690, 2210, 2380, 2050, 1930, 2420, 2560, 2290, 2110, 2640, 2810, 2470, 2330, 2860, 3020, 2750, 3180]
  profit_days = revenue_days.each_with_index.map { |v, i| (v * (0.22 + ((i * 7) % 5) * 0.012)).round }
  width = 300.0
  height = 80.0
  peak = revenue_days.max * 1.08
  points = ->(series) { series.each_with_index.map { |v, i| [(i / (series.length - 1.0) * width).round(2), (height - v / peak * height).round(2)] } }
  smooth = lambda do |pts|
    d = "M#{pts[0][0]},#{pts[0][1]}"
    (0...pts.length - 1).each do |i|
      p0 = i.zero? ? pts[0] : pts[i - 1]
      p1 = pts[i]
      p2 = pts[i + 1]
      p3 = pts[i + 2] || p2
      c1 = [(p1[0] + (p2[0] - p0[0]) / 6).round(2), (p1[1] + (p2[1] - p0[1]) / 6).round(2)]
      c2 = [(p2[0] - (p3[0] - p1[0]) / 6).round(2), (p2[1] - (p3[1] - p1[1]) / 6).round(2)]
      d += " C#{c1[0]},#{c1[1]} #{c2[0]},#{c2[1]} #{p2[0]},#{p2[1]}"
    end
    d
  end
  revenue_pts = points.(revenue_days)
  profit_pts = points.(profit_days)
  revenue_line = smooth.(revenue_pts)
  profit_line = smooth.(profit_pts)
  last = revenue_days.length - 1
  today = Date.current
  day_label = ->(n) { date = today - (last - n); "#{date.day} #{a.("months")[date.month - 1]}" }
  best = [["Chemise en lin", 498, 124_002], ["Survêtement Basic", 252, 97_768], ["Pack 3 T-shirts", 237, 31_173], ["Sac en cuir", 124, 18_947]]
  medals = %w[#f59e0b #94a3b8 #c2410c #cfc7c1]
  partners = [[:stores, [["Shopify", "shopify", 24], ["YouCan", "youcan", 24], ["WooCommerce", "woocommerce", 24]]],
              [:delivery, [["Sendit", "sendit", 24], ["Ozon Express", "ozon", 24], ["Cathedis", "cathedis", 15], ["Ameex", "ameex", 13]]],
              [:ads, [["Meta Ads", "meta", 15], ["TikTok Ads", "tiktok", 24]]]]
  steps = a.("steps")
%>
<a href="/" class="sa-mark" aria-label="<%= Store.platform_name %>"><span dir="ltr">seallo</span><% if current_store %><em><%= current_store.name %></em><% end %></a>

<div class="sa-intro">
  <p class="sa-eyebrow"><%= a.("eyebrow") %></p>
  <h2><span class="nowrap"><%= a.("headline") %></span> <span><%= a.("headline_accent") %></span></h2>
  <p class="sa-tagline"><%= a.("tagline") %></p>
</div>

<div class="sa-card sa-chart">
  <div class="sa-chart-head">
    <div>
      <p class="sa-metric-label"><i class="is-brand"></i><%= a.("revenue") %></p>
      <p class="sa-metric"><%= money.(revenue_days.sum) %> <small>↑ 14 %</small></p>
    </div>
    <div>
      <p class="sa-metric-label"><i class="is-green"></i><%= a.("profit") %></p>
      <p class="sa-metric is-green"><%= money.(profit_days.sum) %> <small>↑ 9 %</small></p>
    </div>
    <span class="sa-pill"><%= a.("days_30") %></span>
  </div>
  <div class="sa-chart-plot" dir="ltr">
    <svg viewBox="0 0 <%= width.to_i %> <%= height.to_i %>" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="sa-ca" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#5b46d6" stop-opacity=".22"/><stop offset="1" stop-color="#5b46d6" stop-opacity="0"/></linearGradient>
        <linearGradient id="sa-pr" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#10b981" stop-opacity=".25"/><stop offset="1" stop-color="#10b981" stop-opacity="0"/></linearGradient>
      </defs>
      <% [0.25, 0.5, 0.75].each do |g| %><line x1="0" x2="<%= width.to_i %>" y1="<%= height * g %>" y2="<%= height * g %>" stroke="#ece6e2" stroke-dasharray="3 4" vector-effect="non-scaling-stroke"/><% end %>
      <path d="<%= revenue_line %> L<%= width.to_i %>,<%= height.to_i %> L0,<%= height.to_i %> Z" fill="url(#sa-ca)"/>
      <path d="<%= profit_line %> L<%= width.to_i %>,<%= height.to_i %> L0,<%= height.to_i %> Z" fill="url(#sa-pr)"/>
      <path d="<%= revenue_line %>" fill="none" stroke="#5b46d6" stroke-width="2" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
      <path d="<%= profit_line %>" fill="none" stroke="#10b981" stroke-width="2" stroke-linecap="round" vector-effect="non-scaling-stroke"/>
      <line x1="<%= revenue_pts[last][0] %>" x2="<%= revenue_pts[last][0] %>" y1="0" y2="<%= height.to_i %>" stroke="#10162a" stroke-opacity=".15" vector-effect="non-scaling-stroke"/>
    </svg>
    <span class="sa-dot is-brand" style="left: 100%; top: <%= (revenue_pts[last][1] / height * 100).round(1) %>%"></span>
    <span class="sa-dot is-green" style="left: 100%; top: <%= (profit_pts[last][1] / height * 100).round(1) %>%"></span>
    <div class="sa-tip">
      <p><%= day_label.(last) %></p>
      <p><%= a.("revenue_short") %> <b><%= money.(revenue_days[last]) %></b></p>
      <p class="is-green"><%= a.("profit_short") %> <b><%= money.(profit_days[last]) %></b></p>
    </div>
  </div>
  <div class="sa-axis" dir="ltr"><% [0, 7, 14, 21, 29].each do |n| %><span><%= day_label.(n) %></span><% end %></div>
</div>

<div class="sa-row">
  <div class="sa-card sa-order" data-sa-order data-steps="<%= steps.to_json %>" data-notes="<%= a.("step_notes").to_json %>">
    <div class="sa-order-head"><p class="sa-metric-label"><%= a.("new_order") %></p><span class="sa-live"><i></i><%= a.("live") %></span></div>
    <div class="sa-order-body">
      <span class="sa-order-icon">👕</span>
      <div><p><b>#<span data-sa-num>2046</span></b></p><small>Chemise en lin · Beige · M · Casablanca</small></div>
      <b dir="ltr">249 MAD</b>
    </div>
    <div class="sa-order-steps">
      <% steps.each_with_index do |s, i| %><div data-sa-step="<%= i %>"><span><i></i></span><p><%= s %></p></div><% end %>
    </div>
    <p class="sa-order-note" data-sa-note><%= a.("step_notes")[0] %></p>
  </div>

  <div class="sa-card sa-best">
    <p class="sa-metric-label"><%= a.("best_sellers") %></p>
    <ul>
      <% best.each_with_index do |(name, orders, ca), i| %>
        <li>
          <span class="sa-medal" style="background: <%= medals[i] %>"><%= i + 1 %></span>
          <div>
            <div class="sa-best-line"><p><%= name %></p><b><%= money.(ca) %></b></div>
            <div class="sa-best-bar"><span><i style="width: <%= (ca * 100.0 / best[0][2]).round(1) %>%"></i></span><small><%= orders %> <%= a.("orders_abbr") %></small></div>
          </div>
        </li>
      <% end %>
    </ul>
  </div>
</div>

<div class="sa-partners" dir="ltr">
  <% partners.each do |key, items| %>
    <div>
      <p dir="auto"><%= a.("partner_titles")[key] %></p>
      <ul><% items.each do |name, file, h| %><li><img src="/images/partners/<%= file %>.png" alt="<%= name %>" title="<%= name %>" style="height: <%= h %>px" draggable="false"></li><% end %></ul>
    </div>
  <% end %>
</div>
<script>
  (function () {
    var card = document.querySelector("[data-sa-order]");
    if (!card) return;
    var steps = card.querySelectorAll("[data-sa-step]");
    var notes = JSON.parse(card.dataset.notes);
    var note = card.querySelector("[data-sa-note]");
    var num = card.querySelector("[data-sa-num]");
    var tick = 0;
    var render = function () {
      var n = steps.length + 1;
      var step = tick % n;
      steps.forEach(function (el, i) {
        el.classList.toggle("is-done", i < step);
        el.querySelector("i").style.width = i < step ? "100%" : "0%";
      });
      num.textContent = 2046 + Math.floor(tick / n);
      note.textContent = notes[Math.min(step, notes.length - 1)];
    };
    render();
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    setInterval(function () { tick += 1; render(); }, 1400);
  })();
</script>
