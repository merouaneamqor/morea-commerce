<!DOCTYPE html>
<html lang="<%= current_locale %>" dir="<%= rtl? ? 'rtl' : 'ltr' %>">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "#{Store.platform_name}, #{current_store&.name || "seallo"}" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no,viewport-fit=cover">
    <meta name="theme-color" content="<%= current_store&.admin_theme == "seallo_dark" ? "#15110f" : "#a8432e" %>">
    <link rel="manifest" href="<%= admin_pwa_manifest_path %>">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="<%= Store.platform_name %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "shared/platform_icons" %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;650;700;800&family=Noto+Naskh+Arabic:wght@400;600&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "admin_pwa" %>
    <%= stylesheet_link_tag "liquid_glass" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "admin_responsive", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "admin_dark", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="admin-body" data-admin-theme="<%= current_store&.admin_theme || "seallo" %>" style="font-family: 'Inter', 'Noto Naskh Arabic', ui-sans-serif, system-ui, sans-serif">
    <% if current_admin_user %>
      <% active = seller_active_key %>
      <% agent = current_admin_user.confirmation_agent_view? %>
      <% new_orders = current_store ? Seller::DashboardStats.new(store: current_store).new_orders_count : 0 %>
      <% missing_costs = current_store && !agent ? Seller::DashboardStats.new(store: current_store).missing_costs : 0 %>
      <%# Class strings are plain literals so Tailwind's scanner always generates them. %>
      <% nav_on = "lg-nav__active font-semibold" %>
      <% nav_off = "text-[#5e5a58] hover:bg-[#f3f1ef] hover:text-[#1f2430]" %>
      <% badge_on = "bg-white text-[#a8432e]" %>
      <% badge_off = "bg-[#f4e4de] text-[#a8432e]" %>
      <% sidebar = capture do %>
        <nav class="lg-nav flex h-full flex-col overflow-y-auto rounded-2xl p-3">
          <div class="flex items-center justify-between px-3 pt-2 pb-5">
            <%= link_to (agent ? "/confirmation" : "/dashboard"), class: "text-2xl font-extrabold text-[#a8432e]", dir: "ltr" do %>seallo<% end %>
            <button type="button" data-seller-close class="text-sm text-[#8a8380] lg:hidden" aria-label="<%= sl("Fermer") %>"><%= sl("Fermer") %></button>
          </div>
          <ul class="space-y-1">
            <% seller_menu(current_admin_user).each do |key, icon, label, href| %>
              <% on = key == active %>
              <li>
                <% if href.nil? %>
                  <span class="flex cursor-not-allowed items-center gap-3 rounded-xl px-3 py-2.5 text-sm text-[#a49d99]" title="<%= sl("Bientôt disponible") %>"><%= seller_icon(icon) %> <%= sl(label) %></span>
                <% else %>
                  <%= link_to href, class: "flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm #{on ? nav_on : nav_off}", data: { onboarding_nav: key } do %>
                    <%= seller_icon(icon) %> <%= sl(label) %>
                    <% if key == "orders" && new_orders.positive? %><span class="ms-auto rounded-full px-2 py-0.5 text-[11px] font-semibold <%= on ? badge_on : badge_off %>"><%= new_orders %></span><% end %>
                    <% if key == "products" && missing_costs.positive? %><span class="ms-auto rounded-full bg-[#fbe7ea] px-2 py-0.5 text-[11px] font-semibold text-[#b4344e]" title="<%= sl("produits sans coût") %>"><%= missing_costs %></span><% end %>
                  <% end %>
                <% end %>
              </li>
            <% end %>
          </ul>
          <div class="mt-auto space-y-1 border-t border-[#f0ebe7]/pt-3">
            <% if current_store && !agent %>
              <div class="lg-nav__store mb-2 rounded-xl px-3 py-2.5">
                <p data-seller-store class="truncate text-sm font-semibold text-[#1f2430]"><%= current_store.name %></p>
                <% if seller_plan_label(current_store) %><p class="text-xs text-[#8a8380]"><%= sl("Plan") %> <%= seller_plan_label(current_store) %></p><% end %>
              </div>
            <% end %>
            <%= render "admin/shared/order_alerts" %>
            <% if super_admin? %>
              <%= link_to admin_platform_path, class: "flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm text-[#5e5a58] hover:bg-[#f3f1ef] hover:text-[#1f2430]" do %><%= seller_icon(:plug) %> <%= t("platform_admin.title") %><% end %>
            <% end %>
            <%= link_to "/settings/profile", class: "flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm text-[#5e5a58] hover:bg-[#f3f1ef] hover:text-[#1f2430]" do %><%= seller_icon(:settings) %> <%= sl("Paramètres") %><% end %>
            <%= button_to admin_logout_path, method: :delete, class: "flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-sm text-[#5e5a58] hover:bg-[#f3f1ef] hover:text-[#1f2430]" do %><%= seller_icon(:logout) %> <%= sl("Se déconnecter") %><% end %>
          </div>
        </nav>
      <% end %>

      <div class="lg-shell text-[#5e5a58]" data-seller-shell>
        <div class="mx-auto flex max-w-[1400px] gap-5 p-4 lg:p-5">
          <aside class="sticky top-5 hidden h-[calc(100dvh-2.5rem)] w-56 shrink-0 lg:block"><%= sidebar %></aside>

          <div data-seller-drawer hidden role="dialog" aria-modal="true" aria-label="<%= sl("Menu") %>" class="lg-scrim fixed inset-0 z-50 p-4 lg:hidden">
            <div class="h-full w-64"><%= sidebar %></div>
          </div>

          <main class="min-w-0 flex-1 space-y-4">
            <%= render "admin/shared/impersonation_banner" if impersonating? %>
            <div class="lg-chrome flex items-center justify-between rounded-2xl px-3 py-2.5 lg:hidden">
              <button type="button" data-seller-open aria-expanded="false" class="rounded-xl border border-[#e8e3df]/bg-white/70 p-2" aria-label="Menu"><%= seller_icon(:menu) %></button>
              <span class="text-xl font-extrabold text-[#a8432e]" dir="ltr">seallo</span>
              <span class="w-9"></span>
            </div>
            <%= render "admin/shared/pwa_install" %>
            <% if current_store&.subscription_required? && !subscription_access? %>
              <p class="rounded-xl bg-[#fbe7ea] px-4 py-3 text-sm text-[#b4344e]">
                <%= t("subscriptions.required") %>
                <%= link_to t("subscriptions.title"), admin_subscription_path, class: "underline font-semibold" %>
              </p>
            <% end %>
            <% if store_billing_past_due? %>
              <p class="rounded-xl bg-[#fbe7ea] px-4 py-3 text-sm text-[#b4344e]"><%= t("admin_ui.past_due") %></p>
            <% end %>
            <% if notice.present? %><p class="rounded-xl bg-[#e3f3e8] px-4 py-3 text-sm text-[#2f7a4a]"><%= notice %></p><% end %>
            <% if alert.present? %><p class="rounded-xl bg-[#fbe7ea] px-4 py-3 text-sm text-[#b4344e]"><%= alert %></p><% end %>
            <%= render "admin/shared/meta_ads_notice" %>
            <% unless content_for?(:seller_lang) %><div class="flex justify-end"><%= render "admin/shared/language_switcher" %></div><% end %>
            <div class="admin-page <%= yield(:admin_page_class) %>"><%= yield %></div>
          </main>
        </div>
        <%= render "admin/shared/bottom_nav", active: active, new_orders: new_orders %>
      </div>
      <script>
        (function () {
          var drawer = document.querySelector("[data-seller-drawer]");
          if (!drawer) return;
          var triggers = Array.prototype.slice.call(document.querySelectorAll("[data-seller-open]"));
          var lastTrigger = triggers[0];
          function setExpanded(value) {
            triggers.forEach(function (el) { el.setAttribute("aria-expanded", value); });
          }
          function closeDrawer() {
            drawer.hidden = true;
            setExpanded("false");
            if (lastTrigger) lastTrigger.focus();
          }
          triggers.forEach(function (trigger) {
            trigger.addEventListener("click", function () {
              lastTrigger = trigger;
              drawer.hidden = false;
              setExpanded("true");
              drawer.querySelector("[data-seller-close]").focus();
            });
          });
          drawer.addEventListener("click", function (e) { if (e.target === drawer || e.target.closest("[data-seller-close]")) closeDrawer(); });
          drawer.addEventListener("keydown", function (e) {
            if (e.key === "Escape") closeDrawer();
            if (e.key !== "Tab") return;
            var items = drawer.querySelectorAll("a[href], button:not([disabled])");
            var first = items[0], last = items[items.length - 1];
            if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
            else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
          });
          // Standalone home-screen sessions get safe-area padding on the shell.
          if (window.matchMedia("(display-mode: standalone)").matches || navigator.standalone) {
            document.querySelector("[data-seller-shell]")?.classList.add("lg-shell--standalone");
          }
        })();
      </script>
    <% else %>
      <div class="lg-shell flex min-h-screen items-center justify-center px-4">
        <%= yield %>
      </div>
    <% end %>
  </body>
</html>
