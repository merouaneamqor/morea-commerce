<!DOCTYPE html>
<html lang="<%= current_locale %>" dir="<%= rtl? ? 'rtl' : 'ltr' %>">
  <head>
    <%= render "shared/favicon" %>
    <title><%= content_for?(:title) ? yield(:title) : "#{Store.platform_name} — #{current_store&.name || "seallo"}" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#1d1d1f">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "shared/platform_icons" %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;650;700;800&family=Noto+Naskh+Arabic:wght@400;600&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "admin_pwa" %>
    <%= stylesheet_link_tag "liquid_glass" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="admin-body" data-admin-theme="<%= current_store&.admin_theme || "seallo" %>" style="font-family: 'Inter', 'Noto Naskh Arabic', ui-sans-serif, system-ui, sans-serif">
    <%= render "demo/banner" if Demo::Workspace.demo_store?(current_store) %>
    <% if current_admin_user %>
      <%# Restore the collapsed menu before the first paint, so it does not jump. %>
      <script>try { if (localStorage.getItem("sellerSidebar") === "collapsed") document.documentElement.setAttribute("data-sidebar", "collapsed"); } catch (error) {}</script>
      <% active = seller_active_key %>
      <% agent = current_admin_user.confirmation_agent_view? %>
      <% new_orders = current_store ? Seller::DashboardStats.new(store: current_store).new_orders_count : 0 %>
      <% missing_costs = current_store && !agent ? Seller::DashboardStats.new(store: current_store).missing_costs : 0 %>
      <%# Class strings are plain literals so Tailwind's scanner always generates them. %>
      <% nav_on = "bg-[#ececf0] font-semibold text-[#1d1d1f]" %>
      <% nav_off = "text-[#3a3a3c] hover:bg-[#e8e8ed] hover:text-[#1c1c1e]" %>
      <% badge_on = "bg-white text-[#1d1d1f]" %>
      <% badge_off = "bg-[#ececf0] text-[#1d1d1f]" %>
      <% sidebar = capture do %>
        <nav class="flex h-full flex-col overflow-y-auto rounded-2xl border border-[#e0e0e5] bg-white p-2.5" data-sidebar-nav>
          <div data-sidebar-head class="flex items-center justify-between px-3 pt-1 pb-3">
            <% if agent && current_store %>
              <%# An agent sees their store: its logo (or its name), the name and the address of the site; never the platform name. %>
              <div class="flex min-w-0 flex-1 items-center gap-2" data-collapse-hide data-agent-brand-block>
                <%= link_to "/mes-statistiques", data: { agent_brand: true }, class: "block max-w-[5rem] shrink-0", dir: "ltr" do %><% if current_store.logo_ready? %><%= image_tag MediaUrl.for(current_store.logo, store: current_store), alt: current_store.name, class: "max-h-14 w-auto max-w-[5rem] object-contain" %><% else %><span class="block max-w-[6.5rem] truncate text-lg font-extrabold tracking-tight text-[#1d1d1f]"><%= current_store.name %></span><% end %><% end %>
                <div class="min-w-0">
                  <% if current_store.logo_ready? %><p class="truncate text-[13px] leading-tight font-semibold text-[#1d1d1f]" title="<%= current_store.name %>" data-agent-store-name><%= current_store.name %></p><% end %>
                  <% if current_store.website_url.present? %>
                    <%= link_to current_store.website_label, current_store.website_url, target: "_blank", rel: "noopener noreferrer", title: current_store.website_url, class: "block text-[10px] leading-tight break-all text-[#6e6e73] hover:text-[#1d1d1f] hover:underline", dir: "ltr", data: { agent_store_url: true } %>
                  <% elsif current_store.storefront_enabled? %>
                    <%= link_to current_store.host_label, current_store.origin, target: "_blank", rel: "noopener", title: current_store.host_label, class: "block text-[10px] leading-tight break-all text-[#6e6e73] hover:text-[#1d1d1f] hover:underline", dir: "ltr", data: { agent_store_url: true } %>
                  <% else %>
                    <p class="text-[10px] leading-tight break-all text-[#6e6e73]" dir="ltr" title="<%= current_store.host_label %>" data-agent-store-url><%= current_store.host_label %></p>
                  <% end %>
                </div>
              </div>
            <% else %>
              <%= link_to "/dashboard", "data-collapse-hide": true, class: "text-2xl font-extrabold tracking-tight text-[#1d1d1f]", dir: "ltr" do %>seallo<% end %>
            <% end %>
            <button type="button" data-seller-close class="text-[#6e6e73] lg:hidden" aria-label="✕">✕</button>
            <%# Desktop only: collapse the menu to its icons and open it again. The choice is remembered in this browser. %>
            <button type="button" data-sidebar-toggle aria-expanded="true" title="<%= sl("Réduire le menu") %>" aria-label="<%= sl("Réduire le menu") %>" data-label-collapse="<%= sl("Réduire le menu") %>" data-label-expand="<%= sl("Agrandir le menu") %>"
                    class="hidden size-8 cursor-pointer place-items-center rounded-lg text-[#6e6e73] hover:bg-[#efeff3] hover:text-[#1c1c1e] lg:grid">
              <svg viewBox="0 0 24 24" class="size-4 fill-none stroke-current [stroke-width:2] [stroke-linecap:round] [stroke-linejoin:round] transition-transform rtl:rotate-180" aria-hidden="true"><path d="m15 6-6 6 6 6"/></svg>
            </button>
          </div>
          <ul class="space-y-0.5">
            <% seller_menu(current_admin_user).each do |key, icon, label, href| %>
              <% on = key == active %>
              <li>
                <% if key == "confirmation" %>
                  <%# "Centre d'appels": a group that opens on click and lists its pages; it stays open on any of them. %>
                  <% sub_active = seller_call_center_active %>
                  <details class="group" data-call-center-nav <%= "open" if on %>>
                    <summary title="<%= sl(label) %>" class="flex cursor-pointer list-none items-center gap-3 rounded-xl px-3 py-2 text-sm [&::-webkit-details-marker]:hidden <%= on ? nav_on : nav_off %>">
                      <%= seller_icon(icon) %> <span data-label><%= sl(label) %></span>
                      <svg data-label viewBox="0 0 24 24" class="ms-auto size-4 shrink-0 fill-none stroke-current [stroke-width:2] [stroke-linecap:round] [stroke-linejoin:round] transition-transform group-open:rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                    </summary>
                    <ul class="mt-0.5 ms-5 space-y-0.5 border-s border-[#e0e0e5] ps-2" data-subnav>
                      <% seller_call_center_menu(current_admin_user).each do |sub_key, sub_icon, sub_label, sub_href| %>
                        <li>
                          <% if sub_href.nil? %>
                            <span class="flex cursor-not-allowed items-center gap-2.5 rounded-lg px-2.5 py-1.5 text-[13px] text-[#8e8e93]" title="<%= sl(sub_label) %> · <%= sl("Bientôt disponible") %>" data-subnav-item="<%= sub_key %>"><%= seller_icon(sub_icon, size: 15) %> <span data-label><%= sl(sub_label) %></span></span>
                          <% else %>
                            <%= link_to sub_href, title: sl(sub_label), "data-subnav-item": sub_key, "aria-current": (sub_key == sub_active ? "page" : nil),
                                  class: "flex items-center gap-2.5 rounded-lg px-2.5 py-1.5 text-[13px] #{sub_key == sub_active ? nav_on : nav_off}" do %>
                              <%= seller_icon(sub_icon, size: 15) %> <span data-label><%= sl(sub_label) %></span>
                            <% end %>
                          <% end %>
                        </li>
                      <% end %>
                    </ul>
                  </details>
                <% elsif href.nil? %>
                  <% reason = SellerHelper::SELLER_MENU_BLOCKED_REASONS.fetch(key, "Bientôt disponible") %>
                  <span class="flex cursor-not-allowed items-center gap-3 rounded-xl px-3 py-2 text-sm text-[#8e8e93]" title="<%= sl(label) %> · <%= sl(reason) %>" aria-disabled="true" data-menu-blocked="<%= key %>" data-blocked-reason="<%= sl(reason) %>"><%= seller_icon(icon) %> <span data-label class="flex min-w-0 flex-col leading-tight"><span><%= sl(label) %></span><% if SellerHelper::SELLER_MENU_BLOCKED_REASONS.key?(key) %><span class="inline-flex items-center gap-1 text-[10px] font-medium text-[#a0a0a8]" data-blocked-line><%= seller_icon(:lock, size: 9) %><%= sl(reason) %></span><% end %></span></span>
                <% else %>
                  <%= link_to href, title: sl(label), class: "flex items-center gap-3 rounded-xl px-3 py-2 text-sm #{on ? nav_on : nav_off}" do %>
                    <%= seller_icon(icon) %> <span data-label><%= sl(label) %></span>
                    <% if key == "orders" && new_orders.positive? %><span data-badge class="ms-auto rounded-full px-2 py-0.5 text-[11px] font-semibold <%= on ? badge_on : badge_off %>"><%= new_orders %></span><% end %>
                    <% if key == "products" && missing_costs.positive? %><span data-badge class="ms-auto rounded-full bg-[#fbe7ea] px-2 py-0.5 text-[11px] font-semibold text-[#b4344e]" title="<%= sl("produits sans coût") %>"><%= missing_costs %></span><% end %>
                  <% end %>
                <% end %>
              </li>
            <% end %>
          </ul>
          <div class="mt-auto space-y-0.5 border-t border-[#ececf0] pt-2">
            <% if current_store && !agent %>
              <%# The plan card opens the plans page, where the owner changes the subscription (the plans live on the shared host). %>
              <%= link_to seller_plans_url, data: { collapse_hide: true, plan_card: true }, title: sl("Changer de plan"), class: "group mb-1.5 block rounded-xl bg-[#e8e8ed] px-3 py-2 transition hover:bg-[#dedee4]" do %>
                <p data-seller-store class="truncate text-sm font-semibold text-[#1c1c1e]"><%= current_store.name %></p>
                <% if seller_plan_label(current_store) %><p class="text-xs text-[#6e6e73]">Plan · <%= seller_plan_label(current_store) %></p><% end %>
                <p class="mt-0.5 text-[11px] font-semibold text-[#1c1c1e] underline-offset-2 group-hover:underline"><%= sl("Changer de plan") %> →</p>
              <% end %>
            <% end %>
            <% if super_admin? %>
              <%= link_to admin_platform_path, class: "flex items-center gap-3 rounded-xl px-3 py-2 text-sm text-[#3a3a3c] hover:bg-[#e8e8ed] hover:text-[#1c1c1e]" do %><%= seller_icon(:plug) %> <span data-label>Platform</span><% end %>
            <% end %>
            <%= link_to "/settings/profile", title: sl("Paramètres"), class: "flex items-center gap-3 rounded-xl px-3 py-2 text-sm text-[#3a3a3c] hover:bg-[#e8e8ed] hover:text-[#1c1c1e]" do %><%= seller_icon(:settings) %> <span data-label><%= sl("Paramètres") %></span><% end %>
            <%= button_to admin_logout_path, method: :delete, title: sl("Se déconnecter"), class: "flex w-full items-center gap-3 rounded-xl px-3 py-2 text-sm text-[#3a3a3c] hover:bg-[#e8e8ed] hover:text-[#1c1c1e]" do %><%= seller_icon(:logout) %> <span data-label><%= sl("Se déconnecter") %></span><% end %>
          </div>
        </nav>
      <% end %>

      <div class="min-h-dvh bg-white text-[#3a3a3c]" data-seller-shell>
        <div class="mx-auto flex max-w-[1400px] gap-5 p-4 lg:p-5">
          <aside class="sticky top-5 hidden h-[calc(100dvh-2.5rem)] w-56 shrink-0 lg:block"><%= sidebar %></aside>

          <div data-seller-drawer hidden class="lg-scrim fixed inset-0 z-50 p-4 lg:hidden">
            <div class="h-full w-64"><%= sidebar %></div>
          </div>

          <%# An agent on shift: this page tells the server every 30 s that they are still here (see presence_controller.js). %>
          <% on_shift = agent && current_store && ConfirmationShift.open.exists?(store: current_store, user: current_admin_user) %>
          <% if on_shift %>
            <span hidden data-presence data-controller="presence" data-presence-url-value="<%= heartbeat_admin_confirmations_path %>"></span>
          <% end %>
          <% if agent && current_store %>
            <%# Glass welcome window: name, word of the day, clock-in when not on shift, and a congratulation at every hundred orders handled today. %>
            <%= render "admin/shared/agent_welcome", welcome: Confirmations::AgentWelcome.new(store: current_store, user: current_admin_user), on_shift: on_shift %>
          <% end %>
          <main class="min-w-0 flex-1 space-y-4">
            <div class="flex items-center justify-between lg:hidden">
              <button type="button" data-seller-open class="rounded-lg border border-[#e0e0e5] bg-white p-2" aria-label="Menu"><%= seller_icon(:menu) %></button>
              <span class="text-xl font-extrabold tracking-tight text-[#1d1d1f]" dir="ltr"><% if agent && current_store %><% if current_store.logo_ready? %><%= image_tag MediaUrl.for(current_store.logo, store: current_store), alt: current_store.name, class: "max-h-8 w-auto max-w-[9rem] object-contain" %><% else %><%= current_store.name %><% end %><% else %>seallo<% end %></span>
              <span class="w-9"></span>
            </div>
            <% if current_store&.subscription_required? && !subscription_access? %>
              <p class="rounded-xl bg-[#fbe7ea] px-4 py-3 text-sm text-[#b4344e]">
                <%= t("subscriptions.required") %>
                <%= link_to t("subscriptions.title"), admin_subscription_path, class: "underline font-semibold" %>
              </p>
            <% end %>
            <% if store_billing_past_due? %>
              <p class="rounded-xl bg-[#fbe7ea] px-4 py-3 text-sm text-[#b4344e]">Subscription payment is overdue. Your storefront stays online, but renew with the platform owner to clear billing.</p>
            <% end %>
            <%= render "admin/shared/toasts" %>
            <%= render "admin/shared/meta_ads_notice" %>
            <% unless content_for?(:seller_lang) %><div class="flex justify-end"><%= render "admin/shared/language_switcher" %></div><% end %>
            <div class="admin-page <%= yield(:admin_page_class) %>"><%= yield %></div>
          </main>
        </div>
      </div>
      <script>
        (function () {
          var root = document.documentElement;
          function apply(collapsed) {
            if (collapsed) root.setAttribute("data-sidebar", "collapsed"); else root.removeAttribute("data-sidebar");
            document.querySelectorAll("[data-sidebar-toggle]").forEach(function (button) {
              var label = collapsed ? button.dataset.labelExpand : button.dataset.labelCollapse;
              button.setAttribute("aria-expanded", String(!collapsed));
              button.setAttribute("title", label);
              button.setAttribute("aria-label", label);
            });
          }
          document.addEventListener("click", function (e) {
            if (!e.target.closest("[data-sidebar-toggle]")) return;
            var collapsed = root.getAttribute("data-sidebar") !== "collapsed";
            apply(collapsed);
            try { localStorage.setItem("sellerSidebar", collapsed ? "collapsed" : "expanded"); } catch (error) {}
          });
          apply(root.getAttribute("data-sidebar") === "collapsed");
        })();
        (function () {
          var drawer = document.querySelector("[data-seller-drawer]");
          if (!drawer) return;
          document.querySelector("[data-seller-open]").addEventListener("click", function () { drawer.hidden = false; });
          drawer.addEventListener("click", function (e) { if (e.target === drawer || e.target.closest("[data-seller-close]")) drawer.hidden = true; });
        })();
      </script>
    <% else %>
      <div class="flex min-h-screen items-center justify-center px-4">
        <%= yield %>
      </div>
    <% end %>
  </body>
</html>
