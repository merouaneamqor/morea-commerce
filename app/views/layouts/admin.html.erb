<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Admin — #{current_store&.name || "Store"}" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;650;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="admin-body">
    <% if current_admin_user %>
      <div class="admin-shell" data-controller="admin-menu">
        <header class="admin-topbar">
          <div class="flex items-center gap-2">
            <button type="button" class="admin-topbar__menu md:hidden" data-action="admin-menu#toggle" aria-label="Menu">
              <%= admin_icon(:menu) %>
            </button>
            <%= link_to admin_root_path, class: "admin-topbar__brand" do %>
              <span class="admin-topbar__logo"><%= current_store&.name.to_s.first.presence || "M" %></span>
              <span><%= current_store&.name || "Store" %></span>
            <% end %>
          </div>

          <%= form_with url: admin_orders_path, method: :get, class: "admin-topbar__search" do %>
            <%= admin_icon(:search, size: 16) %>
            <%= search_field_tag :q, params[:q], placeholder: "Search orders", "aria-label": "Search orders" %>
          <% end %>

          <div class="admin-topbar__account gap-3">
            <% if super_admin? %>
              <%= link_to "Platform", admin_platform_path, class: "admin-btn-plain hidden sm:inline" %>
            <% end %>
            <span class="admin-avatar"><%= current_store&.name.to_s.first.presence || "M" %></span>
            <span class="hidden sm:inline"><%= current_store&.name || "Store" %></span>
          </div>
        </header>

        <aside class="admin-sidebar" data-admin-menu-target="sidebar">
          <nav class="admin-sidebar__nav">
            <%= admin_nav_link "Home", admin_root_path, icon: :home, active: controller_name == "dashboard" %>
            <%= admin_nav_link "Orders", admin_orders_path, icon: :orders, active: controller_name == "orders" %>
            <%= admin_nav_link "Products", admin_products_path, icon: :products, active: controller_name.in?(%w[products variants inventory]) %>
            <%= admin_nav_link "Collections", admin_collections_path, icon: :collections, active: controller_name == "collections" %>
            <%= admin_nav_link "Discounts", admin_discounts_path, icon: :discounts, active: controller_name == "discounts" %>
            <%= admin_nav_link "Media", admin_media_path, icon: :image, active: controller_name == "media" %>
            <%= admin_nav_link "Customers", admin_customers_path, icon: :customers, active: controller_name == "customers" %>

            <p class="admin-sidebar__heading">Sales channels</p>
            <% online_store = controller_name.in?(%w[home_sections pages menu_items]) %>
            <%= admin_nav_link "Online Store", admin_home_sections_path, icon: :store, active: online_store %>
            <% if online_store %>
              <div class="admin-subnav">
                <%= link_to "Customize", admin_home_sections_path, class: "admin-subnav__item #{'is-active' if controller_name == 'home_sections'}" %>
                <%= link_to "Pages", admin_pages_path, class: "admin-subnav__item #{'is-active' if controller_name == 'pages'}" %>
                <%= link_to "Navigation", admin_menu_items_path, class: "admin-subnav__item #{'is-active' if controller_name == 'menu_items'}" %>
              </div>
            <% end %>
          </nav>

          <div class="admin-sidebar__footer">
            <% if super_admin? %>
              <%= admin_nav_link "Platform", admin_platform_path, icon: :external, active: false %>
            <% end %>
            <% settings_open = controller_name.in?(%w[stores pixels]) %>
            <%= admin_nav_link "Settings", edit_admin_store_path, icon: :settings, active: settings_open %>
            <% if settings_open %>
              <div class="admin-subnav">
                <%= link_to "General", edit_admin_store_path, class: "admin-subnav__item #{'is-active' if controller_name == 'stores'}" %>
                <%= link_to "Pixels", edit_admin_pixels_path, class: "admin-subnav__item #{'is-active' if controller_name == 'pixels'}" %>
              </div>
            <% end %>
            <%= admin_nav_link "Staff", admin_users_path, icon: :staff, active: controller_name == "users" %>
            <%= button_to admin_logout_path, method: :delete, class: "admin-nav-item w-full" do %>
              <%= admin_icon(:logout) %><span>Sign out</span>
            <% end %>
          </div>
        </aside>
        <div class="admin-scrim md:hidden" data-action="click->admin-menu#close"></div>

        <main class="admin-main">
          <div class="admin-page">
            <% if store_billing_past_due? %>
              <div class="admin-banner admin-banner--critical">
                Subscription payment is overdue. Your storefront stays online, but renew with the platform owner to clear billing.
              </div>
            <% end %>
            <% if notice.present? %><div class="admin-banner admin-banner--success"><%= notice %></div><% end %>
            <% if alert.present? %><div class="admin-banner admin-banner--critical"><%= alert %></div><% end %>
            <%= yield %>
          </div>
        </main>
      </div>
    <% else %>
      <div class="flex min-h-screen items-center justify-center px-4">
        <%= yield %>
      </div>
    <% end %>
  </body>
</html>
