<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= rtl? ? "rtl" : "ltr" %>">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "#{current_store&.name || "Morea"} — #{current_store&.tagline || t("store.tagline_fallback")}" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="<%= content_for?(:hero_nav) ? "#1a1716" : "#f7f5f2" %>">
    <meta name="description" content="<%= content_for?(:meta_description) ? yield(:meta_description) : (current_store&.tagline || t("store.tagline_fallback")) %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0;400;500;600;1,400&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&family=Noto+Naskh+Arabic:wght@400;500;600&display=swap" rel="stylesheet">
    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.svg">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <% body = yield %>
  <body class="min-h-screen min-h-dvh <%= "has-mobile-buy" if content_for?(:mobile_buy) %> <%= "is-rtl" if rtl? %>">
    <header class="maison-nav <%= "is-over-hero" if content_for?(:hero_nav) %>">
      <%= render "shared/brand_lockup" %>
      <nav class="flex items-center gap-5 md:gap-8">
        <%= link_to t("nav.shop"), collections_path, class: "maison-link" %>
        <%= link_to cart_path, class: "maison-link" do %>
          <%= t("nav.bag") %><% if cart_count.positive? %><span class="ms-1 opacity-70"><%= cart_count %></span><% end %>
        <% end %>
        <%= render "shared/locale_switcher" %>
      </nav>
    </header>

    <% if notice.present? %>
      <div class="flash" data-controller="reveal"><%= notice %></div>
    <% end %>
    <% if alert.present? %>
      <div class="flash" data-controller="reveal"><%= alert %></div>
    <% end %>

    <main>
      <%= body %>
    </main>

    <footer class="morea-packaging border-t border-line px-5 py-12 text-center md:px-10 md:py-14"
            style="padding-bottom: max(3rem, calc(env(safe-area-inset-bottom) + 2rem))">
      <div class="morea-packaging__mark mx-auto text-ink" aria-hidden="true">
        <%= render "shared/wordmark_svg" %>
      </div>
      <p class="mt-5 text-[10px] uppercase tracking-[0.32em] text-ink-faint md:tracking-[0.4em]">
        <%= t("store.footer_tagline") %>
      </p>
      <p class="mt-3 text-[10px] uppercase tracking-[0.22em] text-ink-faint">
        <%= current_store&.cod_label || t("store.default_campaign_cta") %>
      </p>
      <div class="mt-6 flex flex-wrap items-center justify-center gap-x-8 gap-y-3 text-[10px] uppercase tracking-[0.22em] text-ink-faint">
        <%= link_to t("nav.track_order"), track_orders_path, class: "hover:text-ink" %>
        <%= link_to "@morea.style", "https://www.instagram.com/morea.style/",
              class: "hover:text-ink", target: "_blank", rel: "noopener noreferrer" %>
        <span>morea.website</span>
      </div>
    </footer>
  </body>
</html>
