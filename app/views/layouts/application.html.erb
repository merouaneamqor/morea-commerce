<!DOCTYPE html>
<html lang="<%= I18n.locale %>" dir="<%= rtl? ? "rtl" : "ltr" %>">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "#{current_store&.name || "Morea"} — #{current_store&.tagline || t("store.tagline_fallback")}" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="<%= content_for?(:hero_nav) ? "#1a1716" : "#f7f5f2" %>">
    <meta name="description" content="<%= content_for?(:meta_description) ? yield(:meta_description) : (current_store&.tagline || t("store.tagline_fallback")) %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&family=Noto+Naskh+Arabic:wght@400;500;600&display=swap" rel="stylesheet">
    <%= yield :head %>

    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.svg">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <% body = yield %>
  <body class="min-h-screen min-h-dvh <%= "has-mobile-buy" if content_for?(:mobile_buy) %> <%= "is-rtl" if rtl? %> <%= "has-announcement" if current_store&.announcement.present? %>"
        data-controller="cart-drawer">
    <div class="site-header">
      <% if current_store&.announcement.present? %>
        <p class="announcement-bar"><%= current_store.announcement %></p>
      <% end %>
      <header class="maison-nav <%= "is-over-hero" if content_for?(:hero_nav) %> <%= "is-split-hero" if content_for?(:split_hero_nav) %>"
              data-controller="nav-scroll">
        <div class="flex items-center gap-8">
          <%= render "shared/brand_lockup" %>
          <nav class="maison-nav__menu" aria-label="<%= t("nav.main_menu") %>">
            <% store_menu("header").each do |item| %>
              <%= store_menu_link item, class: "maison-link" %>
            <% end %>
          </nav>
        </div>
        <nav class="maison-nav__actions">
          <details class="mobile-menu md:hidden">
            <summary class="maison-link cursor-pointer list-none"><%= t("nav.menu") %></summary>
            <div class="mobile-menu__panel">
              <% store_menu("header").each do |item| %>
                <%= store_menu_link item, class: "mobile-menu__link" %>
              <% end %>
            </div>
          </details>
          <%= link_to cart_path, class: "maison-link", data: { action: "cart-drawer#open" } do %>
            <%= t("nav.bag") %><%= render "carts/count" %>
          <% end %>
          <%= render "shared/locale_switcher" %>
        </nav>
      </header>
    </div>

    <% if notice.present? %>
      <div class="flash" data-controller="reveal"><%= notice %></div>
    <% end %>
    <% if alert.present? %>
      <div class="flash" data-controller="reveal"><%= alert %></div>
    <% end %>

    <main>
      <%= body %>
    </main>

    <%= render "shared/footer" %>
    <% if current_cart && controller_name != "checkouts" %>
      <%= render "carts/drawer", cart: current_cart %>
    <% end %>
  </body>
</html>
