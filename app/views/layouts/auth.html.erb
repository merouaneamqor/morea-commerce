<% localized = content_for?(:localized) %>
<% brand = current_store&.name.presence || Store.platform_name %>
<% account_origin = Store.apex_host?(request.host) ? "" : Store.platform_origin %>
<% login_page = controller_path == "admin/sessions" %>
<!DOCTYPE html>
<html lang="<%= localized ? I18n.locale : "en" %>" dir="<%= localized && rtl? ? "rtl" : "ltr" %>">
  <head>
    <meta charset="utf-8">
    <title><%= content_for?(:title) ? yield(:title) : t("sign_in.heading") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Naskh+Arabic:wght@400;600&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "platform_home", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "auth", "data-turbo-track": "reload" %>
  </head>
  <body>
    <div class="platform-landing auth-page fx-stage" dir="<%= localized && rtl? ? "rtl" : "ltr" %>">
      <header class="platform-header auth-header">
        <div class="auth-container auth-header-inner">
          <a href="/" class="platform-brand"><span class="platform-logo" aria-hidden="true"><%= brand.first %><span>.</span></span><span><%= brand %><span class="platform-brand-suffix"> crm</span></span></a>
          <div class="auth-header-actions">
            <%= yield :topbar %>
            <a href="/" class="auth-home-link"><%= t("registration.auth.home") %></a>
          </div>
        </div>
      </header>
      <main class="auth-container auth-main">
        <section class="auth-aside" aria-label="<%= brand %>">
          <%= yield :aside %>
          <div class="auth-map" aria-hidden="true"><%= render "platform_home/network_map" %></div>
        </section>
        <div class="auth-form-column">
          <nav class="auth-tabs" aria-label="<%= t("registration.auth.sign_in") %> / <%= t("registration.auth.sign_up") %>">
            <%= link_to t("registration.auth.login_tab"), admin_login_path(locale: I18n.locale), "aria-current": (login_page ? "page" : nil) %>
            <%= link_to t("registration.auth.signup_tab"), "#{account_origin}#{signup_path(locale: I18n.locale)}", "aria-current": (controller_path == "signups" ? "page" : nil) %>
          </nav>
          <%= yield %>
          <p class="auth-secure-note"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 10V7a6 6 0 0 1 12 0v3M5 10h14v11H5z"/></svg><%= t("registration.auth.secure_note") %></p>
        </div>
      </main>
      <footer class="auth-container auth-footer"><span>© <%= Date.current.year %> <%= brand %></span><span><%= t("registration.auth.footer_tagline") %></span></footer>
    </div>
  </body>
</html>
