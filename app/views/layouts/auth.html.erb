<% localized = content_for?(:localized) %>
<!DOCTYPE html>
<html lang="<%= localized ? I18n.locale : "en" %>">
  <head>
    <meta charset="utf-8">
    <title><%= content_for?(:title) ? yield(:title) : "Sign in" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="dark">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Naskh+Arabic:wght@400;600&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>
  <body class="bg-[#04122e]" style="font-family: 'Inter', 'Noto Naskh Arabic', ui-sans-serif, system-ui, sans-serif">
    <% brand = current_store&.name.presence || Store.platform_name %>
    <div class="fx-stage" dir="<%= localized && rtl? ? "rtl" : "ltr" %>">
      <span class="fx-orb" style="width: 28rem; height: 28rem; top: -8rem; right: -6rem" aria-hidden="true"></span>
      <span class="fx-orb" style="width: 22rem; height: 22rem; bottom: -8rem; left: -6rem; animation-delay: -6s" aria-hidden="true"></span>

      <div class="relative z-10 mx-auto flex min-h-screen max-w-6xl flex-col px-5 sm:px-8">
        <header class="flex flex-wrap items-center justify-between gap-4 py-6">
          <a href="/" class="flex items-center gap-2 text-base font-semibold tracking-tight text-white">
            <span class="fx-dot" aria-hidden="true"></span><%= brand %>
          </a>
          <div class="flex flex-wrap items-center gap-4 text-xs text-[#b9d3ff]">
            <%= yield :topbar %>
            <a href="/" class="fx-link"><%= content_for?(:back_label) ? yield(:back_label) : "Back to home" %></a>
          </div>
        </header>

        <main class="grid flex-1 items-center gap-10 pb-12 lg:grid-cols-2 lg:gap-16">
          <section class="hidden lg:block" aria-hidden="<%= content_for?(:aside) ? "false" : "true" %>">
            <%= yield :aside %>
          </section>
          <div class="mx-auto w-full max-w-md lg:max-w-lg">
            <%= yield %>
          </div>
        </main>

        <footer class="py-6 text-center text-xs text-[#7f9bc9]"><%= brand %> · <%= Store.base_domain %></footer>
      </div>
    </div>
  </body>
</html>
