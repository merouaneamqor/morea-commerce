<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <meta charset="utf-8">
    <title><%= content_for?(:title) ? yield(:title) : "seallo" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="color-scheme" content="light">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "shared/platform_icons" %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Noto+Naskh+Arabic:wght@400;600&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>
  <body class="seallo-flow" style="font-family: 'Inter', 'Noto Naskh Arabic', ui-sans-serif, system-ui, sans-serif">
    <div dir="<%= rtl? ? "rtl" : "ltr" %>" class="flex min-h-dvh flex-col bg-[#e9ecf1] text-[#4b5260]">
      <header class="mx-auto flex w-full max-w-6xl items-center justify-between px-4 <%= content_for?(:tall_header) ? "py-6" : "py-4" %> sm:px-6">
        <a href="/" class="text-2xl font-extrabold tracking-tight text-[#5b46d6]"><span dir="ltr">seallo</span></a>
        <div class="flex items-center gap-3">
          <div class="sa-lang">
            <nav aria-label="<%= t("platform_home.language") %>" dir="ltr">
              <% Morea::Locales::AVAILABLE.each do |locale| %>
                <%= link_to locale.to_s.upcase, url_for(request.query_parameters.merge(locale: locale, only_path: true)), "aria-current": (locale.to_s == I18n.locale.to_s ? "true" : nil) %>
              <% end %>
            </nav>
          </div>
          <% if @guest %>
            <p class="hidden text-sm sm:block">
              <%= st("Vous avez déjà un compte ?") %>
              <%= link_to st("Se connecter →"), admin_login_path(locale: I18n.locale), class: "font-semibold text-[#5b46d6] hover:underline" %>
            </p>
          <% elsif @guest == false %>
            <div class="flex items-center gap-4">
              <%= button_to st("Se déconnecter"), admin_logout_path, method: :delete, class: "text-sm font-medium hover:text-[#10162a]" %>
              <%= link_to st("Tableau de bord →"), admin_root_path, class: "rounded-lg bg-[#10162a] px-4 py-2 text-sm font-semibold text-white hover:bg-[#10162a]/85" %>
            </div>
          <% else %>
            <%= button_to st("Se déconnecter"), admin_logout_path, method: :delete, class: "text-sm font-medium hover:text-[#10162a]" %>
          <% end %>
        </div>
      </header>
      <%= yield %>
    </div>
  </body>
</html>
