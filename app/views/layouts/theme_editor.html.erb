<!DOCTYPE html>
<html lang="<%= current_locale %>" dir="<%= rtl? ? "rtl" : "ltr" %>">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Theme editor" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#f1f1f1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "shared/platform_icons" %>
    <%= render "shared/fonts", primary: :dm_sans %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "storefront_responsive", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "theme_editor", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="te-body">
    <%= yield %>
  </body>
</html>
