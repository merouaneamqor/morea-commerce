<!DOCTYPE html>
<html lang="<%= current_locale %>" dir="<%= rtl? ? "rtl" : "ltr" %>">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Theme editor" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
    <meta name="theme-color" content="#f1f1f1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= render "shared/platform_icons" %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600&family=Inter:wght@400;500;600;700&family=Luxurious+Roman&family=Noto+Naskh+Arabic:wght@400;600&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "storefront_responsive", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "theme_editor", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="te-body">
    <%= yield %>
  </body>
</html>
