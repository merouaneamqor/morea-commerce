<% content_for :title, "#{t("orders.order")} #{@order.number} — #{current_store.name}" %>

<section class="mx-auto max-w-xl px-5 pb-24 pt-28 md:px-12 md:pb-28 md:pt-32" data-controller="reveal">
  <span class="order-done__mark" aria-hidden="true">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M5 12.5l4.5 4.5L19 7.5"/></svg>
  </span>
  <p class="mt-6 text-[10px] uppercase tracking-[0.3em] text-brass"><%= t("orders.confirmed") %></p>
  <h1 class="mt-3 font-display text-3xl text-ink md:mt-4 md:text-4xl"><%= t("orders.thanks", name: @order.customer_name.to_s.split.first) %></h1>
  <p class="mt-3 text-sm leading-7 text-ink-soft"><%= t("orders.number_line", number: @order.number) %></p>

  <div class="order-done__due">
    <span class="text-[10px] uppercase tracking-[0.22em] text-ink-faint"><%= t("orders.to_pay") %></span>
    <span class="font-display text-3xl text-ink"><%= @order.total_display %></span>
  </div>

  <div class="order-done__next">
    <p><%= t(current_store.whatsapp_url ? "orders.next_whatsapp" : "orders.next_call", phone: Phonelib.parse(@order.customer_phone).national) %></p>
    <% if current_store.cod_note.present? %>
      <p><%= current_store.cod_note %></p>
    <% end %>
  </div>

  <% if (wa = current_store.whatsapp_url(t("orders.whatsapp_message", number: @order.number, total: @order.total_display))) %>
    <%= link_to wa, class: "maison-button mt-6 flex w-full items-center justify-center gap-3", target: "_blank", rel: "noopener" do %>
      <%= render "shared/whatsapp_icon" %>
      <span><%= t("orders.open_whatsapp") %></span>
    <% end %>
  <% end %>

  <div class="mt-10 space-y-3 border-y border-line py-6 text-sm md:py-8">
    <% @order.order_items.each do |item| %>
      <div class="flex justify-between gap-4">
        <span class="min-w-0"><%= item.product_name %><%= " — #{item.variant_name}" if item.variant_name %> × <%= item.quantity %></span>
        <span class="shrink-0"><%= money(item.total_cents, @order.currency) %></span>
      </div>
    <% end %>
  </div>

  <div class="mt-8 space-y-4 text-sm text-ink-soft">
    <p><span class="text-[10px] uppercase tracking-[0.18em] text-ink-faint"><%= t("orders.status") %></span><br><%= @order.status_label %></p>
    <p><span class="text-[10px] uppercase tracking-[0.18em] text-ink-faint"><%= t("orders.delivery") %></span><br><%= @order.delivery_address %>, <%= @order.customer_city %></p>
    <p><span class="text-[10px] uppercase tracking-[0.18em] text-ink-faint"><%= t("orders.phone") %></span><br><span dir="ltr"><%= Phonelib.parse(@order.customer_phone).national %></span></p>
  </div>

  <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:gap-6 md:mt-12">
    <%= link_to t("orders.continue_browsing"), localized_root_path, class: "maison-cta" %>
    <%= link_to t("orders.track_order"), track_orders_path, class: "maison-link self-start pt-1" %>
  </div>
</section>
