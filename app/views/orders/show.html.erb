<% content_for :title, "Order #{@order.number} — #{current_store.name}" %>

<section class="mx-auto max-w-xl px-5 pb-24 pt-28 md:px-12 md:pb-28 md:pt-32" data-controller="reveal">
  <p class="text-[10px] uppercase tracking-[0.3em] text-brass"><%= t("orders.confirmed") %></p>
  <h1 class="mt-3 font-display text-3xl text-ink md:mt-4 md:text-4xl"><%= @order.number %></h1>
  <p class="mt-4 text-sm leading-7 text-ink-soft">
    <%= t("orders.thank_you_html", name: @order.customer_name, total: @order.total_display).html_safe %>
  </p>

  <div class="mt-8 space-y-3 border-y border-line py-6 text-sm md:mt-10 md:py-8">
    <% @order.order_items.each do |item| %>
      <div class="flex justify-between gap-4">
        <span class="min-w-0"><%= item.product_name %><%= " — #{item.variant_name}" if item.variant_name %> × <%= item.quantity %></span>
        <span class="shrink-0"><%= money(item.total_cents, @order.currency) %></span>
      </div>
    <% end %>
  </div>

  <div class="mt-8 space-y-4 text-sm text-ink-soft">
    <p><span class="text-[10px] uppercase tracking-[0.18em] text-ink-faint"><%= t("orders.status") %></span><br><%= @order.status_label %></p>
    <p><span class="text-[10px] uppercase tracking-[0.18em] text-ink-faint"><%= t("orders.delivery") %></span><br><%= @order.customer_address %>, <%= @order.customer_city %></p>
    <p><span class="text-[10px] uppercase tracking-[0.18em] text-ink-faint"><%= t("orders.phone") %></span><br><%= @order.customer_phone %></p>
  </div>

  <div class="mt-10 flex flex-col gap-4 sm:flex-row sm:flex-wrap sm:gap-6 md:mt-12">
    <%= link_to t("orders.continue_browsing"), localized_root_path, class: "maison-cta" %>
    <%= link_to t("orders.track_order"), track_orders_path, class: "maison-link self-start pt-1" %>
  </div>
</section>
