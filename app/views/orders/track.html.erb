<% content_for :title, "#{t("orders.track_title")} — #{current_store.name}" %>

<section class="mx-auto max-w-md px-5 pb-24 pt-28 md:px-12 md:pb-28 md:pt-32">
  <h1 class="font-display text-3xl text-ink md:text-4xl"><%= t("orders.track_title") %></h1>
  <p class="mt-3 text-sm text-ink-soft md:mt-4"><%= t("orders.track_hint") %></p>

  <%= form_with url: lookup_orders_path, method: :post, class: "mt-8 space-y-7 md:mt-10 md:space-y-8" do %>
    <div class="space-y-2">
      <label class="text-[10px] uppercase tracking-[0.2em] text-ink-faint"><%= t("orders.order_number") %></label>
      <%= text_field_tag :number, params[:number], required: true, placeholder: "M000000", autocomplete: "off", class: "w-full border-0 border-b border-line bg-transparent py-3 text-base outline-none md:text-sm" %>
    </div>
    <div class="space-y-2">
      <label class="text-[10px] uppercase tracking-[0.2em] text-ink-faint"><%= t("orders.phone") %></label>
      <%= telephone_field_tag :phone, params[:phone], required: true, autocomplete: "tel", inputmode: "tel", class: "w-full border-0 border-b border-line bg-transparent py-3 text-base outline-none md:text-sm" %>
    </div>
    <%= submit_tag t("orders.find"), class: "maison-button w-full cursor-pointer text-center" %>
  <% end %>
</section>
