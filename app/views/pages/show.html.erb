<% content_for :title, "#{@page.seo_title.presence || @page.title} — #{current_store.name}" %>
<% content_for :meta_description, @page.seo_description.presence || @page.body.to_s.truncate(155) %>

<% if @page.landing? && @sections.any? %>
  <% if @sections.first&.kind == "hero" %>
    <% content_for :hero_nav, "1" %>
  <% end %>
  <% if (lcp_preload = page_lcp_preload(@sections.first)) %>
    <% content_for :lcp, lcp_preload %>
  <% end %>

  <% @sections.each_with_index do |section, index| %>
    <%= render "home/sections/#{section.kind}", section: section, first: index.zero?, lcp: index.zero? %>
  <% end %>
<% else %>
  <article class="store-page">
    <header class="store-page__head">
      <p class="landing-eyebrow justify-center"><%= current_store.name %></p>
      <h1 class="store-page__title"><%= @page.title %></h1>
    </header>
    <div class="store-page__body">
      <%= Morea::Markdown.render(@page.body) %>
    </div>
  </article>
<% end %>
