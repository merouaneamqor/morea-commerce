<% content_for :title, t("password_reset.edit_title") %>
<%= render "password_resets/chrome" %>
<div class="fx-glass p-7 sm:p-9">
  <% if @user.nil? %>
    <h1 class="text-3xl font-bold tracking-tight text-white"><%= t("password_reset.invalid_title") %></h1>
    <p class="mt-3 text-sm leading-6 text-[#b9d3ff]" role="alert"><%= t("password_reset.invalid_body") %></p>
    <%= link_to t("password_reset.request_new_link"), new_password_reset_path(locale: I18n.locale), class: "fx-btn mt-7 inline-flex items-center justify-center no-underline" %>
  <% else %>
    <h1 class="text-3xl font-bold tracking-tight text-white"><%= t("password_reset.edit_title") %></h1>
    <p class="mt-3 text-sm leading-6 text-[#b9d3ff]"><%= t("password_reset.edit_lead") %></p>
    <% if @user.errors.any? %>
      <div role="alert" class="fx-alert mt-5">
        <p><%= t("registration.fix_fields") %></p>
        <ul class="mt-2 list-inside list-disc"><% @user.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
      </div>
    <% end %>
    <%= form_with url: password_reset_path(locale: I18n.locale), method: :patch, class: "mt-7 space-y-5" do %>
      <%= hidden_field_tag :token, @token %>
      <div>
        <%= label_tag :password, t("registration.password"), class: "fx-label" %>
        <%= password_field_tag :password, nil, required: true, autocomplete: "new-password", minlength: 12, maxlength: 72, autofocus: true,
              "aria-invalid": (@user.errors.include?(:password) ? "true" : nil), "aria-describedby": "reset-password-help", class: "fx-input" %>
        <p id="reset-password-help" class="mt-2 text-xs text-[#b9d3ff]"><%= t("registration.password_help") %></p>
      </div>
      <div>
        <%= label_tag :password_confirmation, t("registration.password_confirmation"), class: "fx-label" %>
        <%= password_field_tag :password_confirmation, nil, required: true, autocomplete: "new-password", minlength: 12, maxlength: 72,
              "aria-invalid": (@user.errors.include?(:password_confirmation) ? "true" : nil), class: "fx-input" %>
      </div>
      <%= submit_tag t("password_reset.update"), class: "fx-btn" %>
    <% end %>
  <% end %>
  <p class="mt-6 text-center text-sm"><%= link_to t("password_reset.back_to_sign_in"), admin_login_path(locale: I18n.locale), class: "fx-link" %></p>
</div>
