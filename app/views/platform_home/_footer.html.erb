<footer class="platform-footer-wrap">
  <div class="platform-container platform-footer">
    <a href="#top" class="platform-brand" aria-label="seallo"><span dir="ltr">seallo</span></a>
    <p><%= t("platform_home.seallo.foot") %></p>
    <nav class="platform-footer-connect" aria-label="<%= t("seallo_connect_pages.nav.label") %>">
