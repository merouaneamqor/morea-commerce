<footer class="platform-container platform-footer">
  <a href="<%= platform_home_path(locale: I18n.locale) %>" class="platform-brand"><span class="platform-logo" aria-hidden="true"><%= Store.platform_name.first %><span>.</span></span><span><%= Store.platform_name %><span class="platform-brand-suffix"> crm</span></span></a>
  <p>© <%= Date.current.year %> <%= Store.platform_name %>. <%= t("platform_home.refresh.footer") %></p>
  <%= link_to t("platform_home.footer.admin"), admin_login_path(locale: nil), class: "platform-admin-link" %>
  <div class="platform-languages" role="group" aria-label="<%= t("platform_home.language") %>"><% Morea::Locales::AVAILABLE.each do |locale| %><%= link_to locale.to_s.upcase, platform_home_path(locale: locale), lang: locale, "aria-current": (locale.to_s == I18n.locale.to_s ? "true" : nil) %><% end %></div>
</footer>
