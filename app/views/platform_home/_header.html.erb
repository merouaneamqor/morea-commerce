<% h = ->(key) { t("platform_home.#{key}") } %>
<% sign_in_path = admin_login_path(locale: nil) %>
  <header class="sticky top-0 z-20 border-b border-[#ebebeb] bg-white/90 backdrop-blur">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
      <a href="/" class="text-base font-semibold tracking-tight text-[#0b2447]"><%= Store.platform_name %></a>
      <nav class="hidden items-center gap-6 text-sm text-[#616161] md:flex" aria-label="Primary">
        <a class="hover:text-[#005bd3]" href="<%= platform_home_path(anchor: "journey") %>"><%= h.("nav.journey") %></a>
        <a class="hover:text-[#005bd3]" href="<%= platform_home_path(anchor: "features") %>"><%= h.("nav.features") %></a>
        <a class="hover:text-[#005bd3]" href="<%= platform_home_path(anchor: "integrations") %>"><%= h.("nav.integrations") %></a>
        <a class="hover:text-[#005bd3]" href="<%= platform_home_path(anchor: "faq") %>"><%= h.("nav.faq") %></a>
      </nav>
      <div class="flex items-center gap-3 text-xs">
        <div class="flex items-center gap-2 text-[#616161]" role="group" aria-label="<%= h.("language") %>">
          <% Morea::Locales::AVAILABLE.each do |locale| %>
            <%= link_to locale.to_s.upcase, "#{request.path}?locale=#{locale}",
                  class: (locale.to_s == I18n.locale.to_s ? "font-semibold text-[#0b2447]" : "hover:text-[#005bd3]"),
                  "aria-current": (locale.to_s == I18n.locale.to_s ? "true" : nil) %>
          <% end %>
        </div>
        <%= link_to h.("nav.sign_in"), sign_in_path, class: "hidden px-2 py-2 text-sm font-medium text-[#303030] hover:text-[#005bd3] sm:inline" %>
        <%= link_to h.("nav.signup"), signup_path, class: "rounded-lg bg-[#005bd3] px-3.5 py-2 text-sm font-medium text-white hover:bg-[#004299] focus:outline-2 focus:outline-offset-2 focus:outline-[#005bd3]" %>
      </div>
    </div>
  </header>
