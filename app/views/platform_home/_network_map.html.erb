<%# World dot map with arcs from the Casablanca hub, as on the seallo landing page. %>
<%
  width = 1000.0
  height = 383
  project = ->(lat, lon) { [((lon + 180) / 360.0 * width).round(1), ((80 - lat) / 360.0 * width).round(1)] }
  hub = project.(33.6, -7.6)
  cities = [
    [48.9, 2.4], [51.5, -0.1], [40.7, -74], [45.5, -73.6], [34, -118.2], [19.4, -99.1], [-23.5, -46.6],
    [14.7, -17.4], [6.5, 3.4], [30, 31.2], [-1.3, 36.8], [-26.2, 28], [41, 29], [55.8, 37.6],
    [25.2, 55.3], [24.7, 46.7], [19.1, 72.9], [39.9, 116.4], [35.7, 139.7], [1.35, 103.8], [-6.2, 106.8], [-33.9, 151.2]
  ].map { |lat, lon| project.(lat, lon) }
%>
<div class="platform-world" style="aspect-ratio: <%= width.to_i %> / <%= height %>">
  <div class="platform-world-dots"></div>
  <svg viewBox="0 0 <%= width.to_i %> <%= height %>" focusable="false">
    <defs>
      <linearGradient id="platform-arc"><stop offset="0" stop-color="#a8432e" stop-opacity=".2"/><stop offset=".5" stop-color="#a8432e" stop-opacity=".9"/><stop offset="1" stop-color="#a8432e" stop-opacity=".2"/></linearGradient>
      <radialGradient id="platform-glow"><stop offset="0" stop-color="#a8432e" stop-opacity=".55"/><stop offset="1" stop-color="#a8432e" stop-opacity="0"/></radialGradient>
    </defs>
    <% cities.each_with_index do |(x, y), i| %>
      <% mx = ((hub[0] + x) / 2).round(1); my = ([hub[1], y].min - Math.hypot(x - hub[0], y - hub[1]) * 0.28).round(1) %>
      <% d = "M#{hub[0]} #{hub[1]} Q#{mx} #{my} #{x} #{y}" %>
      <path d="<%= d %>" fill="none" stroke="url(#platform-arc)" stroke-width="1.3"/>
      <path d="<%= d %>" fill="none" stroke="#a8432e" stroke-width="2" stroke-linecap="round" stroke-dasharray="6 900" class="platform-flow" style="animation-delay: <%= ((i % 8) * 0.45).round(2) %>s"/>
      <circle cx="<%= x %>" cy="<%= y %>" r="8" fill="url(#platform-glow)"/>
      <circle cx="<%= x %>" cy="<%= y %>" r="2.6" fill="#a8432e"/>
    <% end %>
    <circle cx="<%= hub[0] %>" cy="<%= hub[1] %>" r="18" fill="url(#platform-glow)" class="platform-pulse"/>
    <circle cx="<%= hub[0] %>" cy="<%= hub[1] %>" r="5" fill="#a8432e" stroke="#fff" stroke-width="2"/>
  </svg>
</div>
