<%# Live-view style globe (public/globe.js): parcels moving between the cities of Morocco. Drag or touch to move it. %>
<% s = ->(key) { t("platform_home.seallo.#{key}") } %>
<div class="platform-globe" data-globe data-earth="/images/earth.jpg" data-event="<%= s.("live_event") %>">
  <p class="platform-live"><span><%= s.("live_title") %></span> <b data-live-count>0</b><i aria-hidden="true"></i></p>
  <canvas role="img" aria-label="<%= s.("live_title") %>"></canvas>
  <button type="button" class="platform-live-pause" data-live-pause aria-label="<%= s.("live_pause") %>" aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true"><path class="p-pause" d="M9 6v12M15 6v12"/><path class="p-play" d="m8 5 11 7-11 7z"/></svg></button>
</div>
