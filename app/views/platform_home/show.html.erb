<% content_for :title, t("platform_home.title") %>
<% content_for :head do %>
  <meta name="color-scheme" content="dark">
  <%= stylesheet_link_tag "platform_home", "data-turbo-track": "reload" %>
<% end %>
<% h = ->(key) { t("platform_home.refresh.#{key}") } %>
<div class="platform-landing" dir="<%= rtl? ? "rtl" : "ltr" %>">
  <%= render "platform_home/header" %>
  <main>
    <section class="platform-hero" aria-labelledby="platform-title">
      <div class="platform-container platform-hero-copy">
        <p class="platform-eyebrow"><span aria-hidden="true"></span><%= h.("eyebrow") %></p>
        <h1 id="platform-title"><%= h.("headline") %><br><span><%= h.("headline_accent") %></span></h1>
        <p class="platform-lead"><%= h.("lead") %></p>
        <div class="platform-actions">
          <%= link_to t("platform_home.hero.primary"), signup_path(locale: I18n.locale), class: "platform-button" %>
          <%= link_to signup_path(locale: I18n.locale), class: "platform-button platform-button-secondary platform-agent-button" do %>
            <span><%= h.("agent_button") %></span>
            <%= render "platform_home/agent_logos" %>
          <% end %>
        </div>
        <a href="#journey" class="platform-journey-link"><%= t("platform_home.hero.secondary") %><span aria-hidden="true"> ↓</span></a>
        <ul class="platform-badges"><% h.("badges").each do |badge| %><li><%= badge %></li><% end %></ul>
      </div>
      <div class="platform-map" aria-hidden="true"><%= render "platform_home/network_map" %></div>
    </section>
    <section id="features" class="platform-container platform-features" aria-labelledby="features-title">
      <h2 id="features-title"><%= h.("features_title") %></h2>
      <p class="platform-section-lead"><%= h.("features_lead") %></p>
      <ul class="platform-cards">
        <% h.("features").each_with_index do |item, index| %>
          <li class="platform-card">
            <span class="platform-icon" aria-hidden="true">
              <% if index == 0 %><svg viewBox="0 0 24 24"><path d="m5 12 4 4L19 6"/></svg>
              <% elsif index == 1 %><svg viewBox="0 0 24 24"><path d="M3 6h11v11H3zM14 10h4l3 4v3h-7"/><circle cx="7" cy="18" r="2"/><circle cx="18" cy="18" r="2"/></svg>
              <% else %><svg viewBox="0 0 24 24"><path d="M5 19V12M12 19V5M19 19V9"/></svg><% end %>
            </span>
            <h3><%= item[:title] %></h3><p><%= item[:body] %></p>
          </li>
        <% end %>
      </ul>
    </section>
    <section id="journey" class="platform-container platform-journey" aria-labelledby="journey-title">
      <h2 id="journey-title"><%= h.("journey_title") %></h2>
      <ol class="platform-timeline">
        <% h.("steps").each_with_index do |step, index| %>
          <li><span class="platform-step"><%= index + 1 %></span><h3><%= step[:title] %></h3><p><%= step[:body] %></p></li>
        <% end %>
      </ol>
    </section>
    <section id="contact" class="platform-container platform-contact" aria-labelledby="contact-title">
      <div class="platform-cta"><h2 id="contact-title"><%= h.("cta_title") %></h2><p><%= h.("cta_body") %></p><%= link_to t("platform_home.hero.primary"), signup_path(locale: I18n.locale), class: "platform-button platform-button-white" %></div>
    </section>
  </main>
  <%= render "platform_home/footer" %>
</div>
