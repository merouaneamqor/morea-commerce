<% content_for :title, "#{t("privacy_rights.title")} — #{current_store.name}" %>

<section class="mx-auto max-w-xl px-4 py-12 sm:py-16">
  <p class="text-[10px] uppercase tracking-[0.28em] text-ink-faint"><%= t("privacy_rights.eyebrow") %></p>
  <h1 class="mt-3 font-display text-3xl text-ink sm:text-4xl"><%= t("privacy_rights.title") %></h1>
  <p class="mt-4 text-sm leading-relaxed text-ink-soft"><%= t("privacy_rights.lead") %></p>
  <p class="mt-2 text-xs leading-relaxed text-ink-faint"><%= t("privacy_rights.unsubscribe_note") %></p>

  <% if notice.present? %>
    <p class="mt-6 text-sm text-ink" role="status"><%= notice %></p>
  <% end %>

  <%= form_with model: @request, url: privacy_rights_path, class: "mt-8 space-y-5" do |f| %>
    <% if @request.errors.any? %>
      <div role="alert" class="text-sm text-red-800"><%= @request.errors.full_messages.to_sentence %></div>
    <% end %>

    <div>
      <%= f.label :request_type, t("privacy_rights.fields.type"), class: "checkout-label" %>
      <%= f.select :request_type,
            PrivacyRightsRequest::TYPES.map { |type| [ t("privacy_rights.types.#{type}"), type ] },
            {},
            class: "checkout-input mt-2" %>
    </div>
    <div>
      <%= f.label :requester_name, t("privacy_rights.fields.name"), class: "checkout-label" %>
      <%= f.text_field :requester_name, class: "checkout-input mt-2", autocomplete: "name", required: true %>
    </div>
    <div>
      <%= f.label :requester_contact, t("privacy_rights.fields.contact"), class: "checkout-label" %>
      <%= f.text_field :requester_contact, class: "checkout-input mt-2", autocomplete: "email", required: true %>
      <p class="mt-1 text-xs text-ink-faint"><%= t("privacy_rights.fields.contact_help") %></p>
    </div>
    <div>
      <%= f.label :order_number, t("privacy_rights.fields.order_number"), class: "checkout-label" %>
      <%= f.text_field :order_number, class: "checkout-input mt-2", autocomplete: "off" %>
    </div>
    <div>
      <%= f.label :details, t("privacy_rights.fields.details"), class: "checkout-label" %>
      <%= f.text_area :details, rows: 4, class: "checkout-input checkout-input--area mt-2" %>
    </div>

    <p class="text-xs leading-relaxed text-ink-faint"><%= t("privacy_rights.minimization") %></p>

    <%= f.button t("privacy_rights.submit"), type: "submit", class: "maison-button w-full cursor-pointer text-center" %>
  <% end %>
</section>
