<%# Quantity, COD "order now" (straight to checkout), add to bag.
    buttons_class hides the buttons where a sticky mobile bar takes over. %>
<% buttons_class = local_assigns.fetch(:buttons_class, "") %>

<div class="pdp__qty hidden md:block">
  <p class="pdp__option-label"><%= t("product.quantity") %></p>
  <div class="qty-stepper mt-3" data-controller="quantity">
    <button type="button" class="qty-stepper__btn" data-action="quantity#decrement" aria-label="<%= t("product.decrease") %>">−</button>
    <%= number_field_tag :quantity, 1, min: 1, max: 10, inputmode: "numeric", class: "qty-stepper__input",
          aria: { label: t("product.quantity") }, data: { quantity_target: "input" } %>
    <button type="button" class="qty-stepper__btn" data-action="quantity#increment" aria-label="<%= t("product.increase") %>">+</button>
  </div>
</div>

<div class="pdp__desktop-cta space-y-3 <%= buttons_class %>">
  <%= button_tag type: "submit", name: "checkout", value: "1", class: "maison-button pdp-order-btn pdp-order-btn--desktop w-full cursor-pointer text-start", disabled: !product.available?, data: { action: "click->variant-picker#ensureSize", variant_picker_target: "purchaseButton" } do %>
    <span class="pdp-order-btn__row">
      <svg class="pdp-order-btn__bag" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <path d="M6 8h12l-1 13H7L6 8z"/>
        <path d="M9 8a3 3 0 0 1 6 0"/>
      </svg>
      <span><%= product.available? ? t("product.buy_now") : t("product.sold_out") %></span>
    </span>
    <span class="pdp-order-btn__sub"><%= t("product.pay_on_delivery_detail") %></span>
  <% end %>
  <%= button_tag type: "submit", class: "pdp-add-link w-full cursor-pointer", disabled: !product.available?, data: { action: "click->variant-picker#ensureSize", variant_picker_target: "purchaseButton" } do %>
    <%= t("product.add_to_bag") %>
  <% end %>
</div>
