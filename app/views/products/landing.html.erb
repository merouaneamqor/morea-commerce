<% content_for :title, "#{@product.name} — #{current_store.name}" %>
<% content_for :meta_description, @product.short_description.presence || t("landing.hero_tagline") %>
<% content_for :split_hero_nav, "1" %>
<% if @hero_image.present? %>
  <% content_for :head do %>
    <%= preload_hero_image(@hero_image) %>
  <% end %>
<% end %>

<%# ——— Hero ——— %>
<section class="landing-hero">
  <div class="landing-hero__copy" data-controller="reveal">
    <p class="landing-eyebrow"><%= t("landing.eyebrow") %></p>
    <h1 class="landing-hero__title"><%= @product.name %></h1>
    <p class="landing-hero__tagline"><%= t("landing.hero_tagline") %></p>

    <a href="#essentiel"
       class="landing-ghost-btn"
       data-controller="scroll-to"
       data-action="scroll-to#scroll">
      <span><%= t("landing.discover") %></span>
    </a>

    <span class="landing-hero__scroll" aria-hidden="true"></span>
  </div>

  <div class="landing-hero__visual">
    <div class="landing-hero__media">
      <% if @hero_image.present? %>
        <%= object_image_tag @hero_image,
              alt: @product.name,
              sizes: "(max-width: 768px) 100vw, 58vw",
              widths: [640, 960, 1280, 1600],
              loading: "eager",
              fetchpriority: "high" %>
      <% else %>
        <div class="h-full w-full bg-stone-deep"></div>
      <% end %>
    </div>

    <div class="landing-hero__caption" data-controller="reveal" data-reveal-delay-value="180">
      <p class="landing-hero__movement"><%= t("landing.for_movement") %></p>
    </div>
  </div>
</section>

<%# ——— Product ——— %>
<section id="essentiel" class="landing-product">
  <div class="landing-gallery" data-controller="reveal">
    <% @gallery.each_with_index do |shot, i| %>
      <figure class="landing-gallery__shot">
        <div class="object-frame aspect-[3/4]">
          <%= object_image_tag shot[:url],
                alt: "#{@product.name} — #{shot[:label]}",
                sizes: "(max-width: 768px) 78vw, 30vw",
                widths: [400, 640, 960, 1280],
                loading: i < 2 ? "eager" : "lazy" %>
        </div>
        <figcaption class="landing-gallery__caption">
          <span class="landing-gallery__index"><%= format("%02d", i + 1) %></span>
          <span><%= shot[:label] %></span>
        </figcaption>
      </figure>
    <% end %>
  </div>

  <div class="landing-buy" data-controller="reveal" data-reveal-delay-value="120">
    <%= form_with url: add_item_cart_path, method: :post, class: "landing-buy__form",
          data: (@variants.any? ? {
            controller: "variant-picker",
            variant_picker_variants_value: @variant_payload
          } : {}) do %>
      <%= hidden_field_tag :product_id, @product.id %>

      <header class="landing-buy__head">
        <p class="landing-eyebrow"><%= t("landing.eyebrow") %></p>
        <h2 class="landing-buy__title"><%= @product.name %></h2>
        <p class="landing-buy__price"><%= @product.price_display %></p>
        <% if @product.short_description.present? %>
          <p class="landing-buy__desc"><%= @product.short_description %></p>
        <% end %>
      </header>

      <% if @variants.any? %>
        <%= hidden_field_tag :product_variant_id, @variants.first.id, data: { variant_picker_target: "variantId" } %>

        <% if @colors.any? %>
          <div class="landing-buy__group">
            <p class="landing-buy__label">
              <%= t("product.color") %>
              <span class="landing-buy__value" data-variant-picker-target="colorLabel"><%= @colors.first %></span>
            </p>
            <div class="mt-4 flex flex-wrap gap-4">
              <% @colors.each do |color| %>
                <button type="button"
                        class="landing-swatch <%= "is-active" if color == @colors.first %>"
                        data-variant-picker-target="colorButton"
                        data-color="<%= color %>"
                        data-action="variant-picker#selectColor"
                        aria-label="<%= color %>"
                        title="<%= color %>">
                  <span class="landing-swatch__dot" style="background: <%= color_hex(color) %>"></span>
                </button>
              <% end %>
            </div>
          </div>
        <% end %>

        <% if @sizes.any? %>
          <div class="landing-buy__group">
            <p class="landing-buy__label"><%= t("product.size") %></p>
            <div class="mt-4 flex gap-2">
              <% @sizes.each do |size| %>
                <button type="button"
                        class="size-pill <%= "is-active" if size == @sizes.first %>"
                        data-variant-picker-target="sizeButton"
                        data-size="<%= size %>"
                        data-action="variant-picker#selectSize"><%= size %></button>
              <% end %>
            </div>
          </div>
        <% end %>
      <% end %>

      <div class="space-y-6">
        <%= render "products/buy_actions", product: @product %>
      </div>

      <ul class="landing-trust" role="list">
        <li class="landing-trust__item">
          <span class="landing-trust__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M3 7h11v10H3z"/><path d="M14 10h4l3 3v4h-7"/><circle cx="7" cy="18.5" r="1.5"/><circle cx="17" cy="18.5" r="1.5"/></svg>
          </span>
          <span><%= t("landing.trust.delivery") %></span>
        </li>
        <li class="landing-trust__item">
          <span class="landing-trust__icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M4 12a8 8 0 0 1 13.5-5.8L20 8"/><path d="M20 4v4h-4"/><path d="M20 12a8 8 0 0 1-13.5 5.8L4 16"/><path d="M4 20v-4h4"/></svg>
          </span>
          <span><%= t("landing.trust.returns") %></span>
        </li>
      </ul>
    <% end %>
  </div>
</section>

<%# ——— Savoir-faire ——— %>
<section class="landing-craft" data-controller="reveal">
  <p class="landing-eyebrow landing-eyebrow--light justify-center"><%= t("landing.for_movement") %></p>
  <ul class="landing-craft__list" role="list">
    <% %w[breathable quickdry fit modest].each_with_index do |key, i| %>
      <li class="landing-craft__item">
        <span class="landing-craft__index"><%= format("%02d", i + 1) %></span>
        <span class="landing-craft__icon" aria-hidden="true">
          <%= render "shared/feature_icon", name: key %>
        </span>
        <span class="landing-craft__label"><%= t("landing.features.#{key}") %></span>
      </li>
    <% end %>
  </ul>
</section>

<%# ——— Story ——— %>
<section class="landing-story" data-controller="reveal">
  <div class="landing-story__media object-frame">
    <% if @story_image.present? %>
      <%= object_image_tag @story_image,
            alt: t("landing.story_title"),
            sizes: "(max-width: 768px) 100vw, 50vw",
            widths: [640, 960, 1280] %>
    <% else %>
      <div class="h-full w-full bg-stone-deep"></div>
    <% end %>
  </div>

  <div class="landing-story__copy">
    <p class="landing-eyebrow"><%= t("landing.story_eyebrow") %></p>
    <h2 class="landing-story__title"><%= t("landing.story_title") %></h2>
    <p class="landing-story__body">
      <%= t("landing.story_body") %>
    </p>
    <%= link_to t("landing.our_story"), collections_path, class: "maison-cta mt-10 md:mt-12" %>
  </div>
</section>
