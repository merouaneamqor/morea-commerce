<% content_for :title, "#{@product.seo_title.presence || @product.name} — #{current_store.name}" %>
<% content_for :meta_description, @product.seo_description.presence || @product.short_description %>
<% content_for :mobile_buy, "1" %>
<%= pixel_event_tag "ViewContent", product_pixel_payload(@product) %>

<div data-controller="variant-gallery variant-picker"
     data-action="variant-picker:change->variant-gallery#show turbo:before-cache@document->variant-gallery#restoreProductGallery"
     data-variant-picker-variants-value="<%= @variant_payload.to_json %>"
     data-variant-picker-track-inventory-value="<%= @product.track_inventory %>"
     data-variant-picker-available-label-value="<%= t("merchandising.available") %>"
     data-variant-picker-unavailable-label-value="<%= t("product.sold_out") %>"
     data-variant-picker-order-label-value="<%= t("product.order_now") %>"
     data-variant-picker-compare-at-value="<%= @product.compare_at_cents.to_i %>">
<article class="pdp pdp-mobile-pad">
  <nav class="pdp__crumbs" aria-label="<%= t("merchandising.breadcrumb") %>">
    <%= link_to t("nav.home"), localized_root_path %>
    <span aria-hidden="true">/</span>
    <% if @collection %>
      <%= link_to @collection.name, collection_path(@collection) %>
      <span aria-hidden="true">/</span>
    <% end %>
    <span class="text-ink"><%= @product.name %></span>
  </nav>

  <div class="pdp__grid">
    <div class="pdp__gallery" data-controller="reveal" data-variant-gallery-target="gallery">
      <% @gallery.each_with_index do |url, i| %>
        <div class="pdp__shot object-frame <%= "pdp__shot--lead" if i.zero? %>">
          <%= object_image_tag url,
                alt: (i.zero? ? @product.name : "#{@product.name} — #{i + 1}"),
                sizes: (i.zero? ? "(max-width: 768px) 90vw, 58vw" : "(max-width: 768px) 90vw, 29vw"),
                widths: [640, 960, 1280],
                loading: (i.zero? ? "eager" : "lazy"),
                fetchpriority: (i.zero? ? "high" : nil) %>
        </div>
      <% end %>
    </div>

    <template data-variant-gallery-target="shotTemplate">
      <div class="pdp__shot object-frame">
        <img alt="<%= @product.name %>" class="h-full w-full object-cover" decoding="async">
      </div>
    </template>

    <div class="pdp__info" data-controller="reveal" data-reveal-delay-value="140">
      <div class="pdp__sticky">
        <p class="landing-eyebrow"><%= @collection&.name || @eyebrow %></p>
        <h1 class="pdp__title"><%= @product.name %></h1>
        <div class="mt-5 flex flex-wrap items-baseline gap-3">
          <p class="pdp__price" data-variant-picker-target="price"><%= @initial_variant&.fetch(:price) || @product.price_display %></p>
          <% if @product.compare_at_cents.to_i > @product.price_cents %>
            <s class="pdp__price-compare" data-variant-picker-target="comparePrice" <%= "hidden" if @product.compare_at_cents.to_i <= (@initial_variant&.fetch(:price_cents) || @product.price_cents) %>><%= @product.compare_at_display %></s>
          <% end %>
        </div>
        <p class="pdp__availability" role="status" data-variant-picker-target="availability"><%= @product.available? ? t("merchandising.available") : t("product.sold_out") %></p>

        <% if @product.short_description.present? %>
          <p class="mt-6 max-w-md text-sm leading-7 text-ink-soft"><%= @product.short_description %></p>
        <% end %>

        <% if @product.material.present? || @product.fit.present? || @product.dimensions.present? %>
          <a href="#product-details" class="pdp__details-link"><%= t("merchandising.explore_details") %></a>
        <% end %>

        <%= form_with url: add_item_cart_path, method: :post, class: "mt-8 space-y-8 border-t border-line pt-8", id: "pdp-add-form",
              data: { action: "submit->variant-picker#validate" } do %>
          <%= hidden_field_tag :product_id, @product.id %>

          <% if @variants.any? %>
            <%= hidden_field_tag :product_variant_id, @initial_variant[:id], data: { variant_picker_target: "variantId" } %>

            <% if @colors.any? %>
              <div>
                <p class="landing-buy__label">
                  <%= t("product.color") %>
                  <span class="landing-buy__value" data-variant-picker-target="colorLabel"><%= @initial_variant[:color] %></span>
                </p>
                <div class="mt-4 flex flex-wrap gap-4">
                  <% @colors.each do |color| %>
                    <button type="button"
                            class="landing-swatch <%= "is-active" if color == @initial_variant[:color] %>"
                            title="<%= color %>"
                            data-variant-picker-target="colorButton"
                            data-color="<%= color %>"
                            data-action="variant-picker#selectColor"
                            aria-label="<%= color %>" aria-pressed="<%= color == @initial_variant[:color] %>">
                      <span class="landing-swatch__dot" style="background: <%= color_hex(color, stored: @color_hexes[color]) %>"></span>
                    </button>
                  <% end %>
                </div>
              </div>
            <% end %>

            <% if @sizes.any? %>
              <div>
                <p class="landing-buy__label"><%= t("product.size") %></p>
                <div class="mt-4 flex flex-wrap gap-2">
                  <% @sizes.each do |size| %>
                    <button type="button"
                            class="size-pill <%= "is-active" if size == @initial_variant[:size] %>"
                            data-variant-picker-target="sizeButton"
                            data-size="<%= size %>"
                            data-action="variant-picker#selectSize" aria-pressed="<%= size == @initial_variant[:size] %>"><%= size %></button>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>

          <%= render "products/buy_actions", product: @product, buttons_class: "hidden md:block" %>
        <% end %>

        <% if (wa = current_store.whatsapp_url(t("product.whatsapp_message", product: @product.name, url: product_url(@product)))) %>
          <aside class="pdp-advice">
            <p class="pdp-advice__title"><%= t("merchandising.services.advice") %></p>
            <p class="pdp-advice__body"><%= t("merchandising.services.advice_body") %></p>
            <%= link_to wa, class: "whatsapp-link", target: "_blank", rel: "noopener" do %>
              <%= render "shared/whatsapp_icon" %>
              <span><%= t("merchandising.services.contact") %></span>
            <% end %>
          </aside>
        <% end %>

        <div class="pdp__accordions" id="product-details">
          <% [
            [t("product.the_story"), @product.story],
            [t("product.the_fabric"), @product.material],
            [t("merchandising.origin"), @product.origin],
            [t("product.the_fit"), [@product.fit, @product.dimensions].compact_blank.join("\n\n")],
            [t("product.the_movement"), @product.movement],
            [t("product.care"), @product.care]
          ].each do |title, text| %>
            <% next if text.blank? %>
            <details class="pdp-accordion" <%= "open" if title == t("product.the_story") %>>
              <summary class="pdp-accordion__summary"><%= title %></summary>
              <div class="pdp-accordion__body"><%= simple_format text %></div>
            </details>
          <% end %>
          <details class="pdp-accordion">
            <summary class="pdp-accordion__summary"><%= t("product.shipping_returns") %></summary>
            <div class="pdp-accordion__body">
              <p><%= current_store.cod_label.presence || t("landing.trust.cod") %></p>
              <% if current_store.cod_note.present? %><p><%= current_store.cod_note %></p><% end %>
              <% %w[shipping returns].each do |slug| %>
                <% if (policy = storefront_policy(slug)) %>
                  <p><%= link_to policy.title, page_path(policy), class: "underline underline-offset-4" %></p>
                <% end %>
              <% end %>
              <% if (wa = current_store.whatsapp_url(t("product.whatsapp_message", product: @product.name, url: product_url(@product)))) %>
                <p class="mt-3">
                  <%= link_to wa, class: "whatsapp-link", target: "_blank", rel: "noopener" do %>
                    <%= render "shared/whatsapp_icon" %>
                    <span><%= t("product.whatsapp_question") %></span>
                  <% end %>
                </p>
              <% end %>
            </div>
          </details>
        </div>
      </div>
    </div>
  </div>
</article>

<% if @related.any? %>
  <section class="home-section border-t border-line">
    <header class="home-section__head" data-controller="reveal">
      <div>
        <p class="landing-eyebrow"><%= @collection&.name || t("shop.selected") %></p>
        <h2 class="home-section__title"><%= t("product.related") %></h2>
      </div>
      <%= link_to t("home.view_all"), (@collection ? collection_path(@collection) : collections_path), class: "maison-cta" %>
    </header>
    <div class="home-products" data-controller="reveal" data-reveal-delay-value="120">
      <% @related.each do |product| %>
        <%= render "products/card", product: product %>
      <% end %>
    </div>
  </section>
<% end %>

<div class="mobile-buy-bar">
  <div class="mobile-buy-bar__stack">
    <div class="flex min-w-0 items-baseline justify-between gap-3">
      <p class="truncate font-display text-lg text-ink"><%= @product.name %></p>
      <p class="shrink-0 font-display text-base text-ink" data-variant-picker-target="price"><%= @initial_variant&.fetch(:price) || @product.price_display %></p>
    </div>
    <button type="submit" form="pdp-add-form" name="checkout" value="1" class="maison-button w-full cursor-pointer py-3" data-variant-picker-target="purchaseButton" <%= "disabled" unless @product.available? %>>
      <span data-variant-picker-target="orderLabel">
        <%= @product.available? ? t("product.order_now") : t("product.sold_out") %>
      </span>
    </button>
    <button type="submit" form="pdp-add-form" class="pdp-add-link w-full cursor-pointer py-1" data-variant-picker-target="purchaseButton" <%= "disabled" unless @product.available? %>>
      <%= t("product.add_to_bag") %>
    </button>
  </div>
</div>
</div>
