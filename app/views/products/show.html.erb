<% content_for :title, "#{@product.seo_title.presence || @product.name} — #{current_store.name}" %>
<% content_for :meta_description, @product.seo_description.presence || @product.short_description %>
<% content_for :mobile_buy, "1" %>
<% if @gallery.first.present? %>
  <% content_for :lcp do %>
    <%= preload_hero_image(@gallery.first, widths: [640, 960, 1280], sizes: "(max-width: 768px) 100vw, 58vw") %>
  <% end %>
<% end %>
<%= pixel_event_tag "ViewContent", product_pixel_payload(@product) %>

<% size_advisor_labels = @size_chart.present? ? {
  "step_of" => t("size_advisor.step_of"),
  "height_invalid" => t("size_advisor.height_invalid"),
  "weight_invalid" => t("size_advisor.weight_invalid"),
  "best_title" => t("size_advisor.best_title"),
  "between_title" => t("size_advisor.between_title"),
  "none_title" => t("size_advisor.none_title"),
  "none_body" => t("size_advisor.none_body"),
  "result_body" => t("size_advisor.result_body"),
  "size" => t("product.size"),
  "measure_chest" => t("size_advisor.measure.chest"),
  "measure_waist" => t("size_advisor.measure.waist"),
  "measure_hips" => t("size_advisor.measure.hips"),
  "measure_length" => t("size_advisor.measure.length"),
  "note_match" => t("size_advisor.note.match"),
  "note_snug" => t("size_advisor.note.snug"),
  "note_easy" => t("size_advisor.note.easy"),
  "note_roomy" => t("size_advisor.note.roomy"),
  "guide_title" => t("size_advisor.guide_title"),
  "guide_body" => t("size_advisor.guide_body")
} : nil %>
<% require_size = @sizes.any? %>
<% initial_price = @initial_variant&.fetch(:price) || @product.price_display %>
<% sale_until_copy = product_sale_until_copy(@product) %>
<% returns_page = storefront_policy("returns") %>
<% flat_shipping = product_flat_shipping_label(@product) %>
<div data-controller="variant-gallery variant-picker<%= " size-advisor" if @size_chart.present? %>"
     data-action="variant-picker:change->variant-gallery#show turbo:before-cache@document->variant-gallery#restoreProductGallery"
     data-variant-gallery-product-images-value="<%= @product_image_urls.to_json %>"
     data-variant-picker-variants-value="<%= @variant_payload.to_json %>"
     data-variant-picker-track-inventory-value="<%= @product.track_inventory %>"
     data-variant-picker-require-size-value="<%= require_size %>"
     data-variant-picker-available-label-value="<%= t("merchandising.available") %>"
     data-variant-picker-unavailable-label-value="<%= t("product.sold_out") %>"
     data-variant-picker-order-label-value="<%= t("product.order_now") %>"
     data-variant-picker-order-with-price-label-value="<%= t("product.order_with_price", price: "%{price}") %>"
     data-variant-picker-choose-size-label-value="<%= t("product.choose_size") %>"
     data-variant-picker-selection-summary-label-value="<%= t("product.selection_summary", color: "%{color}", size: "%{size}") %>"
     data-variant-picker-selection-summary-size-label-value="<%= t("product.selection_summary_size", size: "%{size}") %>"
     data-variant-picker-compare-at-value="<%= @product.on_sale? ? @product.compare_at_cents.to_i : 0 %>"
     data-variant-picker-compare-at-display-value="<%= @product.compare_at_display.to_s %>"
     data-variant-picker-save-amount-label-value="<%= t("product.save_amount", amount: "%{amount}") %>"
     data-variant-picker-price-reverts-label-value="<%= t("product.price_reverts_after", when: "%{when}", compare: "%{compare}") %>"
     data-variant-picker-sale-until-when-value="<%= sale_until_copy ? sale_until_when(@product.sale_ends_at_active) : "" %>"
     data-variant-picker-savings-display-value="<%= @product.savings_display.to_s %>"
     <% if @size_chart.present? %>
       data-size-advisor-chart-value="<%= @size_chart.to_json %>"
       data-size-advisor-labels-value="<%= size_advisor_labels.to_json %>"
     <% end %>>
<article class="pdp pdp-mobile-pad">
  <nav class="pdp__crumbs" aria-label="<%= t("merchandising.breadcrumb") %>">
    <%= link_to t("nav.home"), localized_root_path %>
    <span aria-hidden="true">/</span>
    <% if @collection %>
      <%= link_to @collection.name, collection_path(@collection) %>
      <span aria-hidden="true">/</span>
    <% end %>
    <span class="text-ink"><%= @product.name %></span>
  </nav>

  <div class="pdp__grid">
    <div class="pdp__gallery" data-variant-gallery-target="gallery">
      <% @gallery.each_with_index do |url, i| %>
        <div class="pdp__shot object-frame <%= "pdp__shot--lead" if i.zero? %>">
          <%= object_image_tag url,
                alt: (i.zero? ? @product.name : "#{@product.name} — #{i + 1}"),
                sizes: (i.zero? ? "(max-width: 768px) 100vw, 58vw" : "(max-width: 768px) 78vw, 29vw"),
                widths: [640, 960, 1280],
                loading: (i.zero? ? "eager" : "lazy"),
                fetchpriority: (i.zero? ? "high" : nil) %>
        </div>
      <% end %>
    </div>

    <template data-variant-gallery-target="shotTemplate">
      <div class="pdp__shot object-frame">
        <img alt="<%= @product.name %>" class="h-full w-full object-cover" decoding="async">
      </div>
    </template>

    <div class="pdp__info" data-controller="reveal" data-reveal-delay-value="140">
      <div class="pdp__sticky">
        <p class="landing-eyebrow pdp__eyebrow"><%= @collection&.name || @eyebrow %></p>
        <h1 class="pdp__title"><%= @product.name %></h1>

        <div class="pdp__offer" data-variant-picker-target="offer">
          <div class="pdp__offer-prices">
            <% if @product.on_sale? %>
              <s class="pdp__price-compare" data-variant-picker-target="comparePrice" <%= "hidden" if @product.compare_at_cents.to_i <= (@initial_variant&.fetch(:price_cents) || @product.price_cents) %>><%= @product.compare_at_display %></s>
            <% end %>
            <p class="pdp__price" data-variant-picker-target="price"><%= initial_price %></p>
          </div>
          <% if @product.on_sale? %>
            <span class="pdp__promo-badge"><%= t("product.promotion") %></span>
            <p class="pdp__offer-save" data-variant-picker-target="savings" <%= "hidden" if sale_until_copy.present? %>>
              <%= t("product.save_amount", amount: @product.savings_display) %>
            </p>
            <% if sale_until_copy.present? %>
              <p class="pdp__offer-until" data-variant-picker-target="saleUntil"><%= sale_until_copy %></p>
            <% end %>
          <% end %>
        </div>

        <p class="pdp__ship-note">
          <span class="pdp__ship-note-lead"><%= t("product.shipping_at_checkout_lead") %></span><%= t("product.shipping_at_checkout_rest") %>
        </p>

        <p class="pdp__availability" role="status" data-variant-picker-target="availability"><%= @product.available? ? t("merchandising.available") : t("product.sold_out") %></p>

        <% if @product.short_description.present? %>
          <p class="pdp__desc"><%= @product.short_description %></p>
        <% end %>

        <% if @product.material.present? || @product.fit.present? || @product.dimensions.present? %>
          <a href="#product-details" class="pdp__details-link"><%= t("merchandising.explore_details") %></a>
        <% end %>

        <%= form_with url: add_item_cart_path, method: :post, class: "pdp__buy-form", id: "pdp-add-form",
              data: { action: "submit->variant-picker#validate submit->cart-drawer#optimisticAdd" } do %>
          <%= hidden_field_tag :product_id, @product.id %>

          <% if @variants.any? %>
            <%= hidden_field_tag :product_variant_id, (require_size ? "" : @initial_variant[:id]), data: { variant_picker_target: "variantId" } %>

            <% if @colors.any? %>
              <div class="pdp__option">
                <p class="pdp__option-label">
                  <%= t("product.color") %>:
                  <span data-variant-picker-target="colorLabel"><%= @initial_variant[:color] %></span>
                </p>
                <div class="pdp__swatches">
                  <% @colors.each do |color| %>
                    <button type="button"
                            class="landing-swatch <%= "is-active" if color == @initial_variant[:color] %>"
                            title="<%= color %>"
                            data-variant-picker-target="colorButton"
                            data-color="<%= color %>"
                            data-action="variant-picker#selectColor"
                            aria-label="<%= color %>" aria-pressed="<%= color == @initial_variant[:color] %>">
                      <span class="landing-swatch__dot" style="background: <%= color_hex(color, stored: @color_hexes[color]) %>"></span>
                    </button>
                  <% end %>
                </div>
              </div>
            <% end %>

            <% if @sizes.any? %>
              <div id="pdp-sizes" class="pdp__option" data-variant-picker-target="sizeGroup">
                <div class="pdp__size-head">
                  <p class="landing-buy__label pdp__option-label"><%= t("product.size") %></p>
                  <% if @size_chart.present? %>
                    <button type="button" class="size-guide-trigger" data-action="size-advisor#openGuide">
                      <%= t("product.size_guide") %>
                    </button>
                  <% end %>
                </div>
                <div class="pdp__sizes">
                  <% @sizes.each do |size| %>
                    <button type="button"
                            class="size-pill"
                            data-variant-picker-target="sizeButton"
                            data-size="<%= size %>"
                            data-action="variant-picker#selectSize" aria-pressed="false"><%= size %></button>
                  <% end %>
                </div>
                <% if @size_chart.present? %>
                  <button type="button" class="size-advisor-trigger" data-action="size-advisor#open">
                    <svg class="size-advisor-trigger__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                      <path d="M3 8h18v8H3z"/>
                      <path d="M7 8v3M11 8v2M15 8v3M19 8v2"/>
                    </svg>
                    <span><%= t("size_advisor.find_my_size") %></span>
                  </button>
                <% end %>
              </div>
            <% end %>
          <% end %>

          <%= render "products/buy_actions", product: @product, buttons_class: "hidden md:block" %>

          <div class="pdp__trust md:hidden">
            <p><%= flat_shipping.presence || t("product.delivery_reassurance") %></p>
            <% if returns_page %>
              <p><%= link_to t("product.returns_policy"), page_path(returns_page), class: "pdp__trust-link" %></p>
            <% end %>
          </div>
        <% end %>

        <% if (wa = current_store.whatsapp_url(t("product.whatsapp_message", product: @product.name, url: product_url(@product)))) %>
          <aside class="pdp-advice">
            <p class="pdp-advice__title"><%= t("merchandising.services.advice") %></p>
            <p class="pdp-advice__body"><%= t("merchandising.services.advice_body") %></p>
            <%= link_to wa, class: "whatsapp-link", target: "_blank", rel: "noopener" do %>
              <%= render "shared/whatsapp_icon" %>
              <span><%= t("merchandising.services.contact") %></span>
            <% end %>
          </aside>
        <% end %>

        <div class="pdp__accordions" id="product-details">
          <% [
            [t("product.the_story"), @product.story],
            [t("product.the_fabric"), @product.material],
            [t("merchandising.origin"), @product.origin],
            [t("product.the_fit"), [@product.fit, @product.dimensions].compact_blank.join("\n\n")],
            [t("product.the_movement"), @product.movement],
            [t("product.care"), @product.care]
          ].each do |title, text| %>
            <% next if text.blank? %>
            <details class="pdp-accordion" <%= "open" if title == t("product.the_story") %>>
              <summary class="pdp-accordion__summary"><%= title %></summary>
              <div class="pdp-accordion__body"><%= simple_format text %></div>
            </details>
          <% end %>
          <details class="pdp-accordion">
            <summary class="pdp-accordion__summary"><%= t("product.shipping_returns") %></summary>
            <div class="pdp-accordion__body">
              <p><%= current_store.cod_label.presence || t("landing.trust.cod") %></p>
              <% if current_store.cod_note.present? %><p><%= current_store.cod_note %></p><% end %>
              <% %w[shipping returns].each do |slug| %>
                <% if (policy = storefront_policy(slug)) %>
                  <p><%= link_to policy.title, page_path(policy), class: "underline underline-offset-4" %></p>
                <% end %>
              <% end %>
              <% if (wa = current_store.whatsapp_url(t("product.whatsapp_message", product: @product.name, url: product_url(@product)))) %>
                <p class="mt-3">
                  <%= link_to wa, class: "whatsapp-link", target: "_blank", rel: "noopener" do %>
                    <%= render "shared/whatsapp_icon" %>
                    <span><%= t("product.whatsapp_question") %></span>
                  <% end %>
                </p>
              <% end %>
            </div>
          </details>
        </div>

        <div class="pdp__trust hidden md:block">
          <p><%= flat_shipping.presence || t("product.delivery_reassurance") %></p>
          <% if returns_page %>
            <p><%= link_to t("product.returns_policy"), page_path(returns_page), class: "pdp__trust-link" %></p>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</article>

<% if @related.any? %>
  <section class="home-section home-section--catalog border-t border-line">
    <header class="home-section__head home-section__head--catalog" data-controller="reveal">
      <div>
        <p class="catalog-eyebrow"><%= @collection&.name || t("shop.selected") %></p>
        <h2 class="home-section__title home-section__title--catalog"><%= t("product.related") %></h2>
      </div>
      <%= link_to t("home.view_all"), (@collection ? collection_path(@collection) : collections_path), class: "catalog-link" %>
    </header>
    <div class="home-products home-products--catalog" data-controller="reveal" data-reveal-delay-value="120">
      <% @related.each do |product| %>
        <%= render "products/card", product: product, sizes: "(max-width: 768px) 50vw, (max-width: 1024px) 33vw, 25vw" %>
      <% end %>
    </div>
  </section>
<% end %>

<div class="mobile-buy-bar">
  <div class="mobile-buy-bar__stack">
    <p class="mobile-buy-bar__selection" data-variant-picker-target="selectionSummary" hidden></p>
    <button type="submit" form="pdp-add-form" name="checkout" value="1"
            class="maison-button pdp-order-btn w-full cursor-pointer"
            data-action="click->variant-picker#ensureSize"
            data-variant-picker-target="purchaseButton"
            <%= "disabled" unless @product.available? %>>
      <span class="pdp-order-btn__row">
        <svg class="pdp-order-btn__bag" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M6 8h12l-1 13H7L6 8z"/>
          <path d="M9 8a3 3 0 0 1 6 0"/>
        </svg>
        <span data-variant-picker-target="orderLabel">
          <%= @product.available? ? (require_size ? t("product.choose_size") : t("product.order_with_price", price: initial_price)) : t("product.sold_out") %>
        </span>
      </span>
      <span class="pdp-order-btn__sub"><%= t("product.pay_on_delivery_detail") %></span>
    </button>
  </div>
</div>

<% if require_size %>
  <%= render "products/size_sheet", sizes: @sizes, size_chart: @size_chart %>
<% end %>

<% if @size_chart.present? %>
  <%= render "products/size_advisor", chart: @size_chart %>
<% end %>
</div>
