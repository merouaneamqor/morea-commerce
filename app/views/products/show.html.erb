<% content_for :title, "#{@product.name} — #{current_store.name}" %>
<% content_for :meta_description, @product.short_description %>
<% content_for :mobile_buy, "1" %>

<article class="pdp-mobile-pad pt-20 md:pt-28">
  <div class="grid md:grid-cols-12 md:gap-0">
    <div class="md:col-span-7" data-controller="reveal">
      <div class="object-frame aspect-[4/5] md:min-h-[85vh] md:aspect-auto">
        <%= product_image_tag @product, sizes: "(max-width: 768px) 100vw, 58vw", loading: "eager", fetchpriority: "high" %>
      </div>
      <% if @product.detail_image_url.present? %>
        <div class="object-frame hidden aspect-[4/5] md:block">
          <%= object_image_tag @product.detail_image_url, alt: "#{@product.name} detail", sizes: "(max-width: 768px) 100vw, 58vw" %>
        </div>
      <% end %>
    </div>

    <div class="flex items-start px-5 py-8 md:col-span-5 md:px-12 md:py-16 lg:px-16"
         data-controller="reveal"
         data-reveal-delay-value="140">
      <div class="w-full space-y-7 md:sticky md:top-28 md:space-y-8">
        <div>
          <p class="text-[10px] uppercase tracking-[0.32em] text-brass"><%= @eyebrow %></p>
          <h1 class="mt-3 font-display text-3xl leading-tight text-ink md:mt-4 md:text-5xl"><%= @product.name %></h1>
          <p class="mt-4 font-display text-xl text-ink md:mt-5 md:text-2xl"><%= @product.price_display %></p>
          <% if @product.scarcity_label %>
            <p class="mt-3 text-[10px] uppercase tracking-[0.2em] text-ink-faint"><%= @product.scarcity_label %></p>
          <% end %>
        </div>

        <% if @product.short_description.present? %>
          <p class="max-w-sm text-sm leading-7 text-ink-soft"><%= @product.short_description %></p>
        <% end %>

        <%= form_with url: add_item_cart_path, method: :post, class: "space-y-7 md:space-y-8", id: "pdp-add-form",
              data: (@variants.any? ? {
                controller: "variant-picker",
                variant_picker_variants_value: @variant_payload
              } : {}) do %>
          <%= hidden_field_tag :product_id, @product.id %>
          <%= hidden_field_tag :quantity, 1 %>

          <% if @variants.any? %>
            <%= hidden_field_tag :product_variant_id, @variants.first.id, data: { variant_picker_target: "variantId" } %>

            <% if @colors.any? %>
              <div>
                <p class="text-[10px] uppercase tracking-[0.24em] text-ink-faint">
                  <%= t("product.color") %> · <span data-variant-picker-target="colorLabel"><%= @colors.first %></span>
                </p>
                <div class="mt-4 flex flex-wrap gap-3">
                  <% @colors.each do |color| %>
                    <button type="button"
                            class="color-swatch <%= "is-active" if color == @colors.first %>"
                            style="background: <%= color_hex(color) %>"
                            title="<%= color %>"
                            data-variant-picker-target="colorButton"
                            data-color="<%= color %>"
                            data-action="variant-picker#selectColor"
                            aria-label="<%= color %>"></button>
                  <% end %>
                </div>
              </div>
            <% end %>

            <% if @sizes.any? %>
              <div>
                <p class="text-[10px] uppercase tracking-[0.24em] text-ink-faint"><%= t("product.size") %></p>
                <div class="mt-4 flex gap-2">
                  <% @sizes.each do |size| %>
                    <button type="button"
                            class="size-pill <%= "is-active" if size == @sizes.first %>"
                            data-variant-picker-target="sizeButton"
                            data-size="<%= size %>"
                            data-action="variant-picker#selectSize"><%= size %></button>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>

          <div class="hidden md:block">
            <%= button_tag t("product.add_to_bag"), type: "submit", class: "maison-button w-full cursor-pointer text-center" %>
            <p class="mt-4 text-[10px] uppercase tracking-[0.2em] text-ink-faint"><%= current_store.cod_label %></p>
          </div>
        <% end %>
      </div>
    </div>
  </div>

  <% if @product.detail_image_url.present? %>
    <div class="object-frame aspect-[4/5] md:hidden">
      <%= object_image_tag @product.detail_image_url, alt: "#{@product.name} detail", sizes: "100vw" %>
    </div>
  <% end %>

  <div class="mx-auto max-w-5xl px-5 md:px-10">
    <% if @product.story.present? %>
      <section class="story-section" data-controller="reveal">
        <p class="story-label"><%= t("product.the_story") %></p>
        <div class="story-body">
          <p class="max-w-xl whitespace-pre-line text-sm leading-7 text-ink-soft md:leading-8"><%= @product.story %></p>
        </div>
      </section>
    <% end %>

    <% if @product.material.present? %>
      <section class="story-section" data-controller="reveal">
        <p class="story-label"><%= t("product.the_fabric") %></p>
        <div class="story-body">
          <p class="max-w-xl text-sm leading-7 text-ink-soft md:leading-8"><%= @product.material %></p>
        </div>
      </section>
    <% end %>

    <% if @product.fit.present? %>
      <section class="story-section" data-controller="reveal">
        <p class="story-label"><%= t("product.the_fit") %></p>
        <div class="story-body">
          <p class="max-w-xl text-sm leading-7 text-ink-soft md:leading-8"><%= @product.fit %></p>
          <% if @product.dimensions.present? %>
            <p class="mt-4 text-[10px] uppercase tracking-[0.2em] text-ink-faint"><%= @product.dimensions %></p>
          <% end %>
        </div>
      </section>
    <% end %>

    <% if @product.movement.present? %>
      <section class="story-section" data-controller="reveal">
        <p class="story-label"><%= t("product.the_movement") %></p>
        <div class="story-body">
          <p class="max-w-xl text-sm leading-7 text-ink-soft md:leading-8"><%= @product.movement %></p>
        </div>
      </section>
    <% end %>

    <% if @product.care.present? %>
      <section class="story-section" data-controller="reveal">
        <p class="story-label"><%= t("product.care") %></p>
        <div class="story-body">
          <p class="max-w-xl text-sm leading-7 text-ink-soft md:leading-8"><%= @product.care %></p>
        </div>
      </section>
    <% end %>
  </div>
</article>

<div class="mobile-buy-bar">
  <div class="flex items-center gap-4">
    <div class="min-w-0 flex-1">
      <p class="truncate font-display text-lg text-ink"><%= @product.name %></p>
      <p class="text-[10px] uppercase tracking-[0.18em] text-ink-faint"><%= @product.price_display %></p>
    </div>
    <button type="submit" form="pdp-add-form" class="maison-button shrink-0 cursor-pointer px-5 py-3">
      <%= t("product.add_to_bag") %>
    </button>
  </div>
</div>
