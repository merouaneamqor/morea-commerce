<% content_for :title, "#{@product.seo_title.presence || @product.name} — #{current_store.name}" %>
<% content_for :meta_description, @product.seo_description.presence || @product.short_description %>
<% content_for :mobile_buy, "1" %>
<%= pixel_event_tag "ViewContent", product_pixel_payload(@product) %>

<article class="pdp pdp-mobile-pad">
  <nav class="pdp__crumbs" aria-label="Breadcrumb">
    <%= link_to t("nav.home"), localized_root_path %>
    <span aria-hidden="true">/</span>
    <% if @collection %>
      <%= link_to @collection.name, collection_path(@collection) %>
      <span aria-hidden="true">/</span>
    <% end %>
    <span class="text-ink"><%= @product.name %></span>
  </nav>

  <div class="pdp__grid">
    <div class="pdp__gallery" data-controller="reveal">
      <% @gallery.each_with_index do |url, i| %>
        <div class="pdp__shot object-frame <%= "pdp__shot--lead" if i.zero? %>">
          <%= object_image_tag url,
                alt: (i.zero? ? @product.name : "#{@product.name} — #{i + 1}"),
                sizes: (i.zero? ? "(max-width: 768px) 90vw, 58vw" : "(max-width: 768px) 90vw, 29vw"),
                widths: [640, 960, 1280],
                loading: (i.zero? ? "eager" : "lazy"),
                fetchpriority: (i.zero? ? "high" : nil) %>
        </div>
      <% end %>
    </div>

    <div class="pdp__info" data-controller="reveal" data-reveal-delay-value="140">
      <div class="pdp__sticky">
        <p class="landing-eyebrow"><%= @collection&.name || @eyebrow %></p>
        <h1 class="pdp__title"><%= @product.name %></h1>
        <div class="mt-5 flex flex-wrap items-baseline gap-3">
          <p class="pdp__price"><%= @product.price_display %></p>
          <% if @product.compare_at_cents.to_i > @product.price_cents %>
            <s class="pdp__price-compare"><%= @product.compare_at_display %></s>
            <span class="home-card__badge home-card__badge--sale !static"><%= t("product.sale") %></span>
          <% end %>
        </div>
        <% if @product.scarcity_label %>
          <p class="mt-3 text-[10px] uppercase tracking-[0.2em] text-brass"><%= @product.scarcity_label %></p>
        <% end %>

        <% if @product.short_description.present? %>
          <p class="mt-6 max-w-md text-sm leading-7 text-ink-soft"><%= @product.short_description %></p>
        <% end %>

        <%= form_with url: add_item_cart_path, method: :post, class: "mt-8 space-y-8 border-t border-line pt-8", id: "pdp-add-form",
              data: (@variants.any? ? {
                controller: "variant-picker",
                variant_picker_variants_value: @variant_payload
              } : {}) do %>
          <%= hidden_field_tag :product_id, @product.id %>

          <% if @variants.any? %>
            <%= hidden_field_tag :product_variant_id, @variants.first.id, data: { variant_picker_target: "variantId" } %>

            <% if @colors.any? %>
              <div>
                <p class="landing-buy__label">
                  <%= t("product.color") %>
                  <span class="landing-buy__value" data-variant-picker-target="colorLabel"><%= @colors.first %></span>
                </p>
                <div class="mt-4 flex flex-wrap gap-4">
                  <% @colors.each do |color| %>
                    <button type="button"
                            class="landing-swatch <%= "is-active" if color == @colors.first %>"
                            title="<%= color %>"
                            data-variant-picker-target="colorButton"
                            data-color="<%= color %>"
                            data-action="variant-picker#selectColor"
                            aria-label="<%= color %>">
                      <span class="landing-swatch__dot" style="background: <%= color_hex(color) %>"></span>
                    </button>
                  <% end %>
                </div>
              </div>
            <% end %>

            <% if @sizes.any? %>
              <div>
                <p class="landing-buy__label"><%= t("product.size") %></p>
                <div class="mt-4 flex gap-2">
                  <% @sizes.each do |size| %>
                    <button type="button"
                            class="size-pill <%= "is-active" if size == @sizes.first %>"
                            data-variant-picker-target="sizeButton"
                            data-size="<%= size %>"
                            data-action="variant-picker#selectSize"><%= size %></button>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>

          <%= render "products/buy_actions", product: @product, buttons_class: "hidden md:block" %>
        <% end %>

        <ul class="landing-trust mt-8">
          <li class="landing-trust__item">
            <span class="landing-trust__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M3 7h11v10H3z"/><path d="M14 10h4l3 3v4h-7"/><circle cx="7" cy="18.5" r="1.5"/><circle cx="17" cy="18.5" r="1.5"/></svg>
            </span>
            <span><%= t("landing.trust.delivery") %></span>
          </li>
          <li class="landing-trust__item">
            <span class="landing-trust__icon" aria-hidden="true">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2"><path d="M4 12a8 8 0 0 1 13.5-5.8L20 8"/><path d="M20 4v4h-4"/><path d="M20 12a8 8 0 0 1-13.5 5.8L4 16"/><path d="M4 20v-4h4"/></svg>
            </span>
            <span><%= t("landing.trust.returns") %></span>
          </li>
        </ul>

        <div class="pdp__accordions">
          <% [
            [t("product.the_story"), @product.story],
            [t("product.the_fabric"), @product.material],
            [t("product.the_fit"), [@product.fit, @product.dimensions].compact_blank.join("\n\n")],
            [t("product.the_movement"), @product.movement],
            [t("product.care"), @product.care]
          ].each do |title, text| %>
            <% next if text.blank? %>
            <details class="pdp-accordion">
              <summary class="pdp-accordion__summary"><%= title %></summary>
              <div class="pdp-accordion__body"><%= simple_format text %></div>
            </details>
          <% end %>
          <details class="pdp-accordion">
            <summary class="pdp-accordion__summary"><%= t("product.shipping_returns") %></summary>
            <div class="pdp-accordion__body">
              <p><%= current_store.cod_note.presence || t("landing.trust.delivery") %></p>
              <p><%= t("landing.trust.returns") %></p>
              <% if current_store.pages.published.exists?(slug: "shipping") %>
                <p><%= link_to t("product.shipping_details"), page_path("shipping"), class: "underline underline-offset-4" %></p>
              <% end %>
            </div>
          </details>
        </div>
      </div>
    </div>
  </div>
</article>

<% if @related.any? %>
  <section class="home-section border-t border-line">
    <header class="home-section__head" data-controller="reveal">
      <div>
        <p class="landing-eyebrow"><%= @collection&.name || t("shop.selected") %></p>
        <h2 class="home-section__title"><%= t("product.related") %></h2>
      </div>
      <%= link_to t("home.view_all"), (@collection ? collection_path(@collection) : collections_path), class: "maison-cta" %>
    </header>
    <div class="home-products" data-controller="reveal" data-reveal-delay-value="120">
      <% @related.each do |product| %>
        <%= render "products/card", product: product %>
      <% end %>
    </div>
  </section>
<% end %>

<div class="mobile-buy-bar">
  <div class="flex items-center gap-4">
    <div class="min-w-0 flex-1">
      <p class="truncate font-display text-lg text-ink"><%= @product.name %></p>
      <p class="font-display text-base text-ink"><%= @product.price_display %></p>
    </div>
    <button type="submit" form="pdp-add-form" class="mobile-buy-bar__bag" aria-label="<%= t("product.add_to_bag") %>" title="<%= t("product.add_to_bag") %>">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true"><path d="M5 8h14l-1 12H6z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
    </button>
    <button type="submit" form="pdp-add-form" name="checkout" value="1" class="maison-button shrink-0 cursor-pointer px-5 py-3">
      <%= t("product.order_now") %>
    </button>
  </div>
</div>
