// Admin stays online-only. Never cache authenticated pages, API data or writes.
self.addEventListener("install", () => self.skipWaiting())
self.addEventListener("activate", (event) => event.waitUntil(self.clients.claim()))

// Public, self-contained recovery UI, embedded so it also works without assets.
const OFFLINE_DOCUMENT = <%= render("pwa/offline", formats: [ :html ]).to_json.html_safe %>
const NAVIGATION_RETRY_DELAYS = [750, 1500]

async function fetchNavigation(request) {
  for (let attempt = 0; ; attempt += 1) {
    try {
      // Forward the original request, including its credentials and redirect mode.
      // A slow but healthy response is allowed to finish without an imposed timeout.
      return await fetch(request)
    } catch (error) {
      if (request.signal?.aborted) throw error
      if (attempt === NAVIGATION_RETRY_DELAYS.length) {
        return new Response(OFFLINE_DOCUMENT, {
          status: 503,
          headers: {
            "Content-Type": "text/html; charset=utf-8",
            "Cache-Control": "no-store",
            "Content-Security-Policy": "default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; connect-src 'self'; base-uri 'none'; form-action 'none'"
          }
        })
      }
      await new Promise((resolve) => setTimeout(resolve, NAVIGATION_RETRY_DELAYS[attempt]))
      if (request.signal?.aborted) throw error
    }
  }
}

self.addEventListener("fetch", (event) => {
  const url = new URL(event.request.url)
  const adminPath = url.pathname === "/admin" || url.pathname.startsWith("/admin/")
  // Provider authorization GETs can consume one-time codes or session state.
  const authorizationPath = /^\/admin\/(youcan|seallo|woocommerce)\/(connect|callback)(?:[/.]|$)/.test(url.pathname)
  if (event.request.method !== "GET" || event.request.mode !== "navigate" ||
      url.origin !== self.location.origin || !adminPath || authorizationPath) return

  // Only network failures retry. HTTP errors, sign-in redirects, forms, API calls
  // and storefront navigation retain their existing behavior.
  event.respondWith(fetchNavigation(event.request))
})

// Order alerts: show a system notification, and tell any open admin tab so it can play the chime.
self.addEventListener("push", (event) => {
  let data = {}
  try { data = event.data ? event.data.json() : {} } catch (_) { data = { title: "Seallo", body: event.data ? event.data.text() : "" } }
  const show = self.registration.showNotification(data.title || "Seallo", {
    body: data.body || "",
    tag: data.tag,
    renotify: Boolean(data.tag),
    icon: "/icon-128.png",
    badge: "/icon-48.png",
    requireInteraction: true,
    data: { url: data.url || "/admin/confirmations" }
  })
  const notify = self.clients.matchAll({ type: "window", includeUncontrolled: true })
    .then((clients) => clients.forEach((client) => client.postMessage({ kind: data.kind || "notification", ...data })))
  event.waitUntil(Promise.all([show, notify]))
})

self.addEventListener("notificationclick", (event) => {
  event.notification.close()
  const url = new URL(event.notification.data?.url || "/admin/confirmations", self.location.origin).href
  event.waitUntil(self.clients.matchAll({ type: "window", includeUncontrolled: true }).then((clients) => {
    const open = clients.find((client) => client.url.startsWith(`${self.location.origin}/admin`))
    if (!open) return self.clients.openWindow(url)
    return open.focus().then(() => (typeof open.navigate === "function" ? open.navigate(url) : open.postMessage({ kind: "navigate", url })))
  }))
})
