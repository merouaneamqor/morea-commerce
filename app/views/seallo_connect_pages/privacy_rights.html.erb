<% content_for :title, "#{t("seallo_connect_pages.privacy_rights.title")} · Seallo Connect" %>
<% content_for :head do %>
  <meta name="description" content="<%= t("seallo_connect_pages.privacy_rights.summary") %>">
  <%= stylesheet_link_tag "seallo_connect_pages", "data-turbo-track": "reload" %>
<% end %>
<div class="sc-doc" dir="<%= rtl? ? "rtl" : "ltr" %>">
  <%= render "seallo_connect_pages/header", page: "privacy_rights" %>

  <main id="main-content" class="sc-container sc-main" tabindex="-1">
    <h1><%= t("seallo_connect_pages.privacy_rights.title") %></h1>
    <p class="sc-lead"><%= t("seallo_connect_pages.privacy_rights.summary") %></p>
    <p><%= t("seallo_connect_pages.privacy_rights.unsubscribe_note") %></p>
    <% if notice.present? %>
      <p role="status"><%= notice %></p>
    <% end %>

    <%= form_with model: @privacy_rights_request, url: seallo_connect_privacy_rights_path, class: "sc-form" do |f| %>
      <% if @privacy_rights_request.errors.any? %>
        <div role="alert"><%= @privacy_rights_request.errors.full_messages.to_sentence %></div>
      <% end %>
      <div class="sc-field">
        <%= f.label :request_type, t("seallo_connect_pages.privacy_rights.fields.type") %>
        <%= f.select :request_type, PlatformPrivacyRightsRequest::TYPES.map { |type| [ t("seallo_connect_pages.privacy_rights.types.#{type}"), type ] } %>
      </div>
      <div class="sc-field">
        <%= f.label :requester_name, t("seallo_connect_pages.privacy_rights.fields.name") %>
        <%= f.text_field :requester_name, required: true, autocomplete: "name" %>
      </div>
      <div class="sc-field">
        <%= f.label :requester_contact, t("seallo_connect_pages.privacy_rights.fields.contact") %>
        <%= f.text_field :requester_contact, required: true, autocomplete: "email" %>
        <p class="sc-help"><%= t("seallo_connect_pages.privacy_rights.fields.contact_help") %></p>
      </div>
      <div class="sc-field">
        <%= f.label :shop_domain, t("seallo_connect_pages.privacy_rights.fields.shop_domain") %>
        <%= f.text_field :shop_domain, autocomplete: "off", placeholder: "example.myshopify.com" %>
      </div>
      <div class="sc-field">
        <%= f.label :details, t("seallo_connect_pages.privacy_rights.fields.details") %>
        <%= f.text_area :details, rows: 4 %>
      </div>
      <p class="sc-help"><%= t("seallo_connect_pages.privacy_rights.minimization") %></p>
      <%= f.button t("seallo_connect_pages.privacy_rights.submit"), type: "submit", class: "sc-submit" %>
    <% end %>
  </main>
  <%= render "seallo_connect_pages/footer" %>
</div>
