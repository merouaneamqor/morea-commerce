<div class="cookie-consent"
     role="dialog"
     aria-labelledby="cookie-consent-title"
     aria-describedby="cookie-consent-desc"
     data-controller="tracking-consent"
     data-tracking-consent-url-value="<%= tracking_consent_path %>">
  <div class="cookie-consent__panel">
    <p id="cookie-consent-title" class="cookie-consent__title"><%= t("data_protection.cookie_title") %></p>
    <p id="cookie-consent-desc" class="cookie-consent__text"><%= t("data_protection.cookie_body") %></p>
    <% if (privacy_path = privacy_page_path_for_store) %>
      <p class="cookie-consent__text">
        <%= link_to t("data_protection.cookie_policy_link"), privacy_path, class: "cookie-consent__link" %>
      </p>
    <% end %>
    <div class="cookie-consent__actions">
      <button type="button"
              class="cookie-consent__button cookie-consent__button--primary"
              data-action="tracking-consent#accept">
        <%= t("data_protection.cookie_ok") %>
      </button>
    </div>
  </div>
</div>
