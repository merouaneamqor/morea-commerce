<div class="cookie-consent"
     role="dialog"
     aria-labelledby="cookie-consent-title"
     data-controller="tracking-consent"
     data-tracking-consent-url-value="<%= tracking_consent_path %>">
  <div class="cookie-consent__inner">
    <p id="cookie-consent-title" class="cookie-consent__text">
      <%= t("data_protection.cookie_body") %>
      <% if (privacy_path = privacy_page_path_for_store) %>
        <%= link_to t("data_protection.cookie_policy_link"), privacy_path, class: "cookie-consent__link" %>
      <% end %>
    </p>
    <button type="button"
            class="cookie-consent__button"
            data-action="tracking-consent#accept">
      <%= t("data_protection.cookie_ok") %>
    </button>
  </div>
</div>
