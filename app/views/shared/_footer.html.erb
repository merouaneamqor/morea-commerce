<footer class="site-footer" style="padding-bottom: max(2.5rem, calc(env(safe-area-inset-bottom) + 1.5rem))">
  <div class="site-footer__grid">
    <div class="site-footer__brand">
      <div class="morea-packaging__mark text-ink" aria-hidden="true">
        <%= render "shared/wordmark_svg" %>
      </div>
      <p class="mt-5 text-[10px] uppercase tracking-[0.32em] text-ink-faint"><%= t("store.footer_tagline") %></p>
      <% if current_store&.tagline.present? %>
        <p class="mt-4 max-w-xs font-display text-lg leading-snug text-ink-soft"><%= current_store.tagline %></p>
      <% end %>
      <% if current_store&.business_imprint? %>
        <div class="site-footer__imprint mt-5 space-y-1 text-xs leading-6 text-ink-faint">
          <% if current_store.legal_entity_name.present? %>
            <p><%= current_store.legal_entity_name %></p>
          <% end %>
          <% if current_store.legal_registration_number.present? %>
            <p><%= t("footer.registration", number: current_store.legal_registration_number) %></p>
          <% end %>
          <% if current_store.legal_address.present? %>
            <p><%= current_store.legal_address %></p>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="site-footer__cols">
      <% if store_menu("footer").any? %>
        <details class="site-footer__accordion md:contents" open>
          <summary class="site-footer__accordion-summary md:hidden"><%= t("footer.information") %></summary>
          <nav class="site-footer__col" aria-label="<%= t("footer.information") %>">
            <p class="site-footer__heading hidden md:block"><%= t("footer.information") %></p>
            <% store_menu("footer").each do |item| %>
              <%= store_menu_link item, class: "site-footer__link" %>
            <% end %>
          </nav>
        </details>
      <% end %>

      <details class="site-footer__accordion md:contents" open>
        <summary class="site-footer__accordion-summary md:hidden"><%= t("footer.customer_care") %></summary>
        <div class="site-footer__col">
          <p class="site-footer__heading hidden md:block"><%= t("footer.customer_care") %></p>
          <% if current_store&.phone.present? %>
            <%= link_to current_store.phone, "tel:#{current_store.phone.delete(" ")}", class: "site-footer__link", dir: "ltr" %>
          <% end %>
          <% if current_store&.email.present? %>
            <%= mail_to current_store.email, current_store.email, class: "site-footer__link" %>
          <% end %>
          <% if current_store&.cod_note.present? %>
            <p class="mt-2 max-w-xs text-xs leading-6 text-ink-faint"><%= current_store.cod_note %></p>
          <% end %>
          <p class="mt-3 max-w-xs text-xs leading-6 text-ink-faint"><%= t("footer.age_note", age: current_store&.minimum_purchase_age || 16) %></p>
          <p class="mt-2 max-w-xs text-xs leading-6 text-ink-faint"><%= t("footer.pricing_note") %></p>
        </div>
      </details>
    </div>
  </div>

  <div class="site-footer__bottom">
    <p>© <%= Date.current.year %> <%= current_store&.legal_entity_name.presence || current_store&.name || "Morea" %></p>
    <p class="site-footer__pay"><%= current_store&.cod_label || t("store.default_campaign_cta") %></p>
    <%= render "shared/locale_switcher", dropup: true %>
  </div>
</footer>
