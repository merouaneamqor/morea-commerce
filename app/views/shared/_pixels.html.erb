<% end %>

<% if current_store.google_analytics_id.present? %>
  <% ga_id = current_store.google_analytics_id %>
  <script>
    (function() {
      var id = <%= raw ga_id.to_json %>;
      window._moreaGaIds = window._moreaGaIds || {};
      if (window._moreaGaIds[id]) return;
      window._moreaGaIds[id] = true;
      var src = "https://www.googletagmanager.com/gtag/js?id=<%= ga_id %>";
      if (!document.querySelector('script[src="' + src + '"]')) {
        var s = document.createElement("script");
        s.async = true;
        s.src = src;
        document.head.appendChild(s);
      }
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = window.gtag || gtag;
      gtag('js', new Date());
      gtag('config', <%= raw ga_id.to_json %>, { send_page_view: false });
    })();
  </script>
<% end %>
