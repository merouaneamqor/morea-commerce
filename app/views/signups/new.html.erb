<% content_for :title, t("registration.title", name: Store.platform_name) %>
<%= render "signups/chrome" %>
<% errors = @registration.errors.attribute_names %>

<div class="fx-glass p-7 sm:p-9">
  <h1 class="text-3xl font-bold tracking-tight text-white"><%= t("registration.heading") %></h1>
  <p class="mt-2 text-sm leading-6 text-[#b9d3ff]"><%= t("registration.lead") %></p>

  <% if alert.present? || errors.any? %>
    <div role="alert" class="fx-alert mt-6">
      <% if alert.present? %><p><%= alert %></p><% end %>
      <% if errors.any? %>
        <p><%= t("registration.fix_fields") %></p>
        <ul class="mt-2 list-inside list-disc"><% @registration.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
      <% end %>
    </div>
  <% end %>

  <%= form_with model: @registration, url: signup_path(locale: I18n.locale), method: :post, class: "mt-7 space-y-5" do |f| %>
    <div class="hidden" aria-hidden="true">
      <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off"></label>
    </div>
    <div>
      <%= f.label :business_name, t("registration.business_name"), class: "fx-label" %>
      <%= f.text_field :business_name, required: true, autocomplete: "organization", autofocus: true, maxlength: 80,
            "aria-invalid": (errors.include?(:business_name) ? "true" : nil), class: "fx-input" %>
    </div>
    <div>
      <%= f.label :email, t("registration.email"), class: "fx-label" %>
      <%= f.email_field :email, required: true, autocomplete: "email", maxlength: 160, autocapitalize: "none", spellcheck: false,
            "aria-invalid": (errors.include?(:email) ? "true" : nil), class: "fx-input" %>
    </div>
    <%= render "shared/theme_picker", form: f %>
    <p class="text-sm leading-6 text-[#b9d3ff]"><%= t("registration.subscription_note") %></p>
    <%= f.submit t("registration.submit"), class: "fx-btn" %>
  <% end %>
  <p class="mt-6 border-t border-white/15 pt-6 text-center text-sm text-[#b9d3ff]">
    <%= t("registration.have_account") %>
    <%= link_to t("registration.sign_in"), admin_login_path(locale: I18n.locale), class: "fx-link font-semibold underline underline-offset-4" %>
  </p>
</div>
