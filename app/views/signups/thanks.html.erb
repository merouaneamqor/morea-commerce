<% content_for :title, t("registration.check_email_title") %>
<%= render "signups/chrome" %>
<div class="auth-card fx-glass">
  <h1 class="auth-title"><%= t("registration.check_email_title") %></h1>
  <p class="mt-3 text-sm leading-6 text-[#b9d3ff]"><%= t("registration.check_email_body") %></p>
  <% if notice.present? %><p class="mt-4 text-sm text-[#b9d3ff]" role="status"><%= notice %></p><% end %>
  <% if alert.present? %><p class="fx-alert mt-4" role="alert"><%= alert %></p><% end %>
  <h2 class="mt-7 text-lg font-semibold text-white"><%= t("registration.resend_title") %></h2>
  <p class="mt-2 text-sm leading-6 text-[#b9d3ff]"><%= t("registration.resend_help") %></p>
  <%= form_with url: signup_resend_path(locale: I18n.locale), method: :post, class: "mt-5 space-y-4" do %>
    <div>
      <%= label_tag :email, t("registration.email"), class: "fx-label" %>
      <%= email_field_tag :email, nil, required: true, autocomplete: "email", maxlength: 160, autocapitalize: "none", spellcheck: false, class: "fx-input" %>
    </div>
    <%= submit_tag t("registration.resend"), class: "fx-btn" %>
  <% end %>
  <p class="mt-6 text-center text-sm"><%= link_to t("registration.sign_in"), admin_login_path(locale: I18n.locale), class: "fx-link" %></p>
</div>
