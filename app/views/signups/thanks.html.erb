<% content_for :title, t("signup.thanks_title") %>
<% content_for :head do %>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<% end %>

<div dir="<%= rtl? ? "rtl" : "ltr" %>" class="min-h-screen bg-white text-[#303030]" style="font-family: 'Inter', 'Noto Naskh Arabic', ui-sans-serif, system-ui, sans-serif">
  <%= render "platform_home/header" %>

  <main class="bg-[#f3f8ff] px-4 py-16 sm:px-6 sm:py-24">
    <div class="mx-auto max-w-md rounded-2xl border border-[#dbe8fb] bg-white p-8 text-center shadow-sm">
      <h1 class="text-2xl font-bold tracking-tight text-[#0b2447]"><%= t("signup.thanks_title") %></h1>
      <p class="mt-3 text-sm leading-6 text-[#616161]"><%= t("signup.thanks_body") %></p>
      <%= link_to t("signup.back"), platform_home_path, class: "mt-6 inline-block rounded-lg border border-[#d4d4d4] px-5 py-2.5 text-sm font-semibold text-[#303030] hover:bg-[#f3f8ff]" %>
    </div>
  </main>

  <%= render "platform_home/footer" %>
</div>
