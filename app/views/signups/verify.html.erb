<% content_for :title, t("registration.verify_title") %>
<%= render "signups/chrome" %>
<div class="fx-glass p-7 sm:p-9">
  <% if @registration.nil? %>
    <h1 class="text-3xl font-bold tracking-tight text-white"><%= t("registration.expired_title") %></h1>
    <p class="mt-3 text-sm leading-6 text-[#b9d3ff]" role="alert"><%= t("registration.expired_body") %></p>
    <%= link_to t("registration.request_new_link"), signup_thanks_path(locale: I18n.locale), class: "fx-btn mt-7 inline-flex items-center justify-center no-underline" %>
    <p class="mt-5 text-center text-sm"><%= link_to t("registration.sign_in"), admin_login_path(locale: I18n.locale), class: "fx-link" %></p>
  <% else %>
    <h1 class="text-3xl font-bold tracking-tight text-white"><%= t("registration.verify_title") %></h1>
    <p class="mt-3 text-sm leading-6 text-[#b9d3ff]"><%= t("registration.verify_body") %></p>
    <% if @registration.errors.any? %>
      <div role="alert" class="fx-alert mt-5">
        <p><%= t("registration.fix_fields") %></p>
        <ul class="mt-2 list-inside list-disc"><% @registration.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
      </div>
    <% end %>
    <%= form_with url: signup_confirm_path(locale: I18n.locale), method: :post, class: "mt-7 space-y-5" do %>
      <%= hidden_field_tag :token, @token %>
      <div>
        <%= label_tag :password, t("registration.password"), class: "fx-label" %>
        <%= password_field_tag :password, nil, required: true, autocomplete: "new-password", minlength: 12, maxlength: 72, autofocus: true,
              "aria-invalid": (@registration.errors.include?(:password) ? "true" : nil), "aria-describedby": "verify-password-help", class: "fx-input" %>
        <p id="verify-password-help" class="mt-2 text-xs text-[#b9d3ff]"><%= t("registration.password_help") %></p>
      </div>
      <div>
        <%= label_tag :password_confirmation, t("registration.password_confirmation"), class: "fx-label" %>
        <%= password_field_tag :password_confirmation, nil, required: true, autocomplete: "new-password", minlength: 12, maxlength: 72,
              "aria-invalid": (@registration.errors.include?(:password_confirmation) ? "true" : nil), class: "fx-input" %>
      </div>
      <%= submit_tag t("registration.verify_submit"), class: "fx-btn" %>
    <% end %>
  <% end %>
</div>
