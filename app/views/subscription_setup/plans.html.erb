<% content_for :title, st("Choisissez votre plan") %>
<% included = ["Commandes automatiques", "Confirmation par équipe", "Envoi à la livraison", "Suivi des colis", "Pubs Meta et TikTok", "Bénéfice réel", "FR · AR · EN", "Support WhatsApp"] %>
<% config = Plans.config.slice("currency", "currencies", "trial_days", "annual_months_paid", "list") %>
<main class="mx-auto w-full max-w-6xl flex-1 px-4 pb-8 sm:px-6" data-plans
      data-config="<%= config.to_json %>" data-strings="<%= plans_page_strings.to_json %>"
      data-current="<%= @current %>" data-billing="<%= @current_billing %>" data-currency="<%= @current_currency %>" data-guest="<%= @guest %>"
      data-locale="<%= { "ar" => "ar-MA", "en" => "en-GB" }.fetch(I18n.locale.to_s, "fr-FR") %>">
  <%= render "signups/steps", current: 2, done_until: (@guest ? 0 : 1), links: (@guest ? { 1 => signup_path } : (@current ? { 3 => payment_path } : {})) %>

  <% if alert.present? %><div role="alert" class="mt-4 rounded-lg bg-[#f8dcd9] px-4 py-3 text-sm text-[#b0342a]"><%= alert %></div><% end %>

  <div class="mt-5 flex flex-wrap items-end justify-between gap-4">
    <div>
      <h1 class="text-3xl font-extrabold tracking-tight text-[#10162a] sm:text-4xl">
        <% if I18n.locale.to_s == "en" %>Choose your <span class="text-[#5b46d6]">plan.</span>
        <% elsif I18n.locale.to_s == "ar" %>اختر <span class="text-[#5b46d6]">خطتك.</span>
        <% else %>Choisissez votre <span class="text-[#5b46d6]">plan.</span>
        <% end %>
      </h1>
      <p class="mt-1.5 text-sm"><%= st("Toutes les fonctionnalités dans chaque plan. Prix en dollars, ou dans la devise de votre pays.") %></p>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      <label class="inline-flex items-center gap-2 rounded-xl border border-[#e7e9ee] bg-white px-3 py-1.5 text-sm font-semibold text-[#10162a]">
        <span class="text-xs font-medium text-[#6b7280]"><%= st("Devise") %></span>
        <select data-currency-select class="cursor-pointer bg-transparent font-semibold outline-none" aria-label="<%= st("Devise") %>">
          <% Plans.currencies.each do |code, c| %><option value="<%= code %>" title="<%= c["name"] %>"><%= c["symbol"] == code ? code : "#{code} (#{c["symbol"]})" %></option><% end %>
        </select>
      </label>
      <div class="inline-flex items-center rounded-xl border border-[#e7e9ee] bg-white p-1 text-sm font-semibold">
        <% %w[monthly annual].each do |b| %>
          <button type="button" data-billing-button="<%= b %>" class="flex items-center gap-2 rounded-lg px-4 py-1.5 transition">
            <%= st(b == "monthly" ? "Mensuel" : "Annuel") %>
            <% if b == "annual" %><span data-saving class="rounded-md px-1.5 py-0.5 text-[11px]">−<%= Plans.annual_saving %> %</span><% end %>
          </button>
        <% end %>
      </div>
    </div>
  </div>

  <%= form_with url: plans_path, method: :post, data: { plan_form: true } do %>
    <input type="hidden" name="plan" data-field="plan">
    <input type="hidden" name="billing" data-field="billing">
    <input type="hidden" name="currency" data-field="currency">
  <% end %>

  <div data-plan-grid class="mt-5 grid grid-cols-2 gap-2.5 sm:gap-3 lg:grid-cols-5"></div>

  <div class="mt-3 flex flex-col gap-3 rounded-2xl border border-[#e7e9ee] bg-white px-5 py-4 lg:flex-row lg:items-center lg:justify-between">
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-[#10162a]">
      <span class="font-semibold"><%= st("Inclus partout :") %></span>
      <% included.each do |feature| %><span class="flex items-center gap-1"><span class="text-[#5b46d6]">✓</span><%= st(feature) %></span><% end %>
    </div>
    <a href="mailto:contact@seallo.ma" class="shrink-0 text-sm font-semibold text-[#5b46d6] hover:underline"><%= st("+15 000 commandes ? Plan sur mesure →") %></a>
  </div>
</main>

<script>
  (function () {
    var root = document.querySelector("[data-plans]");
    var cfg = JSON.parse(root.dataset.config);
    var S = JSON.parse(root.dataset.strings);
    var locale = root.dataset.locale;
    var guest = root.dataset.guest === "true";
    var current = root.dataset.current || null;
    var KEY = "seallo-currency";
    var state = { billing: root.dataset.billing || "monthly", currency: root.dataset.currency || cfg.currency, sending: null };
    if (!root.dataset.currency) {
      try { var saved = localStorage.getItem(KEY); if (saved && cfg.currencies[saved]) state.currency = saved; } catch (e) {}
    }

    var fmt = function (n) { return Number(n).toLocaleString("fr-FR").replace(/[  ]/g, " "); };
    var convert = function (usd, code) {
      var rate = (cfg.currencies[code] || { rate: 1 }).rate, v = usd * rate;
      if (v === 0) return 0;
      return rate >= 50 ? Math.round(v / 10) * 10 : Math.round(v);
    };
    var money = function (usd, code) {
      var c = cfg.currencies[code] || { symbol: code, rate: 1 }, n = fmt(convert(usd, code));
      if (c.symbol === "$" || c.symbol === "£") return "⁦" + c.symbol + n + "⁩";
      if (c.symbol === "€") return "⁦" + n + " €⁩";
      return "⁦" + n + " " + c.symbol + "⁩";
    };
    var monthly = function (p) { return state.billing === "annual" ? p.price * cfg.annual_months_paid / 12 : p.price; };
    var ordersLabel = function (p) { return p.orders === null ? S["Commandes illimitées"] : fmt(p.orders) + " " + S["commandes/mois"]; };
    var storesLabel = function (p) { return p.stores === null ? S["Boutiques illimitées"] : p.stores + " " + S[p.stores > 1 ? "boutiques" : "boutique"]; };
    var esc = function (s) { return String(s).replace(/[&<>"]/g, function (c) { return { "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]; }); };

    var grid = root.querySelector("[data-plan-grid]");
    var form = root.querySelector("[data-plan-form]");
    var render = function () {
      var big = ["USD", "EUR", "GBP"].indexOf(state.currency) >= 0;
      var html = "";
      Object.keys(cfg.list).forEach(function (key) {
        var p = cfg.list[key], free = p.price === 0;
        var label = state.sending === key ? S["Un instant…"]
          : current === key ? (guest ? S["Plan choisi"] : S["Plan actuel"])
          : free ? S["Commencer"] : S["Choisir"] + " " + p.name;
        var billed = free ? S["Sans carte, sans engagement"]
          : state.billing === "annual" ? S["Facturé"] + " " + money(p.price * cfg.annual_months_paid, state.currency) + " " + S["/ an"] : "";
        html += '<button type="button" data-plan="' + key + '"' + (state.sending !== null ? " disabled" : "") +
          ' class="group relative flex flex-col rounded-2xl border bg-white p-3.5 text-start transition sm:p-5 ' + (free ? "col-span-2 lg:col-span-1 " : "") +
          'hover:-translate-y-0.5 hover:shadow-[0_20px_40px_-24px_rgba(16,22,42,0.35)] disabled:opacity-70 ' +
          (p.popular ? "border-[#5b46d6] ring-1 ring-[#5b46d6]" : "border-[#e7e9ee] hover:border-[#5b46d6]/50") + '">' +
          (p.popular ? '<span class="absolute -top-2.5 right-3 rounded-full bg-[#5b46d6] px-2 py-0.5 text-[10px] font-bold whitespace-nowrap text-white sm:right-4 sm:px-2.5 sm:text-[11px]">' + (free ? S["Offre de lancement"] : S["Le plus populaire"]) + "</span>" : "") +
          '<span class="font-semibold text-[#10162a]">' + esc(S[p.name] || p.name) + "</span>" +
          '<span class="mt-1.5 flex items-baseline gap-1"><span class="font-extrabold whitespace-nowrap text-[#10162a] ' + (big ? "text-2xl sm:text-3xl" : "text-xl sm:text-2xl") + '" dir="ltr">' + money(monthly(p), state.currency) + '</span><span class="text-xs font-medium whitespace-nowrap">' + S["/ mois"] + "</span></span>" +
          '<span class="h-4 text-[11px]">' + esc(billed) + "</span>" +
          '<span class="mt-2 flex-1 space-y-1 text-[11px] text-[#10162a] sm:mt-3 sm:text-[13px]">' +
          '<span class="flex gap-2"><span class="text-[#5b46d6]">✓</span> ' + esc(ordersLabel(p)) + "</span>" +
          '<span class="flex gap-2"><span class="text-[#5b46d6]">✓</span> ' + esc(storesLabel(p)) + "</span>" +
          '<span class="flex gap-2"><span class="text-[#5b46d6]">✓</span> ' + esc(free ? S["Tous les outils, illimités"] : cfg.trial_days + " " + S["jours d'essai gratuit"]) + "</span></span>" +
          '<span class="mt-3 flex h-9 items-center justify-center rounded-xl px-2 text-center text-xs font-semibold whitespace-nowrap transition sm:mt-4 sm:h-10 sm:text-sm ' +
          (p.popular ? "bg-[#5b46d6] text-white group-hover:bg-[#4a37c2]" : "bg-[#e9ecf1] text-[#10162a] group-hover:bg-[#5b46d6] group-hover:text-white") + '">' + esc(label) + "</span></button>";
      });
      grid.innerHTML = html;
      root.querySelectorAll("[data-billing-button]").forEach(function (b) {
        var on = b.dataset.billingButton === state.billing;
        b.className = "flex items-center gap-2 rounded-lg px-4 py-1.5 transition " + (on ? "bg-[#10162a] text-white" : "text-[#10162a] hover:bg-[#e9ecf1]");
        var saving = b.querySelector("[data-saving]");
        if (saving) saving.className = "rounded-md px-1.5 py-0.5 text-[11px] " + (on ? "bg-white/15 text-emerald-300" : "bg-emerald-50 text-emerald-700");
      });
      root.querySelector("[data-currency-select]").value = state.currency;
    };

    grid.addEventListener("click", function (e) {
      var card = e.target.closest("[data-plan]");
      if (!card || state.sending !== null) return;
      state.sending = card.dataset.plan;
      form.querySelector("[data-field=plan]").value = state.sending;
      form.querySelector("[data-field=billing]").value = state.billing;
      form.querySelector("[data-field=currency]").value = state.currency;
      render();
      form.requestSubmit();
    });
    root.querySelectorAll("[data-billing-button]").forEach(function (b) {
      b.addEventListener("click", function () { state.billing = b.dataset.billingButton; render(); });
    });
    root.querySelector("[data-currency-select]").addEventListener("change", function (e) {
      state.currency = e.target.value;
      try { localStorage.setItem(KEY, state.currency); } catch (err) {}
      render();
    });
    render();
  })();
</script>
